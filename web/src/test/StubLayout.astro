---
/**
 * A page's layout in a render test that is about the page alone: its props as data, its slot in
 * `<main data-page>`, and none of the frame's own markup to match by mistake.
 */
const { title, titlePrefix } = Astro.props;
---

<main data-page data-title={title} data-title-prefix={titlePrefix || undefined}><slot /></main>
