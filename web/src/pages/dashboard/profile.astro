---
/**
 * Account (/dashboard/account), on the kit (style-guide rollout M12, audit A§15): how you take part
 * (onboarding), your name, and your photo, as the shell draws you (one look per person). Each form
 * posts here: a saved one answers 303 with a read-once flash; a refused one renders again with what
 * was typed, a focused danger Notice and the error under its field (400; 409 when the profile moved
 * during the check, 422 when Tembo's check holds it); a failure that isn't the person's is a 503.
 */
import SpacePage from "@/components/platform/spaces/SpacePage.astro";
import { onboardingFor, resolveSpacePageWith } from "@/components/platform/spaces/space-page";
import { SPACE_PAGE_PATHS } from "@/components/platform/spaces/sidebar";
import TakingPart from "@/components/platform/onboarding/TakingPart.astro";
import { ACTION_FIELD, handleAccountAction } from "@/components/platform/onboarding/account-actions";
import { accountActions } from "@/components/platform/onboarding/server-actions";
import { Avatar, Button, Card, FileField, Notice, PageHeader, TextField } from "@/components/platform/ui";
import { redirectWithFlash, takeFlash } from "@/lib/platform/server/flash";
import { expireSessionCache } from "@/lib/auth-session";
import { drizzle } from "drizzle-orm/d1";
import * as schema from "@/lib/db/schema";
import { env } from "cloudflare:workers";
import {
  AvatarUploadError,
  loadProfilePhotoForModeration,
  storeProfilePhoto,
} from "@/lib/avatar";
import { isAgentSession } from "@/lib/agent-auth";
import {
  checkProfileContent,
  previewProfileModerationResult,
  PROFILE_MODERATION_PREVIEW_HEADER,
} from "@/lib/moderation/clef";
import {
  saveProfileIdentity,
  type ProfileIdentityInput,
} from "@/components/profile/profile-handlers";
import {
  discardReplacedProfilePhotos,
  discardUnreferencedProfilePhoto,
} from "@/components/profile/profile-photo-cleanup";
import type { ProfileContentCheck } from "@/components/portfolio/portfolio-handlers";
import { ACCOUNT_COPY } from "@/lib/student/account-page";

const user = Astro.locals.user!;
const db = drizzle(env.DB, { schema });
// The frame starts first, beside whatever the request does (PERF-2); the page has no reads of its own.
const resolving = resolveSpacePageWith(Astro.locals, "account", async () => null);

/** Which form a refusal belongs to, so its error sits under that form's field. */
let failed: "name" | "photo" | null = null;
/** What the danger Notice says; `fieldError`, when the refusal is about what was typed or chosen. */
let error = "";
let fieldError = "";
let moderationMessages: string[] = [];
let submittedName: string | null = null;

const previewModeration = previewProfileModerationResult(
  env.DEPLOYMENT_ENVIRONMENT,
  isAgentSession(Astro.locals.session?.userAgent),
  Astro.request.headers.get(PROFILE_MODERATION_PREVIEW_HEADER),
);
const moderateProfile: ProfileContentCheck = async (state, avatarUrl) => {
  if (previewModeration) {
    return { ...previewModeration, publicAvatarUrl: avatarUrl };
  }
  const moderation = await checkProfileContent(env.AI, state, {
    gatewayName: env.AI_GATEWAY_NAME,
    loadAvatarImage: avatarUrl
      ? () => loadProfilePhotoForModeration(env.BUCKET, avatarUrl)
      : undefined,
  });
  return { ...moderation, publicAvatarUrl: avatarUrl };
};
const discardAvatar = async (imageUrl: string | null | undefined) => {
  await discardUnreferencedProfilePhoto({
    db,
    bucket: env.BUCKET,
    userId: user.id,
    imageUrl,
  });
};

/**
 * The onboarding forms (Account's "How you take part", and the cards on the
 * landing pages, which post here) exist only while onboarding applies to this
 * person and session; otherwise, as if they did not exist. Whether it applies
 * is the flag and the session, never a read that can fail: a failed write
 * returns to the page with "That didn't save". Each answer is private to this
 * person and never cached.
 */
async function answerOnboardingForm(form: FormData): Promise<Response> {
  const respond = (status: number, headers: Record<string, string> = {}) =>
    new Response(status === 404 ? "Not found." : null, { status, headers: { "Cache-Control": "no-store", Vary: "Cookie", ...headers } });
  const context = (await resolving)?.[0];
  if (!context || !onboardingFor(Astro.locals, context.me)) return respond(404);
  const result = await handleAccountAction(form, accountActions(env.DB, user.id));
  return result.kind === "refuse" ? respond(result.status) : respond(303, { Location: result.location });
}

let formData: FormData | null = null;
if (Astro.request.method === "POST") {
  try {
    formData = await Astro.request.formData();
  } catch {
    error = ACCOUNT_COPY.unreadable;
    Astro.response.status = 400;
  }
}
const onboardingAnswer = formData?.has(ACTION_FIELD) ? await answerOnboardingForm(formData) : null;
if (onboardingAnswer) return onboardingAnswer;

if (formData) {
  const action = formData.get("action");
  failed = action === "avatar" ? "photo" : "name";
  let uploadedAvatarUrl: string | null = null;
  try {
    if (action === "avatar") {
      const avatarFile = formData.get("avatar");
      if (!(avatarFile instanceof File) || avatarFile.size === 0) {
        throw new AvatarUploadError(ACCOUNT_COPY.noPhoto);
      }

      const previousImageUrl = user.image;
      const previousProfile = await db.query.studentProfile.findFirst({
        where: (profile, { eq }) => eq(profile.userId, user.id),
        columns: { publicAvatarUrl: true },
      });
      const uploadedAvatar = await storeProfilePhoto(env, {
        userId: user.id,
        file: avatarFile,
        previousImageUrl,
        deletePrevious: false,
      });
      uploadedAvatarUrl = uploadedAvatar.imageUrl;

      const result = await saveProfileIdentity(db, user.id, { avatarUrl: uploadedAvatar.imageUrl }, moderateProfile);
      if (!result.success) {
        await discardAvatar(uploadedAvatarUrl);
        uploadedAvatarUrl = null;
        fieldError = result.error ?? ACCOUNT_COPY.photoNotSaved;
        error = ACCOUNT_COPY.fixBelow;
        moderationMessages = result.moderationMessages ?? [];
        Astro.response.status = result.moderationOutcome === "hold" ? 422 : 409;
      } else {
        await discardReplacedProfilePhotos({
          db,
          bucket: env.BUCKET,
          userId: user.id,
          imageUrls: [previousImageUrl, previousProfile?.publicAvatarUrl],
        });
        expireSessionCache(Astro.request, Astro.cookies);
        return redirectWithFlash(Astro, SPACE_PAGE_PATHS.account, { tone: "success", title: ACCOUNT_COPY.photoSaved });
      }
    } else {
      const name = String(formData.get("name") ?? "").trim();
      submittedName = name;
      if (!name) {
        fieldError = ACCOUNT_COPY.noName;
        error = ACCOUNT_COPY.fixBelow;
        Astro.response.status = 400;
      } else {
        const input: ProfileIdentityInput = { name };
        const result = await saveProfileIdentity(db, user.id, input, moderateProfile);
        if (!result.success) {
          fieldError = result.error ?? ACCOUNT_COPY.nameNotSaved;
          error = ACCOUNT_COPY.fixBelow;
          moderationMessages = result.moderationMessages ?? [];
          Astro.response.status = result.moderationOutcome === "hold" ? 422 : 409;
        } else {
          // The shell and this form read the person from the session cache: let the next request read D1.
          expireSessionCache(Astro.request, Astro.cookies);
          return redirectWithFlash(Astro, SPACE_PAGE_PATHS.account, { tone: "success", title: ACCOUNT_COPY.nameSaved });
        }
      }
    }
  } catch (caught) {
    await discardAvatar(uploadedAvatarUrl);
    if (caught instanceof AvatarUploadError) {
      fieldError = caught.message;
      error = ACCOUNT_COPY.fixBelow;
      Astro.response.status = 400;
    } else {
      error = ACCOUNT_COPY.unavailable;
      Astro.response.status = 503;
    }
  }
}

const spaces = (await resolving)?.[0] ?? null;
const onboarding = spaces?.onboarding ?? null;
// A POST never carries a flash, and a refused one says what went wrong instead.
const flash = Astro.request.method === "GET" ? takeFlash(Astro) : null;
const nameError = failed === "name" && fieldError ? fieldError : undefined;
const photoError = failed === "photo" && fieldError ? fieldError : undefined;
---

<SpacePage context={spaces} title="Account" titlePrefix={error ? "Error: " : ""}>
  <div class="flex max-w-3xl flex-col gap-8">
    <PageHeader title="Account">{ACCOUNT_COPY.lead}</PageHeader>

    {flash && <Notice tone={flash.tone} title={flash.title}>{flash.message}</Notice>}

    {error && (
      <Notice tone="danger" focusOnLoad id="account-failure" title={failed === "photo" ? ACCOUNT_COPY.photoNotSaved : failed === "name" ? ACCOUNT_COPY.nameNotSaved : ACCOUNT_COPY.notSaved}>
        {moderationMessages.length > 0 ? (
          <ul class="m-0 list-disc space-y-1 pl-5">
            {moderationMessages.map((message) => <li>{message}</li>)}
          </ul>
        ) : (
          error
        )}
      </Notice>
    )}

    {onboarding && <TakingPart view={onboarding} />}

    <Card as="section" aria-labelledby="account-details-title" className="flex flex-col gap-5">
      <h2 id="account-details-title" class="text-xl leading-snug text-ink-primary">Your details</h2>
      <div class="flex min-w-0 items-center gap-4">
        <Avatar id={user.id} name={user.name} src={user.image ?? undefined} size="xl" decorative />
        <div class="min-w-0">
          <p class="m-0 font-semibold break-words text-ink-primary">{user.name}</p>
          <p class="m-0 text-sm break-all text-ink-secondary">{user.email}</p>
        </div>
      </div>
      <form method="POST" class="flex flex-col gap-4" data-account-name>
        <input type="hidden" name="action" value="profile" />
        <TextField label="Name" name="name" required autocomplete="name" defaultValue={submittedName ?? user.name} error={nameError} />
        <TextField label="Email" id="account-email" type="email" defaultValue={user.email} disabled hint={ACCOUNT_COPY.emailHint} />
        <div><Button type="submit" variant="primary">Save name</Button></div>
      </form>
    </Card>

    <Card as="section" aria-labelledby="account-photo-title" className="flex flex-col gap-5">
      <h2 id="account-photo-title" class="text-xl leading-snug text-ink-primary">Photo</h2>
      <form method="POST" enctype="multipart/form-data" class="flex flex-col gap-4" data-account-photo>
        <input type="hidden" name="action" value="avatar" />
        <FileField label="Profile photo" name="avatar" accept="image/png,image/jpeg,image/gif,image/webp" required hint={ACCOUNT_COPY.photoHint} error={photoError} />
        <div><Button type="submit">Upload photo</Button></div>
      </form>
    </Card>
  </div>
</SpacePage>
