---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import Card from "@/components/common/Card.astro";
import Button from "@/components/common/Button.astro";
import { drizzle } from "drizzle-orm/d1";
import * as schema from "@/lib/db/schema";
import { env } from "cloudflare:workers";
import {
  AvatarUploadError,
  loadProfilePhotoForModeration,
  storeProfilePhoto,
} from "@/lib/avatar";
import { isAgentSession } from "@/lib/agent-auth";
import {
  checkProfileContent,
  previewProfileModerationResult,
  PROFILE_MODERATION_PREVIEW_HEADER,
} from "@/lib/moderation/clef";
import {
  saveProfileIdentity,
  type ProfileIdentityInput,
} from "@/components/profile/profile-handlers";
import { discardUnreferencedProfilePhoto } from "@/components/profile/profile-photo-cleanup";
import type { ProfileContentCheck } from "@/components/portfolio/portfolio-handlers";

const user = Astro.locals.user!;
const db = drizzle(env.DB, { schema });

let success = "";
let error = "";
let moderationMessages: string[] = [];
let submittedName: string | null = null;

const previewModeration = previewProfileModerationResult(
  env.DEPLOYMENT_ENVIRONMENT,
  isAgentSession(Astro.locals.session?.userAgent),
  Astro.request.headers.get(PROFILE_MODERATION_PREVIEW_HEADER),
);
const moderateProfile: ProfileContentCheck = async (state, avatarUrl) => {
  if (previewModeration) {
    return { ...previewModeration, publicAvatarUrl: avatarUrl };
  }
  const moderation = await checkProfileContent(env.AI, state, {
    gatewayName: env.AI_GATEWAY_NAME,
    loadAvatarImage: avatarUrl
      ? () => loadProfilePhotoForModeration(env.BUCKET, avatarUrl)
      : undefined,
  });
  return { ...moderation, publicAvatarUrl: avatarUrl };
};
const discardAvatar = async (imageUrl: string | null | undefined) => {
  await discardUnreferencedProfilePhoto({
    db,
    bucket: env.BUCKET,
    userId: user.id,
    imageUrl,
  });
};

// Handle POST — update user profile or avatar
if (Astro.request.method === "POST") {
  let uploadedAvatarUrl: string | null = null;
  try {
    const formData = await Astro.request.formData();
    const action = formData.get("action");

    if (action === "avatar") {
      const avatarFile = formData.get("avatar");

      if (!(avatarFile instanceof File)) {
        throw new AvatarUploadError("Please choose an image to upload.");
      }

      const previousImageUrl = user.image;
      const uploadedAvatar = await storeProfilePhoto(env, {
        userId: user.id,
        file: avatarFile,
        previousImageUrl,
        deletePrevious: false,
      });
      uploadedAvatarUrl = uploadedAvatar.imageUrl;

      const result = await saveProfileIdentity(
        db,
        user.id,
        { avatarUrl: uploadedAvatar.imageUrl },
        moderateProfile,
      );
      if (!result.success) {
        await discardAvatar(uploadedAvatarUrl);
        uploadedAvatarUrl = null;
        error = result.error ?? "The profile photo could not be updated.";
        moderationMessages = result.moderationMessages ?? [];
        Astro.response.status = result.moderationOutcome === "hold" ? 422 : 409;
      } else {
        user.image = uploadedAvatar.imageUrl;
        success = "Profile photo updated successfully!";
        await discardAvatar(previousImageUrl);
      }
    } else {
      const name = (formData.get("name") as string)?.trim();

      if (!name) {
        error = "Name is required.";
      } else {
        submittedName = name;
        const input: ProfileIdentityInput = { name };
        const result = await saveProfileIdentity(
          db,
          user.id,
          input,
          moderateProfile,
        );
        if (!result.success) {
          error = result.error ?? "The profile could not be updated.";
          moderationMessages = result.moderationMessages ?? [];
          Astro.response.status = result.moderationOutcome === "hold" ? 422 : 409;
        } else {
          user.name = name;
          submittedName = null;
          success = "Profile updated successfully!";
        }
      }
    }
  } catch (e) {
    await discardAvatar(uploadedAvatarUrl);
    error =
      e instanceof AvatarUploadError
        ? e.message
        : "Something went wrong. Please try again.";
  }
}
---

<DashboardLayout title="Profile">
  <div class="space-y-6">
    <div>
      <h2 class="text-2xl font-bold text-white">Your Profile</h2>
      <p class="mt-1 text-ink-secondary">
        Manage your account information.
      </p>
    </div>

    {success && (
      <div class="rounded-md border border-green-500/30 bg-green-500/10 p-4 text-green-300">
        {success}
      </div>
    )}

    {error && (
      <div class="rounded-md border border-red-500/30 bg-red-500/10 p-4 text-red-300">
        <p>{error}</p>
        {moderationMessages.length > 0 && (
          <ul class="mt-2 list-disc space-y-1 pl-5">
            {moderationMessages.map((message) => <li>{message}</li>)}
          </ul>
        )}
      </div>
    )}

    <div class="grid gap-6 lg:grid-cols-3">
      {/* Avatar section */}
      <Card>
        <div class="flex flex-col items-center gap-4 text-center">
          {user.image ? (
            <img
              src={user.image}
              alt={user.name}
              class="h-24 w-24 rounded-full border-2 border-primary"
            />
          ) : (
            <div class="flex h-24 w-24 items-center justify-center rounded-full bg-teal text-3xl font-bold text-white">
              {user.name.charAt(0).toUpperCase()}
            </div>
          )}
          <div>
            <p class="text-lg font-semibold text-white">{user.name}</p>
            <p class="text-sm text-ink-secondary">{user.email}</p>
          </div>
          <form method="POST" enctype="multipart/form-data" class="w-full space-y-3">
            <input type="hidden" name="action" value="avatar" />
            <div class="flex flex-col gap-1.5 text-left">
              <label for="avatar" class="text-sm font-medium text-white/90">
                Profile photo
              </label>
              <input
                id="avatar"
                name="avatar"
                type="file"
                accept="image/*"
                required
                class="block w-full cursor-pointer rounded-md border border-teal bg-dark/50 px-3 py-2 text-sm text-white file:mr-4 file:rounded-md file:border-0 file:bg-primary file:px-4 file:py-2 file:font-medium file:text-dark hover:file:bg-primary/90 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/50"
              />
              <p class="text-xs text-ink-muted">
                Upload a PNG, JPG, GIF, or WebP image. Files are resized to a maximum of 1024x1024 before storage.
              </p>
            </div>
            <Button type="submit" class="w-full">
              Upload Photo
            </Button>
          </form>
        </div>
      </Card>

      {/* Edit form */}
      <Card class="lg:col-span-2">
        <h3 class="mb-4 text-lg font-semibold text-white">Edit Profile</h3>
        <form method="POST" class="space-y-4">
          <input type="hidden" name="action" value="profile" />
          <div class="flex flex-col gap-1.5">
            <label for="name" class="text-sm font-medium text-white/90">
              Name <span class="text-primary">*</span>
            </label>
            <input
              id="name"
              name="name"
              type="text"
              required
              value={submittedName ?? user.name}
              class="form-control placeholder:text-ink-muted"
            />
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="email" class="text-sm font-medium text-white/90">
              Email
            </label>
            <input
              id="email"
              type="email"
              value={user.email}
              disabled
              class="form-control text-ink-muted cursor-not-allowed"
            />
            <p class="text-xs text-ink-muted">
              Email is managed by your sign-in provider and cannot be changed here.
            </p>
          </div>

          <Button type="submit">
            Save Changes
          </Button>
        </form>
      </Card>
    </div>
  </div>
</DashboardLayout>
