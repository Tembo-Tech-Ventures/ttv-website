---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CommunityApp from "@/components/community/CommunityApp";
import SpacePage from "@/components/platform/spaces/SpacePage.astro";
import CohortInvitation from "@/components/platform/spaces/CohortInvitation.astro";
import OnboardingNotices from "@/components/platform/onboarding/OnboardingNotices.astro";
import { PARTNER } from "@/components/platform/onboarding/copy";
import { offersCohort } from "@/components/platform/onboarding/framing";
import { resolveSpacePage, restrictedNextStep, restrictionsFor } from "@/components/platform/spaces/space-page";
import { drizzle } from "drizzle-orm/d1";
import { env } from "cloudflare:workers";
import * as schema from "@/lib/db/schema";
import { getStudentJourney } from "@/lib/student/journey";
// oxlint-disable-next-line import/no-unassigned-import -- Workspace stylesheet.
import "@/styles/discovery.css";
// Authentication is enforced by dashboard middleware; every data API checks access.

const spaces = await resolveSpacePage(Astro.locals, "journey");
const journey = spaces ? await getStudentJourney(drizzle(env.DB, { schema }), spaces.me.user.id) : undefined;
// With onboarding on, how the person said they take part frames this page (onboarding SPEC §3).
// Without it (null), Community reads exactly as before: member framing for everyone.
const framing = spaces?.onboarding?.framing;
// Without a cohort there is no Cohort tab: the way to apply has to be here, on screen.
// Mentors and organisations who did not choose to build and learn are not asked to apply.
// A restricted synthetic identity that cannot follow the step gets no invitation (it is already on its journey).
const step = spaces && !spaces.me.spaces.includes("cohort") && offersCohort(framing) ? journey?.nextStep : undefined;
const invitation = step && restrictedNextStep(restrictionsFor(Astro.locals), step) === step ? step : undefined;
---
{
  spaces ? (
    <SpacePage context={spaces} title={framing === "partner" ? PARTNER.title : "Your journey"} journey={journey}>
      {spaces.onboarding && <OnboardingNotices view={spaces.onboarding} space={spaces.space} class={invitation ? "mb-4" : "mb-10"} />}
      {invitation && <CohortInvitation step={invitation} />}
      <CommunityApp client:load view="journey" embedded framing={framing} />
    </SpacePage>
  ) : (
    <BaseLayout title="Your community journey | TTV" noIndex>
      <CommunityApp client:load view="journey" />
    </BaseLayout>
  )
}
