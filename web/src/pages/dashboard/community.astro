---
/**
 * Community's home (/dashboard/community): the caller's profile and the work they've posted, as
 * everyone signed in sees them, with the way to change them. There is one profile editor, in the
 * Profile space (/dashboard/me/portfolio): this page links there for the profile and for posting,
 * editing and deleting work, so nothing is edited in two places. Server-rendered with no island.
 * Authentication is enforced by dashboard middleware; every read passes the API's own checks.
 */
import { drizzle } from "drizzle-orm/d1";
import { env } from "cloudflare:workers";
import * as schema from "@/lib/db/schema";
import { getStudentJourney } from "@/lib/student/journey";
import { redirectWithFlash, takeFlash } from "@/lib/platform/server/flash";
import SpacePage from "@/components/platform/spaces/SpacePage.astro";
import CohortInvitation from "@/components/platform/spaces/CohortInvitation.astro";
import ChannelShortcuts from "@/components/platform/spaces/ChannelShortcuts.astro";
import { loadChannelShortcuts } from "@/components/platform/spaces/channel-shortcuts-server";
import { pickSpace, resolveSpacePageWith, restrictedNextStep, restrictionsFor } from "@/components/platform/spaces/space-page";
import OnboardingNotices from "@/components/platform/onboarding/OnboardingNotices.astro";
import OnboardingPrompt from "@/components/platform/onboarding/OnboardingPrompt.astro";
import { PARTNER } from "@/components/platform/onboarding/copy";
import { offersCohort } from "@/components/platform/onboarding/framing";
import { ButtonLink, DataList, EmptyState, Notice, PageHeader, linkClass } from "@/components/platform/ui";
import ProfileCard from "@/components/community/home/ProfileCard.astro";
import JourneyEntry from "@/components/community/home/JourneyEntry.astro";
import { loadCommunityHome } from "@/components/community/home/home-data";
import { EVERYONE_SEES } from "@/components/platform/profile-editor/copy";
import { addWorkHref, EDITOR_PATH, editWorkHref, profileFormHref } from "@/components/platform/profile-editor/work-forms";
import { SPACE_PATHS } from "@/lib/platform/server/space-routes";

const { method } = Astro.request;
// This page used to post work and save the profile itself. A form from a tab opened before that moved
// lands in the editor, told plainly that nothing was saved, instead of on a bare 405.
if (method === "POST") {
  return redirectWithFlash(Astro, EDITOR_PATH, {
    tone: "warning", title: "Your profile and work are edited here now", message: "Nothing was saved from the old page. Please make the change again below.",
  });
}
if (method !== "GET" && method !== "HEAD") {
  return new Response("Not allowed.", { status: 405, headers: { Allow: "GET, HEAD, POST", "Cache-Control": "no-store", Vary: "Cookie" } });
}
// The old page's own links (posting, editing a piece, editing the profile) open the same in the editor.
const legacy = Astro.url.searchParams;
const editing = legacy.get("edit");
const moved = legacy.has("add") ? addWorkHref() : editing ? editWorkHref({ id: editing }) : legacy.get("profile") === "edit" ? profileFormHref() : null;
if (moved) return Astro.redirect(moved, 301);

// The page's own reads start together, beside the space context and onboarding (PERF-2): the profile
// and work through the community API, the student journey the frame and the invitation share, and
// the channel list for the "Channels" card, which the sidebar reuses (QA2-16).
const [landing, journey, home] = await Promise.all([
  resolveSpacePageWith(Astro.locals, "journey", (me) => loadChannelShortcuts({ me, space: pickSpace(me, "journey")!, page: "journey" })),
  getStudentJourney(drizzle(env.DB, { schema }), Astro.locals.user!.id),
  loadCommunityHome(Astro.request, Astro.locals, env),
]);
const spaces = landing?.[0] ?? null;
const { channels, shortcuts } = landing?.[1] ?? { channels: undefined, shortcuts: null };
// Everything the caller has posted or drafted, repositories included: each one leads to where it is changed.
const work = home?.claims ?? [];
Astro.response.headers.set("Cache-Control", "no-store");
const flash = takeFlash(Astro);

// With onboarding on, how the person said they take part frames this page (onboarding SPEC §3).
// Without it, Community reads exactly as before: member framing for everyone.
const framing = spaces?.onboarding?.framing ?? "member";
// Without a cohort there is no Cohort tab: the way to apply has to be here, on screen.
// Mentors and organisations who did not choose to build and learn are not asked to apply.
// A restricted synthetic identity that cannot follow the step gets no invitation (it is already on its journey).
const step = spaces && !spaces.me.spaces.includes("cohort") && offersCohort(framing) ? journey.nextStep : undefined;
const invitation = step && restrictedNextStep(restrictionsFor(Astro.locals), step) === step ? step : undefined;
const journeyTitle = framing === "partner" ? PARTNER.ownWork : "Your journey";
---

<SpacePage context={spaces} title={framing === "partner" ? PARTNER.title : "Your journey"} journey={journey} channels={channels}>
  <div class="flex max-w-4xl flex-col gap-10">
    <div class="flex flex-col gap-8">
      <PageHeader title="Community">
        Show what you made, what you learned, and the part that was yours.
        {home && <Fragment slot="action"><ButtonLink href={addWorkHref()} variant="primary" size="lg">Post work</ButtonLink></Fragment>}
      </PageHeader>
      {/* Onboarding's cards follow the page's title, so its h1 comes first (QAO-05). */}
      {spaces?.onboarding && <OnboardingNotices view={spaces.onboarding} space={spaces.space} class="" />}
      {invitation && <CohortInvitation step={invitation} />}
      <OnboardingPrompt view={spaces?.onboarding} space={spaces?.space ?? "community"} />
    </div>

    {flash && <Notice tone={flash.tone} title={flash.title} focusOnLoad>{flash.message}</Notice>}

    {home ? (
      <>
        {home.moderationHold && (
          <Notice tone="warning" title="Your profile is waiting for a check">
            It's saved. A person at TTV checks it before anyone else can see it; until then only you and the team can.
          </Notice>
        )}
        <ProfileCard profile={home} />

        <section aria-labelledby="community-journey-title" class="flex flex-col gap-6" data-community-journey>
          <div class="flex flex-col gap-3">
            <h2 id="community-journey-title" class="text-2xl text-ink-primary">{journeyTitle}</h2>
            <p class="max-w-prose text-base leading-relaxed text-ink-secondary">
              Say what was yours. Link the work. Describe what changed. A mentor can confirm the specific work they
              reviewed. A missing confirmation is an open question, not a mark against you.
            </p>
          </div>
          <Notice tone="info" title="Who sees this">
            {EVERYONE_SEES} Drafts are only for you.
            <Fragment slot="actions"><ButtonLink href={`${SPACE_PATHS.community}/members`}>See the members directory</ButtonLink></Fragment>
          </Notice>

          <DataList label={journeyTitle} isEmpty={work.length === 0}>
            {work.map((claim) => <JourneyEntry claim={claim} />)}
            <Fragment slot="empty">
              {/* Someone just looking around, a mentor or an organisation is not prompted like a student. */}
              {framing === "member" && (
                <EmptyState title="Your first piece of work belongs here.">
                  You don't need a finished portfolio. Start with one thing you made or learned.
                </EmptyState>
              )}
            </Fragment>
          </DataList>
        </section>
      </>
    ) : (
      <Notice tone="danger" title="We couldn't load your profile">
        Your profile and work are safe. Try again in a moment, or{" "}
        <a href={`/auth/login?next=${encodeURIComponent(SPACE_PATHS.community)}`} class={linkClass()}>sign in again</a> if
        you've been signed out.
        <Fragment slot="actions"><ButtonLink href={SPACE_PATHS.community}>Try again</ButtonLink></Fragment>
      </Notice>
    )}

    <ChannelShortcuts model={shortcuts} />
  </div>
</SpacePage>
