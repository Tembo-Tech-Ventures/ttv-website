---
import { DEMO_PREFIX, isDemoUser } from "@/lib/staging-demo-policy";
import SpacePage from "@/components/platform/spaces/SpacePage.astro";
import PageTitle from "@/components/platform/spaces/PageTitle.astro";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";
import { SPACE_PATHS } from "@/lib/platform/server/space-routes";
import Badge from "@/components/common/Badge.astro";
import Card from "@/components/common/Card.astro";
import ApplicationAnswers from "@/components/platform/application/ApplicationAnswers.astro";
import { drizzle } from "drizzle-orm/d1";
import * as schema from "@/lib/db/schema";
import { and, eq } from "drizzle-orm";
import { env } from "cloudflare:workers";
import { toProgramApplicationBadgeVariant } from "@/lib/admin/program-application";
import { draftsFor, parseApplicationAnswers, type ApplicationAnswerDrafts } from "@/lib/student/application-answers";
import { saveApplicationAnswers } from "@/lib/student/save-application-answers";

const user = Astro.locals.user!;
const db = drizzle(env.DB, { schema });
const { id } = Astro.params;

let success = "";
let error = "";

// The application, only if it belongs to this user.
const ownApplication = and(
  eq(schema.programApplication.id, id!),
  eq(schema.programApplication.userId, user.id),
  isDemoUser(user.id) ? eq(schema.programApplication.programId, DEMO_PREFIX + "program") : undefined
);
const loadApplication = () =>
  db.query.programApplication.findFirst({
    where: ownApplication,
    with: { program: { with: { curriculum: true } } },
  });

let application = await loadApplication();

if (!application) {
  return Astro.redirect("/dashboard");
}

// Members answer the questions their application carries, as plain fields;
// they never edit the stored JSON. Without questions there is nothing to post
// (saveApplicationAnswers ignores the form).
let answers = parseApplicationAnswers(application.application);
let drafts: ApplicationAnswerDrafts = answers.kind === "questions" ? draftsFor(answers.questions) : {};
let fieldErrors: Readonly<Record<string, string>> = {};

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData().catch(() => null);
  const result = formData
    ? await saveApplicationAnswers({
        db: env.DB,
        userId: user.id,
        applicationId: application.id,
        programId: isDemoUser(user.id) ? DEMO_PREFIX + "program" : undefined,
        read: (field) => formData.get(field),
      })
    : null;

  switch (result?.kind) {
    case undefined:
      error = "Your answers could not be read. Please try again.";
      Astro.response.status = 400;
      break;
    case "invalid":
      drafts = result.drafts;
      fieldErrors = result.errors;
      Astro.response.status = 400;
      break;
    case "saved":
      application.application = result.application;
      answers = parseApplicationAnswers(result.application);
      drafts = answers.kind === "questions" ? draftsFor(answers.questions) : {};
      success = "Your answers are saved.";
      break;
    case "stale":
      // Reviewed or changed while the form was open: show where it stands now.
      application = (await loadApplication()) ?? application;
      answers = parseApplicationAnswers(application.application);
      drafts = answers.kind === "questions" ? draftsFor(answers.questions) : {};
      error = application.status === "PENDING"
        ? "This application changed while you were editing it. Check the answers below and save again."
        : "The team has already reviewed this application, so its answers can no longer change.";
      Astro.response.status = 409;
      break;
    case "reviewed":
      error = "The team has already reviewed this application, so its answers can no longer change.";
      Astro.response.status = 409;
      break;
    case "failed":
      drafts = result.drafts;
      error = "Your answers could not be saved. Please try again.";
      Astro.response.status = 500;
      break;
    case "not-found":
    case "not-editable":
      // No questions to answer: the page renders as it would for a GET.
      break;
  }
}

const spaces = await resolveSpacePage(Astro.locals, "apply");
// Screen readers hear the title first on a reloaded page, so a rejected form says so there too.
const titlePrefix = error || Object.keys(fieldErrors).length > 0 ? "Error: " : "";
---

<SpacePage context={spaces} title={`${titlePrefix}Application details`} legacyTitle={`${titlePrefix}Application Details`}>
  <div class="space-y-6">
    <div class="flex items-center gap-4">
      <a
        href={spaces ? SPACE_PATHS.cohort : "/dashboard"}
        class="text-sm text-ink-secondary hover:text-white transition-colors"
      >
        &larr; {spaces ? "Back to Cohort" : "Back to Dashboard"}
      </a>
    </div>

    {success && (
      <div role="status" class="rounded-md border border-green-500/30 bg-green-500/10 p-4 text-green-300">
        {success}
      </div>
    )}

    {error && (
      <div role="alert" class="rounded-md border border-red-500/30 bg-red-500/10 p-4 text-red-300">
        {error}
      </div>
    )}

    <Card>
      <div class="space-y-4">
        <div class="flex items-start justify-between gap-4">
          <div>
            <PageTitle spaces={Boolean(spaces)} size="card" legacyClass="text-2xl font-bold text-white">
              {application.program?.name ?? "Unknown Cohort"}
            </PageTitle>
            {application.program?.curriculum && (
              <p class="mt-1 text-ink-secondary">
                {application.program.curriculum.title}
              </p>
            )}
          </div>
          <Badge variant={toProgramApplicationBadgeVariant(application.status)} />
        </div>

        <div class="grid gap-4 sm:grid-cols-2 text-sm">
          {application.program?.startDate && (
            <div>
              <span class="text-ink-muted">Start Date</span>
              <p class="text-white">{application.program.startDate.toLocaleDateString()}</p>
            </div>
          )}
          {application.program?.endDate && (
            <div>
              <span class="text-ink-muted">End Date</span>
              <p class="text-white">{application.program.endDate.toLocaleDateString()}</p>
            </div>
          )}
          <div>
            <span class="text-ink-muted">Applied</span>
            <p class="text-white">{application.createdAt.toLocaleDateString()}</p>
          </div>
          {application.completedAt && (
            <div>
              <span class="text-ink-muted">Completed</span>
              <p class="text-white">{application.completedAt.toLocaleDateString()}</p>
            </div>
          )}
        </div>
      </div>
    </Card>

    {application.status === "AUDIT" && (
      <p class="text-sm text-ink-secondary">
        As an Audit participant, you can learn alongside the cohort through session recordings and Ask AI, but Audit does not include a completion certificate.
      </p>
    )}

    <Card>
      <h3 class="mb-4 text-lg font-semibold text-white">Application Details</h3>

      <ApplicationAnswers answers={answers} status={application.status} drafts={drafts} errors={fieldErrors} />
    </Card>
  </div>
</SpacePage>
