---
import { DEMO_PREFIX, isDemoUser } from "@/lib/staging-demo-policy";
import SpacePage from "@/components/platform/spaces/SpacePage.astro";
import { resolveSpacePageWith } from "@/components/platform/spaces/space-page";
import { SPACE_PATHS } from "@/lib/platform/server/space-routes";
import { BackLink, DescriptionItem, DescriptionList, Notice, PageHeader, StatusChip, type StatusOf } from "@/components/platform/ui";
import { redirectWithFlash, takeFlash } from "@/lib/platform/server/flash";
import ApplicationAnswers from "@/components/platform/application/ApplicationAnswers.astro";
import { drizzle } from "drizzle-orm/d1";
import * as schema from "@/lib/db/schema";
import { and, eq } from "drizzle-orm";
import { env } from "cloudflare:workers";
import { draftsFor, parseApplicationAnswers, type ApplicationAnswerDrafts } from "@/lib/student/application-answers";
import { saveApplicationAnswers } from "@/lib/student/save-application-answers";
import { formatCalendarDate, formatMomentDate } from "@/lib/display-date";

const user = Astro.locals.user!;
const db = drizzle(env.DB, { schema });
const { id } = Astro.params;

let error = "";

// The application, only if it belongs to this user.
const ownApplication = and(
  eq(schema.programApplication.id, id!),
  eq(schema.programApplication.userId, user.id),
  isDemoUser(user.id) ? eq(schema.programApplication.programId, DEMO_PREFIX + "program") : undefined
);
const loadApplication = () =>
  db.query.programApplication.findFirst({
    where: ownApplication,
    with: { program: { with: { curriculum: true } } },
  });

// The application is read beside the space context (PERF-2): it needs only who is asking.
const [loaded, landing] = await Promise.all([
  loadApplication(),
  resolveSpacePageWith(Astro.locals, "apply", async () => null),
]);
let application = loaded;
const spaces = landing?.[0] ?? null;

if (!application) {
  return Astro.redirect(SPACE_PATHS.cohort);
}
// Where a save lands: this application at its canonical address, which then says so once.
const here = `${SPACE_PATHS.cohort}/application/${encodeURIComponent(application.id)}`;

// Members answer the questions their application carries, as plain fields;
// they never edit the stored JSON. Without questions there is nothing to post
// (saveApplicationAnswers ignores the form).
let answers = parseApplicationAnswers(application.application);
let drafts: ApplicationAnswerDrafts = answers.kind === "questions" ? draftsFor(answers.questions) : {};
let fieldErrors: Readonly<Record<string, string>> = {};
// Typed answers that could not be saved because the team reviewed the application first.
let unsaved: ApplicationAnswerDrafts = {};
const reviewedMessage =
  "The team reviewed this application before your answers were saved, so they can no longer change. What you typed is shown below so you can keep a copy.";

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData().catch(() => null);
  const result = formData
    ? await saveApplicationAnswers({
        db: env.DB,
        userId: user.id,
        applicationId: application.id,
        programId: isDemoUser(user.id) ? DEMO_PREFIX + "program" : undefined,
        read: (field) => formData.get(field),
      })
    : null;

  switch (result?.kind) {
    case undefined:
      error = "Your answers could not be read. Please try again.";
      Astro.response.status = 400;
      break;
    case "invalid":
      drafts = result.drafts;
      fieldErrors = result.errors;
      Astro.response.status = 400;
      break;
    case "saved":
      // 303 home, so a reload never posts again; the page says it once.
      return redirectWithFlash(Astro, here, { tone: "success", title: "Your answers are saved." });
    case "stale":
      // Changed between reading and writing: show where it stands now, keeping what was typed.
      application = (await loadApplication()) ?? application;
      answers = parseApplicationAnswers(application.application);
      if (application.status === "PENDING") {
        drafts = result.drafts;
        error = "This application changed while you were editing it. Your answers are still in the form: check them and save again.";
      } else {
        unsaved = result.drafts;
        error = reviewedMessage;
      }
      Astro.response.status = 409;
      break;
    case "reviewed":
      // The page was read as PENDING moments ago only if staff acted in between; reload what they saw.
      application = (await loadApplication()) ?? application;
      answers = parseApplicationAnswers(application.application);
      unsaved = result.drafts;
      error = reviewedMessage;
      Astro.response.status = 409;
      break;
    case "failed":
      drafts = result.drafts;
      error = "Your answers could not be saved. Please try again.";
      Astro.response.status = 503;
      break;
    case "not-found":
    case "not-editable":
      // No questions to answer: the page renders as it would for a GET.
      break;
  }
}

const flash = Astro.request.method === "POST" ? null : takeFlash(Astro);
// Screen readers hear the tab title first on a reloaded page, so a form the member must
// fix or resend says so there too. "Already reviewed" is not an error to fix.
const reviewed = Object.keys(unsaved).length > 0;
const titlePrefix = !reviewed && (error || Object.keys(fieldErrors).length > 0) ? "Error: " : "";
const status = application.status as StatusOf<"application">;
const program = application.program;
---

<SpacePage context={spaces} title="Application details" titlePrefix={titlePrefix}>
  <div class="flex max-w-3xl flex-col gap-8">
    <div class="flex flex-col gap-4">
      <BackLink href={SPACE_PATHS.cohort}>Cohort</BackLink>
      <PageHeader title={program?.name ?? "Unknown cohort"}>
        {program?.curriculum?.title}
      </PageHeader>
    </div>

    {flash && <Notice tone={flash.tone} title={flash.title} focusOnLoad>{flash.message}</Notice>}
    {/* "Already reviewed" is not a problem to fix: what was typed is kept below to copy. */}
    {error && (
      <Notice tone={reviewed ? "warning" : "danger"} announce="assertive" focusOnLoad title="Your answers weren't saved">
        {error}
      </Notice>
    )}

    <DescriptionList>
      <DescriptionItem term="Status"><StatusChip domain="application" status={status} /></DescriptionItem>
      {program?.startDate && <DescriptionItem term="Starts">{formatCalendarDate(program.startDate)}</DescriptionItem>}
      {program?.endDate && <DescriptionItem term="Ends">{formatCalendarDate(program.endDate)}</DescriptionItem>}
      <DescriptionItem term="Applied">{formatMomentDate(application.createdAt)}</DescriptionItem>
      {application.completedAt && <DescriptionItem term="Completed">{formatMomentDate(application.completedAt)}</DescriptionItem>}
    </DescriptionList>

    {application.status === "AUDIT" && (
      <Notice tone="info">
        As an Audit participant, you can learn alongside the cohort through session recordings and Ask Tembo, but Audit does not include a completion certificate.
      </Notice>
    )}

    <section aria-labelledby="application-answers-title" class="flex flex-col gap-4">
      <h2 id="application-answers-title" class="text-2xl text-ink-primary">Your answers</h2>
      <ApplicationAnswers answers={answers} status={application.status} drafts={drafts} errors={fieldErrors} unsaved={unsaved} />
    </section>
  </div>
</SpacePage>
