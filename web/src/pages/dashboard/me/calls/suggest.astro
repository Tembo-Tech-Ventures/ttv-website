---
/**
 * Calls → Suggest a call (in-app calls P10, src/lib/meetings/README.md, "Calls between two people"): a
 * plain form that posts here and works without JavaScript. In a direct conversation, either person
 * suggests up to three times for a call or a project check-in on one revision of one piece of work,
 * in their own time zone (Nairobi's unless their browser says otherwise), and may ask to record it.
 * Its card goes to the conversation, where the other person picks a time, suggests others or says
 * "Not now". `?instead=` answers the other person's suggestion with other times; `?change=` is a new
 * round of times for a booked call, which keeps its time until one is picked, and is checked first.
 * The form's own token makes sending it twice suggest once.
 *
 * Only for one of the conversation's two members, while `meeting_checkins` is on for them: anything
 * else, an admin outside the conversation included, is the same 404.
 */
import { createId } from "@paralleldrive/cuid2";
import { env } from "cloudflare:workers";
import { drizzle } from "drizzle-orm/d1";
import { blankSuggestion, fieldsIn, readSuggestion, TIME_SLOTS, type FieldErrors, type SuggestValues } from "@/components/platform/calls/call-form";
import { callerFor, callPageResponse, callsContext, conversationHref, hiddenRefusal } from "@/components/platform/calls/call-page";
import SessionTime from "@/components/platform/sessions/SessionTime.astro";
import SpacePage from "@/components/platform/spaces/SpacePage.astro";
import { resolveSpacePageWith } from "@/components/platform/spaces/space-page";
import {
  BackLink, Button, Card, Checkbox, ChoiceGroup, DescriptionItem, DescriptionList, Notice, PageHeader, SelectField, TextField,
} from "@/components/platform/ui";
import { hasMatchingRequestOrigin } from "@/lib/admin/mutation-security";
import { ChannelError } from "@/lib/channels/errors";
import * as schema from "@/lib/db/schema";
import {
  CALL_LENGTHS, callConversation, readBookedCall, readProposal, suggestCall, type BookedCall, type CallProposal,
} from "@/lib/meetings/proposals";
import { CALL_LIMIT_MINUTES, CHECKIN_LIMIT_MINUTES, MAX_PROPOSED_TIMES } from "@/lib/meetings/rules";
import { SCHEDULE_TOKEN } from "@/lib/meetings/sessions";
import { lengthLabel, SESSION_TIME_ZONE, sessionDay } from "@/lib/meetings/session-times";
import { redirectWithFlash } from "@/lib/platform/server/flash";
import { requestCapabilities } from "@/lib/platform/server/request-capabilities";
import { CALLS_PAGE_PATH, CONDUCT_PATH, proposalPath } from "@/lib/platform/server/space-routes";

const { method } = Astro.request;
const query = Astro.url.searchParams;
const db = drizzle(env.DB, { schema });
const now = Date.now();

// The conversation, and the suggestion this answers or the call it moves, read beside the space context.
const resolved = await resolveSpacePageWith(Astro.locals, "calls", async (me) => {
  if (!me.flags.meeting_checkins) return null;
  const caller = callerFor(me, await requestCapabilities(db, Astro.locals));
  const conversationId = query.get("conversation") ?? "";
  const insteadId = query.get("instead");
  const changeId = query.get("change");
  try {
    const [conversation, instead, change] = await Promise.all([
      callConversation(env.DB, caller, conversationId, now),
      insteadId ? readProposal(env.DB, caller, insteadId, now) : null,
      changeId ? readBookedCall(env.DB, caller, changeId, now) : null,
    ]);
    // The suggestion or call must be this conversation's; another's is the same 404.
    if ((instead && instead.channelId !== conversation.channel.id) || (change && change.channelId !== conversation.channel.id)) return null;
    return { caller, conversation, instead, change };
  } catch (error) {
    if (error instanceof ChannelError && error.status === 404) return null;
    throw error;
  }
});
if (!resolved || !resolved[1]) return callPageResponse(404);
if (method !== "GET" && method !== "HEAD" && method !== "POST") return callPageResponse(405);
if (method === "POST" && !hasMatchingRequestOrigin(Astro.request)) return callPageResponse(404);
const [context, { caller, conversation }] = resolved;
const instead: CallProposal | null = resolved[1].instead;
const change: BookedCall | null = resolved[1].change;
const other = conversation.counterpart.name;
const firstName = other.split(/\s+/u)[0] || other;

const answering = instead !== null && !instead.mine && instead.state === "open";
// A round of new times keeps what the call is: its kind and its work.
const moving: { purpose: "CALL" | "CHECKIN"; at: number; minutes: number; id: string } | null = change
  ? { purpose: change.purpose, at: change.scheduledStartAt, minutes: change.bookedMinutes, id: change.id }
  : instead?.call && instead.call.id !== instead.id ? { purpose: instead.purpose, at: instead.call.scheduledStartAt, minutes: instead.call.bookedMinutes, id: instead.call.id } : null;
let values: SuggestValues = blankSuggestion(createId(), conversation.channel.id, {
  instead: answering ? instead.id : "", change: change?.id ?? "",
  purpose: moving?.purpose ?? (answering ? instead.purpose : "CALL"),
  work: answering ? instead.work?.journeyId ?? "" : "",
  length: String(change?.bookedMinutes ?? (answering ? instead.bookedMinutes : 30)),
  record: answering ? instead.askToRecord : change ? change.recordingPolicy === "BOTH_AGREE" : false,
});
let errors: FieldErrors = {};
let failure: { message: string; conduct: boolean } | null = null;
/** New times for a booked call, checked before they are sent. */
let review: number[] | null = null;

if (method === "POST") {
  const reading = readSuggestion(await Astro.request.formData(), now);
  // The form must be for this page's own conversation, suggestion and call.
  if (reading.values.conversation !== conversation.channel.id || reading.values.instead !== values.instead || reading.values.change !== values.change) {
    return callPageResponse(404);
  }
  const tokened = SCHEDULE_TOKEN.test(reading.values.token);
  values = tokened ? reading.values : { ...reading.values, token: createId() };
  if (reading.kind === "invalid") {
    errors = reading.errors;
    Astro.response.status = 400;
  } else if (!tokened) {
    failure = { message: "This form had expired, so nothing was sent. Check it and press the button again.", conduct: false };
    Astro.response.status = 400;
  } else if (moving && reading.review) {
    review = reading.times;
  } else {
    try {
      const sent = await suggestCall(callsContext(env, Astro.locals.cfContext, CALLS_PAGE_PATH, now), caller, {
        conversationId: conversation.channel.id, token: values.token, purpose: values.purpose,
        journeyId: values.purpose === "CHECKIN" && !moving ? values.work : null, bookedMinutes: reading.minutes || CHECKIN_LIMIT_MINUTES,
        times: reading.times, askToRecord: values.record, instead: values.instead || null, change: values.change || null,
      });
      if (sent.card === "posted") return Astro.redirect(`${conversationHref(sent.channelId)}#channel-messages`, 303);
      return redirectWithFlash(Astro, proposalPath(sent.proposalId), {
        tone: "warning", title: "Times suggested",
        message: `The card didn't post in your conversation, so tell ${firstName} there. They can answer from Calls.`,
      });
    } catch (error) {
      const hidden = hiddenRefusal(error);
      if (hidden) return hidden;
      const refusal = error as ChannelError;
      failure = { message: refusal.message, conduct: refusal.code === "conduct_required" };
      Astro.response.status = refusal.status;
    }
  }
}

const title = moving ? "Suggest new times" : answering ? "Suggest other times" : "Suggest a call";
const hasErrors = Object.keys(errors).length > 0 || failure !== null;
const errorCount = Object.keys(errors).length;
const waitingHere = conversation.waiting && conversation.waiting.id !== values.instead ? conversation.waiting : null;
const mineWork = conversation.works.filter(({ ownerId }) => ownerId === caller.userId);
const theirWork = conversation.works.filter(({ ownerId }) => ownerId !== caller.userId);
const zones = [{ value: SESSION_TIME_ZONE, label: "Nairobi time (EAT)" }, ...(values.zone !== SESSION_TIME_ZONE ? [{ value: values.zone, label: `Your time (${values.zone.replaceAll("_", " ")})` }] : [])];
const slotFields = TIME_SLOTS.map((slot, index) => {
  const date = values.dates[index] ?? "";
  const clock = values.clocks[index] ?? "";
  return { slot, date, clock };
});
// Answering other times starts from the times the other person offered, in the form's zone, for reference.
const offered = answering ? instead.times.map((at) => ({ at, ...fieldsIn(at, values.zone) })) : [];
Astro.response.headers.set("Cache-Control", "no-store");
---

<SpacePage context={context} title={title} titlePrefix={hasErrors ? "Error: " : ""}>
  <div class="flex max-w-3xl flex-col gap-6">
    <BackLink href={conversationHref(conversation.channel.id)}>{`Conversation with ${other}`}</BackLink>
    <PageHeader title={title}>
      {moving
        ? `Your call stays booked until ${firstName} picks one of these. If they say Not now, it stays as it is.`
        : answering
          ? `Suggest times that suit you better. ${firstName}'s suggestion closes, and they pick from yours.`
          : `Suggest up to ${MAX_PROPOSED_TIMES} times. ${firstName} picks one, suggests others, or says Not now.`}
    </PageHeader>

    {failure ? (
      <Notice tone="danger" title="We couldn't send it" focusOnLoad>
        {failure.message}{" "}
        {failure.conduct ? <a class="underline underline-offset-4" href={CONDUCT_PATH}>Read how we talk to each other</a> : null}
      </Notice>
    ) : errorCount > 0 ? (
      <Notice tone="danger" title="Check the form" focusOnLoad>
        {errorCount === 1 ? "One answer needs a change." : `${errorCount} answers need a change.`} Each says what to do next to it.
      </Notice>
    ) : review ? (
      <div data-review-change>
        <Notice tone="warning" title="Suggest these new times?" focusOnLoad>
          {`${firstName} is asked to pick one. Until then your call stays booked for ${sessionDay(moving!.at, now)}.`}
          {` If ${firstName} says Not now, nothing changes.`}
        </Notice>
      </div>
    ) : waitingHere ? (
      <Notice tone="info" title="A suggestion is already waiting here">
        {waitingHere.proposedBy === caller.userId
          ? `Your earlier times are still waiting for ${firstName}. Withdraw them from the conversation before you suggest new ones.`
          : `${firstName} suggested times. Answer them in the conversation, or suggest other times from there.`}
      </Notice>
    ) : null}

    {moving ? (
      <p class="m-0 text-ink-secondary" data-booked-now>
        Booked now: <SessionTime startAt={moving.at} minutes={moving.minutes} now={now} />
      </p>
    ) : null}
    {offered.length > 0 ? (
      <p class="m-0 text-ink-secondary" data-offered>
        {`${firstName} offered `}
        {offered.map(({ at }, index) => (<>{index > 0 ? ", " : ""}<SessionTime startAt={at} minutes={instead!.bookedMinutes} now={now} /></>))}.
      </p>
    ) : null}

    <Card>
      <form method="post" class="flex flex-col gap-6" novalidate data-suggest-form>
        <input type="hidden" name="token" value={values.token} />
        <input type="hidden" name="conversation" value={values.conversation} />
        <input type="hidden" name="instead" value={values.instead} />
        <input type="hidden" name="change" value={values.change} />

        {moving ? (
          <input type="hidden" name="purpose" value={values.purpose} />
        ) : (
          <ChoiceGroup
            label="What kind of call"
            name="purpose"
            options={[
              { value: "CALL", label: "A call", hint: `About anything. Every call ends at ${CALL_LIMIT_MINUTES} minutes.` },
              { value: "CHECKIN", label: "A project check-in", hint: `About one revision of one piece of work. It ends at ${CHECKIN_LIMIT_MINUTES} minutes.` },
            ]}
            defaultValue={values.purpose}
            error={errors.purpose}
          />
        )}
        {moving ? null : (
          <SelectField
            label="Work, for a check-in"
            name="work"
            placeholder={conversation.works.length > 0 ? "Choose the work" : "No posted work yet"}
            options={[
              { group: `${firstName}'s work`, options: theirWork.map(({ journeyId, title: workTitle, version }) => ({ value: journeyId, label: `${workTitle} (revision ${version})` })) },
              { group: "Your work", options: mineWork.map(({ journeyId, title: workTitle, version }) => ({ value: journeyId, label: `${workTitle} (revision ${version})` })) },
            ]}
            defaultValue={values.work}
            error={errors.work}
            hint="The check-in stays tied to this revision. Only posted work is listed."
          />
        )}
        {values.purpose === "CHECKIN" && moving ? null : (
          <SelectField
            label="Length, for a call"
            name="length"
            options={CALL_LENGTHS.map((minutes) => ({ value: String(minutes), label: lengthLabel(minutes) }))}
            defaultValue={values.length}
            error={errors.length}
            hint={`A check-in is always ${CHECKIN_LIMIT_MINUTES} minutes.`}
            className="max-w-64"
          />
        )}

        <fieldset class="m-0 flex flex-col gap-4 border-0 p-0" aria-describedby="suggest-times-hint">
          <legend class="text-base font-semibold text-ink-primary">{`Times, up to ${MAX_PROPOSED_TIMES}`}</legend>
          <p id="suggest-times-hint" class="m-0 text-sm text-ink-muted">
            {`Leave a row empty to suggest fewer. ${firstName} sees each time in their own time.`}
          </p>
          <SelectField label="Time zone" name="zone" options={zones} defaultValue={values.zone} error={errors.zone} data-zone-select className="max-w-80" />
          {slotFields.map(({ slot, date, clock }) => (
            <div class="grid gap-4 sm:grid-cols-2" data-time-slot={slot}>
              <TextField label={slot === 1 ? "Date" : `Date ${slot} (optional)`} name={`date${slot}`} type="date" defaultValue={date} error={errors[`date${slot}`]} required={slot === 1} />
              <TextField label={slot === 1 ? "Starts" : `Starts ${slot} (optional)`} name={`time${slot}`} type="time" defaultValue={clock} error={errors[`time${slot}`]} required={slot === 1} />
            </div>
          ))}
        </fieldset>

        <Checkbox
          label="Ask to record"
          name="record"
          defaultChecked={values.record}
          hint={`${firstName} is asked on the day, and so are you. It's recorded only if you both say yes, and saying no changes nothing else.`}
        />

        <DescriptionList>
          <DescriptionItem term="Who can join">{`You and ${other}. Nobody else, staff included.`}</DescriptionItem>
          <DescriptionItem term="Length">{`Every call ends at ${CALL_LIMIT_MINUTES} minutes, a check-in at ${CHECKIN_LIMIT_MINUTES}.`}</DescriptionItem>
          <DescriptionItem term="Reminders">No emails. Once a time is picked, either of you can add it to your calendar.</DescriptionItem>
          <DescriptionItem term="If it's Not now">Nobody else is told, and nothing about it is kept anywhere but this conversation.</DescriptionItem>
        </DescriptionList>

        <div class="flex flex-wrap gap-2">
          {moving && !review ? (
            <Button type="submit" name="intent" value="review" variant="primary">Review the new times</Button>
          ) : (
            <Button type="submit" name="intent" value="send" variant="primary">{moving ? "Suggest these times" : "Suggest times"}</Button>
          )}
        </div>
      </form>
    </Card>
  </div>
</SpacePage>

<script>
  import { offerDeviceZone } from "@/components/platform/calls/zone-choice";
  offerDeviceZone();
</script>
