---
/**
 * Calls → one booked call between two people (in-app calls P10, src/lib/meetings/README.md, "Calls
 * between two people"): when it is, with whom, Join once it can open, Add to calendar, and, while it
 * hasn't started, Change time (a new round of up to three times, checked first; the booked time stands
 * until one is picked) and Cancel call, a ConfirmStep (`?confirm=cancel`). Cancelling tells the other
 * person in the conversation and in their Attention, and records nothing else. Plain forms, so it
 * works without JavaScript.
 *
 * Only for one of the conversation's two members, while `meeting_checkins` is on for them: anything
 * else, an admin outside the conversation and a cohort session included, is the same 404.
 */
import { env } from "cloudflare:workers";
import { drizzle } from "drizzle-orm/d1";
import { callerFor, callPageResponse, callsContext, conversationHref, hiddenRefusal } from "@/components/platform/calls/call-page";
import SessionTime from "@/components/platform/sessions/SessionTime.astro";
import SpacePage from "@/components/platform/spaces/SpacePage.astro";
import { resolveSpacePageWith } from "@/components/platform/spaces/space-page";
import {
  BackLink, ButtonLink, Card, Chip, ConfirmStep, confirmHref, confirmingAction, DescriptionItem, DescriptionList, Notice, PageHeader, withoutConfirm,
} from "@/components/platform/ui";
import { hasMatchingRequestOrigin } from "@/lib/admin/mutation-security";
import { ChannelError } from "@/lib/channels/errors";
import * as schema from "@/lib/db/schema";
import { cancelBookedCall, readBookedCall, type BookedCall } from "@/lib/meetings/proposals";
import { ROOM_OPENS_EARLY_MINUTES } from "@/lib/meetings/room-model";
import { CHECKIN_LIMIT_MINUTES } from "@/lib/meetings/rules";
import { lengthLabel, sessionDay } from "@/lib/meetings/session-times";
import { redirectWithFlash, takeFlash } from "@/lib/platform/server/flash";
import { requestCapabilities } from "@/lib/platform/server/request-capabilities";
import { bookedCallCalendarPath, bookedCallPath, callPath, CALLS_PAGE_PATH, proposalPath, suggestCallPath } from "@/lib/platform/server/space-routes";

const { method } = Astro.request;
const { id } = Astro.params;
if (!id) return callPageResponse(404);
const db = drizzle(env.DB, { schema });
const now = Date.now();

const resolved = await resolveSpacePageWith(Astro.locals, "calls", async (me) => {
  if (!me.flags.meeting_checkins) return null;
  const caller = callerFor(me, await requestCapabilities(db, Astro.locals));
  try {
    return { caller, call: await readBookedCall(env.DB, caller, id, now) };
  } catch (error) {
    if (error instanceof ChannelError && error.status === 404) return null;
    throw error;
  }
});
if (!resolved || !resolved[1]) return callPageResponse(404);
if (method !== "GET" && method !== "HEAD" && method !== "POST") return callPageResponse(405);
if (method === "POST" && !hasMatchingRequestOrigin(Astro.request)) return callPageResponse(404);
const [context, { caller }] = resolved;
let call: BookedCall = resolved[1].call;
let failure: string | null = null;
const firstName = call.counterpart.name.split(/\s+/u)[0] || call.counterpart.name;

if (method === "POST") {
  const form = await Astro.request.formData();
  if (form.get("intent") !== "cancel") return callPageResponse(404);
  try {
    const { note } = await cancelBookedCall(callsContext(env, Astro.locals.cfContext, bookedCallPath(id), now), caller, id, { known: call });
    return redirectWithFlash(Astro, CALLS_PAGE_PATH, {
      tone: note === "not_posted" ? "warning" : "success",
      title: "Call cancelled",
      message: note === "not_posted" ? `The note to your conversation didn't post. Tell ${firstName} there.` : `${firstName} is told in your conversation.`,
    });
  } catch (error) {
    const hidden = hiddenRefusal(error);
    if (hidden) return hidden;
    failure = (error as ChannelError).message;
    Astro.response.status = (error as ChannelError).status;
    call = await readBookedCall(env.DB, caller, id, now);
  }
}

const scheduled = call.state === "SCHEDULED";
const confirming = scheduled && confirmingAction(Astro.url, ["cancel"]) === "cancel";
const canJoin = call.state === "LIVE" || (scheduled && now + ROOM_OPENS_EARLY_MINUTES * 60_000 >= call.scheduledStartAt);
const STATE = { SCHEDULED: "Booked", LIVE: "Open now", ENDED: "Ended", CANCELLED: "Cancelled" } as const;
const title = `${call.title} with ${call.counterpart.name}`;
const flash = method === "GET" ? takeFlash(Astro) : null;
Astro.response.headers.set("Cache-Control", "no-store");
---

<SpacePage context={context} title={title} titlePrefix={failure ? "Error: " : ""}>
  <div class="flex max-w-3xl flex-col gap-6">
    <BackLink href={CALLS_PAGE_PATH}>Calls</BackLink>
    <PageHeader title={call.title}>
      {`With ${call.counterpart.name}. Only the two of you can see or join it.`}
    </PageHeader>
    {failure ? <Notice tone="danger" title="That didn't go through" focusOnLoad>{failure}</Notice>
      : flash ? <Notice tone={flash.tone} title={flash.title} announce="polite">{flash.message}</Notice> : null}

    {confirming ? (
      <ConfirmStep
        title={`Cancel your call with ${firstName} on ${sessionDay(call.scheduledStartAt, now)}?`}
        confirmLabel="Cancel call"
        cancelHref={withoutConfirm(Astro.url)}
        fields={{ intent: "cancel" }}
      >
        {`${firstName} is told in your conversation. If either of you added it to a calendar, remove it there. Nothing else is recorded.`}
      </ConfirmStep>
    ) : null}

    <Card>
      <div class="flex flex-col gap-5" data-booked-call data-call-state={call.state}>
        <div class="flex flex-wrap items-center gap-2"><Chip tone={call.state === "LIVE" ? "peach" : "neutral"}>{STATE[call.state]}</Chip></div>
        <p class="m-0 text-ink-primary"><SessionTime startAt={call.scheduledStartAt} minutes={call.bookedMinutes} now={now} /></p>
        {call.pendingChange ? (
          <Notice tone="info" title="New times are waiting for an answer">
            {"It stays at this time until one is picked. "}
            <a class="underline underline-offset-4" href={proposalPath(call.pendingChange)}>See the new times</a>
          </Notice>
        ) : null}
        <DescriptionList>
          <DescriptionItem term="Length">{call.purpose === "CHECKIN" ? `${CHECKIN_LIMIT_MINUTES} minutes. A check-in ends at ${CHECKIN_LIMIT_MINUTES} minutes` : lengthLabel(call.bookedMinutes)}</DescriptionItem>
          <DescriptionItem term="Recording">
            {call.recordingPolicy === "BOTH_AGREE" ? "Asked to record. You'll both be asked before you join, and it's recorded only if you both say yes." : "Not recorded"}
          </DescriptionItem>
          <DescriptionItem term="Opens">{`Either of you can open it ${ROOM_OPENS_EARLY_MINUTES} minutes before it starts.`}</DescriptionItem>
          <DescriptionItem term="Reminders">No emails. Add it to your calendar to get a reminder from it.</DescriptionItem>
        </DescriptionList>
        <div class="flex flex-wrap gap-2">
          {canJoin ? (
            <ButtonLink variant="primary" href={callPath(call.id)} target="_blank" rel="noopener" data-call-link>
              Join call<span class="sr-only"> (opens in a new tab)</span>
            </ButtonLink>
          ) : null}
          {scheduled ? <ButtonLink variant="quiet" href={bookedCallCalendarPath(call.id)} download data-add-to-calendar>Add to calendar</ButtonLink> : null}
          {scheduled && !call.pendingChange ? (
            <ButtonLink variant="quiet" href={suggestCallPath(call.channelId, { change: call.id })} data-change-time>Change time</ButtonLink>
          ) : null}
          {scheduled && !confirming ? <ButtonLink variant="ghost" href={confirmHref(Astro.url, "cancel")} data-cancel-call>Cancel call</ButtonLink> : null}
          <ButtonLink variant="ghost" href={conversationHref(call.channelId)}>{`Conversation with ${firstName}`}</ButtonLink>
        </div>
      </div>
    </Card>
  </div>
</SpacePage>
