---
import Card from "@/components/common/Card.astro";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import {
  BOARD_STATUSES,
  BOARD_STATUS_LABELS,
  BoardValidationError,
  calculateBoardProgress,
  formatDateInput,
  getBoardPermissions,
  groupBoardTasksByStatus,
  isTaskOverdue,
  parseBoardInput,
  parseBoardTaskInput,
  parseMemberEmail,
  validateAssignee,
} from "@/lib/boards";
import * as schema from "@/lib/db/schema";
import { and, asc, eq, sql } from "drizzle-orm";
import { drizzle } from "drizzle-orm/d1";
import { env } from "cloudflare:workers";

const user = Astro.locals.user!;
const db = drizzle(env.DB, { schema });
const boardId = Astro.params.id!;

async function loadBoard() {
  return db.query.projectBoard.findFirst({
    where: eq(schema.projectBoard.id, boardId),
    with: {
      owner: true,
      members: {
        with: {
          user: true,
        },
      },
      tasks: {
        with: {
          assignee: true,
          creator: true,
        },
        orderBy: [asc(schema.projectBoardTask.createdAt)],
      },
    },
  });
}

function redirectToBoard(message: string, kind: "notice" | "error" = "notice") {
  return Astro.redirect(
    `/dashboard/boards/${boardId}?${kind}=${encodeURIComponent(message)}`,
    303
  );
}
void redirectToBoard;

let board = await loadBoard();
if (!board) {
  return Astro.redirect("/dashboard/boards");
}

let memberUserIds = board.members.map((member) => member.userId);
let permissions = getBoardPermissions(board.ownerId, memberUserIds, user.id);
if (!permissions.canView) {
  return Astro.redirect("/dashboard/boards");
}

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get("action");
    if (typeof action !== "string") {
      throw new BoardValidationError("Board action is missing.");
    }

    const participants = [board.ownerId, ...memberUserIds];
    let notice = "Board updated.";
    void notice;

    switch (action) {
      case "add-task": {
        const input = parseBoardTaskInput(formData);
        validateAssignee(input.assigneeId, participants);
        await db.insert(schema.projectBoardTask).values({
          ...input,
          boardId,
          createdById: user.id,
        });
        notice = "Task added.";
        break;
      }

      case "update-task": {
        const taskId = formData.get("taskId");
        if (typeof taskId !== "string" || !taskId) {
          throw new BoardValidationError("Task is missing.");
        }

        const input = parseBoardTaskInput(formData);
        validateAssignee(input.assigneeId, participants);
        const updated = await db
          .update(schema.projectBoardTask)
          .set(input)
          .where(
            and(
              eq(schema.projectBoardTask.id, taskId),
              eq(schema.projectBoardTask.boardId, boardId)
            )
          )
          .returning({ id: schema.projectBoardTask.id });

        if (updated.length === 0) {
          throw new BoardValidationError("Task no longer exists.");
        }
        notice = "Task updated.";
        break;
      }

      case "delete-task": {
        const taskId = formData.get("taskId");
        if (typeof taskId !== "string" || !taskId) {
          throw new BoardValidationError("Task is missing.");
        }

        const removed = await db
          .delete(schema.projectBoardTask)
          .where(
            and(
              eq(schema.projectBoardTask.id, taskId),
              eq(schema.projectBoardTask.boardId, boardId)
            )
          )
          .returning({ id: schema.projectBoardTask.id });

        if (removed.length === 0) {
          throw new BoardValidationError("Task no longer exists.");
        }
        notice = "Task deleted.";
        break;
      }

      case "add-member": {
        if (!permissions.canManageMembers) {
          throw new BoardValidationError("Only the board owner can add members.");
        }

        const email = parseMemberEmail(formData);
        const newMember = await db.query.user.findFirst({
          where: sql`lower(${schema.user.email}) = ${email}`,
        });

        if (!newMember) {
          throw new BoardValidationError("No TTV account was found for that email.");
        }
        if (newMember.id === board.ownerId) {
          throw new BoardValidationError("The board owner is already included.");
        }
        if (memberUserIds.includes(newMember.id)) {
          throw new BoardValidationError("That person is already a member.");
        }

        await db.insert(schema.projectBoardMember).values({
          boardId,
          userId: newMember.id,
        });
        notice = `${newMember.name} added to the board.`;
        break;
      }

      case "remove-member": {
        if (!permissions.canManageMembers) {
          throw new BoardValidationError("Only the board owner can remove members.");
        }

        const memberId = formData.get("memberId");
        if (typeof memberId !== "string" || !memberId) {
          throw new BoardValidationError("Board member is missing.");
        }

        const membership = await db.query.projectBoardMember.findFirst({
          where: and(
            eq(schema.projectBoardMember.id, memberId),
            eq(schema.projectBoardMember.boardId, boardId)
          ),
        });
        if (!membership) {
          throw new BoardValidationError("Board member no longer exists.");
        }

        await db
          .update(schema.projectBoardTask)
          .set({ assigneeId: null })
          .where(
            and(
              eq(schema.projectBoardTask.boardId, boardId),
              eq(schema.projectBoardTask.assigneeId, membership.userId)
            )
          );

        const removed = await db
          .delete(schema.projectBoardMember)
          .where(
            and(
              eq(schema.projectBoardMember.id, memberId),
              eq(schema.projectBoardMember.boardId, boardId)
            )
          )
          .returning({ id: schema.projectBoardMember.id });

        if (removed.length === 0) {
          throw new BoardValidationError("Board member no longer exists.");
        }
        notice = "Member removed.";
        break;
      }

      case "update-board": {
        if (!permissions.isOwner) {
          throw new BoardValidationError("Only the board owner can edit board details.");
        }

        await db
          .update(schema.projectBoard)
          .set(parseBoardInput(formData))
          .where(eq(schema.projectBoard.id, boardId));
        notice = "Board details updated.";
        break;
      }

      case "delete-board": {
        if (!permissions.canDeleteBoard) {
          throw new BoardValidationError("Only the board owner can delete this board.");
        }

        await db
          .delete(schema.projectBoard)
          .where(
            and(
              eq(schema.projectBoard.id, boardId),
              eq(schema.projectBoard.ownerId, user.id)
            )
          );
        return Astro.redirect(
          `/dashboard/boards?notice=${encodeURIComponent("Board deleted.")}`,
          303
        );
      }

      default:
        throw new BoardValidationError("Board action is invalid.");
    }

    if (action !== "update-board") {
      await db
        .update(schema.projectBoard)
        .set({ updatedAt: new Date() })
        .where(eq(schema.projectBoard.id, boardId));
    }

    return redirectToBoard(notice);
  } catch (caught) {
    const message =
      caught instanceof BoardValidationError
        ? caught.message
        : "The board could not be updated. Please try again.";
    void message;
    return redirectToBoard(message, "error");
  }
}

board = await loadBoard();
if (!board) {
  return Astro.redirect("/dashboard/boards");
}

memberUserIds = board.members.map((member) => member.userId);
permissions = getBoardPermissions(board.ownerId, memberUserIds, user.id);

const participants = [
  {
    id: board.owner.id,
    name: board.owner.name,
    email: board.owner.email,
    label: "Owner",
  },
  ...board.members.map(({ user: member }) => ({
    id: member.id,
    name: member.name,
    email: member.email,
    label: "Member",
  })),
];
const tasksByStatus = groupBoardTasksByStatus(board.tasks);
const progress = calculateBoardProgress(board.tasks);
const notice = Astro.url.searchParams.get("notice");
const error = Astro.url.searchParams.get("error");
---

<DashboardLayout title={board.name}>
  <div class="space-y-8">
    <a
      href="/dashboard/boards"
      class="inline-flex text-sm font-medium text-white/55 transition-colors hover:text-white"
    >
      &larr; All project boards
    </a>

    {
      notice && (
        <div
          role="status"
          class="rounded-md border border-green-500/30 bg-green-500/10 p-4 text-green-200"
        >
          {notice}
        </div>
      )
    }

    {
      error && (
        <div
          role="alert"
          class="rounded-md border border-red-500/30 bg-red-500/10 p-4 text-red-200"
        >
          {error}
        </div>
      )
    }

    <Card>
      <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-end">
        <header>
          <div class="flex flex-wrap items-center gap-3">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">
              {permissions.isOwner ? "Your board" : "Shared board"}
            </p>
            <span class="rounded-full bg-teal/30 px-2.5 py-1 text-xs text-white/60">
              {participants.length}
              {participants.length === 1 ? "person" : "people"}
            </span>
          </div>
          <h2 class="mt-3 text-3xl font-bold text-white">{board.name}</h2>
          <p class="mt-3 max-w-3xl whitespace-pre-line text-white/60">
            {board.description || "No board description yet."}
          </p>
        </header>

        <div>
          <div class="mb-2 flex items-center justify-between text-sm text-white/55">
            <span>{progress.completed} of {progress.total} tasks complete</span>
            <strong class="text-white">{progress.percentage}%</strong>
          </div>
          <div
            class="h-3 overflow-hidden rounded-full bg-teal/30"
            role="progressbar"
            aria-label="Board completion"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow={progress.percentage}
          >
            <div
              class="h-full rounded-full bg-primary transition-[width]"
              style={`width: ${progress.percentage}%`}
            >
            </div>
          </div>
        </div>
      </div>
    </Card>

    <div class="grid gap-6 xl:grid-cols-[minmax(0,2fr)_minmax(19rem,1fr)]">
      <Card>
        <h3 class="text-xl font-semibold text-white">Add a task</h3>
        <p class="mt-1 text-sm text-white/50">
          Give the work a clear owner and deadline when possible.
        </p>

        <form method="POST" class="mt-5 grid gap-4 md:grid-cols-2">
          <input type="hidden" name="action" value="add-task" />
          <div class="flex flex-col gap-1.5 md:col-span-2">
            <label for="new-task-title" class="text-sm font-medium text-white/90">
              Task title <span class="text-primary">*</span>
            </label>
            <input
              id="new-task-title"
              name="title"
              type="text"
              maxlength="120"
              required
              placeholder="Prepare the demo walkthrough"
              class="rounded-md border border-teal bg-dark/50 px-3 py-2 text-white placeholder:text-white/35 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/50"
            />
          </div>

          <div class="flex flex-col gap-1.5 md:col-span-2">
            <label for="new-task-description" class="text-sm font-medium text-white/90">
              Description
            </label>
            <textarea
              id="new-task-description"
              name="description"
              rows="3"
              maxlength="1000"
              class="rounded-md border border-teal bg-dark/50 px-3 py-2 text-white focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/50"
            ></textarea>
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="new-task-assignee" class="text-sm font-medium text-white/90">
              Assignee
            </label>
            <select
              id="new-task-assignee"
              name="assigneeId"
              class="rounded-md border border-teal bg-dark/50 px-3 py-2 text-white focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/50"
            >
              <option value="">Unassigned</option>
              {
                participants.map((participant) => (
                  <option value={participant.id}>{participant.name}</option>
                ))
              }
            </select>
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="new-task-due" class="text-sm font-medium text-white/90">
              Due date
            </label>
            <input
              id="new-task-due"
              name="dueDate"
              type="date"
              class="rounded-md border border-teal bg-dark/50 px-3 py-2 text-white focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/50"
            />
          </div>

          <button
            type="submit"
            class="inline-flex items-center justify-center rounded-md bg-primary px-5 py-2.5 font-semibold text-dark transition-colors hover:bg-primary/90 md:col-span-2 md:justify-self-start"
          >
            Add task
          </button>
        </form>
      </Card>

      <Card>
        <h3 class="text-xl font-semibold text-white">Participants</h3>
        <ul class="mt-4 divide-y divide-teal/20">
          {
            participants.map((participant) => (
              <li class="flex items-center justify-between gap-3 py-3 first:pt-0">
                <div class="min-w-0">
                  <p class="truncate text-sm font-medium text-white">
                    {participant.name}
                  </p>
                  <p class="truncate text-xs text-white/45">{participant.email}</p>
                </div>
                <span class="shrink-0 rounded-full bg-teal/30 px-2 py-1 text-xs text-white/60">
                  {participant.label}
                </span>
              </li>
            ))
          }
        </ul>

        {
          permissions.canManageMembers && (
            <form method="POST" class="mt-5 border-t border-teal/20 pt-5">
              <input type="hidden" name="action" value="add-member" />
              <label for="member-email" class="text-sm font-medium text-white/90">
                Add an existing TTV member
              </label>
              <div class="mt-2 flex flex-col gap-2 sm:flex-row xl:flex-col 2xl:flex-row">
                <input
                  id="member-email"
                  name="email"
                  type="email"
                  maxlength="320"
                  required
                  placeholder="member@example.com"
                  class="min-w-0 flex-1 rounded-md border border-teal bg-dark/50 px-3 py-2 text-white placeholder:text-white/35 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/50"
                />
                <button
                  type="submit"
                  class="rounded-md border border-primary px-4 py-2 text-sm font-semibold text-primary transition-colors hover:bg-primary hover:text-dark"
                >
                  Add member
                </button>
              </div>
            </form>
          )
        }
      </Card>
    </div>

    <section aria-labelledby="board-tasks-heading">
      <div class="mb-4 flex items-end justify-between gap-4">
        <div>
          <h3 id="board-tasks-heading" class="text-xl font-semibold text-white">
            Board tasks
          </h3>
          <p class="mt-1 text-sm text-white/50">
            Edit a task to move it between columns or change ownership.
          </p>
        </div>
        <span class="text-sm text-white/45">
          {progress.total}
          {progress.total === 1 ? "task" : "tasks"}
        </span>
      </div>

      <div class="grid gap-5 xl:grid-cols-3">
        {
          BOARD_STATUSES.map((status) => (
            <div class="rounded-lg border border-teal/20 bg-dark/35 p-4">
              <div class="mb-4 flex items-center justify-between gap-3">
                <h4 class="font-semibold text-white">{BOARD_STATUS_LABELS[status]}</h4>
                <span class="rounded-full bg-teal/30 px-2.5 py-1 text-xs text-white/60">
                  {tasksByStatus[status].length}
                </span>
              </div>

              {tasksByStatus[status].length === 0 ? (
                <p class="rounded-md border border-dashed border-teal/30 px-3 py-8 text-center text-sm text-white/35">
                  No tasks here.
                </p>
              ) : (
                <div class="space-y-3">
                  {tasksByStatus[status].map((task) => {
                    const overdue = isTaskOverdue(task.dueDate, task.status);

                    return (
                      <article class="rounded-md border border-teal/25 bg-dark/85 p-4 shadow-md">
                        <h5 class="font-semibold text-white">{task.title}</h5>
                        {task.description && (
                          <p class="mt-2 whitespace-pre-line text-sm text-white/55">
                            {task.description}
                          </p>
                        )}

                        <div class="mt-4 flex flex-wrap gap-2 text-xs">
                          <span class="rounded-full bg-teal/30 px-2.5 py-1 text-white/65">
                            {task.assignee?.name ?? "Unassigned"}
                          </span>
                          {task.dueDate && (
                            <span
                              class:list={[
                                "rounded-full px-2.5 py-1",
                                overdue
                                  ? "bg-red-500/15 text-red-200"
                                  : "bg-teal/30 text-white/65",
                              ]}
                            >
                              {overdue ? "Overdue · " : "Due · "}
                              {formatDateInput(task.dueDate)}
                            </span>
                          )}
                        </div>

                        <details class="mt-4 border-t border-teal/20 pt-3">
                          <summary class="cursor-pointer text-sm font-medium text-primary">
                            Edit task
                          </summary>

                          <form method="POST" class="mt-4 space-y-3">
                            <input type="hidden" name="action" value="update-task" />
                            <input type="hidden" name="taskId" value={task.id} />

                            <div class="flex flex-col gap-1">
                              <label
                                for={`title-${task.id}`}
                                class="text-xs font-medium text-white/70"
                              >
                                Title
                              </label>
                              <input
                                id={`title-${task.id}`}
                                name="title"
                                type="text"
                                maxlength="120"
                                required
                                value={task.title}
                                class="rounded-md border border-teal bg-dark/50 px-3 py-2 text-sm text-white focus:border-primary focus:outline-none"
                              />
                            </div>

                            <div class="flex flex-col gap-1">
                              <label
                                for={`description-${task.id}`}
                                class="text-xs font-medium text-white/70"
                              >
                                Description
                              </label>
                              <textarea
                                id={`description-${task.id}`}
                                name="description"
                                rows="3"
                                maxlength="1000"
                                class="rounded-md border border-teal bg-dark/50 px-3 py-2 text-sm text-white focus:border-primary focus:outline-none"
                              >
                                {task.description}
                              </textarea>
                            </div>

                            <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-1 2xl:grid-cols-2">
                              <div class="flex flex-col gap-1">
                                <label
                                  for={`status-${task.id}`}
                                  class="text-xs font-medium text-white/70"
                                >
                                  Status
                                </label>
                                <select
                                  id={`status-${task.id}`}
                                  name="status"
                                  class="rounded-md border border-teal bg-dark/50 px-3 py-2 text-sm text-white focus:border-primary focus:outline-none"
                                >
                                  {BOARD_STATUSES.map((optionStatus) => (
                                    <option
                                      value={optionStatus}
                                      selected={optionStatus === task.status}
                                    >
                                      {BOARD_STATUS_LABELS[optionStatus]}
                                    </option>
                                  ))}
                                </select>
                              </div>

                              <div class="flex flex-col gap-1">
                                <label
                                  for={`assignee-${task.id}`}
                                  class="text-xs font-medium text-white/70"
                                >
                                  Assignee
                                </label>
                                <select
                                  id={`assignee-${task.id}`}
                                  name="assigneeId"
                                  class="rounded-md border border-teal bg-dark/50 px-3 py-2 text-sm text-white focus:border-primary focus:outline-none"
                                >
                                  <option value="" selected={!task.assigneeId}>
                                    Unassigned
                                  </option>
                                  {participants.map((participant) => (
                                    <option
                                      value={participant.id}
                                      selected={participant.id === task.assigneeId}
                                    >
                                      {participant.name}
                                    </option>
                                  ))}
                                </select>
                              </div>
                            </div>

                            <div class="flex flex-col gap-1">
                              <label
                                for={`due-${task.id}`}
                                class="text-xs font-medium text-white/70"
                              >
                                Due date
                              </label>
                              <input
                                id={`due-${task.id}`}
                                name="dueDate"
                                type="date"
                                value={formatDateInput(task.dueDate)}
                                class="rounded-md border border-teal bg-dark/50 px-3 py-2 text-sm text-white focus:border-primary focus:outline-none"
                              />
                            </div>

                            <button
                              type="submit"
                              class="w-full rounded-md bg-primary px-4 py-2 text-sm font-semibold text-dark transition-colors hover:bg-primary/90"
                            >
                              Save task
                            </button>
                          </form>

                          <form
                            method="POST"
                            class="mt-2"
                            onsubmit="return confirm('Delete this task?')"
                          >
                            <input type="hidden" name="action" value="delete-task" />
                            <input type="hidden" name="taskId" value={task.id} />
                            <button
                              type="submit"
                              class="w-full rounded-md border border-red-400/40 px-4 py-2 text-sm font-medium text-red-200 transition-colors hover:bg-red-500/10"
                            >
                              Delete task
                            </button>
                          </form>
                        </details>
                      </article>
                    );
                  })}
                </div>
              )}
            </div>
          ))
        }
      </div>
    </section>

    {
      permissions.isOwner && (
        <Card>
          <details>
            <summary class="cursor-pointer text-lg font-semibold text-white">
              Board settings
            </summary>

            <div class="mt-6 grid gap-8 lg:grid-cols-2">
              <form method="POST" class="space-y-4">
                <input type="hidden" name="action" value="update-board" />
                <h3 class="font-semibold text-white">Board details</h3>
                <div class="flex flex-col gap-1.5">
                  <label for="board-name" class="text-sm font-medium text-white/80">
                    Name
                  </label>
                  <input
                    id="board-name"
                    name="name"
                    type="text"
                    maxlength="80"
                    required
                    value={board.name}
                    class="rounded-md border border-teal bg-dark/50 px-3 py-2 text-white focus:border-primary focus:outline-none"
                  />
                </div>
                <div class="flex flex-col gap-1.5">
                  <label
                    for="board-description"
                    class="text-sm font-medium text-white/80"
                  >
                    Description
                  </label>
                  <textarea
                    id="board-description"
                    name="description"
                    rows="4"
                    maxlength="500"
                    class="rounded-md border border-teal bg-dark/50 px-3 py-2 text-white focus:border-primary focus:outline-none"
                  >
                    {board.description}
                  </textarea>
                </div>
                <button
                  type="submit"
                  class="rounded-md bg-primary px-4 py-2 font-semibold text-dark transition-colors hover:bg-primary/90"
                >
                  Save board details
                </button>
              </form>

              <div>
                <h3 class="font-semibold text-white">Manage members</h3>
                {board.members.length === 0 ? (
                  <p class="mt-3 text-sm text-white/45">
                    This board has no additional members.
                  </p>
                ) : (
                  <ul class="mt-3 space-y-2">
                    {board.members.map((member) => (
                      <li class="flex items-center justify-between gap-3 rounded-md border border-teal/20 p-3">
                        <div class="min-w-0">
                          <p class="truncate text-sm font-medium text-white">
                            {member.user.name}
                          </p>
                          <p class="truncate text-xs text-white/45">
                            {member.user.email}
                          </p>
                        </div>
                        <form
                          method="POST"
                          onsubmit="return confirm('Remove this member from the board?')"
                        >
                          <input type="hidden" name="action" value="remove-member" />
                          <input type="hidden" name="memberId" value={member.id} />
                          <button
                            type="submit"
                            class="text-sm font-medium text-red-200 hover:text-red-100"
                          >
                            Remove
                          </button>
                        </form>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>

            <div class="mt-8 border-t border-red-400/20 pt-6">
              <h3 class="font-semibold text-red-200">Delete board</h3>
              <p class="mt-1 text-sm text-white/45">
                This permanently deletes every task and membership on the board.
              </p>
              <form
                method="POST"
                class="mt-3"
                onsubmit="return confirm('Delete this entire board and all of its tasks?')"
              >
                <input type="hidden" name="action" value="delete-board" />
                <button
                  type="submit"
                  class="rounded-md border border-red-400/50 px-4 py-2 text-sm font-semibold text-red-200 transition-colors hover:bg-red-500/10"
                >
                  Delete board
                </button>
              </form>
            </div>
          </details>
        </Card>
      )
    }
  </div>
</DashboardLayout>
