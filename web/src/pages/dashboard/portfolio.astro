---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import Card from "@/components/common/Card.astro";
import Badge from "@/components/common/Badge.astro";
import Button from "@/components/common/Button.astro";
import RepoPicker from "@/components/portfolio/RepoPicker";
import { drizzle } from "drizzle-orm/d1";
import * as schema from "@/lib/db/schema";
import { eq } from "drizzle-orm";
import { env } from "cloudflare:workers";
import { hasCompletedCohort } from "@/lib/talent/eligibility";
import { parseSkillsJson } from "@/lib/talent/profile";
import { fetchGitHubLogin } from "@/lib/talent/github";
import { preserveFormTextValues } from "@/lib/form-values";
import {
  saveProfile,
  submitForReview,
  type ProfileFormResult,
} from "@/components/portfolio/portfolio-handlers";

const user = Astro.locals.user!;
const db = drizzle(env.DB, { schema });

const eligible = await hasCompletedCohort(db, user.id);

const PROFILE_TEXT_FIELDS = [
  "handle",
  "headline",
  "bio",
  "location",
  "country",
  "skills",
  "portfolioUrl",
  "linkedinUrl",
] as const;
type ProfileTextField = (typeof PROFILE_TEXT_FIELDS)[number];

let result: ProfileFormResult | null = null;
let saveFailed = false;
let submittedProfileValues: Record<ProfileTextField, string> | null = null;
let submittedAvailability = {
  openToFreelance: false,
  openToRoles: false,
};

if (Astro.request.method === "POST" && eligible) {
  const formData = await Astro.request.formData();
  const action = formData.get("_action") as string;

  if (action === "save") {
    submittedProfileValues = preserveFormTextValues(
      formData,
      PROFILE_TEXT_FIELDS,
    );
    submittedAvailability = {
      openToFreelance: formData.get("openToFreelance") === "on",
      openToRoles: formData.get("openToRoles") === "on",
    };
    const existing = await db.query.studentProfile.findFirst({
      where: eq(schema.studentProfile.userId, user.id),
      columns: { id: true },
    });
    result = await saveProfile(db, user.id, formData, existing?.id);
    if (!result.success) {
      saveFailed = true;
      Astro.response.status = 400;
    }
  } else if (action === "submit_for_review") {
    const existing = await db.query.studentProfile.findFirst({
      where: eq(schema.studentProfile.userId, user.id),
      columns: { id: true },
    });
    if (existing) {
      result = await submitForReview(db, user.id, existing.id);
    } else {
      result = { success: false, error: "Create your profile first" };
    }
  }
}

const profile = eligible
  ? await db.query.studentProfile.findFirst({
      where: eq(schema.studentProfile.userId, user.id),
      with: { highlights: true },
    })
  : null;

const skills = profile ? parseSkillsJson(profile.skills) : [];
const skillsValue = skills.join(", ");

let defaultHandle = "";
if (eligible && !profile) {
  try {
    const ghAccount = await db.query.account.findFirst({
      where: eq(schema.account.userId, user.id),
      columns: { accessToken: true, providerId: true },
    });
    if (ghAccount?.providerId === "github" && ghAccount.accessToken) {
      defaultHandle = await fetchGitHubLogin(ghAccount.accessToken);
    }
  } catch {
    // GitHub unavailable — leave blank
  }
}

const isEditable = !profile || profile.status === "DRAFT" || profile.status === "PUBLISHED";

const invalidProfileValues = saveFailed ? submittedProfileValues : null;
const profileFormValues: Record<ProfileTextField, string> = {
  handle: invalidProfileValues?.handle ?? profile?.handle ?? defaultHandle,
  headline: invalidProfileValues?.headline ?? profile?.headline ?? "",
  bio: invalidProfileValues?.bio ?? profile?.bio ?? "",
  location: invalidProfileValues?.location ?? profile?.location ?? "",
  country: invalidProfileValues?.country ?? profile?.country ?? "",
  skills: invalidProfileValues?.skills ?? skillsValue,
  portfolioUrl: invalidProfileValues?.portfolioUrl ?? profile?.portfolioUrl ?? "",
  linkedinUrl: invalidProfileValues?.linkedinUrl ?? profile?.linkedinUrl ?? "",
};
const profileAvailability = saveFailed
  ? submittedAvailability
  : {
      openToFreelance: profile?.openToFreelance ?? false,
      openToRoles: profile?.openToRoles ?? false,
    };

const profileFieldErrors: Partial<Record<ProfileTextField, string>> = {};
if (result?.handleError) profileFieldErrors.handle = result.handleError;
for (const field of PROFILE_TEXT_FIELDS) {
  if (field === "handle") continue;
  const directError = result?.fieldErrors?.[field];
  const nestedError = Object.entries(result?.fieldErrors ?? {}).find(
    ([path]) => path.startsWith(`${field}.`),
  )?.[1];
  const fieldError = directError ?? nestedError;
  if (fieldError) profileFieldErrors[field] = fieldError;
}

const PROFILE_FIELD_LABELS: Record<ProfileTextField, string> = {
  handle: "Handle",
  headline: "Headline",
  bio: "Bio",
  location: "City / Region",
  country: "Country",
  skills: "Skills",
  portfolioUrl: "Portfolio URL",
  linkedinUrl: "LinkedIn URL",
};
const firstProfileError = PROFILE_TEXT_FIELDS.find(
  (field) => profileFieldErrors[field],
);
const profileFieldDescription = (
  field: ProfileTextField,
  helperId?: string,
) =>
  [helperId, profileFieldErrors[field] ? `${field}-error` : undefined]
    .filter(Boolean)
    .join(" ") || undefined;
const skillsPattern = String.raw`\s*[^,]{1,30}\s*(,\s*[^,]{1,30}\s*){0,11}`;

const existingHighlights = profile?.highlights
  ? profile.highlights
      .toSorted((a, b) => a.sortOrder - b.sortOrder)
      .map((h) => ({
        repoFullName: h.repoFullName,
        blurb: h.blurb ?? "",
        sortOrder: h.sortOrder,
      }))
  : [];

const hasGitHubAccount = profile
  ? await db.query.account
      .findFirst({
        where: eq(schema.account.userId, user.id),
        columns: { accessToken: true, providerId: true },
      })
      .then((a) => a?.providerId === "github" && !!a.accessToken)
  : false;
---

<DashboardLayout title="Portfolio">
  <div class="space-y-6">
    <div>
      <h2 class="text-2xl font-bold text-white">Portfolio</h2>
      <p class="mt-1 text-ink-secondary">
        Showcase your work and connect with opportunities.
      </p>
    </div>

    {!eligible && (
      <Card>
        <div class="py-8 text-center">
          <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-primary/10">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <p class="text-lg font-semibold text-white">
            Your portfolio unlocks when you complete a cohort
          </p>
          <p class="mx-auto mt-2 max-w-md text-ink-secondary">
            Once you finish a training program, you'll be able to build your
            portfolio, highlight your best projects, and connect with
            opportunities across the ecosystem.
          </p>
          <Button href="/dashboard/apply" class="mt-6">
            Browse Programs
          </Button>
        </div>
      </Card>
    )}

    {eligible && (
      <>
        {/* Status banner */}
        {profile && (
          <div class:list={[
            "rounded-md border p-4",
            profile.status === "DRAFT" && "border-amber-500/30 bg-amber-500/10 text-amber-300",
            profile.status === "IN_REVIEW" && "border-blue-500/30 bg-blue-500/10 text-blue-300",
            profile.status === "PUBLISHED" && "border-green-500/30 bg-green-500/10 text-green-300",
            profile.status === "SUSPENDED" && "border-red-500/30 bg-red-500/10 text-red-300",
          ]}>
            <div class="flex items-center justify-between gap-4">
              <div class="flex items-center gap-3">
                <Badge variant={profile.status.toLowerCase() as "draft" | "in_review" | "published" | "suspended"} />
                {profile.status === "DRAFT" && (
                  <span>Your profile is a draft. Submit it for review when you're ready.</span>
                )}
                {profile.status === "IN_REVIEW" && (
                  <span>The TTV team is reviewing your profile.</span>
                )}
                {profile.status === "PUBLISHED" && (
                  <span>
                    Live at{" "}
                    <a
                      href={`/talent/${profile.handle}`}
                      class="underline hover:text-white"
                      target="_blank"
                      rel="noopener noreferrer"
                    >/talent/{profile.handle}</a>
                    {" "}— edits go live immediately.
                  </span>
                )}
                {profile.status === "SUSPENDED" && (
                  <span>Your profile is paused — reach out to the team for assistance.</span>
                )}
              </div>
              {profile.status === "DRAFT" && (
                <form method="POST">
                  <input type="hidden" name="_action" value="submit_for_review" />
                  <Button type="submit" class="whitespace-nowrap">
                    Submit for Review
                  </Button>
                </form>
              )}
            </div>
          </div>
        )}

        {/* Result messages */}
        {saveFailed && (
          <div
            class="rounded-md border border-red-500/30 bg-red-500/10 p-4 text-red-300"
            role="alert"
          >
            <p class="font-medium">
              We couldn&rsquo;t save your profile. Your changes are still in the form.
            </p>
            {firstProfileError ? (
              <a
                href={`#${firstProfileError}`}
                class="mt-1 inline-block underline hover:text-white"
              >
                Go to the first error: {PROFILE_FIELD_LABELS[firstProfileError]}
              </a>
            ) : result?.error ? (
              <p class="mt-1">{result.error}</p>
            ) : null}
          </div>
        )}

        {result && !result.success && result.error && !saveFailed && (
          <div class="rounded-md border border-red-500/30 bg-red-500/10 p-4 text-red-300">
            {result.error}
          </div>
        )}

        {result?.success && (
          <div class="rounded-md border border-green-500/30 bg-green-500/10 p-4 text-green-300">
            Profile saved successfully.
          </div>
        )}

        {/* Profile editor */}
        {isEditable && (
          <Card>
            <form id="profile-editor" method="POST" class="space-y-5">
              <input type="hidden" name="_action" value="save" />

              <h3 class="text-lg font-semibold text-white">
                {profile ? "Edit Your Profile" : "Create Your Profile"}
              </h3>

              {/* Handle */}
              <div class="flex flex-col gap-1.5">
                <label for="handle" class="text-sm font-medium text-white/90">
                  Handle <span class="text-primary">*</span>
                </label>
                <div class="flex items-center gap-2">
                  <span class="text-ink-muted">/talent/</span>
                  <input
                    id="handle"
                    name="handle"
                    type="text"
                    required
                    maxlength="39"
                    placeholder="your-handle"
                    value={profileFormValues.handle}
                    aria-invalid={Boolean(profileFieldErrors.handle)}
                    aria-describedby={profileFieldDescription("handle", "handle-help")}
                    class:list={[
                      "flex-1 rounded-md border bg-dark/50 px-3 py-2 text-white placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-primary/50",
                      profileFieldErrors.handle ? "border-red-500" : "border-teal focus:border-primary",
                    ]}
                  />
                </div>
                {profileFieldErrors.handle && (
                  <p id="handle-error" class="text-sm text-red-400">
                    {profileFieldErrors.handle}
                  </p>
                )}
                <p id="handle-help" class="text-xs text-ink-muted">
                  3-39 characters. Lowercase letters, numbers, and hyphens only.
                </p>
              </div>

              {/* Headline */}
              <div class="flex flex-col gap-1.5">
                <label for="headline" class="text-sm font-medium text-white/90">
                  Headline
                </label>
                <input
                  id="headline"
                  name="headline"
                  type="text"
                  maxlength="120"
                  placeholder="e.g. Full-Stack Developer · Lagos, Nigeria"
                  value={profileFormValues.headline}
                  aria-invalid={Boolean(profileFieldErrors.headline)}
                  aria-describedby={profileFieldDescription("headline")}
                  class:list={[
                    "rounded-md border bg-dark/50 px-3 py-2 text-white placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-primary/50",
                    profileFieldErrors.headline ? "border-red-500" : "border-teal focus:border-primary",
                  ]}
                />
                {profileFieldErrors.headline && (
                  <p id="headline-error" class="text-sm text-red-400">
                    {profileFieldErrors.headline}
                  </p>
                )}
              </div>

              {/* Bio */}
              <div class="flex flex-col gap-1.5">
                <label for="bio" class="text-sm font-medium text-white/90">
                  Bio
                </label>
                <textarea
                  id="bio"
                  name="bio"
                  rows={4}
                  maxlength="4000"
                  placeholder="Tell the community about yourself, your journey, and what you're building."
                  aria-invalid={Boolean(profileFieldErrors.bio)}
                  aria-describedby={profileFieldDescription("bio")}
                  class:list={[
                    "rounded-md border bg-dark/50 px-3 py-2 text-white placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-primary/50",
                    profileFieldErrors.bio ? "border-red-500" : "border-teal focus:border-primary",
                  ]}
                >{profileFormValues.bio}</textarea>
                {profileFieldErrors.bio && (
                  <p id="bio-error" class="text-sm text-red-400">
                    {profileFieldErrors.bio}
                  </p>
                )}
              </div>

              {/* Location + Country */}
              <div class="grid gap-4 sm:grid-cols-2">
                <div class="flex flex-col gap-1.5">
                  <label for="location" class="text-sm font-medium text-white/90">
                    City / Region
                  </label>
                  <input
                    id="location"
                    name="location"
                    type="text"
                    maxlength="120"
                    placeholder="e.g. Lagos"
                    value={profileFormValues.location}
                    aria-invalid={Boolean(profileFieldErrors.location)}
                    aria-describedby={profileFieldDescription("location")}
                    class:list={[
                      "form-control placeholder:text-ink-muted",
                      profileFieldErrors.location && "border-red-500",
                    ]}
                  />
                  {profileFieldErrors.location && (
                    <p id="location-error" class="text-sm text-red-400">
                      {profileFieldErrors.location}
                    </p>
                  )}
                </div>
                <div class="flex flex-col gap-1.5">
                  <label for="country" class="text-sm font-medium text-white/90">
                    Country
                  </label>
                  <input
                    id="country"
                    name="country"
                    type="text"
                    maxlength="56"
                    placeholder="e.g. Nigeria"
                    value={profileFormValues.country}
                    aria-invalid={Boolean(profileFieldErrors.country)}
                    aria-describedby={profileFieldDescription("country")}
                    class:list={[
                      "form-control placeholder:text-ink-muted",
                      profileFieldErrors.country && "border-red-500",
                    ]}
                  />
                  {profileFieldErrors.country && (
                    <p id="country-error" class="text-sm text-red-400">
                      {profileFieldErrors.country}
                    </p>
                  )}
                </div>
              </div>

              {/* Skills */}
              <div class="flex flex-col gap-1.5">
                <label for="skills" class="text-sm font-medium text-white/90">
                  Skills
                </label>
                <input
                  id="skills"
                  name="skills"
                  type="text"
                  pattern={skillsPattern}
                  title="Use up to 12 comma-separated skills, with 30 characters or fewer in each skill."
                  placeholder="e.g. TypeScript, React, Node.js, Python"
                  value={profileFormValues.skills}
                  aria-invalid={Boolean(profileFieldErrors.skills)}
                  aria-describedby={profileFieldDescription("skills", "skills-help")}
                  class:list={[
                    "rounded-md border bg-dark/50 px-3 py-2 text-white placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-primary/50",
                    profileFieldErrors.skills ? "border-red-500" : "border-teal focus:border-primary",
                  ]}
                />
                {profileFieldErrors.skills && (
                  <p id="skills-error" class="text-sm text-red-400">
                    {profileFieldErrors.skills}
                  </p>
                )}
                <p id="skills-help" class="text-xs text-ink-muted">
                  Add up to 12 comma-separated skills. Each skill can be up to 30 characters.
                </p>
              </div>

              {/* Availability toggles */}
              <div class="flex flex-wrap gap-6">
                <label class="flex items-center gap-2 text-sm text-white/90">
                  <input
                    type="checkbox"
                    name="openToFreelance"
                    checked={profileAvailability.openToFreelance}
                    class="h-4 w-4 rounded border-teal bg-dark/50 text-primary focus:ring-primary/50"
                  />
                  Open to freelance work
                </label>
                <label class="flex items-center gap-2 text-sm text-white/90">
                  <input
                    type="checkbox"
                    name="openToRoles"
                    checked={profileAvailability.openToRoles}
                    class="h-4 w-4 rounded border-teal bg-dark/50 text-primary focus:ring-primary/50"
                  />
                  Open to full-time roles
                </label>
              </div>

              {/* URLs */}
              <div class="grid gap-4 sm:grid-cols-2">
                <div class="flex flex-col gap-1.5">
                  <label for="portfolioUrl" class="text-sm font-medium text-white/90">
                    Portfolio URL
                  </label>
                  <input
                    id="portfolioUrl"
                    name="portfolioUrl"
                    type="url"
                    maxlength="300"
                    placeholder="https://your-site.com"
                    value={profileFormValues.portfolioUrl}
                    aria-invalid={Boolean(profileFieldErrors.portfolioUrl)}
                    aria-describedby={profileFieldDescription("portfolioUrl")}
                    class:list={[
                      "rounded-md border bg-dark/50 px-3 py-2 text-white placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-primary/50",
                      profileFieldErrors.portfolioUrl ? "border-red-500" : "border-teal focus:border-primary",
                    ]}
                  />
                  {profileFieldErrors.portfolioUrl && (
                    <p id="portfolioUrl-error" class="text-sm text-red-400">
                      {profileFieldErrors.portfolioUrl}
                    </p>
                  )}
                </div>
                <div class="flex flex-col gap-1.5">
                  <label for="linkedinUrl" class="text-sm font-medium text-white/90">
                    LinkedIn URL
                  </label>
                  <input
                    id="linkedinUrl"
                    name="linkedinUrl"
                    type="url"
                    maxlength="300"
                    placeholder="https://linkedin.com/in/your-profile"
                    value={profileFormValues.linkedinUrl}
                    aria-invalid={Boolean(profileFieldErrors.linkedinUrl)}
                    aria-describedby={profileFieldDescription("linkedinUrl")}
                    class:list={[
                      "rounded-md border bg-dark/50 px-3 py-2 text-white placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-primary/50",
                      profileFieldErrors.linkedinUrl ? "border-red-500" : "border-teal focus:border-primary",
                    ]}
                  />
                  {profileFieldErrors.linkedinUrl && (
                    <p id="linkedinUrl-error" class="text-sm text-red-400">
                      {profileFieldErrors.linkedinUrl}
                    </p>
                  )}
                </div>
              </div>

              <div class="flex justify-end">
                <Button type="submit">
                  {profile ? "Save Changes" : "Create Profile"}
                </Button>
              </div>
            </form>
          </Card>
        )}

        {/* IN_REVIEW non-editable state */}
        {profile && profile.status === "IN_REVIEW" && (
          <Card>
            <div class="py-4 text-center text-ink-secondary">
              Your profile is under review. You'll be able to edit it again once the team responds.
            </div>
          </Card>
        )}

        {/* SUSPENDED non-editable state */}
        {profile && profile.status === "SUSPENDED" && (
          <Card>
            <div class="py-4 text-center text-ink-secondary">
              Your profile is currently paused. Please reach out to the TTV team for next steps.
            </div>
          </Card>
        )}

        {/* GitHub Highlights */}
        {profile && (
          <Card>
            <h3 class="mb-4 text-lg font-semibold text-white">
              GitHub Highlights
            </h3>
            <RepoPicker
              client:load
              profileId={profile.id}
              existingHighlights={existingHighlights}
              hasGitHubToken={hasGitHubAccount}
            />
          </Card>
        )}
      </>
    )}
  </div>
</DashboardLayout>
