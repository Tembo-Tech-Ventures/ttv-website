---
/**
 * The public profile editor (/dashboard/me/portfolio), on the kit (style-guide rollout M13, audit
 * A§16): the profile's state as a Notice with its StatusChip (publishing a draft is the page's one
 * primary), kit fields, and the GitHub highlights island below the form, hydrated when it scrolls in.
 * Its reads start beside the space frame, and a GET makes no call to GitHub. A saved form answers 303
 * with a read-once flash; a refused one renders again with every value kept, the error under each
 * field and a focused danger Notice (400, or 422 when Tembo's check holds it); a failure that isn't
 * the person's is a 503.
 */
import SpacePage from "@/components/platform/spaces/SpacePage.astro";
import { resolveSpacePageWith } from "@/components/platform/spaces/space-page";
import { SPACE_PAGE_PATHS } from "@/components/platform/spaces/sidebar";
import PartnerProfileNote from "@/components/platform/onboarding/PartnerProfileNote.astro";
import {
  Button, ButtonLink, Card, Checkbox, EmptyState, HINT, LABEL, Notice, PageHeader, PrefixField, StatusChip,
  TextAreaField, TextField, linkClass,
} from "@/components/platform/ui";
import RepoPicker from "@/components/portfolio/RepoPicker";
import { redirectWithFlash, takeFlash } from "@/lib/platform/server/flash";
import { drizzle } from "drizzle-orm/d1";
import * as schema from "@/lib/db/schema";
import { and, eq } from "drizzle-orm";
import { env } from "cloudflare:workers";
import { getStudentJourney } from "@/lib/student/journey";
import { parseSkillsJson } from "@/lib/talent/profile";
import { preserveFormTextValues } from "@/lib/form-values";
import { isAgentSession } from "@/lib/agent-auth";
import {
  loadProfilePhotoForModeration,
  resolveModeratedProfileAvatar,
  safePublicProfileAvatarUrl,
} from "@/lib/avatar";
import {
  checkProfileContent,
  previewProfileModerationResult,
  PROFILE_MODERATION_PREVIEW_HEADER,
} from "@/lib/moderation/clef";
import { discardUnreferencedProfilePhoto } from "@/components/profile/profile-photo-cleanup";
import {
  publishProfile,
  saveProfile,
  type ProfileContentCheck,
  type ProfileFormResult,
} from "@/components/portfolio/portfolio-handlers";
import { PORTFOLIO_COPY } from "@/lib/student/portfolio-page";

const user = Astro.locals.user!;
const db = drizzle(env.DB, { schema });
// The frame starts first, beside whatever the request does (PERF-2). Whether the person has completed a
// cohort comes from their journey, which the frame reads anyway (one read per request): its sidebar
// offers the profile link exactly then.
const resolving = resolveSpacePageWith(Astro.locals, "portfolio", async () => null);
const eligibility = getStudentJourney(db, user.id).then((journey) => journey.visibleLinkIds.includes("profile"));

const previewModeration = previewProfileModerationResult(
  env.DEPLOYMENT_ENVIRONMENT,
  isAgentSession(Astro.locals.session?.userAgent),
  Astro.request.headers.get(PROFILE_MODERATION_PREVIEW_HEADER),
);
let moderatedSnapshotUrl: string | null = null;
const moderateProfile: ProfileContentCheck = async (state, avatarUrl) => {
  if (previewModeration) {
    return {
      ...previewModeration,
      publicAvatarUrl: safePublicProfileAvatarUrl(avatarUrl),
    };
  }

  let loadedAvatarImage: string | null | undefined;
  const moderation = await checkProfileContent(env.AI, state, {
    gatewayName: env.AI_GATEWAY_NAME,
    loadAvatarImage: avatarUrl
      ? async () => {
          loadedAvatarImage = await loadProfilePhotoForModeration(
            env.BUCKET,
            avatarUrl,
          );
          return loadedAvatarImage;
        }
      : undefined,
  });

  const resolvedAvatar = await resolveModeratedProfileAvatar({
    bucket: env.BUCKET,
    userId: user.id,
    avatarUrl,
    avatarImage: loadedAvatarImage,
    outcome: moderation.outcome,
  });
  moderatedSnapshotUrl = resolvedAvatar.createdSnapshotUrl;

  return { ...moderation, publicAvatarUrl: resolvedAvatar.publicAvatarUrl };
};

async function withModeratedSnapshotCleanup<T>(
  write: () => Promise<T>,
): Promise<T> {
  try {
    return await write();
  } finally {
    await discardUnreferencedProfilePhoto({
      db,
      bucket: env.BUCKET,
      userId: user.id,
      imageUrl: moderatedSnapshotUrl,
    });
    moderatedSnapshotUrl = null;
  }
}

const PROFILE_TEXT_FIELDS = [
  "handle",
  "headline",
  "bio",
  "location",
  "country",
  "skills",
  "portfolioUrl",
  "linkedinUrl",
] as const;
type ProfileTextField = (typeof PROFILE_TEXT_FIELDS)[number];

let result: ProfileFormResult | null = null;
/** Which form was refused: the editor ("save") or the draft's publish button. */
let refused: "save" | "publish" | null = null;
let unavailable = false;
let submittedProfileValues: Record<ProfileTextField, string> | null = null;
let submittedAvailability = { openToFreelance: false, openToRoles: false };

if (Astro.request.method === "POST") {
  if (!(await eligibility)) {
    // Nothing to save before a cohort is complete: the page says why.
    Astro.response.status = 403;
  } else {
    try {
      const formData = await Astro.request.formData();
      const action = formData.get("_action");
      const existing = await db.query.studentProfile.findFirst({
        where: eq(schema.studentProfile.userId, user.id),
        columns: { id: true },
      });

      if (action === "save") {
        submittedProfileValues = preserveFormTextValues(formData, PROFILE_TEXT_FIELDS);
        submittedAvailability = {
          openToFreelance: formData.get("openToFreelance") === "on",
          openToRoles: formData.get("openToRoles") === "on",
        };
        result = await withModeratedSnapshotCleanup(() => saveProfile(db, user.id, formData, existing?.id, moderateProfile));
        if (result.success) {
          const title = result.published ? PORTFOLIO_COPY.live : existing ? PORTFOLIO_COPY.draftSaved : PORTFOLIO_COPY.created;
          return redirectWithFlash(Astro, SPACE_PAGE_PATHS.portfolio, { tone: "success", title });
        }
        refused = "save";
        Astro.response.status = result.moderationOutcome === "hold" ? 422 : 400;
      } else if (action === "publish") {
        result = existing
          ? await withModeratedSnapshotCleanup(() => publishProfile(db, user.id, existing.id, moderateProfile))
          : { success: false, error: "Create your profile first." };
        if (result.success) {
          return redirectWithFlash(Astro, SPACE_PAGE_PATHS.portfolio, { tone: "success", title: PORTFOLIO_COPY.published });
        }
        refused = "publish";
        Astro.response.status = result.moderationOutcome === "hold" ? 422 : 400;
      } else {
        refused = "save";
        result = { success: false, error: "That form didn't arrive whole. Try again." };
        Astro.response.status = 400;
      }
    } catch {
      unavailable = true;
      Astro.response.status = 503;
    }
  }
}

const [landing, eligible, profile, github] = await Promise.all([
  resolving,
  eligibility,
  db.query.studentProfile.findFirst({
    where: eq(schema.studentProfile.userId, user.id),
    with: { highlights: true },
  }),
  db.query.account.findFirst({
    where: and(eq(schema.account.userId, user.id), eq(schema.account.providerId, "github")),
    columns: { accessToken: true },
  }),
]);
const spaces = landing?.[0] ?? null;
// Someone who chose to mentor or find people, and not to build and learn, is not sent to apply (QAO-07).
// A partner who has completed a cohort keeps their profile, and the page that goes with it.
const partnerLocked = !eligible && spaces?.onboarding?.framing === "partner";
const editable = eligible && (!profile || profile.status === "DRAFT" || profile.status === "PUBLISHED");
// A POST never carries a flash, and a refused one says what went wrong instead.
const flash = Astro.request.method === "GET" ? takeFlash(Astro) : null;

const kept = refused === "save" ? submittedProfileValues : null;
const values: Record<ProfileTextField, string> = {
  handle: kept?.handle ?? profile?.handle ?? "",
  headline: kept?.headline ?? profile?.headline ?? "",
  bio: kept?.bio ?? profile?.bio ?? "",
  location: kept?.location ?? profile?.location ?? "",
  country: kept?.country ?? profile?.country ?? "",
  skills: kept?.skills ?? (profile ? parseSkillsJson(profile.skills).join(", ") : ""),
  portfolioUrl: kept?.portfolioUrl ?? profile?.portfolioUrl ?? "",
  linkedinUrl: kept?.linkedinUrl ?? profile?.linkedinUrl ?? "",
};
const availability = kept
  ? submittedAvailability
  : { openToFreelance: profile?.openToFreelance ?? false, openToRoles: profile?.openToRoles ?? false };

const errors: Partial<Record<ProfileTextField, string>> = {};
if (refused === "save") {
  if (result?.handleError) errors.handle = result.handleError;
  for (const field of PROFILE_TEXT_FIELDS) {
    if (field === "handle") continue;
    const nested = Object.entries(result?.fieldErrors ?? {}).find(([path]) => path.startsWith(`${field}.`))?.[1];
    const error = result?.fieldErrors?.[field] ?? nested;
    if (error) errors[field] = error;
  }
}
const fieldErrors = Object.keys(errors).length > 0;
const moderationMessages = result?.moderationMessages ?? [];
const skillsPattern = String.raw`\s*[^,]{1,30}\s*(,\s*[^,]{1,30}\s*){0,11}`;

const existingHighlights = (profile?.highlights ?? [])
  .toSorted((a, b) => a.sortOrder - b.sortOrder)
  .map((h) => ({ repoFullName: h.repoFullName, blurb: h.blurb ?? "", sortOrder: h.sortOrder }));
const draft = profile?.status === "DRAFT";
---

<SpacePage context={spaces} title="Public profile" titlePrefix={refused || unavailable ? "Error: " : ""}>
  <div class="flex max-w-3xl flex-col gap-8">
    <PageHeader title="Public profile">
      {!partnerLocked && "Show your work, and be found for what you can do."}
    </PageHeader>

    {flash && <Notice tone={flash.tone} title={flash.title}>{flash.message}</Notice>}

    {unavailable && (
      <Notice tone="danger" focusOnLoad id="portfolio-failure" title={PORTFOLIO_COPY.notSaved}>{PORTFOLIO_COPY.unavailable}</Notice>
    )}
    {refused && (
      <Notice tone="danger" focusOnLoad id="portfolio-failure" title={refused === "publish" ? PORTFOLIO_COPY.notPublished : PORTFOLIO_COPY.notSaved}>
        <p class="m-0">{fieldErrors ? PORTFOLIO_COPY.fixBelow : result?.error}</p>
        {moderationMessages.length > 0 && (
          <ul class="m-0 mt-2 list-disc space-y-1 pl-5">
            {moderationMessages.map((message) => <li>{message}</li>)}
          </ul>
        )}
      </Notice>
    )}

    {partnerLocked && <PartnerProfileNote />}

    {!eligible && !partnerLocked && (
      <EmptyState title="Your public profile opens when you complete a cohort" headingLevel={2}>
        Then you can build it, choose your best projects, and be found for opportunities across the community.
        <Fragment slot="action"><ButtonLink href={SPACE_PAGE_PATHS.apply} variant="primary">Browse cohorts</ButtonLink></Fragment>
      </EmptyState>
    )}

    {eligible && profile && (
      <div data-profile-status={profile.status}>
        {profile.status === "DRAFT" && (
          <Notice tone="info" title="Your profile is a draft">
            <span class="inline-flex flex-wrap items-center gap-2"><StatusChip domain="profile" status="DRAFT" /> Only you can see it. Publish it when you're ready.</span>
            <Fragment slot="actions">
              <form method="POST">
                <input type="hidden" name="_action" value="publish" />
                <Button type="submit" variant="primary" size="sm">Publish profile</Button>
              </form>
            </Fragment>
          </Notice>
        )}
        {profile.status === "PUBLISHED" && (
          <Notice tone="success" title="Your profile is live">
            <span class="inline-flex flex-wrap items-center gap-2"><StatusChip domain="profile" status="PUBLISHED" /> <span>Live at <a href={`/talent/${profile.handle}`} class={linkClass()}>/talent/{profile.handle}</a>.</span></span>
            Saved edits go live straight away. An automatic check runs as you save, and if it holds an edit for the team, you'll see why.
          </Notice>
        )}
        {profile.status === "SUSPENDED" && (
          <Notice tone="warning" title="Your profile is paused">
            <span class="inline-flex flex-wrap items-center gap-2"><StatusChip domain="profile" status="SUSPENDED" /> Reach out to the team for next steps.</span>
          </Notice>
        )}
      </div>
    )}

    {editable && (
      <Card as="section" aria-labelledby="profile-editor-title" className="flex flex-col gap-5">
        <h2 id="profile-editor-title" class="text-xl leading-snug text-ink-primary">{profile ? "Edit your profile" : "Create your profile"}</h2>
        <form id="profile-editor" method="POST" class="flex flex-col gap-5">
          <input type="hidden" name="_action" value="save" />
          <PrefixField
            label="Handle" name="handle" prefix="/talent/" required maxLength={39} autocomplete="off" spellcheck={false}
            defaultValue={values.handle} error={errors.handle}
            hint="3 to 39 characters: lowercase letters, numbers and hyphens. Your GitHub username works well."
          />
          <TextField label="Headline" name="headline" optional maxLength={120} placeholder="Full-stack developer in Kisumu" defaultValue={values.headline} error={errors.headline} />
          <TextAreaField label="Bio" name="bio" optional rows={5} maxLength={4000} defaultValue={values.bio} error={errors.bio}
            hint="Who you are, what you've built, and what you're building next." />
          <div class="grid gap-5 sm:grid-cols-2">
            <TextField label="City or region" name="location" optional maxLength={120} autocomplete="address-level2" defaultValue={values.location} error={errors.location} />
            <TextField label="Country" name="country" optional maxLength={56} autocomplete="country-name" defaultValue={values.country} error={errors.country} />
          </div>
          <TextField label="Skills" name="skills" optional pattern={skillsPattern} placeholder="TypeScript, React, Python" defaultValue={values.skills} error={errors.skills}
            hint="Up to 12, separated by commas, each up to 30 characters." />
          <fieldset class="m-0 flex flex-col gap-3 border-0 p-0">
            <legend class={LABEL}>Open to <span class={HINT}>(optional)</span></legend>
            <Checkbox label="Freelance work" name="openToFreelance" defaultChecked={availability.openToFreelance} />
            <Checkbox label="Full-time roles" name="openToRoles" defaultChecked={availability.openToRoles} />
          </fieldset>
          <div class="grid gap-5 sm:grid-cols-2">
            <TextField label="Portfolio link" name="portfolioUrl" type="url" optional maxLength={300} placeholder="https://your-site.com" defaultValue={values.portfolioUrl} error={errors.portfolioUrl} />
            <TextField label="LinkedIn link" name="linkedinUrl" type="url" optional maxLength={300} placeholder="https://linkedin.com/in/you" defaultValue={values.linkedinUrl} error={errors.linkedinUrl} />
          </div>
          <div>
            <Button type="submit" variant={draft ? "quiet" : "primary"}>{!profile ? "Create profile" : draft ? "Save draft" : "Save changes"}</Button>
          </div>
        </form>
      </Card>
    )}

    {eligible && profile && profile.status !== "SUSPENDED" && (
      <Card as="section" aria-labelledby="highlights-title" className="flex flex-col gap-4">
        <div>
          <h2 id="highlights-title" class="text-xl leading-snug text-ink-primary">GitHub highlights</h2>
          <p class={`m-0 mt-1 ${HINT}`}>Choose up to six repositories to show on your public profile, each with a line about your part in it.</p>
        </div>
        <RepoPicker
          client:visible
          profileId={profile.id}
          existingHighlights={existingHighlights}
          hasGitHubToken={Boolean(github?.accessToken)}
        />
      </Card>
    )}
  </div>
</SpacePage>
