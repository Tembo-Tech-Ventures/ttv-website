---
/**
 * The student's own feedback and what happened to it. Not in the sidebar:
 * students reach it from the feedback form, which is where the question
 * "did anyone read that?" comes up.
 */
import SpacePage from "@/components/platform/spaces/SpacePage.astro";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";
import { Button, Card, EmptyState, FOCUS_RING, PageTitle, StatusChip, linkClass } from "@/components/platform/ui";
import { env } from "cloudflare:workers";
import { listFeedbackForUser } from "@/lib/feedback/store";
import { feedbackAttachmentPath } from "@/lib/feedback/api";
import { FEEDBACK_KIND_LABELS, feedbackPagePath } from "@/lib/feedback/model";
import {
  isClosedThemeStatus,
  studentFeedbackState,
  type FeedbackThemeStatus,
} from "@/lib/feedback/themes";
import { OPEN_FEEDBACK_ATTRIBUTE } from "@/components/feedback/feedback-client";
import { formatMomentDate } from "@/lib/display-date";

const user = Astro.locals.user!;
// The notes and the space context are read together, not one after the other.
const [items, spaces] = await Promise.all([
  listFeedbackForUser(env.DB, user.id),
  resolveSpacePage(Astro.locals, "feedback"),
]);

const openFeedback = { [OPEN_FEEDBACK_ATTRIBUTE]: "" };
// Once a theme closes, the reply's "See the change" link takes over.
const planLink = (theme: { status: FeedbackThemeStatus; issueUrl: string | null }) =>
  isClosedThemeStatus(theme.status) ? null : theme.issueUrl;
const othersOnTheme = (students: number) =>
  students === 2
    ? "One other student raised this too."
    : `${students - 1} other students raised this too.`;
---

<SpacePage context={spaces} title="Your feedback">
  <div class={spaces ? "max-w-3xl space-y-6" : "mx-auto max-w-3xl space-y-6"}>
    <header class="flex flex-wrap items-end justify-between gap-4">
      <div class="min-w-0 basis-80 grow">
        <PageTitle>Your feedback</PageTitle>
        <p class="mt-3 text-base leading-relaxed text-ink-secondary">
          Everything you've sent, where it stands, and any reply from the team.
        </p>
        <p class="mt-1 text-sm text-ink-muted">
          Feedback never affects your applications, profile or opportunities.
        </p>
      </div>
      <Button variant="primary" size="lg" {...openFeedback}>Send feedback</Button>
    </header>

    {
      items.length === 0 ? (
        <EmptyState title="Nothing sent yet" headingLevel={2}>
          Whenever something is broken, confusing, or could be better, use {spaces ? "Feedback in your account menu" : "the Feedback button in the corner of any page"}.
          A sentence or a screenshot is plenty.
        </EmptyState>
      ) : (
        <ol class="space-y-4" data-testid="feedback-history">
          {items.map((item) => (
            <li id={`feedback-${item.id}`} class="scroll-mt-24">
              <Card>
                <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                  <StatusChip domain="studentFeedback" status={studentFeedbackState(item.status, item.theme?.status ?? null)} />
                  <span class="text-sm font-semibold text-ink-primary">
                    {FEEDBACK_KIND_LABELS[item.kind]}
                  </span>
                  <span class="text-sm text-ink-muted">
                    {formatMomentDate(item.createdAt)} · on {feedbackPagePath(item.pageUrl)}
                  </span>
                </div>

                {item.message && (
                  <p class="mt-3 whitespace-pre-wrap break-words text-sm leading-relaxed text-ink-secondary">{item.message}</p>
                )}

                {item.theme && (item.theme.students > 1 || planLink(item.theme)) && (
                  <p class="mt-3 text-sm text-ink-secondary">
                    {item.theme.students > 1 && othersOnTheme(item.theme.students)}
                    {planLink(item.theme) && (
                      <>
                        {" "}
                        <a href={planLink(item.theme)!} target="_blank" rel="noopener noreferrer" class={linkClass()}>
                          Follow the plan
                        </a>
                      </>
                    )}
                  </p>
                )}

                {item.attachments.length > 0 && (
                  <ul class="mt-3 flex flex-wrap gap-2" aria-label="Your screenshots">
                    {item.attachments.map((attachment, index) => (
                      <li>
                        <a
                          href={feedbackAttachmentPath(attachment.id)}
                          target="_blank"
                          rel="noopener"
                          class={`block overflow-hidden rounded-lg border border-hairline transition-colors duration-150 motion-reduce:transition-none hover:border-ink-primary/45 ${FOCUS_RING}`}
                        >
                          <img
                            src={feedbackAttachmentPath(attachment.id)}
                            alt={`Screenshot ${index + 1}`}
                            loading="lazy"
                            class="h-20 w-28 object-cover object-top"
                          />
                        </a>
                      </li>
                    ))}
                  </ul>
                )}

                {(item.response || item.resolutionUrl) && (
                  <div class="mt-4 rounded-r-lg border-l-2 border-primary bg-primary/6 px-4 py-3" data-feedback-reply>
                    <p class="text-sm font-semibold text-ink-primary">From the TTV team</p>
                    {item.response && (
                      <p class="mt-1 whitespace-pre-wrap break-words text-sm leading-relaxed text-ink-primary">{item.response}</p>
                    )}
                    {item.resolutionUrl && (
                      <p class="mt-2 text-sm">
                        <a href={item.resolutionUrl} target="_blank" rel="noopener noreferrer" class={linkClass()}>
                          See the change
                        </a>
                      </p>
                    )}
                  </div>
                )}
              </Card>
            </li>
          ))}
        </ol>
      )
    }
  </div>
</SpacePage>
