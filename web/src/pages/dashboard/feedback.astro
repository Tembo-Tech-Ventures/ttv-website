---
/**
 * The student's own feedback and what happened to it. Not in the sidebar:
 * students reach it from the feedback form, which is where the question
 * "did anyone read that?" comes up.
 */
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import Card from "@/components/common/Card.astro";
import { env } from "cloudflare:workers";
import { listFeedbackForUser } from "@/lib/feedback/store";
import { feedbackAttachmentPath } from "@/lib/feedback/api";
import { FEEDBACK_KIND_LABELS, feedbackPagePath } from "@/lib/feedback/model";
import FeedbackStatusPill from "@/components/feedback/FeedbackStatusPill.astro";
import { OPEN_FEEDBACK_ATTRIBUTE } from "@/components/feedback/feedback-client";

const user = Astro.locals.user!;
const items = await listFeedbackForUser(env.DB, user.id);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  });
const openFeedback = { [OPEN_FEEDBACK_ATTRIBUTE]: "" };
---

<DashboardLayout title="Your feedback">
  <div class="mx-auto max-w-3xl space-y-6">
    <header class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold text-white">Your feedback</h2>
        <p class="mt-1 text-sm text-ink-secondary">
          Everything you've sent, where it stands, and any reply from the team.
        </p>
      </div>
      <button
        type="button"
        {...openFeedback}
        class="rounded-md bg-primary px-4 py-2 text-sm font-semibold text-dark hover:bg-primary/90"
      >
        Send feedback
      </button>
    </header>

    {
      items.length === 0 ? (
        <Card>
          <p class="text-ink-secondary">
            Nothing yet. Whenever something is broken, confusing, or could be
            better, use the Feedback button in the corner of any page. A
            sentence or a screenshot is plenty.
          </p>
        </Card>
      ) : (
        <ol class="space-y-4" data-testid="feedback-history">
          {items.map((item) => (
            <li id={`feedback-${item.id}`}>
              <Card>
                <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                  <FeedbackStatusPill status={item.status} />
                  <span class="text-sm font-medium text-ink-primary">
                    {FEEDBACK_KIND_LABELS[item.kind]}
                  </span>
                  <span class="text-sm text-ink-muted">
                    {formatDate(item.createdAt)} · on {feedbackPagePath(item.pageUrl)}
                  </span>
                </div>

                {item.message && (
                  <p class="mt-3 whitespace-pre-wrap break-words text-sm leading-relaxed text-ink-secondary">{item.message}</p>
                )}

                {item.attachments.length > 0 && (
                  <ul class="mt-3 flex flex-wrap gap-2" aria-label="Your screenshots">
                    {item.attachments.map((attachment, index) => (
                      <li>
                        <a
                          href={feedbackAttachmentPath(attachment.id)}
                          target="_blank"
                          rel="noopener"
                          class="block overflow-hidden rounded-md border border-rule hover:border-primary"
                        >
                          <img
                            src={feedbackAttachmentPath(attachment.id)}
                            alt={`Screenshot ${index + 1}`}
                            loading="lazy"
                            class="h-20 w-28 object-cover object-top"
                          />
                        </a>
                      </li>
                    ))}
                  </ul>
                )}

                {(item.response || item.resolutionUrl) && (
                  <div class="mt-4 rounded-md border-l-2 border-primary bg-primary/[0.06] px-4 py-3">
                    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-primary">
                      From the TTV team
                    </p>
                    {item.response && (
                      <p class="mt-1 whitespace-pre-wrap break-words text-sm leading-relaxed text-ink-primary">{item.response}</p>
                    )}
                    {item.resolutionUrl && (
                      <a
                        href={item.resolutionUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mt-2 inline-block text-sm text-primary underline-offset-4 hover:underline"
                      >
                        See the change
                      </a>
                    )}
                  </div>
                )}
              </Card>
            </li>
          ))}
        </ol>
      )
    }
  </div>
</DashboardLayout>
