---
/**
 * Writing: the builder's blog posts, drafts first, then published and suspended ones. Writing opens
 * with a published profile; until then the page says what opens it. Read-only: the editor is
 * /dashboard/me/writing/new and /dashboard/me/writing/[id].
 */
import SpacePage from "@/components/platform/spaces/SpacePage.astro";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";
import { SPACE_PAGE_PATHS } from "@/components/platform/spaces/sidebar";
import { ButtonLink, Card, EmptyState, PageTitle, RowAction, StatusChip, linkClass } from "@/components/platform/ui";
import { drizzle } from "drizzle-orm/d1";
import * as schema from "@/lib/db/schema";
import { and, desc, eq, inArray } from "drizzle-orm";
import { env } from "cloudflare:workers";
import { formatMomentDate } from "@/lib/display-date";

const user = Astro.locals.user!;
const db = drizzle(env.DB, { schema });
/** The person's published profile, as a subquery: its posts are read beside it. */
const publishedProfile = db.select({ id: schema.studentProfile.id }).from(schema.studentProfile)
  .where(and(eq(schema.studentProfile.userId, user.id), eq(schema.studentProfile.status, "PUBLISHED")));

// The profile, its posts (only while it is published) and the space context: one round trip.
const [profile, posts, spaces] = await Promise.all([
  db.query.studentProfile.findFirst({
    where: eq(schema.studentProfile.userId, user.id),
    columns: { id: true, status: true, handle: true },
  }),
  db.query.blogPost.findMany({
    where: inArray(schema.blogPost.profileId, publishedProfile),
    orderBy: [desc(schema.blogPost.updatedAt)],
    columns: { id: true, title: true, slug: true, status: true, readingMinutes: true, publishedAt: true, updatedAt: true },
  }),
  resolveSpacePage(Astro.locals, "writing"),
]);

const hasPublishedProfile = profile?.status === "PUBLISHED";
const base = SPACE_PAGE_PATHS.writing;
const profilePath = SPACE_PAGE_PATHS.portfolio;
const listed = hasPublishedProfile ? posts : [];
const sections = [
  { key: "drafts", title: "Drafts", posts: listed.filter((post) => post.status === "DRAFT") },
  { key: "published", title: "Published", posts: listed.filter((post) => post.status === "PUBLISHED") },
  { key: "suspended", title: "Suspended", posts: listed.filter((post) => post.status === "SUSPENDED") },
].filter((section) => section.posts.length > 0);

const detail = (post: (typeof posts)[number]) =>
  post.status === "PUBLISHED"
    ? `Published ${post.publishedAt ? formatMomentDate(post.publishedAt) : ""} · ${post.readingMinutes} min read`
    : post.status === "SUSPENDED"
      ? "Suspended by the TTV team"
      : `Updated ${formatMomentDate(post.updatedAt)} · ${post.readingMinutes} min read`;
---

<SpacePage context={spaces} title="Writing">
  <div class="max-w-3xl space-y-8">
    <header class="flex flex-wrap items-end justify-between gap-4">
      <div class="min-w-0 basis-80 grow">
        <PageTitle>Writing</PageTitle>
        <p class="mt-3 text-base leading-relaxed text-ink-secondary">Write and publish posts to the TTV blog.</p>
      </div>
      {listed.length > 0 && <ButtonLink href={`${base}/new`} variant="primary" size="lg">New post</ButtonLink>}
    </header>

    {!hasPublishedProfile && (
      <EmptyState title={profile ? "Your profile isn't published yet" : "Writing opens with a published profile"} headingLevel={2}>
        {!profile
          ? "Complete a cohort and publish your builder profile. Once it's live, you can write posts here."
          : profile.status === "SUSPENDED"
            ? "Your profile is suspended, so writing is closed for now. Contact the TTV team for help."
            : "Your profile is still a draft. Writing opens once it's published."}
        <ButtonLink slot="action" href={profilePath}>Go to your profile</ButtonLink>
      </EmptyState>
    )}

    {hasPublishedProfile && listed.length === 0 && (
      <EmptyState title="No posts yet" headingLevel={2}>
        Share what you've learned, what you're building, or what caught your attention.
        <ButtonLink slot="action" href={`${base}/new`} variant="primary">Start writing</ButtonLink>
      </EmptyState>
    )}

    {sections.map((section) => (
      <section aria-labelledby={`writing-${section.key}`} data-writing-section={section.key}>
        <h2 id={`writing-${section.key}`} class="font-body text-lg leading-snug font-bold text-ink-primary">{section.title}</h2>
        <ul class="mt-3 space-y-3">
          {section.posts.map((post) => {
            const title = post.title || "Untitled";
            return (
              <li>
                <Card>
                  <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
                    <div class="min-w-0 basis-60 grow">
                      <h3 class="text-base leading-snug font-semibold break-words text-ink-primary">{title}</h3>
                      <p class="mt-0.5 text-sm text-ink-muted">{detail(post)}</p>
                      {post.status === "PUBLISHED" && profile?.handle && (
                        <p class="mt-1 text-sm break-all">
                          <a href={`/blog/${profile.handle}/${post.slug}`} target="_blank" rel="noopener noreferrer" class={linkClass()}>
                            View live<span class="sr-only"> (opens in a new tab)</span>
                          </a>
                          <span class="text-ink-muted"> · /blog/{profile.handle}/{post.slug}</span>
                        </p>
                      )}
                    </div>
                    <div class="flex shrink-0 items-center gap-3">
                      <StatusChip domain="post" status={post.status} />
                      <RowAction href={`${base}/${post.id}`} row={title}>{post.status === "DRAFT" ? "Edit" : "Open"}</RowAction>
                    </div>
                  </div>
                </Card>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>
</SpacePage>
