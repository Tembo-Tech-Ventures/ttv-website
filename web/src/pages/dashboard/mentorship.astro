---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CommunityApp from "@/components/community/CommunityApp";
import SpacePage from "@/components/platform/spaces/SpacePage.astro";
import MentoringOverview from "@/components/platform/spaces/MentoringOverview.astro";
import OnboardingNotices from "@/components/platform/onboarding/OnboardingNotices.astro";
import OnboardingPrompt from "@/components/platform/onboarding/OnboardingPrompt.astro";
import { awaitingConfirmation } from "@/components/platform/spaces/awaiting-confirmation";
import { pickSpace, resolveSpacePage, resolveSpacePageWith } from "@/components/platform/spaces/space-page";
import { loadChannelShortcuts } from "@/components/platform/spaces/channel-shortcuts-server";
import { normalizeSpacePath, SPACE_PATHS } from "@/lib/platform/server/space-routes";
import { env } from "cloudflare:workers";
import { mentorRequestsOpen } from "@/components/platform/mentors/mentor-display";
import { loadMentoringOverview } from "@/components/platform/mentors/overview";
// oxlint-disable-next-line import/no-unassigned-import -- Workspace stylesheet.
import "@/styles/discovery.css";

// B-1.2 serves this page at /dashboard/mentoring (the space's landing) and at
// /dashboard/mentoring/confirm (the review). Admins who are not mentors keep
// the review, in their Admin space, without becoming mentors.
const atLanding = normalizeSpacePath(Astro.originPathname) === SPACE_PATHS.mentoring;
// The landing's own reads start beside onboarding (PERF-2): the channel list for its "Channels" card
// (QA2-16), handed on to SpacePage, and requests and availability while mentor requests are open (U-4.1).
const landing = atLanding
  ? await resolveSpacePageWith(Astro.locals, "mentoring", (me) => Promise.all([
    loadChannelShortcuts({ me, space: pickSpace(me, "mentoring")!, page: "mentoring" }),
    mentorRequestsOpen(me) ? loadMentoringOverview(Astro, env, me) : null,
  ]))
  : null;
const spaces = landing?.[0] ?? (await resolveSpacePage(Astro.locals, "confirm"));
const [shortcuts, requests] = landing?.[1] ?? [null, null];
---
{
  spaces?.page === "mentoring" ? (
    <SpacePage context={spaces} title="Mentoring" channels={shortcuts?.channels}>
      <MentoringOverview awaiting={awaitingConfirmation(spaces.me)} shortcuts={shortcuts?.shortcuts ?? null} requests={requests}>
        {/* The status cards follow the page's title, so its h1 comes first. */}
        <Fragment slot="after-title">
          {spaces.onboarding && <OnboardingNotices view={spaces.onboarding} space={spaces.space} class="mt-8" />}
        </Fragment>
        <OnboardingPrompt slot="after-primary" view={spaces.onboarding} space={spaces.space} class="mt-6" />
      </MentoringOverview>
    </SpacePage>
  ) : spaces ? (
    <SpacePage context={spaces} title={spaces.space === "admin" ? "Mentor review" : "Confirm work"}>
      <CommunityApp client:load view="mentor" embedded />
    </SpacePage>
  ) : (
    <BaseLayout title="Review community contributions | TTV" noIndex>
      <CommunityApp client:load view="mentor" />
    </BaseLayout>
  )
}
