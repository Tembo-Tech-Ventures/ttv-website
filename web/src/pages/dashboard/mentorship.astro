---
import SpacePage from "@/components/platform/spaces/SpacePage.astro";
import MentoringOverview from "@/components/platform/spaces/MentoringOverview.astro";
import OnboardingNotices from "@/components/platform/onboarding/OnboardingNotices.astro";
import OnboardingPrompt from "@/components/platform/onboarding/OnboardingPrompt.astro";
import { awaitingConfirmation } from "@/components/platform/spaces/awaiting-confirmation";
import { pickSpace, resolveSpacePage, resolveSpacePageWith } from "@/components/platform/spaces/space-page";
import { loadChannelShortcuts } from "@/components/platform/spaces/channel-shortcuts-server";
import { normalizeSpacePath, SPACE_PATHS } from "@/lib/platform/server/space-routes";
import { env } from "cloudflare:workers";
import { mentorRequestsOpen } from "@/components/platform/mentors/mentor-display";
import { loadMentoringOverview } from "@/components/platform/mentors/overview";
import ConfirmWork from "@/components/platform/mentors/ConfirmWork.astro";
import { loadMentorship, readConfirmPost, runConfirmPost, type ConfirmOutcome } from "@/components/platform/mentors/confirm-state";
import { PageHeader, Notice } from "@/components/platform/ui";
import { communityFetch } from "@/lib/community/in-process";
import { redirectWithFlash, takeFlash } from "@/lib/platform/server/flash";
import { SPACE_PAGE_PATHS } from "@/components/platform/spaces/sidebar";
import { UiApiError } from "@/components/discovery/ui-errors";

// B-1.2 serves this page at /dashboard/mentoring (the space's landing) and at
// /dashboard/mentoring/confirm (the review). Admins who are not mentors keep
// the review, in their Admin space, without becoming mentors.
const atLanding = normalizeSpacePath(Astro.originPathname) === SPACE_PATHS.mentoring;
// The landing's own reads start beside onboarding (PERF-2): the channel list for its "Channels" card
// (QA2-16), handed on to SpacePage, and requests and availability while mentor requests are open (U-4.1).
const landing = atLanding
  ? await resolveSpacePageWith(Astro.locals, "mentoring", (me) => Promise.all([
    loadChannelShortcuts({ me, space: pickSpace(me, "mentoring")!, page: "mentoring" }),
    mentorRequestsOpen(me) ? loadMentoringOverview(Astro, env, me) : null,
  ]))
  : null;
const [shortcuts, requests] = landing?.[1] ?? [null, null];

// Confirm work (/dashboard/mentoring/confirm), on the kit with no island (style-guide rollout M17, D5): the
// mentor's list is read through the community API's own handler, in process, beside the space context; each
// action is a POST here, answered with a 303 and a flash, or a refusal that keeps what the mentor wrote.
const fetcher = atLanding ? null : communityFetch(Astro.request, Astro.locals, env);
let outcome: ConfirmOutcome | null = null;
if (fetcher && Astro.request.method === "POST") {
  const post = readConfirmPost(await Astro.request.formData().catch(() => new FormData()));
  outcome = post
    ? await runConfirmPost(post, fetcher)
    : { ok: false, status: 400, title: "That form didn't arrive whole", detail: "Try again from the contribution.", kept: null };
  if (outcome.ok) return redirectWithFlash(Astro, SPACE_PAGE_PATHS.confirm, outcome.flash);
  Astro.response.status = outcome.status;
}
const confirmReads = fetcher
  ? await Promise.all([
    resolveSpacePage(Astro.locals, "confirm"),
    loadMentorship(fetcher).then((list) => ({ list, failed: null as number | null }), (failure: unknown) => ({
      list: [],
      failed: failure instanceof UiApiError ? failure.status : 503,
    })),
  ])
  : null;
const spaces = landing?.[0] ?? confirmReads?.[0] ?? null;
const contributions = confirmReads?.[1] ?? null;
if (contributions?.failed && !outcome) Astro.response.status = contributions.failed === 403 ? 403 : 503;
const refused = outcome && !outcome.ok ? outcome : null;
// A POST never carries a flash, and a refused one says what went wrong instead.
const flash = fetcher && Astro.request.method === "GET" ? takeFlash(Astro) : null;
const confirmTitle = spaces?.space === "admin" ? "Mentor review" : "Confirm work";
---
{
  spaces?.page === "mentoring" ? (
    <SpacePage context={spaces} title="Mentoring" channels={shortcuts?.channels}>
      <MentoringOverview awaiting={awaitingConfirmation(spaces.me)} shortcuts={shortcuts?.shortcuts ?? null} requests={requests}>
        {/* The status cards follow the page's title, so its h1 comes first. */}
        <Fragment slot="after-title">
          {spaces.onboarding && <OnboardingNotices view={spaces.onboarding} space={spaces.space} class="mt-8" />}
        </Fragment>
        <OnboardingPrompt slot="after-primary" view={spaces.onboarding} space={spaces.space} class="mt-6" />
      </MentoringOverview>
    </SpacePage>
  ) : (
    <SpacePage context={spaces} title={confirmTitle} titlePrefix={Astro.response.status >= 400 ? "Error: " : ""}>
      <div class="flex max-w-4xl flex-col gap-8">
        <PageHeader title={confirmTitle} />
        {flash && <Notice tone={flash.tone} title={flash.title}>{flash.message}</Notice>}
        {refused && (
          <Notice tone="danger" focusOnLoad id="confirm-failure" title={refused.title}>{refused.detail}</Notice>
        )}
        {contributions?.failed === 403 ? (
          <Notice tone="info" title="Mentor access needs approval">
            An administrator approves mentor access. Ask for it from your Account page.
          </Notice>
        ) : contributions?.failed ? (
          <Notice tone="danger" title="Shared work didn't load">Please try again in a moment.</Notice>
        ) : (
          <ConfirmWork requests={contributions?.list ?? []} kept={refused?.kept ?? null} />
        )}
      </div>
    </SpacePage>
  )
}
