---
/**
 * Cohort → Sessions → one session: its title, then the player and the transcript beside it. Each
 * transcript line links to `?t=`, which the player starts from.
 */
import SpacePage from "@/components/platform/spaces/SpacePage.astro";
import { resolveSpacePageWith } from "@/components/platform/spaces/space-page";
import { SPACE_PAGE_PATHS } from "@/components/platform/spaces/sidebar";
import { BackLink, EmptyState, PageTitle, StatusChip } from "@/components/platform/ui";
import SessionViewer from "@/components/recordings/SessionViewer";
import { requestCapabilities } from "@/lib/platform/server/request-capabilities";
import { parseTimestampParam } from "@/lib/recordings/time-utils";
import { programAccessible } from "@/lib/recordings/access";
import { drizzle } from "drizzle-orm/d1";
import { eq } from "drizzle-orm";
import * as schema from "@/lib/db/schema";
import { env } from "cloudflare:workers";

const user = Astro.locals.user!;
const db = drizzle(env.DB, { schema });
const { id } = Astro.params;
const sessionsHref = SPACE_PAGE_PATHS.sessions;
if (!id) return Astro.redirect(sessionsHref);

// The recording and the person's cohorts (read once per request, shared with the space context)
// start together, beside the space context rather than after it.
const reads = Promise.all([
  db.query.recording.findFirst({
    where: eq(schema.recording.id, id),
    with: { segments: { orderBy: (segment, { asc }) => [asc(segment.startTime)] } },
  }),
  requestCapabilities(db, Astro.locals),
]);
const resolved = await resolveSpacePageWith(Astro.locals, "sessions", () => reads);
const spaces = resolved?.[0] ?? null;
// Without the spaces shell (a token, or a context that failed to load) the page still checks access.
const [recording, capabilities] = resolved?.[1] ?? await reads;

if (!recording || !programAccessible(capabilities.cohortIds, user.id, recording.programId)) {
  return Astro.redirect(sessionsHref);
}

const ready = recording.processingStatus === "complete";
const failed = recording.processingStatus === "failed";
const initialTime = parseTimestampParam(Astro.url.searchParams.get("t"));
// The video's accessible name is the page's h1.
const TITLE_ID = "session-title";
---

<SpacePage context={spaces} title={recording.title}>
  <div class="flex flex-col gap-6">
    <div class="flex flex-col items-start gap-3">
      <BackLink href={sessionsHref}>Sessions</BackLink>
      <PageTitle id={TITLE_ID}>{recording.title}</PageTitle>
      {ready ? (
        <p class="m-0 max-w-prose text-[0.9375rem] leading-relaxed text-ink-secondary">
          Use the transcript to jump to a moment in the session.
        </p>
      ) : (
        <StatusChip domain="recording" status={recording.processingStatus} />
      )}
    </div>

    {ready ? (
      <SessionViewer
        client:load
        labelledBy={TITLE_ID}
        videoUrl={`/api/recordings/${recording.id}/video`}
        initialTime={initialTime}
        segments={recording.segments.map((segment) => ({
          id: segment.id,
          startTime: segment.startTime,
          endTime: segment.endTime,
          text: segment.text,
          speaker: segment.speaker,
        }))}
      />
    ) : failed ? (
      <EmptyState title="This recording couldn't be processed" headingLevel={2}>
        Its video and transcript aren't available. Ask your instructor if you need this session.
      </EmptyState>
    ) : (
      <EmptyState title="Not ready to watch yet" headingLevel={2}>
        This recording is still being processed. Check back once the transcript is ready.
      </EmptyState>
    )}
  </div>
</SpacePage>
