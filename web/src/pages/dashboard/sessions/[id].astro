---
import SpacePage from "@/components/platform/spaces/SpacePage.astro";
import PageTitle from "@/components/platform/spaces/PageTitle.astro";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";
import { SPACE_PAGE_PATHS } from "@/components/platform/spaces/sidebar";
import Card from "@/components/common/Card.astro";
import SessionViewer from "@/components/recordings/SessionViewer";
import ProcessingStatus from "@/components/recordings/ProcessingStatus.astro";
import { parseTimestampParam } from "@/lib/recordings/time-utils";
import { userCanAccessProgram } from "@/lib/recordings/access";
import { drizzle } from "drizzle-orm/d1";
import { eq } from "drizzle-orm";
import * as schema from "@/lib/db/schema";
import { env } from "cloudflare:workers";

const user = Astro.locals.user!;
const db = drizzle(env.DB, { schema });
const { id } = Astro.params;
const spaces = await resolveSpacePage(Astro.locals, "sessions");
// In the shell, go straight to the list's space path instead of through its redirect.
const sessionsHref = spaces ? SPACE_PAGE_PATHS.sessions : "/dashboard/sessions";
if (!id) return Astro.redirect(sessionsHref);

const recording = await db.query.recording.findFirst({
  where: eq(schema.recording.id, id),
  with: {
    program: true,
    segments: {
      orderBy: (segment, { asc }) => [asc(segment.startTime)],
    },
  },
});

if (!recording) return Astro.redirect(sessionsHref);
const hasAccess = await userCanAccessProgram(db, user.id, recording.programId);
if (!hasAccess) return Astro.redirect(sessionsHref);

const initialTime = parseTimestampParam(Astro.url.searchParams.get("t"));
---

<SpacePage context={spaces} title={recording.title}>
  <div class="space-y-6">
    <a href={sessionsHref} class="text-sm text-primary hover:underline">
      &larr; Back to Sessions
    </a>

    {recording.processingStatus !== "complete" ? (
      <Card>
        <div class="space-y-3 py-8 text-center">
          <ProcessingStatus status={recording.processingStatus} />
          <PageTitle spaces={Boolean(spaces)} size="card" legacyClass="text-xl font-semibold text-white">{recording.title}</PageTitle>
          <p class="text-ink-muted">
            This recording is still being processed. Check back once the transcript is ready.
          </p>
        </div>
      </Card>
    ) : (
      <SessionViewer
        client:load
        title={recording.title}
        titleAs={spaces ? "h1" : "h2"}
        videoUrl={`/api/recordings/${recording.id}/video`}
        initialTime={initialTime}
        segments={recording.segments.map((segment) => ({
          id: segment.id,
          startTime: segment.startTime,
          endTime: segment.endTime,
          text: segment.text,
          speaker: segment.speaker,
        }))}
      />
    )}
  </div>
</SpacePage>
