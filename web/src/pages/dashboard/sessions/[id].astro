---
/**
 * Cohort → Sessions → one session: its title, then the player and the transcript beside it. Each
 * transcript line links to `?t=`, which the player starts from. The player shows whenever the video
 * is stored, the transcript once processing is complete. A recording that is missing and one the
 * recording access policy refuses are the same 404.
 *
 * While `meetings` is on for them, the cohort's hosts (its instructors and TAs) and admins can hide a
 * cohort's recording from the cohort, behind a confirm step, and show it again (in-app calls P9, UX
 * review M9; src/lib/recordings/README.md, "Hiding a recording"). Plain forms, so it works without
 * JavaScript. A POST from anyone else, or from another site, is the same 404.
 */
import SpacePage from "@/components/platform/spaces/SpacePage.astro";
import { resolveSpacePageWith } from "@/components/platform/spaces/space-page";
import { SPACE_PAGE_PATHS } from "@/components/platform/spaces/sidebar";
import {
  BackLink, Button, ButtonLink, ConfirmStep, EmptyState, Notice, PageTitle, StatusChip, confirmHref, confirmingAction, withoutConfirm,
} from "@/components/platform/ui";
import SessionViewer from "@/components/recordings/SessionViewer";
import { requestCapabilities } from "@/lib/platform/server/request-capabilities";
import { parseTimestampParam } from "@/lib/recordings/time-utils";
import { recordingAccessFor, transcriptReady } from "@/lib/recordings/access";
import { mayHideRecording, setRecordingHidden } from "@/lib/recordings/hiding";
import { hasMatchingRequestOrigin } from "@/lib/admin/mutation-security";
import { redirectWithFlash, takeFlash } from "@/lib/platform/server/flash";
import { drizzle } from "drizzle-orm/d1";
import { eq } from "drizzle-orm";
import * as schema from "@/lib/db/schema";
import { env } from "cloudflare:workers";

const user = Astro.locals.user!;
const db = drizzle(env.DB, { schema });
const { id } = Astro.params;
const sessionsHref = SPACE_PAGE_PATHS.sessions;
const notFound = () => new Response("Not found.", { status: 404, headers: { "Cache-Control": "no-store", Vary: "Cookie" } });
if (!id) return notFound();

// The recording and the person's cohorts (read once per request, shared with the space context)
// start together, beside the space context rather than after it.
const reads = Promise.all([
  db.query.recording.findFirst({
    where: eq(schema.recording.id, id),
    with: { segments: { orderBy: (segment, { asc }) => [asc(segment.startTime)] }, program: { columns: { name: true } } },
  }),
  requestCapabilities(db, Astro.locals),
]);
let meetings = false;
const resolved = await resolveSpacePageWith(Astro.locals, "sessions", (me) => {
  meetings = me.flags.meetings;
  return reads;
});
const spaces = resolved?.[0] ?? null;
// Without the spaces shell (a token, or a context that failed to load) the page still checks access.
const [recording, capabilities] = resolved?.[1] ?? await reads;

if (!recording || !recordingAccessFor(capabilities, recording, { userId: user.id })) return notFound();

// Hiding it from the cohort, or showing it again: for its hosts and admins, while `meetings` is on for them.
const canHide = meetings && mayHideRecording(capabilities, recording);
const pagePath = `${sessionsHref}/${encodeURIComponent(recording.id)}`;
// The browser's address is the space path, whatever path the router rendered this page at.
const pageUrl = new URL(`${pagePath}${Astro.url.search}`, Astro.url);
if (Astro.request.method === "POST") {
  if (!canHide || !hasMatchingRequestOrigin(Astro.request)) return notFound();
  const intent = (await Astro.request.formData()).get("intent");
  if (intent !== "hide" && intent !== "show") return notFound();
  const hide = intent === "hide";
  if (!await setRecordingHidden(env.DB, recording.id, hide, Date.now())) return notFound();
  const cohort = recording.program?.name.trim() || "The cohort";
  return redirectWithFlash(Astro, pagePath, hide
    ? { tone: "success", title: "Hidden from the cohort", message: `${cohort} can't watch it or read its transcript now. You can show it again here.` }
    : { tone: "success", title: "Shown to the cohort again", message: `${cohort} can watch it and read its transcript again.` });
}
if (Astro.request.method !== "GET" && Astro.request.method !== "HEAD") return notFound();
const confirming = canHide && !recording.hiddenAt ? confirmingAction(pageUrl, ["hide"] as const) : null;
const flash = canHide ? takeFlash(Astro) : null;
const cohortLabel = recording.program?.name.trim() || "The cohort";

const ready = transcriptReady(recording);
// A complete transcript without a stored video keeps its lines; the player then says it can't play.
const viewable = recording.r2VideoKey !== null || ready;
const failed = recording.processingStatus === "failed";
const initialTime = parseTimestampParam(Astro.url.searchParams.get("t"));
// The video's accessible name is the page's h1.
const TITLE_ID = "session-title";
---

<SpacePage context={spaces} title={recording.title}>
  <div class="flex flex-col gap-6">
    <div class="flex flex-col items-start gap-3">
      <BackLink href={sessionsHref}>Sessions</BackLink>
      <PageTitle id={TITLE_ID}>{recording.title}</PageTitle>
      {ready ? (
        <p class="m-0 max-w-prose text-[0.9375rem] leading-relaxed text-ink-secondary">
          Use the transcript to jump to a moment in the session.
        </p>
      ) : (
        <StatusChip domain="recording" status={recording.processingStatus} />
      )}
    </div>

    {flash ? <Notice tone={flash.tone} title={flash.title} announce="polite">{flash.message}</Notice> : null}
    {confirming === "hide" ? (
      <ConfirmStep
        title={`Hide “${recording.title}” from ${cohortLabel}?`}
        confirmLabel="Hide from the cohort"
        cancelHref={withoutConfirm(pageUrl)}
        fields={{ intent: "hide" }}
      >
        {cohortLabel} can't watch it, read its transcript, find it in search or ask Tembo about it, and its card in the cohort's
        channel says it isn't available. You, the cohort's other instructors and TAs, and admins still can. You can show it again
        here at any time.
      </ConfirmStep>
    ) : canHide && recording.hiddenAt ? (
      <Notice tone="warning" title="Hidden from the cohort">
        Only the cohort's instructors and TAs, and admins, can watch it or read its transcript.
        <form method="post" class="mt-3">
          <input type="hidden" name="intent" value="show" />
          <Button type="submit" variant="quiet" size="sm">Show to the cohort</Button>
        </form>
      </Notice>
    ) : canHide ? (
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-ink-secondary" data-hide-recording>
        <p class="m-0 max-w-prose">The cohort's instructors and TAs, and admins, can hide a recording from the cohort and show it again.</p>
        <ButtonLink variant="ghost" size="sm" href={confirmHref(pageUrl, "hide")}>Hide from the cohort</ButtonLink>
      </div>
    ) : null}

    {viewable ? (
      <SessionViewer
        client:load
        labelledBy={TITLE_ID}
        videoUrl={`/api/recordings/${recording.id}/video`}
        initialTime={initialTime}
        segments={ready ? recording.segments.map((segment) => ({
          id: segment.id,
          startTime: segment.startTime,
          endTime: segment.endTime,
          text: segment.text,
          speaker: segment.speaker,
        })) : []}
      />
    ) : failed ? (
      <EmptyState title="This recording couldn't be processed" headingLevel={2}>
        Its video and transcript aren't available. Ask your instructor if you need this session.
      </EmptyState>
    ) : (
      <EmptyState title="Not ready to watch yet" headingLevel={2}>
        This recording is still being processed. Check back once the transcript is ready.
      </EmptyState>
    )}
  </div>
</SpacePage>
