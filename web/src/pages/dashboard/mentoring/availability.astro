---
/**
 * Mentoring → Availability (U-4.1): the headline, areas, formats, monthly
 * capacity and pause members' directory reads. It exists only while
 * `mentor_requests` is on for the person and they hold the Mentoring space.
 * A plain form that posts here and saves through the API's own handler
 * (availability-post.ts), so it reads and saves without JavaScript.
 */
import { env } from "cloudflare:workers";
import SpacePage from "@/components/platform/spaces/SpacePage.astro";
import { resolveSpacePageWith } from "@/components/platform/spaces/space-page";
import MentorPageIntro from "@/components/platform/mentors/MentorPageIntro.astro";
import AvailabilityForm from "@/components/platform/mentors/AvailabilityForm.astro";
import { handleAvailabilityPost, valuesOf, type AvailabilityPostResult } from "@/components/platform/mentors/availability-post";
import { MENTOR_AVAILABILITY_PATH, mentorRequestsOpen } from "@/components/platform/mentors/mentor-display";
import { mentorPageResponse } from "@/components/platform/mentors/page-responses";
import { mentorsServer } from "@/components/platform/mentors/server";

const { method } = Astro.request;
const allowed = method === "GET" || method === "HEAD" || method === "POST";
const now = Date.now();
// The saved availability is read beside onboarding, once `mentor_requests` is known to be on (PERF-2).
// A POST reads it after its save instead, so the listing says what the save left.
const resolved = await resolveSpacePageWith(Astro.locals, "mentorAvailability", (me) =>
  mentorRequestsOpen(me) && allowed && method !== "POST" ? mentorsServer(Astro, env, me, now).availability() : Promise.resolve(null));
if (!resolved) return mentorPageResponse(404);
const [context, early] = resolved;
if (context.space !== "mentoring" || !mentorRequestsOpen(context.me)) return mentorPageResponse(404);
if (!allowed) return mentorPageResponse(405);
const server = mentorsServer(Astro, env, context.me, now);

let posted: Extract<AvailabilityPostResult, { kind: "render" }> | null = null;
if (method === "POST") {
  const result = await handleAvailabilityPost(Astro.request, (body) => server.saveAvailability(body));
  if (result.kind === "saved") return mentorPageResponse(303, { Location: `${MENTOR_AVAILABILITY_PATH}?saved=1` });
  if (result.kind === "refuse") return mentorPageResponse(result.status);
  posted = result;
  Astro.response.status = result.status;
}

const saved = early ?? await server.availability();
const justSaved = !posted && Astro.url.searchParams.get("saved") === "1";
Astro.response.headers.set("Cache-Control", "no-store");
---

<SpacePage context={context} title="Availability" titlePrefix={posted ? "Error: " : ""}>
  <MentorPageIntro page="availability" />
  <AvailabilityForm
    saved={saved}
    values={posted?.values ?? valuesOf(saved)}
    errors={posted?.errors}
    failure={posted?.failure}
    justSaved={justSaved}
    now={now}
  />
</SpacePage>
