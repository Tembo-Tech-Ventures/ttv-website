---
/**
 * Mentoring → Requests (U-4.1, screen 06): the people asking for this
 * mentor's time, with the work attached; accept, suggest another mentor or
 * "Not this month"; and this month's spots. It exists only while
 * `mentor_requests` is on for the person and they hold the Mentoring space.
 * The rail ends with "Worth another look" (B-4.2) when confirmed work has a
 * newer revision.
 * The list reads without JavaScript; answering needs it.
 */
import { env } from "cloudflare:workers";
import SpacePage from "@/components/platform/spaces/SpacePage.astro";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";
import MentorPageIntro from "@/components/platform/mentors/MentorPageIntro.astro";
import MentorRequestsQueue from "@/components/platform/mentors/MentorRequestsQueue";
import { mentorRequestsOpen } from "@/components/platform/mentors/mentor-display";
import { mentorPageResponse } from "@/components/platform/mentors/page-responses";
import { mentorsServer } from "@/components/platform/mentors/server";
import { recordError } from "@/lib/observability/errors";

const context = await resolveSpacePage(Astro.locals, "mentorRequests");
if (!context || context.space !== "mentoring" || !mentorRequestsOpen(context.me)) return mentorPageResponse(404);
if (Astro.request.method !== "GET" && Astro.request.method !== "HEAD") return mentorPageResponse(405, { Allow: "GET, HEAD" });

const now = Date.now();
const server = mentorsServer(Astro, env, context.me, now);
const [initial, mentors, availability, anotherLook] = await Promise.all([
  server.requests({ as: "mentor" }),
  server.directory({}),
  server.availability(),
  // "Worth another look" is a pointer, not the page: when it can't be read, the rail leaves it out.
  server.anotherLook().catch(async (error: unknown) => {
    await recordError(env.DB, { source: "request", route: "/dashboard/mentoring/requests", error, level: "warning" });
    return null;
  }),
]);
Astro.response.headers.set("Cache-Control", "no-store");
---

<SpacePage context={context} title="Requests">
  <MentorPageIntro page="requests" />
  <MentorRequestsQueue client:load initial={initial} mentors={mentors.items} availability={availability} anotherLook={anotherLook} now={now} />
</SpacePage>
