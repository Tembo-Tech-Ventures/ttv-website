---
/**
 * Everything that needs you, across your spaces (U-1.3). The phone's way into
 * attention (the bell leads here below the wide layout), and a full-page inbox
 * on any screen. It sits in the space you were last in, without a sidebar,
 * and belongs to none of them: the phone's bar marks no space current (T12).
 *
 * Dark until the `spaces` flag is on for the person: with it off (or for a
 * personal access token) this route is a 404, as if it did not exist. The
 * first page of items is read here, so the list is there without JavaScript.
 */
import { drizzle } from "drizzle-orm/d1";
import { env } from "cloudflare:workers";
import * as schema from "@/lib/db/schema";
import { listAttention } from "@/lib/attention/service";
import { capabilitiesFor } from "@/lib/platform/server/capabilities";
import { getSpaceContext } from "@/lib/platform/server/space-context";
import SpacesLayout from "@/layouts/SpacesLayout.astro";
import AttentionPage from "@/components/platform/attention/AttentionPage";
import { attentionPageData } from "@/components/platform/attention/attention-page-data";
import PlatformOverlays from "@/components/platform/overlays/PlatformOverlays";
import { cohortSearchLabel } from "@/components/platform/spaces/cohort-heading";
import { loadCohortHeading } from "@/components/platform/spaces/space-page";

const data = await attentionPageData({
  context: () => getSpaceContext(Astro),
  cookie: Astro.request.headers.get("cookie"),
  async list(me) {
    const db = drizzle(env.DB, { schema });
    return listAttention(db, me.user.id, { filter: "all" }, await capabilitiesFor(db, Astro.locals.user!));
  },
});
if (data.kind === "missing") return new Response(null, { status: 404 });
const { me, space, initialList } = data;
// Search names the person's one cohort here too, as on every space page (T07).
const cohortLabel = me.spaces.includes("cohort")
  ? cohortSearchLabel(me, await loadCohortHeading(drizzle(env.DB, { schema }), me).catch(() => null))
  : null;
---

<SpacesLayout me={me} space={space} outsideSpaces title="Attention" overlays={["search", "attention"]}>
  <AttentionPage client:load me={me} initialList={initialList} />
  <PlatformOverlays slot="overlays" client:load me={me} attention={false} cohortLabel={cohortLabel} />
</SpacesLayout>
