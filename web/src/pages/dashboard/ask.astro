---
/**
 * Ask AI.
 *
 * This is the one dashboard route that does not use `DashboardLayout`. A chat
 * needs the whole viewport — the shell's header and the page's own scrolling
 * pushed the composer off the bottom of a phone screen — so it uses
 * `ImmersiveLayout` and carries its own way back into the dashboard instead.
 * Auth is still enforced by middleware on `/dashboard/*`.
 */
import ImmersiveLayout from "@/layouts/ImmersiveLayout.astro";
import ChatApp from "@/components/chat/ChatApp";
import { drizzle } from "drizzle-orm/d1";
import { env } from "cloudflare:workers";
import * as schema from "@/lib/db/schema";
import { getStudentJourney } from "@/lib/student/journey";

const user = Astro.locals.user!;
const journey = await getStudentJourney(drizzle(env.DB, { schema }), user.id);
---

<ImmersiveLayout title="Ask AI | Tembo Tech Ventures">
  <ChatApp
    client:load
    visibleLinkIds={journey.visibleLinkIds}
    unreadLeadCount={journey.unreadLeadCount}
  />
</ImmersiveLayout>
