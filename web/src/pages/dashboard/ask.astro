---
/**
 * Ask Tembo privately: a private conversation with Tembo about the person's cohorts and sessions.
 * Named apart from a channel's "Ask Tembo here", which posts for the channel (QA3-03).
 *
 * A chat needs the whole viewport: the old dashboard shell's header and the
 * page's own scrolling pushed the composer off the bottom of a phone screen.
 * Without spaces it uses `ImmersiveLayout` and carries its own way back into
 * the dashboard. In the spaces shell it fills the sheet instead, and the shell
 * provides the way around. Auth is still enforced by middleware on
 * `/dashboard/*`; signing in is the only page requirement (B-1.2), and the
 * chat APIs decide what each person's questions can draw on.
 */
import { createCommunityService } from "@/lib/community/service";
import { hasDiscoveryAccess } from "@/lib/dashboard-presentation";
import ImmersiveLayout from "@/layouts/ImmersiveLayout.astro";
import ChatApp from "@/components/chat/ChatApp";
import SpacePage from "@/components/platform/spaces/SpacePage.astro";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";
import { drizzle } from "drizzle-orm/d1";
import { env } from "cloudflare:workers";
import * as schema from "@/lib/db/schema";
import { getStudentJourney } from "@/lib/student/journey";
import { capabilitiesFor } from "@/lib/platform/server/capabilities";
import { privateAskScope } from "@/lib/tembo/private-ask";

const user = Astro.locals.user!;
const spaces = await resolveSpacePage(Astro.locals, "ask");
const db = drizzle(env.DB, { schema });
const journey = await getStudentJourney(db, user.id);
// The scope /api/chat gives Tembo, said on the page (QA3-03).
const scope = privateAskScope(await capabilitiesFor(db, { id: user.id }));
const canDiscover = spaces ? false : hasDiscoveryAccess(await createCommunityService(env.DB, user.id, Astro.locals.stagingFixture, env.DEPLOYMENT_ENVIRONMENT).access());
---

{
  spaces ? (
    <SpacePage context={spaces} title="Ask Tembo privately" journey={journey} fill>
      <ChatApp client:load variant="space" scope={scope} />
    </SpacePage>
  ) : (
    <ImmersiveLayout title="Ask Tembo privately | Tembo Tech Ventures">
      <ChatApp
        client:load
        scope={scope}
        canDiscover={canDiscover}
        visibleLinkIds={journey.visibleLinkIds}
        unreadLeadCount={journey.unreadLeadCount}
      />
    </ImmersiveLayout>
  )
}
