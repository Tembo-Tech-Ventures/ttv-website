---
/**
 * Ask Tembo privately: a private conversation with Tembo about the person's cohorts and sessions.
 * Named apart from a channel's "Ask Tembo here", which posts for the channel (QA3-03).
 *
 * A chat needs the whole viewport, so the page fills its sheet (SpacePage
 * `fill`) and the spaces shell provides the way around; without a spaces
 * context it fills the plain frame's sheet the same way. Auth is still enforced by middleware on
 * `/dashboard/*`; signing in is the only page requirement (B-1.2), and the
 * chat APIs decide what each person's questions can draw on.
 */
import ChatApp from "@/components/chat/ChatApp";
import SpacePage from "@/components/platform/spaces/SpacePage.astro";
import { resolveSpacePageWith } from "@/components/platform/spaces/space-page";
import { drizzle } from "drizzle-orm/d1";
import { env } from "cloudflare:workers";
import * as schema from "@/lib/db/schema";
import { getStudentJourney } from "@/lib/student/journey";
import { requestCapabilities } from "@/lib/platform/server/request-capabilities";
import { privateAskScope } from "@/lib/tembo/private-ask";

const user = Astro.locals.user!;
const db = drizzle(env.DB, { schema });
// Read together, beside the space context: the journey and the request's capabilities (which the
// space context shares), rather than one after another once the context is known.
const pageReads = Promise.all([getStudentJourney(db, user.id), requestCapabilities(db, Astro.locals)]);
const resolved = await resolveSpacePageWith(Astro.locals, "ask", () => pageReads);
const spaces = resolved?.[0] ?? null;
const [journey, capabilities] = resolved?.[1] ?? await pageReads;
// The scope /api/chat gives Tembo, said on the page (QA3-03).
const scope = privateAskScope(capabilities);
---

<SpacePage context={spaces} title="Ask Tembo privately" journey={journey} fill>
  <ChatApp client:load scope={scope} />
</SpacePage>
