---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { ChatInterface } from "@/components/recordings/ChatInterface";
---

<DashboardLayout title="Ask AI">
  <div class="space-y-5">
    <div>
      <h2 class="text-2xl font-bold text-white">TTV Learning Coach</h2>
      <p class="mt-1 text-sm text-white/55">
        Revisit session ideas, ask follow-up questions, and turn learning into practice.
      </p>
    </div>

    <ChatInterface client:load />
  </div>
</DashboardLayout>
