---
import SpacePage from "@/components/platform/spaces/SpacePage.astro";
import PageTitle from "@/components/platform/spaces/PageTitle.astro";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";
import { SPACE_PATHS } from "@/lib/platform/server/space-routes";
import Card from "@/components/common/Card.astro";
import Button from "@/components/common/Button.astro";
import { drizzle } from "drizzle-orm/d1";
import * as schema from "@/lib/db/schema";
import { and, eq } from "drizzle-orm";
import { env } from "cloudflare:workers";
import { createId } from "@paralleldrive/cuid2";
import {
  ProgramApplicationError,
  buildSelfApplicationStatement,
  createSelfApplication,
  throwSelfApplicationFailure,
} from "@/lib/admin/program-application";

const user = Astro.locals.user!;
const db = drizzle(env.DB, { schema });
const spaces = await resolveSpacePage(Astro.locals, "apply");

const notice = Astro.url.searchParams.get("notice");
let error = "";

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const application = createSelfApplication({
      id: createId(),
      programId: formData.get("programId"),
      userId: user.id,
    });
    const statement = buildSelfApplicationStatement(application);
    const result = await env.DB.prepare(statement.sql)
      .bind(...statement.params)
      .run();

    if (result.meta.changes !== statement.expectedChanges) {
      if (result.meta.changes !== 0) {
        throw new Error(
          `Atomic cohort application changed ${result.meta.changes} rows; expected ${statement.expectedChanges}.`
        );
      }

      const [program, currentUser, existing] = await Promise.all([
        db.query.program.findFirst({
          where: eq(schema.program.id, application.programId),
          columns: { id: true, applicationsOpen: true },
        }),
        db.query.user.findFirst({
          where: eq(schema.user.id, user.id),
          columns: { id: true },
        }),
        db.query.programApplication.findFirst({
          where: and(
            eq(schema.programApplication.programId, application.programId),
            eq(schema.programApplication.userId, user.id)
          ),
          columns: { id: true },
        }),
      ]);

      throwSelfApplicationFailure({
        programExists: Boolean(program),
        applicationsOpen: program?.applicationsOpen === true,
        userExists: Boolean(currentUser),
        alreadyApplied: Boolean(existing),
      });
    }

    return Astro.redirect("/dashboard/apply?notice=application-submitted");
  } catch (caught) {
    if (caught instanceof ProgramApplicationError) {
      error = caught.message;
      Astro.response.status = 400;
    } else {
      error = "The application could not be submitted. Please try again.";
      Astro.response.status = 500;
    }
  }
}

// Get user's existing applications to filter them out
const userApplications = await db.query.programApplication.findMany({
  where: eq(schema.programApplication.userId, user.id),
  columns: { programId: true },
});
const appliedProgramIds = userApplications
  .map((a) => a.programId)
  .filter(Boolean) as string[];

// Query only open cohorts; filtering after the query could expose a newly
// closed cohort while this response is being assembled.
const allPrograms = await db.query.program.findMany({
  where: eq(schema.program.applicationsOpen, true),
  with: { curriculum: true },
});

// Filter out programs already applied to
const availablePrograms = allPrograms.filter(
  (p) => !appliedProgramIds.includes(p.id)
);

// After a successful post the page confirms the application and nothing else
// contradicts it: the cohort list only offers the other open cohorts, and the
// "nothing open" message is left out. The notice is only believed once the
// person has an application to show.
const submitted = notice === "application-submitted" && appliedProgramIds.length > 0;
const applicationsHref = spaces ? SPACE_PATHS.cohort : "/dashboard";
---

<SpacePage context={spaces} title="Apply to a Cohort" legacyTitle="Apply">
  <div class="space-y-6">
    <div>
      <PageTitle spaces={Boolean(spaces)} legacyClass="text-2xl font-bold text-white">Apply to a Cohort</PageTitle>
      <p class="mt-1 text-ink-secondary">
        Browse cohorts accepting applications and submit yours.
      </p>
    </div>

    {submitted && (
      <div role="status" data-application-submitted class="rounded-md border border-green-500/30 bg-green-500/10 p-4 text-green-300">
        <p class="font-medium">Your cohort application was submitted.</p>
        <p class="mt-1 text-sm text-green-200/90">
          It's with the team now. You can follow its status {spaces ? "on your Cohort page" : "from your dashboard"}.
        </p>
        <Button href={applicationsHref} class="mt-3">
          View your applications
        </Button>
      </div>
    )}

    {error && (
      <div role="alert" class="rounded-md border border-red-500/30 bg-red-500/10 p-4 text-red-300">
        {error}
      </div>
    )}

    {submitted && availablePrograms.length > 0 && (
      <h2 class="text-lg font-semibold text-white">Other open cohorts</h2>
    )}

    {availablePrograms.length > 0 ? (
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {availablePrograms.map((program) => (
          <div data-cohort-id={program.id}>
            <Card>
              <div class="flex flex-col gap-3">
                <h3 class="text-lg font-semibold text-white">{program.name}</h3>
                <p class="text-sm text-ink-secondary">{program.description}</p>
                {program.curriculum && (
                  <div class="rounded bg-teal/20 px-2 py-1 text-xs text-white/70">
                    {program.curriculum.title}
                  </div>
                )}
                {program.startDate && (
                  <p class="text-xs text-ink-muted">
                    Starts {program.startDate.toLocaleDateString()}
                    {program.endDate && ` — Ends ${program.endDate.toLocaleDateString()}`}
                  </p>
                )}
                <form method="POST" class="mt-2">
                  <input type="hidden" name="programId" value={program.id} />
                  <Button type="submit" class="w-full">
                    Apply
                  </Button>
                </form>
              </div>
            </Card>
          </div>
        ))}
      </div>
    ) : !submitted && (
      <Card>
        <div class="text-center py-8" data-apply-empty>
          <p class="text-ink-secondary">
            {allPrograms.length > 0
              ? "You've applied to every cohort that's open right now."
              : "No cohorts are accepting applications right now."}
          </p>
          {appliedProgramIds.length > 0 && (
            <Button href={applicationsHref} class="mt-4">
              View your applications
            </Button>
          )}
        </div>
      </Card>
    )}
  </div>
</SpacePage>
