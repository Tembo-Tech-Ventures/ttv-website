---
/**
 * Apply to a cohort (/dashboard/cohort/apply), on the kit (style-guide rollout
 * M11): the cohorts taking applications, each a kit card with a quiet "Apply to
 * {cohort}" that posts here. A submitted application answers 303 to this page,
 * which says so once (a flash, not a query string), and nothing on it contradicts
 * that (applyPageState).
 */
import SpacePage from "@/components/platform/spaces/SpacePage.astro";
import { resolveSpacePageWith } from "@/components/platform/spaces/space-page";
import { SPACE_PAGE_PATHS } from "@/components/platform/spaces/sidebar";
import { SPACE_PATHS } from "@/lib/platform/server/space-routes";
import { Button, ButtonLink, Card, Chip, EmptyState, HINT, Notice, PageHeader } from "@/components/platform/ui";
import { redirectWithFlash, takeFlash } from "@/lib/platform/server/flash";
import { drizzle } from "drizzle-orm/d1";
import * as schema from "@/lib/db/schema";
import { and, eq } from "drizzle-orm";
import { env } from "cloudflare:workers";
import { createId } from "@paralleldrive/cuid2";
import {
  ProgramApplicationError,
  buildSelfApplicationStatement,
  createSelfApplication,
  throwSelfApplicationFailure,
} from "@/lib/admin/program-application";
import { APPLICATION_SUBMITTED, applyPageState } from "@/lib/student/apply-page";
import { formatCalendarDate } from "@/lib/display-date";

const user = Astro.locals.user!;
const db = drizzle(env.DB, { schema });
// The frame starts first; a GET reads its cohorts beside it (PERF-2).
const resolving = resolveSpacePageWith(Astro.locals, "apply", async () => null);

let error = "";

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const application = createSelfApplication({
      id: createId(),
      programId: formData.get("programId"),
      userId: user.id,
    });
    const statement = buildSelfApplicationStatement(application);
    const result = await env.DB.prepare(statement.sql)
      .bind(...statement.params)
      .run();

    if (result.meta.changes !== statement.expectedChanges) {
      if (result.meta.changes !== 0) {
        throw new Error(
          `Atomic cohort application changed ${result.meta.changes} rows; expected ${statement.expectedChanges}.`
        );
      }

      const [program, currentUser, existing] = await Promise.all([
        db.query.program.findFirst({
          where: eq(schema.program.id, application.programId),
          columns: { id: true, applicationsOpen: true },
        }),
        db.query.user.findFirst({
          where: eq(schema.user.id, user.id),
          columns: { id: true },
        }),
        db.query.programApplication.findFirst({
          where: and(
            eq(schema.programApplication.programId, application.programId),
            eq(schema.programApplication.userId, user.id)
          ),
          columns: { id: true },
        }),
      ]);

      throwSelfApplicationFailure({
        programExists: Boolean(program),
        applicationsOpen: program?.applicationsOpen === true,
        userExists: Boolean(currentUser),
        alreadyApplied: Boolean(existing),
      });
    }

    return redirectWithFlash(Astro, SPACE_PAGE_PATHS.apply, { tone: "success", title: APPLICATION_SUBMITTED });
  } catch (caught) {
    if (caught instanceof ProgramApplicationError) {
      error = caught.message;
      Astro.response.status = 400;
    } else {
      error = "The application could not be submitted. Please try again.";
      Astro.response.status = 503;
    }
  }
}

const [landing, userApplications, allPrograms] = await Promise.all([
  resolving,
  db.query.programApplication.findMany({
    where: eq(schema.programApplication.userId, user.id),
    columns: { programId: true },
  }),
  // Only open cohorts: filtering after the query could expose a newly closed
  // cohort while this response is being assembled.
  db.query.program.findMany({
    where: eq(schema.program.applicationsOpen, true),
    with: { curriculum: true },
  }),
]);
const spaces = landing?.[0] ?? null;
const appliedProgramIds = userApplications.map((a) => a.programId).filter(Boolean) as string[];
const availablePrograms = allPrograms.filter((p) => !appliedProgramIds.includes(p.id));

// After a successful post the page confirms the application and nothing else
// contradicts it: the cohort list only offers the other open cohorts, and the
// "nothing open" message is left out.
const flash = Astro.request.method === "POST" ? null : takeFlash(Astro);
const { submitted, showSubtitle, showOtherCohortsHeading, emptyMessage } = applyPageState({
  submittedNow: flash?.title === APPLICATION_SUBMITTED,
  appliedCount: appliedProgramIds.length,
  openCount: allPrograms.length,
  availableCount: availablePrograms.length,
});
const applicationsHref = SPACE_PATHS.cohort;
const Name = showOtherCohortsHeading ? "h3" : "h2";
---

<SpacePage context={spaces} title="Apply to a cohort" titlePrefix={error ? "Error: " : ""}>
  <div class="flex max-w-5xl flex-col gap-8">
    <PageHeader title="Apply to a cohort">
      {showSubtitle && "Browse cohorts accepting applications and submit yours."}
    </PageHeader>

    {submitted && (
      <div data-application-submitted>
        <Notice tone="success" focusOnLoad title={APPLICATION_SUBMITTED}>
          It's with the team now. You can follow its status on your Cohort page.
          <Fragment slot="actions"><ButtonLink href={applicationsHref} size="sm">View your applications</ButtonLink></Fragment>
        </Notice>
      </div>
    )}

    {error && <Notice tone="danger" focusOnLoad title="Your application wasn't submitted">{error}</Notice>}

    {showOtherCohortsHeading && <h2 class="text-2xl text-ink-primary">Other open cohorts</h2>}

    {availablePrograms.length > 0 ? (
      <ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3" aria-label="Cohorts taking applications">
        {availablePrograms.map((program) => (
          <li class="flex" data-cohort-id={program.id}>
            <Card as="article" aria-labelledby={`cohort-${program.id}`} className="flex flex-1 flex-col gap-3">
              <Name id={`cohort-${program.id}`} class="text-lg leading-snug text-ink-primary">{program.name}</Name>
              {program.description && <p class="text-sm leading-relaxed text-ink-secondary">{program.description}</p>}
              {program.curriculum && <div><Chip>{program.curriculum.title}</Chip></div>}
              {program.startDate && (
                <p class={HINT}>
                  Starts {formatCalendarDate(program.startDate)}
                  {program.endDate && ` — Ends ${formatCalendarDate(program.endDate)}`}
                </p>
              )}
              <form method="POST" class="mt-auto pt-2">
                <input type="hidden" name="programId" value={program.id} />
                <Button type="submit" className="w-full">Apply to {program.name}</Button>
              </form>
            </Card>
          </li>
        ))}
      </ul>
    ) : emptyMessage && (
      <div data-apply-empty>
        <EmptyState title={emptyMessage} headingLevel={2}>
          {appliedProgramIds.length > 0 ? "Your applications and their status are on your Cohort page." : "New cohorts appear here when they open for applications."}
          {appliedProgramIds.length > 0 && (
            <Fragment slot="action"><ButtonLink href={applicationsHref} variant="primary">View your applications</ButtonLink></Fragment>
          )}
        </EmptyState>
      </div>
    )}
  </div>
</SpacePage>
