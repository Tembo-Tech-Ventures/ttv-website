---
/**
 * A cohort channel, in the Cohort space (U-2.3): its header, and the
 * habits on a first visit. After agreeing, the conversation
 * (U-2.1, ChannelPageBody). Not found while `channels` is off for the person, or
 * when the backend does not list this channel as one they can read
 * (channel-page.ts).
 */
import ChannelPageBody from "@/components/channels/ChannelPageBody.astro";
import { resolveChannelPage } from "@/components/channels/channel-page";
import SpacePage from "@/components/platform/spaces/SpacePage.astro";

const page = await resolveChannelPage(Astro, "cohort");
if (page instanceof Response) return page;
---

<SpacePage context={page.context} title={`#${page.channel.name}`} channels={page.readable} channelId={page.channel.id} fill={page.agreed}>
  <ChannelPageBody page={page} />
</SpacePage>
