---
/**
 * Community → Mentors (U-4.1, screen 05): the directory with its filters, the
 * requests this person sent, and the "Ask for time" drawer. It exists only
 * while `mentor_requests` is on for the person (effective only with
 * `channels`); the router answers 404 otherwise, and so does this page.
 *
 * Without JavaScript everything reads, the filters are links, and the drawer
 * is a form that posts here (request-post.ts). Agreeing to how we talk to each
 * other posts here too, and comes back with the drawer open on the same note.
 */
import { env } from "cloudflare:workers";
import { isAgentSession } from "@/lib/agent-auth";
import { CONDUCT_VERSION } from "@/lib/channels/conduct";
import { CONDUCT_PATH } from "@/lib/platform/server/space-routes";
import { areaOptions, directoryHref, directoryQuery, parseDirectoryUrl } from "@/lib/platform/client/mentor-directory";
import { handleConductPost } from "@/components/channels/conduct-flow";
import { channelsServer } from "@/components/channels/server";
import SpacePage from "@/components/platform/spaces/SpacePage.astro";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";
import MentorPageIntro from "@/components/platform/mentors/MentorPageIntro.astro";
import MentorsDirectory from "@/components/platform/mentors/MentorsDirectory";
import { MENTORS_PATH, mentorRequestsOpen } from "@/components/platform/mentors/mentor-display";
import { mentorPageResponse } from "@/components/platform/mentors/page-responses";
import { handleRequestPost, isRequestPost, type RequestPostResult } from "@/components/platform/mentors/request-post";
import { mentorsServer } from "@/components/platform/mentors/server";

const context = await resolveSpacePage(Astro.locals, "mentors");
if (!context || !mentorRequestsOpen(context.me)) return mentorPageResponse(404);
const { method } = Astro.request;
if (method !== "GET" && method !== "HEAD" && method !== "POST") return mentorPageResponse(405);

const now = Date.now();
const server = mentorsServer(Astro, env, context.me, now);
const filters = parseDirectoryUrl(Astro.url.searchParams);
const base = { area: filters.area, format: filters.format, available: filters.available };
const filtered = Boolean(filters.area || filters.format || filters.available);
const [all, matching, ownRequests, projects, canAsk] = await Promise.all([
  server.directory({}),
  filtered ? server.directory(directoryQuery(filters)) : null,
  server.requests({ as: "requester" }),
  server.projects(),
  server.canAsk(),
]);
const canAgree = !isAgentSession(Astro.locals.session?.userAgent);

let posted: Extract<RequestPostResult, { kind: "render" }> | null = null;
if (method === "POST") {
  if (await isRequestPost(Astro.request)) {
    const result = await handleRequestPost(Astro.request, {
      mentors: all.items,
      send: (body) => server.create(body),
      sent: (id) => `${directoryHref(MENTORS_PATH, base)}${filtered ? "&" : "?"}sent=${encodeURIComponent(id)}`,
    });
    if (result.kind === "redirect") return mentorPageResponse(303, { Location: result.location });
    if (result.kind === "refuse") return mentorPageResponse(result.status);
    posted = result;
    Astro.response.status = result.status;
  } else {
    // Agreeing to the habits from the drawer: a person's own act, never an agent's delegated session.
    if (!canAgree) return mentorPageResponse(403);
    const agreed = await handleConductPost(Astro.request, channelsServer(env.DB, context.me).conduct, Astro.url.pathname + Astro.url.search);
    if (agreed?.kind === "redirect") return mentorPageResponse(303, { Location: agreed.location });
    return mentorPageResponse(agreed?.status ?? 400);
  }
}

const sentId = Astro.url.searchParams.get("sent");
const sent = sentId ? ownRequests.items.find((request) => request.id === sentId) ?? null : null;
Astro.response.headers.set("Cache-Control", "no-store");
---

<SpacePage context={context} title="Mentors" titlePrefix={posted ? "Error: " : ""}>
  <MentorPageIntro page="mentors" />
  <MentorsDirectory
    client:load
    me={context.me}
    path={MENTORS_PATH}
    filters={posted ? { ...filters, ask: posted.mentorId } : filters}
    mentors={all.items}
    shown={(matching ?? all).items}
    areas={areaOptions(all.items, filters.area)}
    ownRequests={ownRequests}
    projects={projects}
    canAsk={canAsk}
    conduct={{ version: CONDUCT_VERSION, habitsHref: CONDUCT_PATH, canAgree }}
    now={now}
    serverForm={posted ? { mentorId: posted.mentorId, form: posted.form } : null}
    sent={sent}
  />
</SpacePage>
