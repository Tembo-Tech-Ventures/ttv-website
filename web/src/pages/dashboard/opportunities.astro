---
/**
 * Opportunities: approved client projects, open to a builder whose public profile is published.
 * Raising a hand (with an optional note for the introduction) and withdrawing it post back here,
 * which answers with a 303 and a read-once flash (a reload never posts or says it again), a 400 when the form can't be
 * taken, keeping what was typed, and a 503 when the write fails. No title or organisation is read
 * for anyone the page's gate keeps out: the project query applies the gate itself.
 */
import SpacePage from "@/components/platform/spaces/SpacePage.astro";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";
import { SPACE_PAGE_PATHS } from "@/components/platform/spaces/sidebar";
import { Button, ButtonLink, Card, Chip, EmptyState, Notice, PageTitle, TextAreaField } from "@/components/platform/ui";
import { redirectWithFlash, takeFlash } from "@/lib/platform/server/flash";
import { drizzle } from "drizzle-orm/d1";
import { env } from "cloudflare:workers";
import { and, desc, eq, exists, inArray } from "drizzle-orm";
import * as schema from "@/lib/db/schema";
import { budgetBandLabel } from "@/components/hire/budget-bands";
import { parseSkillsJson } from "@/lib/talent/profile";
import { interestNoteSchema, resolveGateState } from "@/components/hire/validation";
import { formatMomentDate } from "@/lib/display-date";
import { opportunityAnchor } from "@/components/platform/profile/overview";
import { getStudentJourney } from "@/lib/student/journey";

const user = Astro.locals.user!;
const db = drizzle(env.DB, { schema });
/** The person's published profile, as a subquery: what hangs off it is read beside it. */
const publishedProfile = () => db.select({ id: schema.studentProfile.id }).from(schema.studentProfile)
  .where(and(eq(schema.studentProfile.userId, user.id), eq(schema.studentProfile.status, "PUBLISHED")));
const readProfile = () => db.query.studentProfile.findFirst({
  where: eq(schema.studentProfile.userId, user.id),
  columns: { id: true, status: true },
});

const DONE = { raised: "You raised your hand for this project.", withdrawn: "You withdrew your interest." } as const;
let failure = "";
/** The project whose note was refused, and the note, so the person doesn't type it again. */
let refused: { projectId: string; note: string } | null = null;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const action = formData.get("_action");
  const projectId = formData.get("projectId");
  const note = formData.get("note");
  const profile = await readProfile();
  const done = (outcome: keyof typeof DONE) => redirectWithFlash(Astro, SPACE_PAGE_PATHS.opportunities, { tone: "success", message: DONE[outcome] });
  if (!profile || resolveGateState(profile).state !== "published") {
    Astro.response.status = 400;
    failure = "Publish your profile to raise your hand for a project.";
  } else if (typeof projectId !== "string" || !projectId || (action !== "interest" && action !== "withdraw")) {
    Astro.response.status = 400;
    failure = "That didn't go through. Try again from the project.";
  } else if (action === "interest") {
    const parsed = interestNoteSchema.safeParse(typeof note === "string" ? note : "");
    const project = parsed.success
      ? await db.query.clientProject.findFirst({ where: eq(schema.clientProject.id, projectId), columns: { status: true } })
      : null;
    if (!parsed.success || project?.status !== "APPROVED") {
      Astro.response.status = 400;
      failure = !parsed.success
        ? parsed.error.issues[0]?.message ?? "Check your note and try again."
        : "This project isn't taking interest any more.";
      refused = { projectId, note: typeof note === "string" ? note : "" };
    } else {
      try {
        await db.insert(schema.projectInterest)
          .values({ projectId, profileId: profile.id, note: parsed.data || null, status: "INTERESTED" })
          .onConflictDoUpdate({
            target: [schema.projectInterest.projectId, schema.projectInterest.profileId],
            set: { status: "INTERESTED", note: parsed.data || null },
          });
        return done("raised");
      } catch (error) {
        console.error("Interest in a project could not be saved.", error);
        Astro.response.status = 503;
        failure = "Your hand couldn't be raised just now. Try again in a moment.";
        refused = { projectId, note: parsed.data };
      }
    }
  } else {
    try {
      const withdrawn = await db.update(schema.projectInterest).set({ status: "WITHDRAWN" })
        .where(and(
          eq(schema.projectInterest.projectId, projectId),
          eq(schema.projectInterest.profileId, profile.id),
          eq(schema.projectInterest.status, "INTERESTED"),
        ))
        .returning({ id: schema.projectInterest.id });
      if (withdrawn.length > 0) return done("withdrawn");
      Astro.response.status = 400;
      failure = "Your hand wasn't raised for that project.";
    } catch (error) {
      console.error("Interest in a project could not be withdrawn.", error);
      Astro.response.status = 503;
      failure = "That couldn't be saved just now. Try again in a moment.";
    }
  }
}

// The profile (the journey's, which the frame shares), the projects and the person's raised hands
// (both through the published profile), and the space context: one round trip.
const [{ profile }, approved, interests, spaces] = await Promise.all([
  getStudentJourney(db, user.id),
  db.query.clientProject.findMany({
    where: and(eq(schema.clientProject.status, "APPROVED"), exists(publishedProfile())),
    orderBy: [desc(schema.clientProject.createdAt)],
  }),
  db.query.projectInterest.findMany({ where: inArray(schema.projectInterest.profileId, publishedProfile()) }),
  resolveSpacePage(Astro.locals, "opportunities"),
]);
const { state: gateState, message: gateMessage } = resolveGateState(profile);
const raised = new Map(interests.map((interest) => [interest.projectId, interest]));
const projects = gateState === "published" ? approved.map((project) => ({ ...project, interest: raised.get(project.id) ?? null })) : [];

// A POST never carries a flash, and a rejected one says what went wrong instead.
const flash = Astro.request.method === "GET" ? takeFlash(Astro) : null;
const profilePath = SPACE_PAGE_PATHS.portfolio;
---

<SpacePage context={spaces} title={failure ? "Error: Opportunities" : "Opportunities"}>
  <div class="max-w-4xl space-y-6">
    <header>
      <PageTitle>Opportunities</PageTitle>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-secondary">
        Approved client projects looking for builders. If there's a fit, the TTV team makes the introduction.
      </p>
    </header>

    {flash && <Notice tone={flash.tone} title={flash.title} focusOnLoad>{flash.message}</Notice>}
    {failure && <Notice tone="danger" focusOnLoad>{failure}</Notice>}

    {gateState !== "published" && (
      <EmptyState title="Opportunities open with a published profile" headingLevel={2}>
        {gateMessage}
        <ButtonLink slot="action" href={profilePath} variant={gateState === "no_profile" ? "primary" : "quiet"}>
          {gateState === "no_profile" ? "Create your profile" : "Go to your profile"}
        </ButtonLink>
      </EmptyState>
    )}

    {gateState === "published" && projects.length === 0 && (
      <EmptyState title="No approved projects right now" headingLevel={2}>
        When the team approves a client project, it's listed here for you to raise your hand.
      </EmptyState>
    )}

    {projects.length > 0 && (
      <ol class="space-y-6" aria-label="Client projects">
        {projects.map((project) => {
          const skills = parseSkillsJson(project.skills);
          const titleId = `project-${project.id}-title`;
          const isInterested = project.interest?.status === "INTERESTED";
          const refusedHere = refused?.projectId === project.id ? refused : null;
          return (
            <li id={opportunityAnchor(project.id)} class="scroll-mt-24" data-opportunity>
              <Card as="article" aria-labelledby={titleId}>
                <h2 id={titleId} class="font-body text-lg leading-snug font-bold break-words text-ink-primary">{project.title}</h2>
                <p class="mt-0.5 text-sm break-words text-ink-secondary">{project.organization}</p>
                <p class="mt-3 text-[0.9375rem] leading-relaxed break-words whitespace-pre-line text-ink-secondary">{project.description}</p>
                {skills.length > 0 && (
                  <ul class="mt-4 flex flex-wrap gap-2" aria-label="Skills">
                    {skills.map((skill) => <li class="max-w-full"><Chip>{skill}</Chip></li>)}
                  </ul>
                )}
                <p class="mt-4 flex flex-wrap gap-x-6 gap-y-1 text-sm text-ink-muted">
                  <span>{budgetBandLabel(project.budgetBand)}</span>
                  {project.timeline && <span>{project.timeline}</span>}
                  {project.createdAt && <span>Posted {formatMomentDate(project.createdAt)}</span>}
                </p>

                <div class="mt-5 border-t border-hairline pt-5">
                  {isInterested ? (
                    <div class="flex flex-wrap items-start justify-between gap-3">
                      <div class="min-w-0">
                        <Chip tone="ring">Hand raised</Chip>
                        {project.interest?.note && (
                          <p class="mt-2 text-sm break-words whitespace-pre-line text-ink-secondary">Your note: {project.interest.note}</p>
                        )}
                      </div>
                      <form method="POST">
                        <input type="hidden" name="_action" value="withdraw" />
                        <input type="hidden" name="projectId" value={project.id} />
                        <Button type="submit" size="sm" aria-describedby={titleId}>Withdraw</Button>
                      </form>
                    </div>
                  ) : (
                    <form method="POST" class="space-y-3">
                      <input type="hidden" name="_action" value="interest" />
                      <input type="hidden" name="projectId" value={project.id} />
                      <TextAreaField
                        id={`note-${project.id}`}
                        name="note"
                        label="Why you're a fit"
                        hint="The team includes it in the introduction. Up to 500 characters."
                        optional
                        rows={2}
                        maxLength={500}
                        defaultValue={refusedHere?.note}
                        error={refusedHere ? failure : undefined}
                      />
                      <Button type="submit" aria-describedby={titleId}>Raise your hand</Button>
                    </form>
                  )}
                </div>
              </Card>
            </li>
          );
        })}
      </ol>
    )}
  </div>
</SpacePage>
