---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import Badge from "@/components/common/Badge.astro";
import { drizzle } from "drizzle-orm/d1";
import { env } from "cloudflare:workers";
import { eq, desc } from "drizzle-orm";
import * as schema from "@/lib/db/schema";
import { budgetBandLabel } from "@/components/hire/budget-bands";
import { parseSkillsJson } from "@/lib/talent/profile";
import { interestNoteSchema, resolveGateState } from "@/components/hire/validation";
import type { ProfileStatus } from "@/components/hire/validation";

const user = Astro.locals.user!;
const db = drizzle(env.DB, { schema });

const profile = await db.query.studentProfile.findFirst({
  where: (sp, { eq: e }) => e(sp.userId, user.id),
  columns: { id: true, status: true },
}) as { id: string; status: ProfileStatus } | undefined;

const { state: gateState, message: gateMessage } = resolveGateState(profile);

let projects: Array<
  typeof schema.clientProject.$inferSelect & {
    interest: typeof schema.projectInterest.$inferSelect | null;
  }
> = [];

let interestError = "";
let interestSuccess = "";

if (gateState === "published" && profile) {
  if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const action = formData.get("_action") as string;
    const projectId = formData.get("projectId") as string;

    if (action === "interest" && projectId) {
      const noteResult = interestNoteSchema.safeParse(
        (formData.get("note") as string) ?? ""
      );

      if (!noteResult.success) {
        interestError = noteResult.error.issues[0]?.message ?? "Invalid note.";
      } else {
        const project = await db.query.clientProject.findFirst({
          where: (cp, { eq: e }) => e(cp.id, projectId),
          columns: { id: true, status: true },
        });

        if (!project || project.status !== "APPROVED") {
          interestError = "This project is not currently accepting interest.";
        } else {
          const existing = await db.query.projectInterest.findFirst({
            where: (pi, { and: a, eq: e }) =>
              a(e(pi.projectId, projectId), e(pi.profileId, profile.id)),
          });

          if (existing) {
            await db
              .update(schema.projectInterest)
              .set({
                status: "INTERESTED",
                note: noteResult.data || null,
              })
              .where(eq(schema.projectInterest.id, existing.id));
          } else {
            await db.insert(schema.projectInterest).values({
              projectId,
              profileId: profile.id,
              note: noteResult.data || null,
              status: "INTERESTED",
            });
          }

          interestSuccess = "You raised your hand for this project.";
        }
      }
    } else if (action === "withdraw" && projectId) {
      const existing = await db.query.projectInterest.findFirst({
        where: (pi, { and: a, eq: e }) =>
          a(e(pi.projectId, projectId), e(pi.profileId, profile.id)),
      });

      if (existing && existing.status === "INTERESTED") {
        await db
          .update(schema.projectInterest)
          .set({ status: "WITHDRAWN" })
          .where(eq(schema.projectInterest.id, existing.id));
        interestSuccess = "You withdrew your interest.";
      }
    }
  }

  const approvedProjects = await db.query.clientProject.findMany({
    where: (cp, { eq: e }) => e(cp.status, "APPROVED"),
    orderBy: [desc(schema.clientProject.createdAt)],
  });

  const interests = profile
    ? await db.query.projectInterest.findMany({
        where: (pi, { eq: e }) => e(pi.profileId, profile.id),
      })
    : [];

  const interestMap = new Map(interests.map((i) => [i.projectId, i]));

  projects = approvedProjects.map((p) => ({
    ...p,
    interest: interestMap.get(p.id) ?? null,
  }));
}

function formatDate(date: Date | null): string {
  if (!date) return "";
  return date.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
}
---

<DashboardLayout title="Opportunities">
  <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
    <h1 class="text-2xl font-semibold text-white">Opportunities</h1>

    {
      gateState === "no_profile" && (
        <div class="mt-8 rounded-xl border border-[color:var(--color-rule)] bg-dark/40 p-8 text-center">
          <p class="font-body text-lg text-ink-secondary">{gateMessage}</p>
          <a
            href="/dashboard/portfolio"
            class="mt-4 inline-flex items-center rounded-full bg-primary px-6 py-2.5 font-body text-sm font-semibold uppercase tracking-[0.14em] text-dark transition-transform hover:scale-[1.03]"
          >
            Create your profile
          </a>
        </div>
      )
    }

    {
      gateState === "not_published" && (
        <div class="mt-8 rounded-xl border border-[color:var(--color-rule)] bg-dark/40 p-8 text-center">
          <p class="font-body text-lg text-ink-secondary">{gateMessage}</p>
          <a
            href="/dashboard/portfolio"
            class="mt-4 inline-flex items-center rounded-full border border-primary/40 px-6 py-2.5 font-body text-sm font-semibold uppercase tracking-[0.14em] text-primary transition-colors hover:bg-primary/10"
          >
            Go to your profile
          </a>
        </div>
      )
    }

    {
      gateState === "published" && (
        <>
          <p class="mt-2 font-body text-sm text-ink-secondary">
            Approved client projects looking for builders. If there is a fit,
            the TTV team makes the introduction.
          </p>

          {interestError && (
            <p
              role="alert"
              class="mt-4 rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3 font-body text-sm text-red-300"
            >
              {interestError}
            </p>
          )}

          {interestSuccess && (
            <p
              role="status"
              class="mt-4 rounded-lg border border-green-500/30 bg-green-500/10 px-4 py-3 font-body text-sm text-green-300"
            >
              {interestSuccess}
            </p>
          )}

          {projects.length === 0 ? (
            <div class="mt-8 rounded-xl border border-[color:var(--color-rule)] bg-dark/40 p-8 text-center">
              <p class="font-body text-lg text-ink-secondary">
                No approved projects right now. Check back soon.
              </p>
            </div>
          ) : (
            <div class="mt-6 space-y-6">
              {projects.map((project) => {
                const skills = parseSkillsJson(project.skills);
                const isInterested =
                  project.interest?.status === "INTERESTED";
                return (
                  <article class="rounded-xl border border-[color:var(--color-rule)] bg-dark/40 p-6">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                      <div>
                        <p class="font-body text-xs font-medium uppercase tracking-wider text-ink-muted">
                          {project.organization}
                        </p>
                        <h2 class="mt-1 text-lg font-semibold text-ink-primary">
                          {project.title}
                        </h2>
                      </div>
                      <Badge variant="approved" />
                    </div>

                    <p class="mt-3 font-body text-[15px] leading-relaxed text-ink-secondary">
                      {project.description}
                    </p>

                    {skills.length > 0 && (
                      <div class="mt-4 flex flex-wrap gap-2">
                        {skills.map((skill) => (
                          <span class="rounded-full border border-primary/30 bg-primary/10 px-3 py-1 font-body text-xs text-primary">
                            {skill}
                          </span>
                        ))}
                      </div>
                    )}

                    <div class="mt-4 flex flex-wrap gap-x-6 gap-y-1 font-body text-sm text-ink-muted">
                      <span>{budgetBandLabel(project.budgetBand)}</span>
                      {project.timeline && <span>{project.timeline}</span>}
                      {project.createdAt && (
                        <span>Posted {formatDate(project.createdAt)}</span>
                      )}
                    </div>

                    <div class="mt-5 border-t border-[color:var(--color-rule)] pt-5">
                      {isInterested ? (
                        <div>
                          <p class="font-body text-sm font-medium text-green-400">
                            You have raised your hand for this project.
                          </p>
                          {project.interest?.note && (
                            <p class="mt-1 font-body text-sm text-ink-muted">
                              Your note: {project.interest.note}
                            </p>
                          )}
                          <form method="POST" class="mt-3">
                            <input
                              type="hidden"
                              name="_action"
                              value="withdraw"
                            />
                            <input
                              type="hidden"
                              name="projectId"
                              value={project.id}
                            />
                            <button
                              type="submit"
                              class="rounded-full border border-red-500/40 px-5 py-2 font-body text-sm font-medium text-red-400 transition-colors hover:bg-red-500/10"
                            >
                              Withdraw
                            </button>
                          </form>
                        </div>
                      ) : (
                        <form method="POST" class="space-y-3">
                          <input
                            type="hidden"
                            name="_action"
                            value="interest"
                          />
                          <input
                            type="hidden"
                            name="projectId"
                            value={project.id}
                          />
                          <textarea
                            name="note"
                            maxlength="500"
                            rows="2"
                            class="block w-full rounded-lg border border-[color:var(--color-rule)] bg-dark/40 px-4 py-2.5 font-body text-sm text-ink-primary placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-primary/40"
                            placeholder="Why you're a fit — the team includes this in the intro"
                          />
                          <button
                            type="submit"
                            class="rounded-full bg-primary px-5 py-2 font-body text-sm font-semibold uppercase tracking-[0.14em] text-dark transition-transform hover:scale-[1.03]"
                          >
                            Raise your hand
                          </button>
                        </form>
                      )}
                    </div>
                  </article>
                );
              })}
            </div>
          )}
        </>
      )
    }
  </div>
</DashboardLayout>
