---
import { createCommunityService } from "@/lib/community/service";
import { hasDiscoveryAccess, dashboardNextStep } from "@/lib/dashboard-presentation";
import SpacePage from "@/components/platform/spaces/SpacePage.astro";
import OnboardingNotices from "@/components/platform/onboarding/OnboardingNotices.astro";
import OnboardingPrompt from "@/components/platform/onboarding/OnboardingPrompt.astro";
import { pickSpace, resolveSpacePageWith, restrictedNextStep, restrictionsFor } from "@/components/platform/spaces/space-page";
import { canonicalSpacePath } from "@/lib/platform/server/space-routes";
import { ButtonLink, Card, PageTitle } from "@/components/platform/ui";
import { CommunityJourneyCard } from "@/components/community/CommunityIntro";
import { drizzle } from "drizzle-orm/d1";
import { env } from "cloudflare:workers";
import * as schema from "@/lib/db/schema";
import { getStudentJourney } from "@/lib/student/journey";
import { getDashboardGreetingName } from "@/lib/display-name";
import ChannelShortcuts from "@/components/platform/spaces/ChannelShortcuts.astro";
import { loadChannelShortcuts } from "@/components/platform/spaces/channel-shortcuts-server";

const user = Astro.locals.user!;
// Independent reads, started together. The channel list for the "Channels" card (QA2-16), which the
// sidebar reuses, starts beside onboarding (PERF-2).
const [journey, access, landing] = await Promise.all([
  getStudentJourney(drizzle(env.DB, { schema }), user.id),
  createCommunityService(env.DB, user.id, Astro.locals.stagingFixture, env.DEPLOYMENT_ENVIRONMENT).access(),
  resolveSpacePageWith(Astro.locals, "cohort", (me) =>
    loadChannelShortcuts({ me, space: pickSpace(me, "cohort")!, page: "cohort" })),
]);
const spaces = landing?.[0] ?? null;
const { channels, shortcuts } = landing?.[1] ?? { channels: undefined, shortcuts: null };
const canDiscover = hasDiscoveryAccess(access);
const proposedStep = dashboardNextStep(journey.nextStep, canDiscover);
const qa = Astro.locals.stagingQa;
const greetingName = getDashboardGreetingName(user.name);
// Restricted synthetic identities (QA personas, staging fixtures) are never offered a step they cannot open.
const allowedStep = restrictedNextStep(restrictionsFor(Astro.locals), proposedStep);
const nextStep = allowedStep;
// Link straight to the step's space path rather than through its redirect.
const nextStepHref = spaces ? canonicalSpacePath(nextStep.action.href) ?? nextStep.action.href : nextStep.action.href;
const hasVisitedDashboard =
  Astro.cookies.get("ttv-dashboard-visited")?.value === user.id;

Astro.cookies.set("ttv-dashboard-visited", user.id, {
  httpOnly: true,
  maxAge: 60 * 60 * 24 * 365,
  path: "/dashboard",
  sameSite: "lax",
  secure: Astro.url.protocol === "https:",
});
---

<SpacePage context={spaces} title="Cohort" journey={journey} canDiscover={canDiscover} channels={channels}>
  <div class="max-w-3xl space-y-6">
    <header>
      <PageTitle>Cohort</PageTitle>
      {hasVisitedDashboard && <p class="mt-3 text-lg text-ink-secondary">Welcome back, {greetingName}</p>}
    </header>
    {/* The status cards follow the title, so its h1 leads the page; the next step stays its one peach action. */}
    {spaces?.onboarding && <OnboardingNotices view={spaces.onboarding} space={spaces.space} />}

    <Card as="section" aria-labelledby="next-step-title">
      <h2 id="next-step-title" data-testid="student-next-step" class="text-2xl text-ink-primary sm:text-3xl">
        {nextStep.title}
      </h2>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-secondary">
        {nextStep.description}
      </p>
      {nextStep.detail && (
        <p class="mt-3 text-sm font-medium text-ink-muted">
          {nextStep.detail}
        </p>
      )}
      <ButtonLink variant="primary" size="lg" href={nextStepHref} className="mt-6">
        {nextStep.action.label}
      </ButtonLink>
    </Card>
    {spaces && <OnboardingPrompt view={spaces.onboarding} space={spaces.space} />}
    <ChannelShortcuts model={shortcuts} />
    <CommunityJourneyCard restrictedQa={Boolean(qa)} />
  </div>
</SpacePage>
