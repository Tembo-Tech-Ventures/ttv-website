---
import { qaPathAllowed } from "@/lib/staging-qa-policy";
import { createCommunityService } from "@/lib/community/service";
import { hasDiscoveryAccess, dashboardNextStep, restrictedQaNextStep } from "@/lib/dashboard-presentation";
import SpacePage from "@/components/platform/spaces/SpacePage.astro";
import PageTitle from "@/components/platform/spaces/PageTitle.astro";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";
import { canonicalSpacePath } from "@/lib/platform/server/space-routes";
import Card from "@/components/common/Card.astro";
import Button from "@/components/common/Button.astro";
import { CommunityJourneyCard } from "@/components/community/CommunityIntro";
import { drizzle } from "drizzle-orm/d1";
import { env } from "cloudflare:workers";
import * as schema from "@/lib/db/schema";
import { getStudentJourney } from "@/lib/student/journey";
import { getDashboardGreetingName } from "@/lib/display-name";

const user = Astro.locals.user!;
const journey = await getStudentJourney(drizzle(env.DB, { schema }), user.id);
const canDiscover = hasDiscoveryAccess(await createCommunityService(env.DB, user.id, Astro.locals.stagingFixture, env.DEPLOYMENT_ENVIRONMENT).access());
const proposedStep = dashboardNextStep(journey.nextStep, canDiscover);
const qa = Astro.locals.stagingQa;
const nextStep = restrictedQaNextStep(proposedStep, !qa || qaPathAllowed(qa.persona, proposedStep.action.href, "GET"));
const greetingName = getDashboardGreetingName(user.name);
// With spaces on, this page is the Cohort overview at /dashboard/cohort.
const spaces = await resolveSpacePage(Astro.locals, "cohort");
// Link straight to the step's space path rather than through its redirect.
const nextStepHref = spaces ? canonicalSpacePath(nextStep.action.href) ?? nextStep.action.href : nextStep.action.href;
const hasVisitedDashboard =
  Astro.cookies.get("ttv-dashboard-visited")?.value === user.id;

Astro.cookies.set("ttv-dashboard-visited", user.id, {
  httpOnly: true,
  maxAge: 60 * 60 * 24 * 365,
  path: "/dashboard",
  sameSite: "lax",
  secure: Astro.url.protocol === "https:",
});
---

<SpacePage context={spaces} title="Cohort" legacyTitle="Dashboard" journey={journey} canDiscover={canDiscover}>
  <div class={spaces ? "max-w-3xl space-y-6" : "mx-auto max-w-3xl space-y-6"}>
    {spaces ? (
      <header>
        <PageTitle spaces legacyClass="">Cohort</PageTitle>
        {hasVisitedDashboard && <p class="mt-3 text-lg text-ink-secondary">Welcome back, {greetingName}</p>}
      </header>
    ) : hasVisitedDashboard && (
      <header>
        <h2 class="text-2xl font-bold text-white">
          Welcome back, {greetingName}
        </h2>
      </header>
    )}

    <section aria-labelledby="next-step-title">
      <Card>
        <div class="px-2 py-4 sm:px-6 sm:py-8">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary">
            Your next step
          </p>
          <h2
            id="next-step-title"
            data-testid="student-next-step"
            class="mt-3 text-2xl font-bold text-white sm:text-3xl"
          >
            {nextStep.title}
          </h2>
          <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-secondary">
            {nextStep.description}
          </p>
          {nextStep.detail && (
            <p class="mt-3 text-sm font-medium text-ink-muted">
              {nextStep.detail}
            </p>
          )}
          <Button href={nextStepHref} class="mt-6">
            {nextStep.action.label}
          </Button>
        </div>
      </Card>
    </section>
    <CommunityJourneyCard restrictedQa={Boolean(qa)} />
  </div>
</SpacePage>
