---
/**
 * Visitor messages: what people who found the builder's public page wrote to them, newest first.
 * Each can be marked read or archived; both post back here, which answers with a 303 and a
 * read-once flash (so a reload never posts again, nor says it again), a 400 when the form names no
 * message of theirs, and a 503 when the write fails.
 */
import SpacePage from "@/components/platform/spaces/SpacePage.astro";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";
import { SPACE_PAGE_PATHS } from "@/components/platform/spaces/sidebar";
import { Button, ButtonLink, Card, Chip, EmptyState, Notice, PageTitle, StatusChip, linkClass } from "@/components/platform/ui";
import { drizzle } from "drizzle-orm/d1";
import * as schema from "@/lib/db/schema";
import { eq, and, desc, inArray } from "drizzle-orm";
import { env } from "cloudflare:workers";
import { formatMomentDate } from "@/lib/display-date";
import { redirectWithFlash, takeFlash } from "@/lib/platform/server/flash";

const user = Astro.locals.user!;
const db = drizzle(env.DB, { schema });
const ownProfile = () => db.select({ id: schema.studentProfile.id }).from(schema.studentProfile)
  .where(eq(schema.studentProfile.userId, user.id));

const DONE = { READ: "Marked as read", ARCHIVED: "Message archived" } as const;
let failure = "";

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const contactId = formData.get("contactId");
  const status = formData.get("status");
  if (typeof contactId !== "string" || !contactId || (status !== "READ" && status !== "ARCHIVED")) {
    Astro.response.status = 400;
    failure = "That didn't go through. Try again from the message.";
  } else {
    try {
      // Only a message on the person's own profile changes; anything else changes nothing.
      const updated = await db.update(schema.profileContact).set({ status })
        .where(and(eq(schema.profileContact.id, contactId), inArray(schema.profileContact.profileId, ownProfile())))
        .returning({ id: schema.profileContact.id });
      if (updated.length > 0) return redirectWithFlash(Astro, SPACE_PAGE_PATHS.leads, { tone: "success", title: DONE[status] });
      Astro.response.status = 400;
      failure = "That message isn't here any more.";
    } catch (error) {
      console.error("A visitor message could not be updated.", error);
      Astro.response.status = 503;
      failure = "That couldn't be saved just now. Try again in a moment.";
    }
  }
}

// The profile, its messages (found through it) and the space context: one round trip, not three.
const [profile, contacts, spaces] = await Promise.all([
  db.query.studentProfile.findFirst({ where: eq(schema.studentProfile.userId, user.id), columns: { id: true } }),
  db.query.profileContact.findMany({
    where: inArray(schema.profileContact.profileId, ownProfile()),
    orderBy: [desc(schema.profileContact.createdAt)],
  }),
  resolveSpacePage(Astro.locals, "leads"),
]);
const unreadCount = contacts.filter((contact) => contact.status === "NEW").length;

// A POST never carries a flash, and a rejected one says what went wrong instead.
const flash = Astro.request.method === "GET" ? takeFlash(Astro) : null;
const title = spaces ? "Visitor messages" : "Leads";
---

<SpacePage context={spaces} title={failure ? `Error: ${title}` : title}>
  <div class="max-w-3xl space-y-6">
    <header class="flex flex-wrap items-end justify-between gap-4">
      <div class="min-w-0 basis-80 grow">
        <PageTitle>{title}</PageTitle>
        <p class="mt-3 text-base leading-relaxed text-ink-secondary">
          Messages from people who found you through your public profile.
        </p>
      </div>
      {unreadCount > 0 && <Chip tone="peach">{unreadCount} unread</Chip>}
    </header>

    {flash && <Notice tone={flash.tone} title={flash.title} focusOnLoad>{flash.message}</Notice>}
    {failure && <Notice tone="danger" focusOnLoad>{failure}</Notice>}

    {!profile && (
      <EmptyState title="Set up your public profile first" headingLevel={2}>
        Once you have a public profile, people who find it can write to you here.
        <ButtonLink slot="action" href={spaces ? SPACE_PAGE_PATHS.portfolio : "/dashboard/portfolio"} variant="primary">Create your profile</ButtonLink>
      </EmptyState>
    )}

    {profile && contacts.length === 0 && (
      <EmptyState title="No messages yet" headingLevel={2}>
        When someone reaches you through your public profile, their note lands here.
      </EmptyState>
    )}

    {contacts.length > 0 && (
      <ol class="space-y-3" aria-label="Messages" data-visitor-messages>
        {contacts.map((contact) => {
          const from = `contact-${contact.id}-from`;
          return (
            <li data-visitor-message={contact.status}>
              <Card>
                <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                      <h2 id={from} class="font-body text-base leading-snug font-bold break-words text-ink-primary">
                        {contact.fromName}{contact.organization && <span class="font-normal text-ink-secondary"> · {contact.organization}</span>}
                      </h2>
                      <StatusChip domain="contact" status={contact.status} />
                    </div>
                    <p class="mt-2 whitespace-pre-wrap break-words text-sm leading-relaxed text-ink-secondary">{contact.message}</p>
                    <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-ink-muted">
                      <a href={`mailto:${contact.fromEmail}`} class={`${linkClass()} break-all`}>{contact.fromEmail}</a>
                      <span>{formatMomentDate(contact.createdAt)}</span>
                    </p>
                  </div>
                  {contact.status !== "ARCHIVED" && (
                    <div class="flex shrink-0 flex-wrap items-center gap-2">
                      {contact.status === "NEW" && (
                        <form method="POST">
                          <input type="hidden" name="contactId" value={contact.id} />
                          <input type="hidden" name="status" value="READ" />
                          <Button type="submit" size="sm" aria-describedby={from}>Mark read</Button>
                        </form>
                      )}
                      <form method="POST">
                        <input type="hidden" name="contactId" value={contact.id} />
                        <input type="hidden" name="status" value="ARCHIVED" />
                        <Button type="submit" size="sm" variant="ghost" aria-describedby={from}>Archive</Button>
                      </form>
                    </div>
                  )}
                </div>
              </Card>
            </li>
          );
        })}
      </ol>
    )}
  </div>
</SpacePage>
