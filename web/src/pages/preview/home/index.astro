---
import PublicLayout from "@/layouts/PublicLayout.astro";

const candidates = [
  { href: "/preview/home/a", name: "A", title: "Kinetic editorial", idea: "Type is the image: large, balanced headlines, masked reveals and words that fill as you read." },
  { href: "/preview/home/b", name: "B", title: "Layers", idea: "The page as a stack of sheets: sections slide over one another and cards fan, stack and spread." },
  { href: "/preview/home/c", name: "C", title: "Constellation", idea: "The community as a living network, with the cohorts at its centre and connections that draw themselves." },
  { href: "/preview/home/d", name: "D", title: "Layers, mapped", idea: "Candidate B's stack of sheets, carrying C's network language and a first picture of a skills map builders move through." },
];
---

<PublicLayout title="Homepage candidates" description="Three homepage designs for Tembo Tech Ventures." noIndex>
  <section class="mx-auto max-w-5xl px-4 py-24 sm:px-8">
    <h1 class="font-heading tracking-heading text-4xl text-ink-primary md:text-6xl">Four homepages.</h1>
    <p class="mt-6 max-w-2xl text-lg text-ink-secondary">Same content, same order, four different ideas. Pick the one that should become the homepage.</p>
    <ol class="mt-14 divide-y divide-[color:var(--color-rule)] border-y border-[color:var(--color-rule)]">
      {candidates.map((candidate) => (
        <li>
          <a href={candidate.href} class="group grid gap-3 py-8 transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary md:grid-cols-[6rem_1fr_auto] md:items-baseline">
            <span class="font-heading text-4xl text-primary">{candidate.name}</span>
            <span>
              <span class="block text-2xl font-bold text-ink-primary group-hover:text-primary">{candidate.title}</span>
              <span class="mt-2 block text-ink-secondary">{candidate.idea}</span>
            </span>
            <span aria-hidden="true" class="text-2xl text-primary transition-transform group-hover:translate-x-1">→</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</PublicLayout>
