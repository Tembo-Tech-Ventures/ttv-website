---
import { env } from "cloudflare:workers";
import BaseLayout from "@/layouts/BaseLayout.astro";
import DemoAccessApp from "@/components/community/DemoAccessApp";
import { demoOperator, DemoAccessError } from "@/lib/staging-demo-access";

Astro.response.headers.set("Cache-Control", "no-store");
let expiresAt: string | null = null;
try {
  // This page deliberately supports recovery from an expired persona. The
  // independent operator gate must succeed before any controls are rendered.
  const operator = await demoOperator(env, Astro.request);
  expiresAt = new Date(operator.expiresAt * 1000).toISOString();
  // Never serialize operator.session or operator.cookieValue into the island.
} catch (error) {
  Astro.response.status = error instanceof DemoAccessError ? error.status : 503;
}
---
<BaseLayout title="Demo access | TTV" noIndex>
  <main class="min-h-screen bg-dark text-ink-primary">
    {expiresAt ? (
      <DemoAccessApp client:load activePersona={null} displayName="Demo operator" expiresAt={expiresAt} canSwitch={true} />
    ) : (
      <section class="mx-auto max-w-2xl px-4 py-16 sm:px-8">
        <h1 class="font-heading text-3xl">Demo access is unavailable</h1>
        <p class="mt-4 text-ink-secondary">Your access may have expired, or this demo may not be enabled. Use the staging access method provided by the team before choosing a role.</p>
        <a href="/" class="mt-6 inline-block text-primary underline underline-offset-4">Return to TTV</a>
      </section>
    )}
  </main>
</BaseLayout>
