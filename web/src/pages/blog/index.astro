---
import PublicLayout from "@/layouts/PublicLayout.astro";
import { drizzle } from "drizzle-orm/d1";
import { env } from "cloudflare:workers";
import * as schema from "@/lib/db/schema";
import { listPublicPosts } from "@/lib/blog/public";

const db = drizzle(env.DB, { schema });
const posts = await listPublicPosts(db);

const description =
  "Field notes from TTV builders across Africa about what they are learning, making, and sharing with their communities.";

function formatDate(date: Date): string {
  return date.toLocaleDateString("en", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}
---

<PublicLayout title="Field notes" description={description} canonical="/blog">
  <link
    slot="head"
    rel="alternate"
    type="application/rss+xml"
    title="Tembo Tech Ventures field notes"
    href="/blog/rss.xml"
  />

  <section class="mx-auto max-w-5xl px-4 py-28 sm:px-8 md:py-36">
    <div class="max-w-3xl">
      <p class="font-body text-xs font-semibold uppercase tracking-[0.4em] text-primary">
        &sect; Field notes
      </p>

      <h1
        class="font-heading tracking-heading mt-6 text-ink-primary"
        style="font-size: clamp(3rem, 9vw, 6rem); line-height: 0.95;"
      >
        Notes from<br />the community.
      </h1>

      <p class="mt-8 max-w-2xl font-body text-lg text-ink-secondary md:text-xl">
        TTV builders share what they are learning, making, and working through
        in tech communities across Africa.
      </p>
    </div>

    {posts.length === 0 ? (
      <div class="mt-16 border-y border-[color:var(--color-rule)] py-16 text-center">
        <p class="font-body text-sm font-semibold uppercase tracking-[0.28em] text-primary">
          No posts yet
        </p>
        <p class="mx-auto mt-4 max-w-lg font-body text-lg text-ink-secondary">
          Published field notes will appear here when builders share their first
          posts.
        </p>
      </div>
    ) : (
      <ol class="mt-16 divide-y divide-[color:var(--color-rule)] border-y border-[color:var(--color-rule)]">
        {posts.map((post) => (
          <li class="py-9 sm:py-11">
            <article class="grid gap-5 md:grid-cols-[minmax(0,1fr)_auto] md:items-start md:gap-10">
              <div class="min-w-0">
                <h2 class="font-heading tracking-subhead text-2xl text-ink-primary sm:text-3xl">
                  <a
                    href={`/blog/${post.profile.handle}/${post.slug}`}
                    class="transition-colors hover:text-primary"
                  >
                    {post.title}
                  </a>
                </h2>
                {post.excerpt && (
                  <p class="mt-4 max-w-2xl font-body text-base leading-relaxed text-ink-secondary">
                    {post.excerpt}
                  </p>
                )}
                <p class="mt-5 font-body text-sm text-ink-muted">
                  By{" "}
                  <a
                    href={`/talent/${post.profile.handle}`}
                    class="font-semibold text-ink-primary transition-colors hover:text-primary"
                  >
                    {post.profile.user.name}
                  </a>
                </p>
              </div>

              <p class="shrink-0 font-body text-sm text-ink-muted md:text-right">
                <time datetime={post.publishedAt.toISOString()}>
                  {formatDate(post.publishedAt)}
                </time>
                <span aria-hidden="true"> &middot; </span>
                {post.readingMinutes} min read
              </p>
            </article>
          </li>
        ))}
      </ol>
    )}
  </section>
</PublicLayout>
