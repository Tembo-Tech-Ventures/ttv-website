---
import PublicLayout from "@/layouts/PublicLayout.astro";
import Homepage from "@/components/homepage/Homepage.astro";
import { env } from "cloudflare:workers";
import { loadHomepageBuildersSafely } from "@/lib/homepage/builders";

const builders = await loadHomepageBuildersSafely({
  d1: env.DB,
  route: "/",
  version: env.DEPLOYMENT_VERSION,
  waitUntil: Astro.locals.cfContext,
});
---

<PublicLayout
  title="Tembo Tech Ventures"
  description="An African tech community, starting in East Africa and Nigeria: cohorts where early builders learn by shipping real software, and a community anyone can join."
  canonical="/"
>
  <Homepage builders={builders} isAuthenticated={Boolean(Astro.locals.user)} />
</PublicLayout>
