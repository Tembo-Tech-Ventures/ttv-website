---
import { env } from "cloudflare:workers";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";
import {
  Button,
  Card,
  ConfirmStep,
  DataCell,
  DataRow,
  DataTable,
  EmptyState,
  Notice,
  PageHeader,
  RowAction,
  SelectField,
  StatusChip,
  TextField,
  confirmHref,
  confirmingAction,
  withoutConfirm,
} from "@/components/platform/ui";
import { hasMatchingRequestOrigin } from "@/lib/admin/mutation-security";
import { TOKENS_PATH, TOKEN_ACCESS_OPTIONS, TOKEN_EXPIRY_OPTIONS, revokeAction, tokenAccessLabel, tokenStatus } from "@/lib/admin/tokens";
import { isAgentSession } from "@/lib/agent-auth";
import { formatMomentDateTime } from "@/lib/display-date";
import {
  PersonalAccessTokenInputError,
  createPersonalAccessToken,
  listPersonalAccessTokens,
  parsePersonalAccessTokenDuration,
  parsePersonalAccessTokenScopes,
  revokePersonalAccessToken,
} from "@/lib/personal-access-tokens";
import { redirectWithFlash, takeFlash } from "@/lib/platform/server/flash";

/*
 * The admin's own personal access tokens: make one, see each one's access and
 * whether it still works, and revoke one after a confirm step. A new token is
 * shown once, in the response to the form that made it, so that response is
 * never cached and never a redirect.
 */
Astro.response.headers.set("Cache-Control", "no-store");

const userId = Astro.locals.user?.id;
if (!userId) return Astro.redirect("/auth/login");
if (Astro.locals.personalAccessToken || isAgentSession(Astro.locals.session?.userAgent)) {
  return new Response("Forbidden: delegated credentials cannot manage personal access tokens.", { status: 403 });
}

type Field = "label" | "access" | "duration";
const UNAVAILABLE = "The database didn't answer, so nothing changed. Try again in a moment.";
let created: { label: string; token: string } | undefined;
let actionError: string | undefined;
const fieldErrors: Partial<Record<Field, string>> = {};
// What a refused create keeps, so the person fixes one field rather than starting again.
let kept = { label: "", access: "read", duration: TOKEN_EXPIRY_OPTIONS[0].value };

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const action = formData.get("action");
  if (!hasMatchingRequestOrigin(Astro.request)) {
    actionError = "This request didn't come from this page, so nothing changed. Reload the page and try again.";
    Astro.response.status = 403;
  } else if (action === "create") {
    kept = {
      label: String(formData.get("label") ?? ""),
      access: String(formData.get("access") ?? ""),
      duration: String(formData.get("duration") ?? ""),
    };
    try {
      const made = await createPersonalAccessToken({
        db: env.DB,
        userId,
        label: kept.label,
        durationHours: parsePersonalAccessTokenDuration(kept.duration),
        scopes: parsePersonalAccessTokenScopes(kept.access),
      });
      created = { label: made.label, token: made.token };
      kept = { label: "", access: "read", duration: TOKEN_EXPIRY_OPTIONS[0].value };
    } catch (caught) {
      if (caught instanceof PersonalAccessTokenInputError) {
        if (caught.field) fieldErrors[caught.field] = caught.message;
        actionError = caught.field ? "Check the field marked below." : caught.message;
        Astro.response.status = 400;
      } else {
        actionError = UNAVAILABLE;
        Astro.response.status = 503;
      }
    }
  } else if (action === "revoke") {
    const revoked = await revokePersonalAccessToken(env.DB, userId, String(formData.get("tokenId") ?? "")).catch(() => null);
    if (revoked === true) return redirectWithFlash(Astro, TOKENS_PATH, { tone: "success", title: "Token revoked" });
    if (revoked === false) {
      return redirectWithFlash(Astro, TOKENS_PATH, { tone: "info", title: "That token had already stopped working", message: "It was revoked or had expired, so nothing changed." });
    }
    actionError = UNAVAILABLE;
    Astro.response.status = 503;
  } else {
    actionError = "Choose one of the actions on this page.";
    Astro.response.status = 400;
  }
}

const flash = takeFlash(Astro);
const [tokens, spaces] = await Promise.all([listPersonalAccessTokens(env.DB, userId), resolveSpacePage(Astro.locals, "adminTokens")]);
const now = new Date();
const rows = tokens.map((token) => ({ ...token, status: tokenStatus(token, now) }));
const active = rows.filter((token) => token.status === "ACTIVE");
const confirming = confirmingAction(Astro.url, active.map((token) => revokeAction(token.id)));
const toRevoke = confirming ? active.find((token) => revokeAction(token.id) === confirming) : undefined;
const cancelHref = withoutConfirm(Astro.url);
---

<AdminLayout title="Personal access tokens" titlePrefix={actionError ? "Error: " : undefined} spaces={spaces}>
  <div class="flex max-w-5xl flex-col gap-8">
    <PageHeader title="Personal access tokens">
      An expiring credential for the command line or an automated check. A token acts as you, and can never do more than your account can.
    </PageHeader>

    {flash && <Notice tone={flash.tone} title={flash.title}>{flash.message}</Notice>}
    {actionError && <Notice tone="danger" focusOnLoad title="Nothing changed">{actionError}</Notice>}

    {
      created && (
        <Card as="section" aria-labelledby="new-token" className="flex flex-col gap-4">
          <div class="flex flex-col gap-1">
            <h2 id="new-token" class="text-lg text-ink-primary">
              Your new token: {created.label}
            </h2>
            <p class="max-w-prose text-sm text-ink-secondary">
              Copy it now: it won't be shown again. Keep it like a password, and send it only through a secret store, never in chat, logs,
              screenshots or a command's arguments.
            </p>
          </div>
          <div class="flex min-w-0 flex-col gap-3 sm:flex-row sm:items-start">
            <code id="personal-access-token" class="min-w-0 flex-1 rounded-xl bg-ink-primary/6 p-3 font-mono text-sm break-all text-ink-primary">
              {created.token}
            </code>
            <Button id="copy-personal-access-token" type="button" variant="quiet">Copy token</Button>
          </div>
          <p class="text-sm text-ink-secondary">
            Send it as the HTTP header <code class="font-mono">Authorization: Bearer &lt;token&gt;</code>.
          </p>
        </Card>
      )
    }

    <Card as="section" aria-labelledby="create-token" className="flex flex-col gap-4">
      <h2 id="create-token" class="text-lg text-ink-primary">Create a token</h2>
      <form method="POST" action={TOKENS_PATH} class="grid gap-4 sm:grid-cols-2">
        <input type="hidden" name="action" value="create" />
        <TextField
          label="Label"
          name="label"
          required
          maxLength={50}
          autocomplete="off"
          defaultValue={kept.label}
          error={fieldErrors.label}
          hint="What uses it, so you know which one to revoke: letters, numbers, spaces, dots, underscores and hyphens, up to 50."
          className="sm:col-span-2"
        />
        <SelectField
          label="Access"
          name="access"
          options={TOKEN_ACCESS_OPTIONS}
          defaultValue={kept.access}
          error={fieldErrors.access}
          hint="Choose read only unless the automation must change something. Admin read and write can make admin changes without a browser, and decide moderation cases through MCP. A channels token reads channels exactly as you see them, and with write posts, edits, reacts and reports as you; it never reaches admin pages or moderation decisions."
        />
        <SelectField
          label="Expires after"
          name="duration"
          options={TOKEN_EXPIRY_OPTIONS}
          defaultValue={kept.duration}
          error={fieldErrors.duration}
          hint="A month is 30 days. Every token stops working if you stop being an admin."
        />
        <div class="sm:col-span-2">
          <Button type="submit" variant="primary">Create token</Button>
        </div>
      </form>
    </Card>

    <section aria-labelledby="your-tokens" class="flex flex-col gap-4">
      <h2 id="your-tokens" class="text-lg text-ink-primary">Your tokens</h2>

      {
        toRevoke && (
          <ConfirmStep
            title={`Revoke “${toRevoke.label}”?`}
            confirmLabel="Revoke token"
            cancelHref={cancelHref}
            action={TOKENS_PATH}
            fields={{ action: "revoke", tokenId: toRevoke.id }}
          >
            Anything using it stops working at once, and it can't be turned back on. Make a new token if you need one again.
          </ConfirmStep>
        )
      }

      <DataTable
        caption="Your tokens"
        columns={[{ label: "Label" }, { label: "Token" }, { label: "Access" }, { label: "Last used" }, { label: "Expires" }, { label: "Status" }, { label: "Action", align: "end" }]}
        isEmpty={rows.length === 0}
      >
        {
          rows.map((token) => (
            <DataRow current={token.id === toRevoke?.id}>
              <DataCell label="Label" primary>
                {token.label}
              </DataCell>
              <DataCell label="Token">
                <code class="font-mono text-[0.8125rem]">{token.tokenPrefix}</code>
              </DataCell>
              <DataCell label="Access">{tokenAccessLabel(token.scopes)}</DataCell>
              <DataCell label="Last used">{token.lastUsedAt ? formatMomentDateTime(token.lastUsedAt) : "Never"}</DataCell>
              <DataCell label="Expires">{formatMomentDateTime(token.expiresAt)}</DataCell>
              <DataCell label="Status">
                <StatusChip domain="token" status={token.status} />
              </DataCell>
              <DataCell label="Action" align="end">
                {token.status === "ACTIVE" ? (
                  <RowAction href={confirmHref(Astro.url, revokeAction(token.id))} row={token.label}>Revoke</RowAction>
                ) : (
                  <span class="text-ink-secondary">None</span>
                )}
              </DataCell>
            </DataRow>
          ))
        }
        <Fragment slot="empty">
          <EmptyState title="No tokens yet" headingLevel={3}>
            Tokens you create appear here, with their access and when they stop working.
          </EmptyState>
        </Fragment>
      </DataTable>
    </section>
  </div>

  {
    created && (
      <script>
        document.getElementById("copy-personal-access-token")?.addEventListener("click", async () => {
          const token = document.getElementById("personal-access-token")?.textContent?.trim();
          if (token) await navigator.clipboard.writeText(token);
        });
      </script>
    )
  }
</AdminLayout>
