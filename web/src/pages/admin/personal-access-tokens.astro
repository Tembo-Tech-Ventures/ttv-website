---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { env } from "cloudflare:workers";
import { hasMatchingRequestOrigin } from "@/lib/admin/mutation-security";
import { isAgentSession } from "@/lib/agent-auth";
import {
  createPersonalAccessToken,
  listPersonalAccessTokens,
  parsePersonalAccessTokenDuration,
  parsePersonalAccessTokenScopes,
  revokePersonalAccessToken,
} from "@/lib/personal-access-tokens";

Astro.response.headers.set("Cache-Control", "no-store");

const userId = Astro.locals.user?.id;
if (!userId) return Astro.redirect("/auth/login");
if (
  Astro.locals.personalAccessToken ||
  isAgentSession(Astro.locals.session?.userAgent)
) {
  return new Response(
    "Forbidden: delegated credentials cannot manage personal access tokens.",
    { status: 403 }
  );
}

let createdToken: string | undefined;
let message: string | undefined;
let error: string | undefined;

if (Astro.request.method === "POST") {
  try {
    if (!hasMatchingRequestOrigin(Astro.request)) {
      throw new Error("The request origin could not be verified.");
    }

    const formData = await Astro.request.formData();
    const action = String(formData.get("action") ?? "");
    if (action === "create") {
      const created = await createPersonalAccessToken({
        db: env.DB,
        userId,
        label: String(formData.get("label") ?? ""),
        durationHours: parsePersonalAccessTokenDuration(
          formData.get("duration")
        ),
        scopes: parsePersonalAccessTokenScopes(formData.get("access")),
      });
      createdToken = created.token;
      message = `Created ${created.label}. Copy the token now; it will not be shown again.`;
    } else if (action === "revoke") {
      const revoked = await revokePersonalAccessToken(
        env.DB,
        userId,
        String(formData.get("tokenId") ?? "")
      );
      message = revoked ? "Personal access token revoked." : "That active token was not found.";
    } else {
      throw new Error("Unsupported personal access token action.");
    }
  } catch (caught) {
    error = caught instanceof Error ? caught.message : "Token update failed.";
  }
}

const tokens = await listPersonalAccessTokens(env.DB, userId);
const now = new Date();
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en", {
    dateStyle: "medium",
    timeStyle: "short",
    timeZone: "UTC",
  }).format(date);
const tokenState = (expiresAt: Date, revokedAt: Date | null) => {
  if (revokedAt) return "Revoked";
  if (expiresAt <= now) return "Expired";
  return "Active";
};
---

<AdminLayout title="Personal Access Tokens">
  <div class="max-w-5xl space-y-6">
    <div>
      <h2 class="text-2xl font-bold text-white">Personal Access Tokens</h2>
      <p class="mt-2 max-w-3xl text-sm text-ink-secondary">
        Create an expiring credential for command-line or automated verification.
        A token acts as your current account and cannot grant roles you do not have.
      </p>
    </div>

    {message && (
      <div class="rounded-lg border border-emerald-400/30 bg-emerald-400/10 p-4 text-sm text-emerald-100">
        {message}
      </div>
    )}
    {error && (
      <div class="rounded-lg border border-red-400/30 bg-red-400/10 p-4 text-sm text-red-100">
        {error}
      </div>
    )}

    {createdToken && (
      <section class="rounded-lg border border-primary/40 bg-dark/80 p-5 shadow-lg">
        <h3 class="font-semibold text-white">One-time token</h3>
        <p class="mt-1 text-sm text-ink-secondary">
          Store this like a password. Send it only through a secure secret channel,
          never in chat, logs, screenshots, or a command argument.
        </p>
        <div class="mt-4 flex items-start gap-3">
          <code
            id="personal-access-token"
            class="min-w-0 flex-1 break-all rounded-md bg-black/30 p-3 text-sm text-primary"
          >{createdToken}</code>
          <button
            id="copy-personal-access-token"
            type="button"
            class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-dark hover:bg-primary/90"
          >Copy</button>
        </div>
        <p class="mt-3 text-xs text-ink-muted">
          Use the HTTP header <code>Authorization: Bearer &lt;token&gt;</code>.
        </p>
      </section>
    )}

    <section class="rounded-lg border border-teal/20 bg-dark/80 p-5 shadow-lg">
      <h3 class="text-lg font-semibold text-white">Create a token</h3>
      <form method="POST" class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-[minmax(0,1fr)_auto_auto_auto] lg:items-end">
        <input type="hidden" name="action" value="create" />
        <label class="flex flex-col gap-1.5 text-sm text-white/80">
          Label
          <input
            name="label"
            required
            maxlength="50"
            autocomplete="off"
            placeholder="SAM production verifier"
            class="rounded-md border border-teal bg-dark/50 px-3 py-2 text-white placeholder:text-ink-muted focus:border-primary focus:outline-none"
          />
        </label>
        <label class="flex flex-col gap-1.5 text-sm text-white/80">
          Access
          <select
            name="access"
            class="rounded-md border border-teal bg-dark/50 px-3 py-2 text-white focus:border-primary focus:outline-none"
          >
            <option value="read" selected>Read only</option>
            <option value="write">Read and write</option>
          </select>
        </label>
        <label class="flex flex-col gap-1.5 text-sm text-white/80">
          Expires
          <select
            name="duration"
            class="rounded-md border border-teal bg-dark/50 px-3 py-2 text-white focus:border-primary focus:outline-none"
          >
            <option value="8" selected>8 hours</option>
            <option value="24">1 day</option>
            <option value="168">7 days</option>
            <option value="720">30 days</option>
          </select>
        </label>
        <button
          type="submit"
          class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-dark hover:bg-primary/90"
        >Create token</button>
      </form>
      <p class="mt-3 text-xs text-ink-muted">
        Read/write tokens can submit admin changes without a browser Origin header.
        Prefer read-only unless the automation must perform a specific mutation.
      </p>
    </section>

    <section class="rounded-lg border border-teal/20 bg-dark/80 p-5 shadow-lg">
      <h3 class="text-lg font-semibold text-white">Issued tokens</h3>
      {tokens.length === 0 ? (
        <p class="mt-3 text-sm text-ink-muted">No personal access tokens have been issued.</p>
      ) : (
        <div class="mt-4 overflow-x-auto">
          <table class="w-full min-w-[760px] text-left text-sm">
            <thead class="border-b border-teal/20 text-ink-muted">
              <tr>
                <th class="pb-2 pr-4 font-medium">Label</th>
                <th class="pb-2 pr-4 font-medium">Token</th>
                <th class="pb-2 pr-4 font-medium">Access</th>
                <th class="pb-2 pr-4 font-medium">Last used</th>
                <th class="pb-2 pr-4 font-medium">Expires (UTC)</th>
                <th class="pb-2 pr-4 font-medium">Status</th>
                <th class="pb-2 text-right font-medium">Action</th>
              </tr>
            </thead>
            <tbody>
              {tokens.map((token) => {
                const state = tokenState(token.expiresAt, token.revokedAt);
                return (
                  <tr class="border-b border-teal/10 text-white/75">
                    <td class="py-3 pr-4 font-medium text-white">{token.label}</td>
                    <td class="py-3 pr-4 font-mono text-xs">{token.tokenPrefix}</td>
                    <td class="py-3 pr-4">
                      {token.scopes.includes("admin:write") ? "Read/write" : "Read only"}
                    </td>
                    <td class="py-3 pr-4">
                      {token.lastUsedAt ? formatDate(token.lastUsedAt) : "Never"}
                    </td>
                    <td class="py-3 pr-4">{formatDate(token.expiresAt)}</td>
                    <td class="py-3 pr-4">{state}</td>
                    <td class="py-3 text-right">
                      {state === "Active" ? (
                        <form method="POST">
                          <input type="hidden" name="action" value="revoke" />
                          <input type="hidden" name="tokenId" value={token.id} />
                          <button
                            type="submit"
                            class="rounded-md border border-red-400/30 px-3 py-1.5 text-red-200 hover:bg-red-400/10"
                          >Revoke</button>
                        </form>
                      ) : (
                        <span class="text-ink-muted">—</span>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </section>
  </div>

  {createdToken && (
    <script>
      document
        .getElementById("copy-personal-access-token")
        ?.addEventListener("click", async () => {
          const token = document
            .getElementById("personal-access-token")
            ?.textContent?.trim();
          if (token) await navigator.clipboard.writeText(token);
        });
    </script>
  )}
</AdminLayout>
