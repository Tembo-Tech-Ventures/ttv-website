---
import { env } from "cloudflare:workers";
import { drizzle } from "drizzle-orm/d1";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";
import {
  Button,
  ButtonLink,
  Card,
  DataCell,
  DataList,
  DataListItem,
  DataRow,
  DataTable,
  EmptyState,
  Notice,
  PageHeader,
  Pager,
  PillNav,
  StatusChip,
  linkClass,
  statusTone,
} from "@/components/platform/ui";
import { lastPage as lastPageOf, pageHref, pageSummary, parsePage } from "@/lib/admin/paging";
import {
  PROFILES_PATH,
  PROFILE_DONE,
  PROFILE_STATUSES,
  moderateProfile,
  parseProfileStatus,
  profileActionLabel,
  profileActionsFor,
  profileReviewReasons,
  readProfilesPage,
  type ProfileStatus,
} from "@/lib/admin/profiles";
import * as schema from "@/lib/db/schema";
import { formatMomentDate } from "@/lib/display-date";
import { redirectWithFlash, takeFlash } from "@/lib/platform/server/flash";
import { parseAdminProfileAction, parseAdminProfileVersion } from "@/lib/talent/profile-moderation";

/*
 * Builder profiles: first the ones the content check left for a person, each
 * with only the actions that would change it; then every profile, a page at a
 * time, filtered by status through links so the filter has an address.
 */
const db = drizzle(env.DB, { schema });
// Forms post back to this address, filter and page included, never with a #fragment.
const here = `${Astro.url.pathname}${Astro.url.search}`;
let actionError: string | undefined;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const profileId = formData.get("profileId");
  const action = parseAdminProfileAction(formData.get("_action"));
  const expectedVersion = parseAdminProfileVersion(formData.get("contentVersion"));
  if (typeof profileId !== "string" || !profileId || !action || expectedVersion === null) {
    actionError = "Choose one of the publishing actions on this page.";
    Astro.response.status = 400;
  } else {
    const result = await moderateProfile(db, { profileId, action, expectedVersion }).catch(() => "unavailable" as const);
    if (result === "done") return redirectWithFlash(Astro, here, { tone: "success", title: PROFILE_DONE[action] });
    if (result === "missing") return redirectWithFlash(Astro, here, { tone: "info", title: "That profile no longer exists" });
    if (result === "unavailable") {
      actionError = "The database didn't answer, so nothing changed. Try again in a moment.";
      Astro.response.status = 503;
    } else {
      actionError = "The builder changed this profile while you were looking at it. Check it below before acting again.";
      Astro.response.status = 409;
    }
  }
}

const statusFilter = parseProfileStatus(Astro.url.searchParams.get("status"));
const page = parsePage(Astro.url.searchParams.get("page"));
const flash = takeFlash(Astro);
const [{ rows, total, review }, spaces] = await Promise.all([
  readProfilesPage(db, { status: statusFilter, page }),
  resolveSpacePage(Astro.locals, "adminProfiles"),
]);

const lastPage = lastPageOf(total);
const statusLabel = (status: ProfileStatus) => statusTone("profile", status).label;
const filterName = statusFilter ? statusLabel(statusFilter).toLowerCase() : null;
const filters = [
  { label: "All", href: PROFILES_PATH, current: !statusFilter },
  ...PROFILE_STATUSES.map((status) => ({
    label: statusLabel(status),
    href: `${PROFILES_PATH}?status=${status}`,
    current: statusFilter === status,
  })),
];
const reviewSections = [
  {
    id: "held",
    title: "Held by the content check",
    description: "Not public, unless an earlier version was already live. Publish it, hide it, or clear the flag to leave it as it is.",
    empty: "Nothing is held by the content check.",
    profiles: review.held,
  },
  {
    id: "unavailable",
    title: "Published while the check was unavailable",
    description: "These went live without a check. Read each one, then clear the flag or unpublish it.",
    empty: "Nothing published without a check.",
    profiles: review.unavailable,
  },
];
const caption = filterName ? `Profiles, ${filterName}` : "Profiles";
const title = page === 1 ? caption : `${caption}, page ${page}`;
---

<AdminLayout title={title} titlePrefix={actionError ? "Error: " : undefined} spaces={spaces}>
  <div class="flex flex-col gap-8">
    <PageHeader title="Profiles">Builders' public profiles. Open one to read all of it, publish it or hide it.</PageHeader>

    {flash && <Notice tone={flash.tone} title={flash.title}>{flash.message}</Notice>}
    {actionError && <Notice tone="danger" focusOnLoad title="Nothing changed">{actionError}</Notice>}

    {
      reviewSections.map((section) => (
        <Card as="section" aria-labelledby={`review-${section.id}`} className="flex flex-col gap-4">
          <div class="flex flex-col gap-1">
            <h2 id={`review-${section.id}`} class="text-lg text-ink-primary">
              {section.title}
            </h2>
            <p class="max-w-prose text-sm text-ink-secondary">{section.description}</p>
          </div>
          <DataList label={section.title} isEmpty={section.profiles.length === 0}>
            {section.profiles.map((profile) => (
              <DataListItem title={profile.user?.name ?? profile.handle} href={`${PROFILES_PATH}/${profile.id}`} meta={`/talent/${profile.handle}`}>
                <Fragment slot="status">
                  <StatusChip domain="profile" status={profile.status} />
                </Fragment>
                <ul class="m-0 flex list-disc flex-col gap-1 pl-5 text-sm text-ink-secondary">
                  {profileReviewReasons(profile).map((reason) => (
                    <li>{reason}</li>
                  ))}
                </ul>
                <Fragment slot="actions">
                  <div class="flex flex-wrap gap-2">
                    {profileActionsFor(profile).map((action) => (
                      <form method="POST" action={here}>
                        <input type="hidden" name="profileId" value={profile.id} />
                        <input type="hidden" name="_action" value={action} />
                        <input type="hidden" name="contentVersion" value={profile.contentVersion} />
                        <Button type="submit" size="sm" variant="quiet">
                          {profileActionLabel(action, profile.status)}
                          <span class="sr-only"> {profile.user?.name ?? profile.handle}</span>
                        </Button>
                      </form>
                    ))}
                  </div>
                </Fragment>
              </DataListItem>
            ))}
            <Fragment slot="empty">
              <EmptyState title={section.empty} headingLevel={3} />
            </Fragment>
          </DataList>
        </Card>
      ))
    }

    <section aria-labelledby="all-profiles" class="flex flex-col gap-4">
      <h2 id="all-profiles" class="text-lg text-ink-primary">All profiles</h2>
      <PillNav label="Profile status" items={filters} />

      <DataTable
        caption={page === 1 ? caption : `${caption}, page ${page} of ${lastPage}`}
        columns={[{ label: "Builder" }, { label: "Handle" }, { label: "Status" }, { label: "Updated" }, { label: "Published", align: "end" }]}
        isEmpty={rows.length === 0}
      >
        {
          rows.map((profile) => (
            <DataRow>
              <DataCell label="Builder" primary>
                <span class="flex min-w-0 flex-col">
                  <a href={`${PROFILES_PATH}/${profile.id}`} class={linkClass()}>
                    {profile.user?.name ?? profile.handle}
                  </a>
                  {profile.user?.email && <span class="text-sm font-normal text-ink-secondary">{profile.user.email}</span>}
                </span>
              </DataCell>
              <DataCell label="Handle">/talent/{profile.handle}</DataCell>
              <DataCell label="Status">
                <StatusChip domain="profile" status={profile.status} />
              </DataCell>
              <DataCell label="Updated">{profile.updatedAt ? formatMomentDate(profile.updatedAt) : "Not recorded"}</DataCell>
              <DataCell label="Published" align="end">
                {profile.publishedAt ? formatMomentDate(profile.publishedAt) : "Never"}
              </DataCell>
            </DataRow>
          ))
        }
        <Fragment slot="empty">
          {
            page > 1 && total > 0 ? (
              <EmptyState title="No profiles on this page" headingLevel={3}>
                The list has {lastPage} {lastPage === 1 ? "page" : "pages"}.
                <Fragment slot="action">
                  <ButtonLink href={pageHref(Astro.url, 1)}>Back to the first page</ButtonLink>
                </Fragment>
              </EmptyState>
            ) : filterName ? (
              <EmptyState title={`No ${filterName} profiles`} headingLevel={3}>
                Profiles move here when a builder or an administrator changes them.
                <Fragment slot="action">
                  <ButtonLink href={PROFILES_PATH}>See every profile</ButtonLink>
                </Fragment>
              </EmptyState>
            ) : (
              <EmptyState title="No profiles yet" headingLevel={3}>
                Profiles appear here when builders create them.
              </EmptyState>
            )
          }
        </Fragment>
      </DataTable>

      <Pager
        previousHref={page > 1 && rows.length > 0 ? pageHref(Astro.url, page - 1) : null}
        nextHref={page < lastPage ? pageHref(Astro.url, page + 1) : null}
        summary={pageSummary(page, rows.length, total)}
        label="Profile pages"
      />
    </section>
  </div>
</AdminLayout>
