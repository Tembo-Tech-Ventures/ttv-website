---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Card from "@/components/common/Card.astro";
import Badge from "@/components/common/Badge.astro";
import { drizzle } from "drizzle-orm/d1";
import * as schema from "@/lib/db/schema";
import { eq, count } from "drizzle-orm";
import { env } from "cloudflare:workers";
import { getCompletedCohorts } from "@/lib/talent/eligibility";
import { parseSkillsJson } from "@/lib/talent/profile";
import {
  parseAdminProfileAction,
  parseModerationFlags,
  parseModerationScores,
  resolveAdminProfileUpdate,
} from "@/lib/talent/profile-moderation";
import {
  PROFILE_MODERATION_LABELS,
  PROFILE_MODERATION_MESSAGES,
  type ProfileModerationFlag,
} from "@/lib/moderation/clef";
import {
  moderatePost,
  normalizeAdminNote,
  parsePostModerationAction,
} from "@/lib/blog/moderation";
import { postPath } from "@/lib/blog/feed";

const db = drizzle(env.DB, { schema });
const { id } = Astro.params;

if (!id) return Astro.redirect("/admin/profiles");

let actionError: string | undefined;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  if (formData.get("_action") === "moderate-post") {
    const postId = formData.get("postId");
    const action = parsePostModerationAction(formData.get("postAction"));
    if (typeof postId !== "string" || !action) {
      actionError = "Invalid post moderation request.";
      Astro.response.status = 400;
    } else {
      const result = await moderatePost(db, {
        profileId: id,
        postId,
        action,
        adminNote: normalizeAdminNote(formData.get("adminNote")),
      });
      if (!result.success) {
        actionError = result.error;
        Astro.response.status = 409;
      } else {
        return Astro.redirect(`/admin/profiles/${id}#posts`);
      }
    }
  } else if (formData.get("_action") === "moderate-profile") {
    const action = parseAdminProfileAction(formData.get("profileAction"));
    const current = await db.query.studentProfile.findFirst({
      where: eq(schema.studentProfile.id, id),
      columns: {
        status: true,
        publishedAt: true,
        publicName: true,
        publicAvatarUrl: true,
      },
      with: { user: { columns: { name: true, image: true } } },
    });

    if (!current) return Astro.redirect("/admin/profiles");
    if (!action) {
      actionError = "Invalid profile moderation request.";
      Astro.response.status = 400;
    } else {
      await db
        .update(schema.studentProfile)
        .set(resolveAdminProfileUpdate(current, action))
        .where(eq(schema.studentProfile.id, id));

      return Astro.redirect(`/admin/profiles/${id}`);
    }
  } else {
    actionError = "Invalid moderation request.";
    Astro.response.status = 400;
  }
}

const profile = await db.query.studentProfile.findFirst({
  where: eq(schema.studentProfile.id, id),
  with: {
    user: true,
    highlights: { orderBy: (h, { asc }) => [asc(h.sortOrder)] },
    posts: { orderBy: (post, { desc }) => [desc(post.updatedAt)] },
  },
});

if (!profile) return Astro.redirect("/admin/profiles");

const cohorts = await getCompletedCohorts(db, profile.userId);

const [leadsResult] = await db
  .select({ value: count() })
  .from(schema.profileContact)
  .where(eq(schema.profileContact.profileId, profile.id));
const leadsCount = leadsResult?.value ?? 0;

const skills = parseSkillsJson(profile.skills);
const moderationFlags = parseModerationFlags(profile.moderationFlags);
const moderationScores = parseModerationScores(profile.moderationScores);
const moderationScoreRows = Object.entries(moderationScores) as [
  ProfileModerationFlag,
  number,
][];
const moderationOutcomeLabel = profile.moderationOutcome
  ? {
      pass: "Passed",
      hold: "Held",
      error: "Check unavailable",
    }[profile.moderationOutcome]
  : null;
---

<AdminLayout title="Profile Detail">
  <div class="space-y-6">
    <a href="/admin/profiles" class="text-sm text-primary hover:underline">
      &larr; Back to Profiles
    </a>

    {actionError && (
      <p
        role="alert"
        class="rounded-md border border-red-400/40 bg-red-500/15 px-4 py-3 text-sm text-red-100"
      >
        {actionError}
      </p>
    )}

    <div class="flex items-center gap-3">
      <h2 class="text-2xl font-bold text-white">Profile</h2>
      <Badge
        variant={
          profile.status.toLowerCase() as
            | "draft"
            | "published"
            | "suspended"
        }
      />
    </div>

    {profile.moderationOutcome && (
      <Card>
        <h3 class="mb-2 text-lg font-semibold text-white">Content check</h3>
        <p class="text-sm text-ink-secondary">
          Outcome: <span class="font-medium text-white">{moderationOutcomeLabel}</span>
          {profile.moderationCheckedAt && (
            <> · {new Date(profile.moderationCheckedAt).toLocaleString()}</>
          )}
        </p>
        {moderationFlags.length > 0 ? (
          <ul class="mt-3 space-y-2 text-sm text-ink-secondary">
            {moderationFlags.map((flag) => (
              <li>{PROFILE_MODERATION_MESSAGES[flag]}</li>
            ))}
          </ul>
        ) : profile.moderationOutcome === "error" ? (
          <p class="mt-3 text-sm text-ink-secondary">
            The check was unavailable. The profile published automatically and was flagged for this review.
          </p>
        ) : null}
        {moderationScoreRows.length > 0 && (
          <dl class="mt-4 grid gap-2 text-sm sm:grid-cols-2">
            {moderationScoreRows.map(([flag, score]) => (
              <div class="flex items-center justify-between gap-3 rounded-md bg-dark/40 px-3 py-2">
                <dt class="text-ink-secondary">{PROFILE_MODERATION_LABELS[flag]}</dt>
                <dd class="font-mono text-white">{Math.round(score * 100)}%</dd>
              </div>
            ))}
          </dl>
        )}
      </Card>
    )}

    <div class="grid gap-6 lg:grid-cols-2">
      <Card>
        <h3 class="mb-4 text-lg font-semibold text-white">Owner</h3>
        <dl class="space-y-2 text-sm">
          <div class="flex justify-between">
            <dt class="text-ink-secondary">Name</dt>
            <dd class="text-white">{profile.user?.name ?? "Unknown"}</dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-ink-secondary">Email</dt>
            <dd class="text-white">{profile.user?.email ?? "—"}</dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-ink-secondary">GitHub</dt>
            <dd class="text-white">{profile.githubLogin ?? "—"}</dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-ink-secondary">Handle</dt>
            <dd class="font-mono text-white">{profile.handle}</dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-ink-secondary">Leads</dt>
            <dd class="text-white">{leadsCount}</dd>
          </div>
        </dl>
      </Card>

      <Card>
        <h3 class="mb-4 text-lg font-semibold text-white">Completed Cohorts</h3>
        {cohorts.length === 0 ? (
          <p class="text-sm text-ink-muted">No completed cohorts.</p>
        ) : (
          <ul class="space-y-2 text-sm">
            {cohorts.map((c) => (
              <li class="text-white">
                {c.program?.name ?? "Unknown program"}
                {c.application.completedAt && (
                  <span class="ml-2 text-ink-muted">
                    completed{" "}
                    {new Date(c.application.completedAt).toLocaleDateString()}
                  </span>
                )}
              </li>
            ))}
          </ul>
        )}
      </Card>
    </div>

    <Card>
      <h3 class="mb-4 text-lg font-semibold text-white">
        How this will appear publicly
      </h3>

      <div class="space-y-4">
        {profile.headline && (
          <p class="text-lg font-medium text-white">{profile.headline}</p>
        )}

        {profile.bio && <p class="text-sm text-white/80">{profile.bio}</p>}

        <div class="flex flex-wrap gap-4 text-sm text-ink-secondary">
          {profile.location && <span>📍 {profile.location}</span>}
          {profile.country && <span>{profile.country}</span>}
        </div>

        {skills.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {skills.map((skill) => (
              <span class="rounded-full bg-teal/20 px-3 py-1 text-xs font-medium text-white/80">
                {skill}
              </span>
            ))}
          </div>
        )}

        <div class="flex flex-wrap gap-4 text-sm text-ink-secondary">
          {profile.openToFreelance && <span>Open to freelance</span>}
          {profile.openToRoles && <span>Open to roles</span>}
          {!profile.openToFreelance && !profile.openToRoles && (
            <span>Availability not specified</span>
          )}
        </div>

        <div class="flex flex-wrap gap-4 text-sm">
          {profile.portfolioUrl && (
            <a
              href={profile.portfolioUrl}
              class="text-primary hover:underline"
              target="_blank"
              rel="noopener noreferrer"
            >
              Portfolio
            </a>
          )}
          {profile.linkedinUrl && (
            <a
              href={profile.linkedinUrl}
              class="text-primary hover:underline"
              target="_blank"
              rel="noopener noreferrer"
            >
              LinkedIn
            </a>
          )}
        </div>
      </div>
    </Card>

    {profile.highlights.length > 0 && (
      <Card>
        <h3 class="mb-4 text-lg font-semibold text-white">
          Highlighted Projects
        </h3>
        <div class="space-y-4">
          {profile.highlights.map((h) => (
            <div class="rounded-md border border-teal/10 p-4">
              <div class="flex items-start justify-between">
                <a
                  href={h.repoUrl}
                  class="font-medium text-primary hover:underline"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {h.repoFullName}
                </a>
                <span class="text-xs text-ink-muted">
                  {h.stars > 0 && `★ ${h.stars}`}
                  {h.language && (
                    <span class="ml-2">{h.language}</span>
                  )}
                </span>
              </div>
              {h.description && (
                <p class="mt-1 text-sm text-ink-secondary">{h.description}</p>
              )}
              {h.blurb && (
                <p class="mt-1 text-sm italic text-white/80">{h.blurb}</p>
              )}
            </div>
          ))}
        </div>
      </Card>
    )}

    <div id="posts">
      <Card>
        <h3 class="mb-4 text-lg font-semibold text-white">Posts</h3>
        {profile.posts.length === 0 ? (
          <p class="text-sm text-ink-muted">No posts from this builder.</p>
        ) : (
          <div class="space-y-4">
            {profile.posts.map((post) => (
              <section class="rounded-lg border border-teal/15 p-4" aria-label={post.title}>
                <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                  <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-2">
                      <h4 class="font-medium text-white">{post.title}</h4>
                      <Badge
                        variant={post.status.toLowerCase() as "draft" | "published" | "suspended"}
                      />
                    </div>
                    <p class="mt-1 break-all font-mono text-xs text-ink-muted">
                      /blog/{profile.handle}/{post.slug}
                    </p>
                    {post.adminNote && (
                      <p class="mt-2 text-sm text-ink-secondary">
                        Admin note: {post.adminNote}
                      </p>
                    )}
                  </div>
                  {post.status === "PUBLISHED" && (
                    <a
                      href={postPath(profile.handle, post.slug)}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="shrink-0 text-sm font-medium text-primary hover:underline"
                    >
                      View live
                    </a>
                  )}
                </div>

                {(post.status === "PUBLISHED" || post.status === "SUSPENDED") && (
                  <form method="POST" class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-end">
                    <input type="hidden" name="_action" value="moderate-post" />
                    <input type="hidden" name="postId" value={post.id} />
                    <input
                      type="hidden"
                      name="postAction"
                      value={post.status === "PUBLISHED" ? "suspend" : "restore"}
                    />
                    <label class="min-w-0 flex-1 text-xs font-medium uppercase tracking-wider text-ink-muted">
                      Admin note <span class="normal-case tracking-normal">(optional)</span>
                      <input
                        name="adminNote"
                        type="text"
                        maxlength="1000"
                        value={post.adminNote ?? ""}
                        class="mt-1.5 block w-full rounded-md border border-teal/20 bg-dark px-3 py-2 text-sm font-normal normal-case tracking-normal text-white outline-none focus:border-primary"
                      />
                    </label>
                    <button
                      type="submit"
                      class:list={[
                        "shrink-0 rounded-md px-4 py-2 text-sm font-medium text-white transition-colors",
                        post.status === "PUBLISHED"
                          ? "bg-red-600 hover:bg-red-700"
                          : "bg-green-600 hover:bg-green-700",
                      ]}
                    >
                      {post.status === "PUBLISHED" ? "Suspend post" : "Restore post"}
                    </button>
                  </form>
                )}
              </section>
            ))}
          </div>
        )}
      </Card>
    </div>

    <Card>
      <h3 class="mb-4 text-lg font-semibold text-white">Actions</h3>
      <div class="flex flex-wrap gap-2">
        {profile.status !== "PUBLISHED" && (
          <form method="POST">
            <input type="hidden" name="_action" value="moderate-profile" />
            <input type="hidden" name="profileAction" value="publish" />
            <button type="submit" class="rounded-md bg-green-600 px-4 py-2 text-sm font-medium text-white hover:bg-green-700">
              {profile.status === "SUSPENDED" ? "Republish" : "Publish"}
            </button>
          </form>
        )}
        {profile.status !== "SUSPENDED" && (
          <form method="POST">
            <input type="hidden" name="_action" value="moderate-profile" />
            <input type="hidden" name="profileAction" value="unpublish" />
            <button type="submit" class="rounded-md bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700">
              Unpublish
            </button>
          </form>
        )}
        {profile.moderationReviewRequired && (
          <form method="POST">
            <input type="hidden" name="_action" value="moderate-profile" />
            <input type="hidden" name="profileAction" value="clear_flag" />
            <button type="submit" class="rounded-md bg-teal/30 px-4 py-2 text-sm font-medium text-white hover:bg-teal/40">
              Clear flag
            </button>
          </form>
        )}
      </div>
    </Card>
  </div>
</AdminLayout>
