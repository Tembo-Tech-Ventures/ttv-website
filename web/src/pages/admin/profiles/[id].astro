---
import { PiMapPin } from "react-icons/pi";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";
import {
  BackLink,
  Button,
  Card,
  Chip,
  DescriptionItem,
  DescriptionList,
  Notice,
  PageHeader,
  StatusChip,
  TextField,
  linkClass,
} from "@/components/platform/ui";
import { drizzle } from "drizzle-orm/d1";
import * as schema from "@/lib/db/schema";
import { eq, count } from "drizzle-orm";
import { env } from "cloudflare:workers";
import { getCompletedCohorts } from "@/lib/talent/eligibility";
import { parseSkillsJson } from "@/lib/talent/profile";
import {
  applyAdminProfileAction,
  parseAdminProfileAction,
  parseAdminProfileVersion,
  parseModerationFlags,
} from "@/lib/talent/profile-moderation";
import { PROFILE_MODERATION_MESSAGES } from "@/lib/moderation/clef";
import {
  moderatePost,
  normalizeAdminNote,
  parsePostModerationAction,
} from "@/lib/blog/moderation";
import { postPath } from "@/lib/blog/feed";
import { redirectWithFlash, takeFlash } from "@/lib/platform/server/flash";
import { formatCalendarDate, formatMomentDate } from "@/lib/display-date";

const LIST_PATH = "/admin/profiles";
const db = drizzle(env.DB, { schema });
const { id } = Astro.params;

if (!id) return Astro.redirect(LIST_PATH);

const PROFILE_DONE = { publish: "Profile published", unpublish: "Profile unpublished", clear_flag: "Flag cleared" } as const;
let actionError: string | undefined;
// A rejected post action keeps the note typed for that post.
let postedNote: { postId: string; note: string } | undefined;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  if (formData.get("_action") === "moderate-post") {
    const postId = formData.get("postId");
    const action = parsePostModerationAction(formData.get("postAction"));
    const note = formData.get("adminNote");
    if (typeof postId === "string" && typeof note === "string") postedNote = { postId, note };
    if (typeof postId !== "string" || !action) {
      actionError = "Choose suspend or restore for one of the posts below.";
      Astro.response.status = 400;
    } else {
      const result = await moderatePost(db, {
        profileId: id,
        postId,
        action,
        adminNote: normalizeAdminNote(note),
      });
      if (!result.success) {
        actionError = `${result.error} Its status below is the current one.`;
        Astro.response.status = 409;
      } else {
        return redirectWithFlash(Astro, `${Astro.url.pathname}#posts`, {
          tone: "success",
          title: action === "suspend" ? "Post suspended" : "Post restored",
        });
      }
    }
  } else if (formData.get("_action") === "moderate-profile") {
    const action = parseAdminProfileAction(formData.get("profileAction"));
    const expectedVersion = parseAdminProfileVersion(
      formData.get("contentVersion"),
    );
    const current = await db.query.studentProfile.findFirst({
      where: eq(schema.studentProfile.id, id),
      columns: {
        status: true,
        publishedAt: true,
        contentVersion: true,
        publicName: true,
        publicAvatarUrl: true,
      },
      with: { user: { columns: { name: true, image: true } } },
    });

    if (!current) return Astro.redirect(LIST_PATH, 303);
    if (!action || expectedVersion === null) {
      actionError = "Choose one of the publishing actions below.";
      Astro.response.status = 400;
    } else {
      const updated = await applyAdminProfileAction(
        db,
        id,
        current,
        action,
        expectedVersion,
      );

      if (!updated) {
        actionError = "The builder changed this profile while you were looking at it. Check it below before acting again.";
        Astro.response.status = 409;
      } else {
        return redirectWithFlash(Astro, Astro.url.pathname, { tone: "success", title: PROFILE_DONE[action] });
      }
    }
  } else {
    actionError = "Choose one of the actions on this page.";
    Astro.response.status = 400;
  }
}

// The profile, its leads and the Admin space are independent reads: one round trip, not three.
const [profile, leadsResult, spaces] = await Promise.all([
  db.query.studentProfile.findFirst({
    where: eq(schema.studentProfile.id, id),
    with: {
      user: true,
      work: { orderBy: (h, { asc }) => [asc(h.sortOrder)] },
      posts: { orderBy: (post, { desc }) => [desc(post.updatedAt)] },
    },
  }),
  db.select({ value: count() }).from(schema.profileContact).where(eq(schema.profileContact.profileId, id)),
  resolveSpacePage(Astro.locals, "adminProfiles"),
]);

if (!profile) return Astro.redirect(LIST_PATH);

const cohorts = await getCompletedCohorts(db, profile.userId);
const leadsCount = leadsResult[0]?.value ?? 0;
const flash = Astro.request.method === "GET" ? takeFlash(Astro) : null;
const name = profile.publicName ?? profile.user?.name ?? profile.handle;
const skills = parseSkillsJson(profile.skills);
const moderationFlags = parseModerationFlags(profile.moderationFlags);
const moderationOutcomeLabel = profile.moderationOutcome
  ? {
      pass: "Passed",
      hold: "Held",
      error: "Check unavailable",
    }[profile.moderationOutcome]
  : null;
const NEW_TAB = " (opens in a new tab)";
const ROW_LINK = linkClass("inline-flex min-h-11 items-center text-sm");
---

<AdminLayout title={`${name} · profile`} titlePrefix={actionError ? "Error: " : ""} spaces={spaces}>
  <div class="space-y-6">
    <BackLink href={LIST_PATH}>Profiles</BackLink>

    <PageHeader title={name}>
      <span class="inline-flex flex-wrap items-center gap-x-3 gap-y-1">
        <StatusChip domain="profile" status={profile.status} />
        <span class="inline-flex flex-wrap items-center gap-x-1.5">Builder profile at <a href={`/talent/${profile.handle}`} class={ROW_LINK}>/talent/{profile.handle}</a></span>
      </span>
    </PageHeader>

    {flash && <Notice tone={flash.tone} title={flash.title}>{flash.message}</Notice>}
    {actionError && (
      <Notice tone="danger" focusOnLoad id="profile-failure" title="Nothing changed">
        {actionError}
      </Notice>
    )}

    {profile.moderationOutcome && (
      <Card>
        <div class="grid gap-4">
          <h2 class="text-lg text-ink-primary">Content check</h2>
          <DescriptionList>
            <DescriptionItem term="Outcome">{moderationOutcomeLabel}</DescriptionItem>
            {profile.moderationCheckedAt && (
              <DescriptionItem term="Checked">{formatMomentDate(profile.moderationCheckedAt)}</DescriptionItem>
            )}
            {profile.moderationReviewRequired && <DescriptionItem term="Review">Waiting for an admin</DescriptionItem>}
          </DescriptionList>
          {moderationFlags.length > 0 ? (
            <ul class="list-disc space-y-1 pl-5 text-sm text-ink-secondary">
              {moderationFlags.map((flag) => (
                <li>{PROFILE_MODERATION_MESSAGES[flag]}</li>
              ))}
            </ul>
          ) : profile.moderationOutcome === "error" ? (
            <p class="text-sm text-ink-secondary">
              The check was unavailable. The profile published automatically and was flagged for this review.
            </p>
          ) : null}
        </div>
      </Card>
    )}

    <div class="grid gap-6 lg:grid-cols-2">
      <Card>
        <div class="grid gap-4">
          <h2 class="text-lg text-ink-primary">Owner</h2>
          <DescriptionList>
            <DescriptionItem term="Name">
              <a href={`/admin/users/${profile.userId}`} class={linkClass()}>{profile.user?.name ?? "Unknown"}</a>
            </DescriptionItem>
            <DescriptionItem term="Email">{profile.user?.email ?? "Not recorded"}</DescriptionItem>
            <DescriptionItem term="GitHub">{profile.githubLogin ?? "Not connected"}</DescriptionItem>
            <DescriptionItem term="Handle"><span class="font-mono">{profile.handle}</span></DescriptionItem>
            <DescriptionItem term="Leads">{leadsCount}</DescriptionItem>
          </DescriptionList>
        </div>
      </Card>

      <Card>
        <div class="grid gap-4">
          <h2 class="text-lg text-ink-primary">Completed cohorts</h2>
          {cohorts.length === 0 ? (
            <p class="text-sm text-ink-secondary">None yet. A cohort shows here once its application is marked completed.</p>
          ) : (
            <DescriptionList>
              {cohorts.map((c) => (
                <DescriptionItem term={c.program?.name ?? "Unknown cohort"}>
                  {c.application.completedAt ? `Completed ${formatCalendarDate(c.application.completedAt)}` : "Completed"}
                </DescriptionItem>
              ))}
            </DescriptionList>
          )}
        </div>
      </Card>
    </div>

    <Card>
      <div class="grid gap-4">
        <h2 class="text-lg text-ink-primary">How it appears publicly</h2>
        {profile.headline && <p class="text-lg font-semibold text-ink-primary">{profile.headline}</p>}
        {profile.bio && <p class="whitespace-pre-line text-sm text-ink-secondary">{profile.bio}</p>}
        {(profile.location || profile.country) && (
          <p class="inline-flex items-center gap-1.5 text-sm text-ink-secondary">
            <PiMapPin className="size-4 shrink-0" aria-hidden="true" />
            {[profile.location, profile.country].filter(Boolean).join(", ")}
          </p>
        )}
        {skills.length > 0 && (
          <ul class="flex flex-wrap gap-2" aria-label="Skills">
            {skills.map((skill) => (
              <li><Chip>{skill}</Chip></li>
            ))}
          </ul>
        )}
        <p class="text-sm text-ink-secondary">
          {profile.openToFreelance && profile.openToRoles
            ? "Open to freelance work and to roles"
            : profile.openToFreelance
              ? "Open to freelance work"
              : profile.openToRoles
                ? "Open to roles"
                : "Availability not given"}
        </p>
        {(profile.portfolioUrl || profile.linkedinUrl) && (
          <p class="flex flex-wrap gap-x-6">
            {profile.portfolioUrl && (
              <a href={profile.portfolioUrl} class={ROW_LINK} target="_blank" rel="noopener noreferrer">
                Portfolio<span class="sr-only">{NEW_TAB}</span>
              </a>
            )}
            {profile.linkedinUrl && (
              <a href={profile.linkedinUrl} class={ROW_LINK} target="_blank" rel="noopener noreferrer">
                LinkedIn<span class="sr-only">{NEW_TAB}</span>
              </a>
            )}
          </p>
        )}
      </div>
    </Card>

    {profile.work.length > 0 && (
      <Card>
        <div class="grid gap-2">
          <h2 class="text-lg text-ink-primary">Highlighted projects</h2>
          <ul class="divide-y divide-hairline" data-highlights>
            {profile.work.map((h) => (
              <li class="grid gap-1 py-3 first:pt-0 last:pb-0">
                <div class="flex flex-wrap items-center justify-between gap-x-4">
                  <a href={h.repoUrl} class={ROW_LINK} target="_blank" rel="noopener noreferrer">
                    {h.repoFullName ?? h.title}<span class="sr-only">{NEW_TAB}</span>
                  </a>
                  <span class="text-xs text-ink-muted">
                    {[h.stars > 0 ? `${h.stars} ${h.stars === 1 ? "star" : "stars"}` : null, h.language].filter(Boolean).join(" · ")}
                  </span>
                </div>
                {h.description && <p class="text-sm text-ink-secondary">{h.description}</p>}
                {h.blurb && <p class="text-sm text-ink-primary">“{h.blurb}”</p>}
              </li>
            ))}
          </ul>
        </div>
      </Card>
    )}

    <Card>
      <div class="grid gap-2" id="posts">
        <h2 class="text-lg text-ink-primary">Posts</h2>
        {profile.posts.length === 0 ? (
          <p class="text-sm text-ink-secondary">None yet. The builder's posts show here as they write them.</p>
        ) : (
          <ul class="divide-y divide-hairline" data-posts>
            {profile.posts.map((post) => {
              const moderable = post.status === "PUBLISHED" || post.status === "SUSPENDED";
              const note = postedNote?.postId === post.id ? postedNote.note : post.adminNote ?? "";
              return (
                <li class="py-4 first:pt-2 last:pb-0">
                  <section aria-label={post.title} class="grid gap-3">
                    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
                      <div class="flex min-w-0 flex-wrap items-center gap-2">
                        <h3 class="text-base text-ink-primary">{post.title}</h3>
                        <StatusChip domain="profile" status={post.status} />
                      </div>
                      {post.status === "PUBLISHED" && (
                        <a href={postPath(profile.handle, post.slug)} class={ROW_LINK} target="_blank" rel="noopener noreferrer">
                          View live<span class="sr-only"> {post.title}{NEW_TAB}</span>
                        </a>
                      )}
                    </div>
                    <p class="break-all font-mono text-xs text-ink-muted">/blog/{profile.handle}/{post.slug}</p>
                    {post.adminNote && <p class="text-sm text-ink-secondary">Admin note: {post.adminNote}</p>}
                    {moderable && (
                      <form method="POST" action={Astro.url.pathname} class="flex flex-col gap-3 sm:flex-row sm:items-end">
                        <input type="hidden" name="_action" value="moderate-post" />
                        <input type="hidden" name="postId" value={post.id} />
                        <input type="hidden" name="postAction" value={post.status === "PUBLISHED" ? "suspend" : "restore"} />
                        <TextField
                          id={`admin-note-${post.id}`}
                          name="adminNote"
                          label="Admin note"
                          optional
                          maxLength={1000}
                          defaultValue={note}
                          className="min-w-0 flex-1"
                        />
                        <Button type="submit" variant="quiet">
                          {post.status === "PUBLISHED" ? "Suspend post" : "Restore post"}
                        </Button>
                      </form>
                    )}
                  </section>
                </li>
              );
            })}
          </ul>
        )}
      </div>
    </Card>

    <Card>
      <div class="grid gap-4">
        <h2 class="text-lg text-ink-primary">Publishing</h2>
        <p class="text-sm text-ink-secondary">
          {profile.status === "PUBLISHED"
            ? "Anyone can read it now. Unpublishing hides it at once; publishing brings it back."
            : profile.status === "SUSPENDED"
              ? "It's hidden from the public. Republishing shows it again as it is now."
              : "The builder hasn't published it yet."}
        </p>
        <div class="flex flex-wrap gap-2">
          {profile.status !== "PUBLISHED" && (
            <form method="POST" action={Astro.url.pathname}>
              <input type="hidden" name="_action" value="moderate-profile" />
              <input type="hidden" name="profileAction" value="publish" />
              <input type="hidden" name="contentVersion" value={profile.contentVersion} />
              <Button type="submit" variant="primary">{profile.status === "SUSPENDED" ? "Republish" : "Publish"}</Button>
            </form>
          )}
          {profile.status !== "SUSPENDED" && (
            <form method="POST" action={Astro.url.pathname}>
              <input type="hidden" name="_action" value="moderate-profile" />
              <input type="hidden" name="profileAction" value="unpublish" />
              <input type="hidden" name="contentVersion" value={profile.contentVersion} />
              <Button type="submit" variant="quiet">Unpublish</Button>
            </form>
          )}
          {profile.moderationReviewRequired && (
            <form method="POST" action={Astro.url.pathname}>
              <input type="hidden" name="_action" value="moderate-profile" />
              <input type="hidden" name="profileAction" value="clear_flag" />
              <input type="hidden" name="contentVersion" value={profile.contentVersion} />
              <Button type="submit" variant="quiet">Clear flag</Button>
            </form>
          )}
        </div>
      </div>
    </Card>
  </div>
</AdminLayout>
