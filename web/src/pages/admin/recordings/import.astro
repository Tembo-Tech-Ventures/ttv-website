---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";
import {
  BackLink,
  Button,
  ButtonLink,
  Card,
  Chip,
  ConfirmStep,
  DescriptionItem,
  DescriptionList,
  EmptyState,
  Notice,
  PageHeader,
  SelectField,
  TextField,
  confirmHref,
  confirmingAction,
  linkClass,
  withoutConfirm,
} from "@/components/platform/ui";
import { drizzle } from "drizzle-orm/d1";
import { eq } from "drizzle-orm";
import * as schema from "@/lib/db/schema";
import { env } from "cloudflare:workers";
import { createCredentialCipher } from "@/lib/credentials/crypto";
import { getGoogleDriveCredentials } from "@/lib/credentials/google-drive";
import {
  RecordingImportPreviewChangedError,
  previewRecordingImportSource,
  syncRecordingImportSource,
  type RecordingImportPreview,
} from "@/lib/recordings/importer";
import { redirectWithFlash, takeFlash } from "@/lib/platform/server/flash";
import { formatMomentDateTime } from "@/lib/display-date";
import { RECORDINGS_PATH } from "@/lib/admin/recordings";
import {
  FILTER_MAX,
  SOURCE_NAME_MAX,
  expectedEnabled,
  reviewedCount,
  setSourceEnabled,
  sourceFromForm,
  type SourceErrors,
  type SourceValues,
} from "@/lib/admin/recording-import";

/*
 * Google Drive import sources for session recordings: add one (paused), review
 * how many videos its folder holds, add those to the queue, and turn its
 * automatic scans on or off. A historical import queues many videos for
 * transcription at once, so a personal access token can't make changes here.
 */
const db = drizzle(env.DB, { schema });
const INTEGRATIONS_PATH = "/admin/settings/integrations";

async function readCredentials() {
  if (!env.CREDENTIALS_ENCRYPTION_KEY) return null;
  try {
    return await getGoogleDriveCredentials(db, createCredentialCipher(env));
  } catch {
    // A credential that can't be read is one that isn't set up: Integrations replaces it.
    return null;
  }
}

// The credential, the cohorts, the sources and the Admin space are independent reads: one round trip.
const [credentials, programs, initialSources, spaces] = await Promise.all([
  readCredentials(),
  db.query.program.findMany({ columns: { id: true, name: true }, orderBy: (program, { desc }) => [desc(program.createdAt)] }),
  db.query.recordingImportSource.findMany({ with: { program: { columns: { name: true } } }, orderBy: (source, { asc }) => [asc(source.name)] }),
  resolveSpacePage(Astro.locals, "adminRecordings"),
]);
let sources = initialSources;
const configured = Boolean(credentials);

const SELF = Astro.url.pathname;
const NOT_CONFIGURED = "Google Drive isn't connected yet. Set up its credential in Integrations, then review the folder.";
const GONE = "That source was removed, perhaps by another admin. The list below is current.";

let values: SourceValues = { name: "", programId: "", driveFolder: "", filenameContains: "" };
let errors: SourceErrors = {};
let createFailure: string | undefined;
/** A refusal about a source or a scan rather than the form: what it's about, and what it says. */
// Set through `refuse` below; the cast keeps TypeScript from narrowing it to undefined.
let failure = undefined as { title: string; message: string } | undefined;
let preview: (RecordingImportPreview & { sourceId: string }) | undefined;

if (Astro.request.method === "POST") {
  if (Astro.locals.personalAccessToken) {
    return new Response("Forbidden: personal access tokens cannot change recording imports.", { status: 403 });
  }
  const formData = await Astro.request.formData();
  const action = formData.get("action");
  const sourceId = formData.get("sourceId");
  const source = typeof sourceId === "string" ? sources.find((one) => one.id === sourceId) : undefined;
  const refuse = (title: string, message: string, status: 400 | 503 = 400) => {
    failure = { title, message };
    Astro.response.status = status;
  };

  if (action === "create") {
    const parsed = sourceFromForm(formData, programs.map((program) => program.id));
    values = parsed.values;
    errors = parsed.errors;
    if (parsed.source) {
      try {
        await db.insert(schema.recordingImportSource).values({ ...parsed.source, enabled: false });
        return redirectWithFlash(Astro, SELF, {
          tone: "success",
          title: "Import source saved, paused",
          message: "Review its historical import to see what it would add, then turn on automatic scans.",
        });
      } catch {
        createFailure = "The database didn't answer, so the source wasn't saved. Try again in a moment.";
        Astro.response.status = 503;
      }
    } else {
      createFailure = "Fix the fields marked below. Everything you wrote is kept.";
      Astro.response.status = 400;
    }
  } else if (action !== "preview" && action !== "confirm" && action !== "toggle" && action !== "remove") {
    refuse("Nothing changed", "Choose one of the actions on this page.");
  } else if (!source) {
    refuse("Nothing changed", GONE);
  } else if (action === "toggle") {
    const expected = expectedEnabled(formData.get("expectedEnabled"));
    if (expected === null) refuse("Nothing changed", "Choose Pause or Turn on from the source's own row.");
    else {
      try {
        const result = await setSourceEnabled(db, source.id, expected);
        if (result.ok) {
          return redirectWithFlash(Astro, SELF, {
            tone: "success",
            title: result.enabled ? `Automatic scans on for ${source.name}` : `${source.name} paused`,
            message: result.enabled ? "Its folder is scanned every 15 minutes, and every video not yet in TTV is queued." : "Its folder isn't scanned until you turn it on again.",
          });
        }
        refuse("Nothing changed", result.reason === "missing" ? GONE : "Someone changed this source while you were looking at it. Its state below is the current one.");
      } catch {
        refuse("Nothing changed", "The database didn't answer, so nothing changed. Try again in a moment.", 503);
      }
    }
  } else if (action === "remove") {
    try {
      await db.delete(schema.recordingImportSource).where(eq(schema.recordingImportSource.id, source.id));
      return redirectWithFlash(Astro, SELF, { tone: "success", title: `${source.name} removed`, message: "The recordings it already imported stay." });
    } catch {
      refuse("Nothing changed", "The database didn't answer, so the source wasn't removed. Try again in a moment.", 503);
    }
  } else if (!configured) {
    refuse("Google Drive isn't connected", NOT_CONFIGURED);
  } else if (action === "preview") {
    try {
      preview = { ...(await previewRecordingImportSource(env, source.id)), sourceId: source.id };
    } catch (error) {
      refuse("The folder wasn't scanned", `${error instanceof Error ? error.message : "Google Drive didn't answer."} Nothing was added.`, 503);
    }
  } else {
    const expectedImportable = reviewedCount(formData.get("expectedImportable"));
    if (expectedImportable === null) refuse("Nothing was added", "Review the historical import first, then add what it found.");
    else {
      try {
        const summary = await syncRecordingImportSource(env, source.id, { expectedImportable });
        return redirectWithFlash(Astro, SELF, {
          tone: "success",
          title: "Historical import started",
          message: `${summary.created} new, ${summary.queued} queued to transcribe, ${summary.skipped} already in TTV.`,
        });
      } catch (error) {
        if (error instanceof RecordingImportPreviewChangedError) refuse("Nothing was added", error.message);
        else refuse("Nothing was added", `${error instanceof Error ? error.message : "Google Drive didn't answer."} Nothing was queued.`, 503);
      }
    }
  }

  // A scan writes its outcome on the source (its last scan, or its last error): show it.
  if (action === "preview" || action === "confirm") {
    sources = await db.query.recordingImportSource
      .findMany({ with: { program: { columns: { name: true } } }, orderBy: (one, { asc }) => [asc(one.name)] })
      .catch(() => sources);
  }
}

// A POST never carries a flash, and a refused one says what went wrong instead.
const flash = Astro.request.method === "GET" ? takeFlash(Astro) : null;
const reviewed = preview ? sources.find((source) => source.id === preview?.sourceId) : undefined;
const removing = confirmingAction(Astro.url, sources.map((source) => `remove-${source.id}`));
const removingSource = removing ? sources.find((source) => `remove-${source.id}` === removing) : undefined;
const count = (value: number) => value.toLocaleString("en-GB");
const cohortOptions = programs.map((program) => ({ value: program.id, label: program.name }));
const SOURCE_LINK = linkClass("inline-flex min-h-11 items-center text-sm");
---

<AdminLayout title="Import session recordings" titlePrefix={failure || createFailure ? "Error: " : ""} spaces={spaces}>
  <div class="space-y-6">
    <BackLink href={RECORDINGS_PATH}>Recordings</BackLink>

    <PageHeader title="Import session recordings">
      Scan Google Drive folders, and the folders inside them, for Meet recordings. Review the historical count before
      anything is added to the transcription and search queue.
    </PageHeader>

    {flash && <Notice tone={flash.tone} title={flash.title}>{flash.message}</Notice>}
    {failure && (
      <Notice tone="danger" focusOnLoad id="import-failure" title={failure.title}>{failure.message}</Notice>
    )}

    <Card>
      <section class="grid gap-4" aria-labelledby="connection-heading">
        <h2 id="connection-heading" class="text-lg text-ink-primary">Google Drive connection</h2>
        {credentials ? (
          <DescriptionList>
            <DescriptionItem term="Credential"><Chip tone="success">Set up</Chip></DescriptionItem>
            {credentials.impersonatedUser ? (
              <DescriptionItem term="Reads Drive as">{credentials.impersonatedUser}</DescriptionItem>
            ) : (
              <DescriptionItem term="Share each folder, as a Viewer, with"><span class="break-all">{credentials.clientEmail}</span></DescriptionItem>
            )}
          </DescriptionList>
        ) : (
          <div data-testid="drive-not-configured">
            <Notice tone="warning" title="Google Drive isn't connected yet" announce="none">
              You can save sources now, but nothing is scanned until the credential is set. Paste the Google
              service-account JSON in <a href={INTEGRATIONS_PATH} class={linkClass()}>Integrations</a>.
            </Notice>
          </div>
        )}
      </section>
    </Card>

    {preview && (
      <Card>
        <section class="grid gap-4" aria-labelledby="review-heading" data-testid="historical-import-preview">
          <h2 id="review-heading" class="text-lg text-ink-primary">Historical import: {reviewed?.name ?? "Google Drive source"}</h2>
          <p class="max-w-prose text-sm text-ink-secondary">
            The scan checked the folder, every folder inside it and Drive shortcuts. Nothing has been added yet. Videos
            Google marks as not downloadable can't be queued, because TTV can't fetch them to transcribe.
          </p>
          <DescriptionList>
            <DescriptionItem term="Drive items scanned">{count(preview.driveItemsScanned ?? preview.discovered)}</DescriptionItem>
            <DescriptionItem term="Videos Google shows">{count(preview.visibleVideos ?? preview.discovered)}</DescriptionItem>
            <DescriptionItem term="Videos that can be imported">{count(preview.discovered)}</DescriptionItem>
            <DescriptionItem term="Download blocked by Drive">{count(preview.downloadBlockedVideos ?? 0)}</DescriptionItem>
            <DescriptionItem term="New videos">{count(preview.new)}</DescriptionItem>
            <DescriptionItem term="Waiting to retry">{count(preview.pending)}</DescriptionItem>
            <DescriptionItem term="Already in TTV">{count(preview.skipped)}</DescriptionItem>
          </DescriptionList>
          {(preview.downloadBlockedVideos ?? 0) > 0 && (
            <Notice tone="warning" title={`${count(preview.downloadBlockedVideos ?? 0)} videos can't be downloaded`} announce="none">
              Google shows {count(preview.visibleVideos ?? preview.discovered)} videos, but reports these as not downloadable
              with the current credential. Allow downloads for the service account or the user it reads Drive as, then
              review again.
            </Notice>
          )}
          {preview.importable > 0 ? (
            <div class="grid gap-3">
              <form method="POST" action={SELF} class="flex flex-wrap items-center gap-3">
                <input type="hidden" name="action" value="confirm" />
                <input type="hidden" name="sourceId" value={preview.sourceId} />
                <input type="hidden" name="expectedImportable" value={String(preview.importable)} />
                <Button type="submit" variant="primary" aria-describedby="confirm-hint">Add {count(preview.importable)} to the queue</Button>
                <ButtonLink variant="ghost" href={SELF}>Cancel</ButtonLink>
              </form>
              <p id="confirm-hint" class="text-sm text-ink-secondary">
                The folder is scanned once more as you add them. If the count has changed, you'll be asked to review it again.
              </p>
            </div>
          ) : (
            <div class="flex flex-wrap items-center gap-3">
              <p class="text-sm text-ink-secondary">Every video it found is already in TTV, so there's nothing to add.</p>
              <ButtonLink variant="quiet" href={SELF}>Done</ButtonLink>
            </div>
          )}
        </section>
      </Card>
    )}

    <Card>
      <form method="POST" action={SELF} class="grid gap-5" aria-labelledby="create-heading" data-create>
        <div class="grid gap-1">
          <h2 id="create-heading" class="text-lg text-ink-primary">Add an import source</h2>
          <p class="max-w-prose text-sm text-ink-secondary">
            One source per cohort. A filename filter lets several cohorts share one Meet Recordings folder. A new source
            starts paused, so nothing from the folder's history is queued before you review it.
          </p>
        </div>
        {createFailure && (
          <Notice tone="danger" focusOnLoad id="create-failure" title="The source wasn't saved">{createFailure}</Notice>
        )}
        <input type="hidden" name="action" value="create" />
        <div class="grid gap-5 md:grid-cols-2">
          <TextField label="Name" name="name" required maxLength={SOURCE_NAME_MAX} placeholder="Cohort 05 sessions" defaultValue={values.name} error={errors.name} />
          <SelectField label="Cohort" name="programId" required placeholder="Choose a cohort" options={cohortOptions} defaultValue={values.programId} error={errors.programId} />
        </div>
        <TextField label="Drive folder" name="driveFolder" required hint="The folder's address from Drive, or its ID." placeholder="https://drive.google.com/drive/folders/…" defaultValue={values.driveFolder} error={errors.driveFolder} />
        <TextField label="Filename contains" name="filenameContains" optional maxLength={FILTER_MAX} hint="Matching ignores case. Leave it empty to import every video in the folder." placeholder="Cohort 05" defaultValue={values.filenameContains} error={errors.filenameContains} />
        <div>
          <Button type="submit" variant={preview && preview.importable > 0 ? "quiet" : "primary"}>Save import source</Button>
        </div>
      </form>
    </Card>

    <Card>
      <section class="grid gap-4" aria-labelledby="sources-heading" data-sources>
        <div class="grid gap-1">
          <h2 id="sources-heading" class="text-lg text-ink-primary">Sources</h2>
          <p class="max-w-prose text-sm text-ink-secondary">
            A source that's on is scanned every 15 minutes. Reviewing a historical import scans its whole folder and shows
            the count before anything is queued.
          </p>
        </div>
        {sources.length === 0 ? (
          <EmptyState title="No import sources yet" headingLevel={3}>Add one above to import a cohort's recordings from Google Drive.</EmptyState>
        ) : (
          <ul class="divide-y divide-hairline">
            {sources.map((source) => (
              <li class="grid gap-3 py-4 first:pt-0 last:pb-0" data-source={source.id}>
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                  <h3 class="text-base font-semibold text-ink-primary">{source.name}</h3>
                  {source.enabled ? <Chip tone="success">Automatic</Chip> : <Chip tone="neutral">Paused</Chip>}
                </div>
                <DescriptionList>
                  <DescriptionItem term="Cohort">{source.program.name}</DescriptionItem>
                  <DescriptionItem term="Folder"><span class="break-all">{source.driveFolderId}</span></DescriptionItem>
                  <DescriptionItem term="Filename contains">{source.filenameContains ?? "Any name"}</DescriptionItem>
                  <DescriptionItem term="Last scan">{source.lastSyncedAt ? formatMomentDateTime(source.lastSyncedAt) : "Not yet"}</DescriptionItem>
                </DescriptionList>
                {source.lastError && (
                  <Notice tone="danger" title="The last scan failed" announce="none"><span class="break-words">{source.lastError}</span></Notice>
                )}
                {removingSource?.id === source.id ? (
                  <ConfirmStep
                    title={`Remove ${source.name}?`}
                    confirmLabel="Remove source"
                    cancelHref={withoutConfirm(Astro.url)}
                    action={SELF}
                    fields={{ action: "remove", sourceId: source.id }}
                  >
                    Its folder is no longer scanned. The recordings it already imported stay.
                  </ConfirmStep>
                ) : (
                  <div class="flex flex-wrap gap-2">
                    {configured && (
                      <form method="POST" action={SELF}>
                        <input type="hidden" name="action" value="preview" />
                        <input type="hidden" name="sourceId" value={source.id} />
                        <Button type="submit" variant="quiet" size="sm">Review historical import<span class="sr-only"> for {source.name}</span></Button>
                      </form>
                    )}
                    <form method="POST" action={SELF}>
                      <input type="hidden" name="action" value="toggle" />
                      <input type="hidden" name="sourceId" value={source.id} />
                      <input type="hidden" name="expectedEnabled" value={String(source.enabled)} />
                      <Button type="submit" variant="quiet" size="sm">{source.enabled ? "Pause" : "Turn on"}<span class="sr-only"> {source.name}</span></Button>
                    </form>
                    <ButtonLink variant="quiet" size="sm" href={confirmHref(Astro.url, `remove-${source.id}`)}>Remove<span class="sr-only"> {source.name}</span></ButtonLink>
                  </div>
                )}
              </li>
            ))}
          </ul>
        )}
        {!configured && sources.length > 0 && (
          <p class="text-sm text-ink-secondary">
            Reviewing a historical import needs Google Drive connected. <a href={INTEGRATIONS_PATH} class={SOURCE_LINK}>Set it up in Integrations</a>
          </p>
        )}
      </section>
    </Card>
  </div>
</AdminLayout>
