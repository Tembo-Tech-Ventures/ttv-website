---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Card from "@/components/common/Card.astro";
import { drizzle } from "drizzle-orm/d1";
import { eq } from "drizzle-orm";
import * as schema from "@/lib/db/schema";
import { env } from "cloudflare:workers";
import {
  getGoogleDriveConfiguration,
  parseGoogleDriveFolderId,
} from "@/lib/recordings/google-drive";
import { syncRecordingImportSource } from "@/lib/recordings/importer";

const db = drizzle(env.DB, { schema });
const driveConfiguration = getGoogleDriveConfiguration(env);

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const action = String(formData.get("action") ?? "");

  try {
    if (action === "create") {
      const name = String(formData.get("name") ?? "").trim();
      const programId = String(formData.get("programId") ?? "").trim();
      const driveFolderId = parseGoogleDriveFolderId(
        String(formData.get("driveFolder") ?? "")
      );
      const filenameContains =
        String(formData.get("filenameContains") ?? "").trim() || null;

      if (!name || !programId) {
        throw new Error("Source name and program are required.");
      }
      const program = await db.query.program.findFirst({
        where: eq(schema.program.id, programId),
        columns: { id: true },
      });
      if (!program) {
        throw new Error("Select a valid program.");
      }

      await db.insert(schema.recordingImportSource).values({
        name,
        programId,
        driveFolderId,
        filenameContains,
      });
      return Astro.redirect(
        "/admin/recordings/import?success=Import+source+saved"
      );
    }

    const sourceId = String(formData.get("sourceId") ?? "");
    if (!sourceId) {
      throw new Error("Import source is required.");
    }

    if (action === "sync") {
      const summary = await syncRecordingImportSource(env, sourceId);
      const message = encodeURIComponent(
        `Scan complete: ${summary.created} new, ${summary.queued} queued, ${summary.skipped} already known`
      );
      return Astro.redirect(
        `/admin/recordings/import?success=${message}`
      );
    }

    if (action === "toggle") {
      await db
        .update(schema.recordingImportSource)
        .set({ enabled: formData.get("enabled") === "true" })
        .where(eq(schema.recordingImportSource.id, sourceId));
      return Astro.redirect("/admin/recordings/import?success=Source+updated");
    }

    if (action === "delete") {
      await db
        .delete(schema.recordingImportSource)
        .where(eq(schema.recordingImportSource.id, sourceId));
      return Astro.redirect("/admin/recordings/import?success=Source+removed");
    }

    throw new Error("Unknown import action.");
  } catch (error) {
    const message = encodeURIComponent(
      error instanceof Error ? error.message : String(error)
    );
    return Astro.redirect(`/admin/recordings/import?error=${message}`);
  }
}

const [programs, sources] = await Promise.all([
  db.query.program.findMany({
    orderBy: (program, { desc }) => [desc(program.createdAt)],
  }),
  db.query.recordingImportSource.findMany({
    with: { program: true },
    orderBy: (source, { asc }) => [asc(source.name)],
  }),
]);

const success = Astro.url.searchParams.get("success");
const error = Astro.url.searchParams.get("error");
const formatDateTime = (date: Date | null) =>
  date
    ? new Intl.DateTimeFormat("en", {
        dateStyle: "medium",
        timeStyle: "short",
      }).format(date)
    : "Not yet";
---

<AdminLayout title="Import Session Recordings">
  <div class="space-y-6">
    <div>
      <a href="/admin/recordings" class="text-sm text-primary hover:underline">
        &larr; Back to Recordings
      </a>
      <h2 class="mt-3 text-2xl font-bold text-white">
        Import Session Recordings
      </h2>
      <p class="mt-1 max-w-3xl text-sm text-white/55">
        Scan Google Drive folders for Meet recordings, copy new videos to R2,
        and send them through the existing transcription and search pipeline.
      </p>
    </div>

    {success && (
      <p class="rounded-md bg-emerald-500/15 px-4 py-3 text-sm text-emerald-100">
        {success}
      </p>
    )}
    {error && (
      <p class="rounded-md bg-red-500/15 px-4 py-3 text-sm text-red-100">
        {error}
      </p>
    )}

    <Card>
      <h3 class="text-lg font-semibold text-white">Google connection</h3>
      {driveConfiguration.configured ? (
        <div class="mt-3 space-y-2 text-sm text-white/65">
          <p class="text-emerald-200">Service account credentials are configured.</p>
          {driveConfiguration.impersonatedUser ? (
            <p>
              Drive access is delegated as
              <span class="ml-1 font-medium text-white">
                {driveConfiguration.impersonatedUser}
              </span>.
            </p>
          ) : (
            <p>
              Share each source folder with
              <span class="ml-1 break-all font-medium text-white">
                {driveConfiguration.clientEmail}
              </span>
              as a Viewer.
            </p>
          )}
        </div>
      ) : (
        <div class="mt-3 space-y-2 text-sm text-amber-100">
          <p>
            Drive credentials are not configured yet. Sources can be saved now,
            but scans will remain unavailable until the Cloudflare secrets are added.
          </p>
          <p>
            Follow <code class="rounded bg-black/20 px-1.5 py-0.5">docs/session-recording-imports.md</code>
            to create the read-only Google service account.
          </p>
        </div>
      )}
    </Card>

    <Card>
      <h3 class="text-lg font-semibold text-white">Add an import source</h3>
      <p class="mt-1 text-sm text-white/55">
        Use one source per program. An optional filename filter lets several
        programs share the same Meet Recordings folder.
      </p>

      <form method="POST" class="mt-5 grid gap-4 md:grid-cols-2">
        <input type="hidden" name="action" value="create" />
        <div class="flex flex-col gap-1.5">
          <label for="name" class="text-sm font-medium text-white/90">
            Source name *
          </label>
          <input id="name" name="name" required placeholder="2026 cohort sessions" class="rounded-md border border-teal bg-dark/50 px-3 py-2 text-white focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/50" />
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="programId" class="text-sm font-medium text-white/90">
            Program *
          </label>
          <select id="programId" name="programId" required class="rounded-md border border-teal bg-dark/50 px-3 py-2 text-white focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/50">
            <option value="">Select a program</option>
            {programs.map((program) => (
              <option value={program.id}>{program.name}</option>
            ))}
          </select>
        </div>
        <div class="flex flex-col gap-1.5 md:col-span-2">
          <label for="driveFolder" class="text-sm font-medium text-white/90">
            Drive folder URL or ID *
          </label>
          <input id="driveFolder" name="driveFolder" required placeholder="https://drive.google.com/drive/folders/..." class="rounded-md border border-teal bg-dark/50 px-3 py-2 text-white focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/50" />
        </div>
        <div class="flex flex-col gap-1.5 md:col-span-2">
          <label for="filenameContains" class="text-sm font-medium text-white/90">
            Filename contains
          </label>
          <input id="filenameContains" name="filenameContains" placeholder="Optional, e.g. Cohort 2026" class="rounded-md border border-teal bg-dark/50 px-3 py-2 text-white focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/50" />
          <p class="text-xs text-white/45">
            Matching is case-insensitive. Leave blank to import every video in the folder.
          </p>
        </div>
        <div class="md:col-span-2">
          <button type="submit" class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-dark hover:bg-primary/90">
            Save Import Source
          </button>
        </div>
      </form>
    </Card>

    <Card>
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h3 class="text-lg font-semibold text-white">Configured sources</h3>
          <p class="mt-1 text-sm text-white/55">
            Enabled sources scan every 15 minutes. “Scan now” runs the same
            idempotent discovery immediately.
          </p>
        </div>
      </div>

      <div class="mt-5 space-y-4">
        {sources.length === 0 ? (
          <p class="rounded-md border border-dashed border-teal/30 px-4 py-8 text-center text-sm text-white/45">
            No Google Drive import sources configured.
          </p>
        ) : (
          sources.map((source) => (
            <div class="rounded-lg border border-teal/20 bg-black/10 p-4">
              <div class="flex flex-col justify-between gap-4 lg:flex-row lg:items-start">
                <div class="min-w-0 space-y-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <h4 class="font-semibold text-white">{source.name}</h4>
                    <span class:list={[
                      "rounded-full px-2 py-0.5 text-xs",
                      source.enabled
                        ? "bg-emerald-500/15 text-emerald-100"
                        : "bg-white/10 text-white/50",
                    ]}>
                      {source.enabled ? "Automatic" : "Paused"}
                    </span>
                  </div>
                  <p class="text-sm text-white/65">{source.program.name}</p>
                  <p class="break-all text-xs text-white/40">
                    Folder: {source.driveFolderId}
                  </p>
                  <p class="text-xs text-white/40">
                    Filter: {source.filenameContains ?? "All videos"}
                  </p>
                  <p class="text-xs text-white/40">
                    Last scan: {formatDateTime(source.lastSyncedAt)}
                  </p>
                  {source.lastError && (
                    <p class="mt-2 rounded bg-red-500/15 px-2 py-1 text-xs text-red-100">
                      {source.lastError}
                    </p>
                  )}
                </div>

                <div class="flex flex-wrap gap-2">
                  <form method="POST">
                    <input type="hidden" name="action" value="sync" />
                    <input type="hidden" name="sourceId" value={source.id} />
                    <button type="submit" disabled={!driveConfiguration.configured} class="rounded-md bg-primary px-3 py-2 text-sm font-medium text-dark hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-40">
                      Scan now
                    </button>
                  </form>
                  <form method="POST">
                    <input type="hidden" name="action" value="toggle" />
                    <input type="hidden" name="sourceId" value={source.id} />
                    <input type="hidden" name="enabled" value={source.enabled ? "false" : "true"} />
                    <button type="submit" class="rounded-md border border-teal/40 px-3 py-2 text-sm text-white/80 hover:bg-teal/20">
                      {source.enabled ? "Pause" : "Enable"}
                    </button>
                  </form>
                  <form method="POST">
                    <input type="hidden" name="action" value="delete" />
                    <input type="hidden" name="sourceId" value={source.id} />
                    <button type="submit" class="rounded-md border border-red-400/30 px-3 py-2 text-sm text-red-100 hover:bg-red-500/15">
                      Remove
                    </button>
                  </form>
                </div>
              </div>
            </div>
          ))
        )}
      </div>
    </Card>
  </div>
</AdminLayout>
