---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Card from "@/components/common/Card.astro";
import { drizzle } from "drizzle-orm/d1";
import { eq } from "drizzle-orm";
import * as schema from "@/lib/db/schema";
import { env } from "cloudflare:workers";
import { createCredentialCipher } from "@/lib/credentials/crypto";
import { getGoogleDriveCredentials } from "@/lib/credentials/google-drive";
import { parseGoogleDriveFolderId } from "@/lib/recordings/google-drive";
import {
  previewRecordingImportSource,
  syncRecordingImportSource,
  type RecordingImportPreview,
} from "@/lib/recordings/importer";

const db = drizzle(env.DB, { schema });

let credentialsConfigured = false;
let clientEmail: string | undefined;
let impersonatedUser: string | undefined;
let historicalPreview:
  | (RecordingImportPreview & { sourceId: string })
  | undefined;

if (env.CREDENTIALS_ENCRYPTION_KEY) {
  try {
    const cipher = createCredentialCipher(env);
    const creds = await getGoogleDriveCredentials(db, cipher);
    if (creds) {
      credentialsConfigured = true;
      clientEmail = creds.clientEmail;
      impersonatedUser = creds.impersonatedUser;
    }
  } catch {
    // corrupt state — treat as unconfigured
  }
}

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const action = String(formData.get("action") ?? "");

  try {
    if (action === "create") {
      const name = String(formData.get("name") ?? "").trim();
      const programId = String(formData.get("programId") ?? "").trim();
      const driveFolderId = parseGoogleDriveFolderId(
        String(formData.get("driveFolder") ?? "")
      );
      const filenameContains =
        String(formData.get("filenameContains") ?? "").trim() || null;

      if (!name || !programId) {
        throw new Error("Source name and program are required.");
      }
      const program = await db.query.program.findFirst({
        where: eq(schema.program.id, programId),
        columns: { id: true },
      });
      if (!program) {
        throw new Error("Select a valid program.");
      }

      await db.insert(schema.recordingImportSource).values({
        name,
        programId,
        driveFolderId,
        filenameContains,
        enabled: false,
      });
      return Astro.redirect(
        "/admin/recordings/import?success=Import+source+saved+and+paused.+Review+the+historical+count,+then+enable+automatic+scans."
      );
    }

    const sourceId = String(formData.get("sourceId") ?? "");
    if (!sourceId) {
      throw new Error("Import source is required.");
    }

    if (action === "preview") {
      if (!credentialsConfigured) {
        throw new Error(
          "Google Drive credentials are not configured. Set them in Admin → Integrations."
        );
      }
      historicalPreview = {
        ...(await previewRecordingImportSource(env, sourceId)),
        sourceId,
      };
    } else if (action === "confirm") {
      if (!credentialsConfigured) {
        throw new Error(
          "Google Drive credentials are not configured. Set them in Admin → Integrations."
        );
      }
      const expectedValue = String(
        formData.get("expectedImportable") ?? ""
      );
      if (!/^\d+$/.test(expectedValue)) {
        throw new TypeError("Review the historical import before confirming it.");
      }
      const expectedImportable = Number(expectedValue);
      if (!Number.isSafeInteger(expectedImportable)) {
        throw new TypeError("Review the historical import before confirming it.");
      }
      const summary = await syncRecordingImportSource(env, sourceId, {
        expectedImportable,
      });
      const message = encodeURIComponent(
        `Historical import started: ${summary.created} new, ${summary.queued} queued, ${summary.skipped} already known`
      );
      return Astro.redirect(
        `/admin/recordings/import?success=${message}`
      );
    } else if (action === "toggle") {
      await db
        .update(schema.recordingImportSource)
        .set({ enabled: formData.get("enabled") === "true" })
        .where(eq(schema.recordingImportSource.id, sourceId));
      return Astro.redirect("/admin/recordings/import?success=Source+updated");
    } else if (action === "delete") {
      await db
        .delete(schema.recordingImportSource)
        .where(eq(schema.recordingImportSource.id, sourceId));
      return Astro.redirect("/admin/recordings/import?success=Source+removed");
    } else {
      throw new Error("Unknown import action.");
    }
  } catch (error) {
    const message = encodeURIComponent(
      error instanceof Error ? error.message : String(error)
    );
    return Astro.redirect(`/admin/recordings/import?error=${message}`);
  }
}

const [programs, sources] = await Promise.all([
  db.query.program.findMany({
    orderBy: (program, { desc }) => [desc(program.createdAt)],
  }),
  db.query.recordingImportSource.findMany({
    with: { program: true },
    orderBy: (source, { asc }) => [asc(source.name)],
  }),
]);

const success = Astro.url.searchParams.get("success");
const error = Astro.url.searchParams.get("error");
const previewSource = historicalPreview
  ? sources.find((source) => source.id === historicalPreview?.sourceId)
  : undefined;
const formatDateTime = (date: Date | null) =>
  date
    ? new Intl.DateTimeFormat("en", {
        dateStyle: "medium",
        timeStyle: "short",
      }).format(date)
    : "Not yet";
---

<AdminLayout title="Import Session Recordings">
  <div class="space-y-6">
    <div>
      <a href="/admin/recordings" class="text-sm text-primary hover:underline">
        &larr; Back to Recordings
      </a>
      <h2 class="mt-3 text-2xl font-bold text-white">
        Import Session Recordings
      </h2>
      <p class="mt-1 max-w-3xl text-sm text-ink-muted">
        Scan Google Drive folders and subfolders for Meet recordings, review
        historical counts, and add approved videos to the transcription and
        search queue.
      </p>
    </div>

    {success && (
      <p class="rounded-md bg-emerald-500/15 px-4 py-3 text-sm text-emerald-100">
        {success}
      </p>
    )}
    {error && (
      <p class="rounded-md bg-red-500/15 px-4 py-3 text-sm text-red-100">
        {error}
      </p>
    )}

    <Card>
      <h3 class="text-lg font-semibold text-white">Google connection</h3>
      {credentialsConfigured ? (
        <div class="mt-3 space-y-2 text-sm text-ink-secondary">
          <p class="text-emerald-200">Service account credentials are configured.</p>
          {impersonatedUser ? (
            <p>
              Drive access is delegated as
              <span class="ml-1 font-medium text-white">
                {impersonatedUser}
              </span>.
            </p>
          ) : (
            <p>
              Share each source folder with
              <span class="ml-1 break-all font-medium text-white">
                {clientEmail}
              </span>
              as a Viewer.
            </p>
          )}
        </div>
      ) : (
        <div class="mt-3 space-y-2 text-sm text-amber-100" data-testid="drive-not-configured">
          <p>
            Google Drive credentials are not configured yet. Sources can be saved
            now, but scans will remain unavailable until the credentials are set.
          </p>
          <p>
            Go to{" "}
            <a
              href="/admin/settings/integrations"
              class="font-medium text-primary hover:underline"
            >
              Admin &rarr; Settings &rarr; Integrations
            </a>{" "}
            to paste your Google service-account JSON.
          </p>
        </div>
      )}
    </Card>

    {historicalPreview && (
      <Card>
        <div data-testid="historical-import-preview">
          <p class="text-xs font-semibold uppercase tracking-wide text-primary">
            Historical import review
          </p>
          <h3 class="mt-1 text-lg font-semibold text-white">
            {previewSource?.name ?? "Google Drive source"}
          </h3>
          <p class="mt-2 max-w-3xl text-sm text-ink-secondary">
            The scan checked the selected folder, all nested folders, and Drive
            shortcuts. Nothing has been added by this review.
          </p>

          <dl class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
            <div class="rounded-md border border-teal/20 bg-black/10 p-3">
              <dt class="text-xs text-ink-muted">Videos found</dt>
              <dd class="mt-1 text-xl font-semibold text-white">
                {historicalPreview.discovered.toLocaleString()}
              </dd>
            </div>
            <div class="rounded-md border border-teal/20 bg-black/10 p-3">
              <dt class="text-xs text-ink-muted">New videos</dt>
              <dd class="mt-1 text-xl font-semibold text-white">
                {historicalPreview.new.toLocaleString()}
              </dd>
            </div>
            <div class="rounded-md border border-teal/20 bg-black/10 p-3">
              <dt class="text-xs text-ink-muted">Pending retry</dt>
              <dd class="mt-1 text-xl font-semibold text-white">
                {historicalPreview.pending.toLocaleString()}
              </dd>
            </div>
            <div class="rounded-md border border-teal/20 bg-black/10 p-3">
              <dt class="text-xs text-ink-muted">Already in TTV</dt>
              <dd class="mt-1 text-xl font-semibold text-white">
                {historicalPreview.skipped.toLocaleString()}
              </dd>
            </div>
          </dl>

          {historicalPreview.importable > 0 ? (
            <div class="mt-5 flex flex-wrap items-center gap-3">
              <form method="POST">
                <input type="hidden" name="action" value="confirm" />
                <input
                  type="hidden"
                  name="sourceId"
                  value={historicalPreview.sourceId}
                />
                <input
                  type="hidden"
                  name="expectedImportable"
                  value={historicalPreview.importable}
                />
                <button type="submit" class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-dark hover:bg-primary/90">
                  Add {historicalPreview.importable.toLocaleString()} to queue
                </button>
              </form>
              <a href="/admin/recordings/import" class="rounded-md border border-teal/40 px-4 py-2 text-sm text-white/80 hover:bg-teal/20">
                Cancel
              </a>
              <p class="basis-full text-xs text-ink-muted">
                The folder is scanned once more on confirmation. If the count
                changed, you will be asked to review it again.
              </p>
            </div>
          ) : (
            <div class="mt-5 flex flex-wrap items-center gap-3">
              <p class="text-sm text-emerald-100">
                Every discovered video is already in TTV. There is nothing to queue.
              </p>
              <a href="/admin/recordings/import" class="rounded-md border border-teal/40 px-4 py-2 text-sm text-white/80 hover:bg-teal/20">
                Done
              </a>
            </div>
          )}
        </div>
      </Card>
    )}

    <Card>
      <h3 class="text-lg font-semibold text-white">Add an import source</h3>
      <p class="mt-1 text-sm text-ink-muted">
        Use one source per program. An optional filename filter lets several
        programs share the same Meet Recordings folder. New sources start
        paused so the historical backlog cannot run before you review it.
      </p>

      <form method="POST" class="mt-5 grid gap-4 md:grid-cols-2">
        <input type="hidden" name="action" value="create" />
        <div class="flex flex-col gap-1.5">
          <label for="name" class="text-sm font-medium text-white/90">
            Source name *
          </label>
          <input id="name" name="name" required placeholder="2026 cohort sessions" class="rounded-md border border-teal bg-dark/50 px-3 py-2 text-white focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/50" />
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="programId" class="text-sm font-medium text-white/90">
            Program *
          </label>
          <select id="programId" name="programId" required class="w-full max-w-full rounded-md border border-teal bg-dark/50 px-3 py-2 text-white focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/50">
            <option value="">Select a program</option>
            {programs.map((program) => (
              <option value={program.id}>{program.name}</option>
            ))}
          </select>
        </div>
        <div class="flex flex-col gap-1.5 md:col-span-2">
          <label for="driveFolder" class="text-sm font-medium text-white/90">
            Drive folder URL or ID *
          </label>
          <input id="driveFolder" name="driveFolder" required placeholder="https://drive.google.com/drive/folders/..." class="rounded-md border border-teal bg-dark/50 px-3 py-2 text-white focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/50" />
        </div>
        <div class="flex flex-col gap-1.5 md:col-span-2">
          <label for="filenameContains" class="text-sm font-medium text-white/90">
            Filename contains
          </label>
          <input id="filenameContains" name="filenameContains" placeholder="Optional, e.g. Cohort 2026" class="rounded-md border border-teal bg-dark/50 px-3 py-2 text-white focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/50" />
          <p class="text-xs text-ink-muted">
            Matching is case-insensitive. Leave blank to import every video in the folder.
          </p>
        </div>
        <div class="md:col-span-2">
          <button type="submit" class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-dark hover:bg-primary/90">
            Save Import Source
          </button>
        </div>
      </form>
    </Card>

    <Card>
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h3 class="text-lg font-semibold text-white">Configured sources</h3>
          <p class="mt-1 text-sm text-ink-muted">
            Enabled sources scan every 15 minutes. Review historical import
            scans the full folder tree and shows the count before queueing.
          </p>
        </div>
      </div>

      <div class="mt-5 space-y-4">
        {sources.length === 0 ? (
          <p class="rounded-md border border-dashed border-teal/30 px-4 py-8 text-center text-sm text-ink-muted">
            No Google Drive import sources configured.
          </p>
        ) : (
          sources.map((source) => (
            <div class="rounded-lg border border-teal/20 bg-black/10 p-4">
              <div class="flex flex-col justify-between gap-4 lg:flex-row lg:items-start">
                <div class="min-w-0 space-y-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <h4 class="font-semibold text-white">{source.name}</h4>
                    <span class:list={[
                      "rounded-full px-2 py-0.5 text-xs",
                      source.enabled
                        ? "bg-emerald-500/15 text-emerald-100"
                        : "bg-white/10 text-ink-muted",
                    ]}>
                      {source.enabled ? "Automatic" : "Paused"}
                    </span>
                  </div>
                  <p class="text-sm text-ink-secondary">{source.program.name}</p>
                  <p class="break-all text-xs text-ink-muted">
                    Folder: {source.driveFolderId}
                  </p>
                  <p class="text-xs text-ink-muted">
                    Filter: {source.filenameContains ?? "All videos"}
                  </p>
                  <p class="text-xs text-ink-muted">
                    Last scan: {formatDateTime(source.lastSyncedAt)}
                  </p>
                  {source.lastError && (
                    <p class="mt-2 rounded bg-red-500/15 px-2 py-1 text-xs text-red-100">
                      {source.lastError}
                    </p>
                  )}
                </div>

                <div class="flex flex-wrap gap-2">
                  <form method="POST">
                    <input type="hidden" name="action" value="preview" />
                    <input type="hidden" name="sourceId" value={source.id} />
                    <button type="submit" disabled={!credentialsConfigured} class="rounded-md bg-primary px-3 py-2 text-sm font-medium text-dark hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-40">
                      Review historical import
                    </button>
                  </form>
                  <form method="POST">
                    <input type="hidden" name="action" value="toggle" />
                    <input type="hidden" name="sourceId" value={source.id} />
                    <input type="hidden" name="enabled" value={source.enabled ? "false" : "true"} />
                    <button type="submit" class="rounded-md border border-teal/40 px-3 py-2 text-sm text-white/80 hover:bg-teal/20">
                      {source.enabled ? "Pause" : "Enable"}
                    </button>
                  </form>
                  <form method="POST">
                    <input type="hidden" name="action" value="delete" />
                    <input type="hidden" name="sourceId" value={source.id} />
                    <button type="submit" class="rounded-md border border-red-400/30 px-3 py-2 text-sm text-red-100 hover:bg-red-500/15">
                      Remove
                    </button>
                  </form>
                </div>
              </div>
            </div>
          ))
        )}
      </div>
    </Card>
  </div>
</AdminLayout>
