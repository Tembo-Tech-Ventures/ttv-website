---
/**
 * The admin moderation queue (U-2.4, screens/08): one case per message, waiting or decided, with
 * the evidence and the author's review request. Each case is a plain form post, so it works
 * without JavaScript; page-flow.ts holds the request flow the DEV harness shares.
 *
 * The middleware already requires an admin. This page owns the rest: signed in through the
 * browser (personal access tokens can't use channels yet), the `channels` flag on for this admin,
 * and same-origin decisions. B-2.5's listModerationQueue and decideModeration refuse the rest
 * with the same errors as /api/moderation.
 *
 * While mentor requests are on for this admin, a third tab, "Request notes" (`?tab=request-notes`),
 * lists the mentor requests whose note Tembo's check held or a mentor reported (B-4.1 checks). Its reads
 * and decisions go through the API's own handler, so a keep also tells the mentor, as the API does.
 * The tab and the sidebar badge count the open checks this admin may decide (QA4-04).
 */
import { env } from "cloudflare:workers";
import { drizzle } from "drizzle-orm/d1";
import * as schema from "@/lib/db/schema";
import AdminLayout from "@/layouts/AdminLayout.astro";
import ModerationQueueView from "@/components/admin/moderation/ModerationQueueView.astro";
import RequestNotesView from "@/components/admin/moderation/RequestNotesView.astro";
import { MODERATION_PATH, QUEUE_TABS } from "@/components/admin/moderation/case-model";
import {
  moderationView, REQUEST_NOTES_LABEL, REQUEST_NOTES_TAB, requestNotesLink, requestNotesPaths, requestNotesRequest, type RequestNotesViewProps,
} from "@/components/admin/moderation/request-notes";
import { mentoringRequest } from "@/lib/mentoring/http";
import { ROUTES } from "@/lib/platform/contracts";
import type { PillNavItem } from "@/components/platform/ui";
import {
  moderationQueueGate, moderationQueueRequest, queuePaths, type QueueViewProps,
} from "@/components/admin/moderation/page-flow";
import { hasMatchingRequestOrigin } from "@/lib/admin/mutation-security";
import { ChannelError } from "@/lib/channels/errors";
import { decideModeration } from "@/lib/channels/moderation/actions";
import { countPendingModeration, listModerationQueue, moderationChannels } from "@/lib/channels/moderation/queue";
import { countOpenChecks } from "@/lib/mentoring/checks";
import { isFlagEnabled } from "@/lib/platform/server/flags";
import { requestCapabilities } from "@/lib/platform/server/request-capabilities";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";

const { user, personalAccessToken, isAdmin } = Astro.locals;
const flagContext = { db: env.DB, env, user: user ?? null, isAdmin, locals: Astro.locals };
const reading = Astro.request.method === "GET";
const capabilities = user && !personalAccessToken ? requestCapabilities(drizzle(env.DB, { schema }), Astro.locals) : null;
// Awaited below once the gate passes; a request the gate turns away must not leave it unhandled.
capabilities?.catch(() => {});
// A GET of the queue starts its channels beside the flag reads, not after them (PERF-2). Nothing read
// here is shown before the gate below passes, and the read is shared with the queue's own (request-scope.ts).
if (user && capabilities && reading && Astro.url.searchParams.get("tab") !== REQUEST_NOTES_TAB) {
  capabilities.then((caps) => moderationChannels(env.DB, { user, capabilities: caps })).catch(() => {});
}
const [channelsOn, requestNotesOn] = user
  ? await Promise.all([isFlagEnabled(flagContext, "channels"), isFlagEnabled(flagContext, "mentor_requests")])
  : [false, false];
const gate = moderationQueueGate({
  signedIn: Boolean(user),
  personalAccessToken: Boolean(personalAccessToken),
  channelsOn,
  method: Astro.request.method,
  sameOrigin: hasMatchingRequestOrigin(Astro.request),
});
if (gate === "sign-in" || !user) return Astro.redirect("/auth/login");
if (gate === "token") return new Response("Forbidden: personal access tokens can't use channels yet.", { status: 403 });
if (gate === "not-found") return new Response("Not found", { status: 404 });
if (gate === "cross-origin") return new Response("Forbidden: same-origin request required.", { status: 403 });

// In the Admin space while `spaces` is on for this admin (T02); the existing admin shell otherwise. It starts
// beside the page's own reads on a GET; a POST resolves it after its decision.
const resolveSpaces = () => resolveSpacePage(Astro.locals, "moderation");
const spacesRead = reading ? resolveSpaces() : null;
spacesRead?.catch(() => {});
const paths = queuePaths(MODERATION_PATH);
const notesPaths = requestNotesPaths(MODERATION_PATH);

let notesView: (RequestNotesViewProps & { queueTabs: PillNavItem[]; viewerId: string }) | null = null;
let queueView: (QueueViewProps & { requestNotesHref?: string; requestNotesCount?: number }) | null = null;
let pendingCount = 0;
let openChecks = 0;

if (moderationView(Astro.url.searchParams, requestNotesOn) === "request-notes") {
  const api = (operation: "listMentorRequestCases" | "decideMentorRequestCase", request: Request, params: Record<string, string> = {}) =>
    mentoringRequest(operation, { request, locals: Astro.locals, params }, env);
  const notes = await requestNotesRequest(Astro.request, Astro.url, {
    list(query) {
      const url = new URL(ROUTES.listMentorRequestCases.path, Astro.url);
      for (const [key, value] of Object.entries(query)) if (value !== undefined) url.searchParams.set(key, value);
      return api("listMentorRequestCases", new Request(url));
    },
    decide(requestId, body) {
      // The page has already checked its own post is same-origin (the gate above), so this inner request carries that origin.
      const url = new URL(ROUTES.decideMentorRequestCase.path.replace(":id", encodeURIComponent(requestId)), Astro.url);
      return api("decideMentorRequestCase", new Request(url, {
        method: "POST", headers: { "Content-Type": "application/json", Origin: Astro.url.origin }, body: JSON.stringify(body),
      }), { id: requestId });
    },
  }, notesPaths);
  if (notes.kind === "redirect") return Astro.redirect(notes.location, 303);
  Astro.response.status = notes.status;
  [pendingCount, openChecks] = await Promise.all([countPendingModeration(env.DB, user.id), countOpenChecks(env.DB, user.id)]);
  notesView = {
    ...notes.props,
    viewerId: user.id,
    queueTabs: [
      ...QUEUE_TABS.map((tab) => ({ label: tab.label, href: paths.tab(tab.state), current: false, ...(tab.state === "PENDING" ? { count: pendingCount } : {}) })),
      { label: REQUEST_NOTES_LABEL, href: notesPaths.tab("OPEN"), current: true, count: openChecks },
    ],
  };
} else {
  const viewer = { user, capabilities: await (capabilities ?? requestCapabilities(drizzle(env.DB, { schema }), Astro.locals)) };
  const outcome = await moderationQueueRequest(Astro.request, Astro.url, {
    list: (query) => listModerationQueue(env.DB, viewer, query),
    countPending: () => countPendingModeration(env.DB, user.id),
    decide: (input) => decideModeration({ db: env.DB, env }, viewer, input),
    isBadCursor: (error) => error instanceof ChannelError && error.status === 400,
  }, paths);
  if (outcome.kind === "redirect") return Astro.redirect(outcome.location, 303);
  Astro.response.status = outcome.status;
  pendingCount = outcome.props.pendingCount;
  const requestNotesHref = requestNotesLink(requestNotesOn, notesPaths);
  if (requestNotesHref) openChecks = await countOpenChecks(env.DB, user.id);
  queueView = { ...outcome.props, ...(requestNotesHref ? { requestNotesHref, requestNotesCount: openChecks } : {}) };
}
const spaces = await (spacesRead ?? resolveSpaces());
---

<AdminLayout title="Moderation" pendingModeration={pendingCount} pendingRequestNotes={openChecks} spaces={spaces}>
  {notesView && <RequestNotesView {...notesView} />}
  {queueView && <ModerationQueueView {...queueView} />}
</AdminLayout>
