---
import { env } from "cloudflare:workers";
import { desc } from "drizzle-orm";
import { drizzle } from "drizzle-orm/d1";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";
import { ButtonLink, Chip, DataCell, DataRow, DataTable, EmptyState, Notice, PageHeader, linkClass } from "@/components/platform/ui";
import * as schema from "@/lib/db/schema";
import { formatCalendarDate } from "@/lib/display-date";

/*
 * Every cohort, newest first. A cohort's page holds its dates, its people and
 * its applications; this list leads there, and to a new cohort. The cohorts and
 * the Admin space are independent reads, started together.
 */
const db = drizzle(env.DB, { schema });

const [programs, spaces] = await Promise.all([
  db.query.program.findMany({
    columns: { id: true, name: true, startDate: true, endDate: true, applicationsOpen: true },
    with: { curriculum: { columns: { title: true } } },
    orderBy: (program) => [desc(program.createdAt)],
  }),
  resolveSpacePage(Astro.locals, "adminCohorts"),
]);

// A cohort's page sends a reader here when the one they opened is gone.
const missing = Astro.url.searchParams.get("notice") === "missing";
const day = (date: Date | null) => (date ? formatCalendarDate(date) : "Not set");
---

<AdminLayout title="Cohorts" spaces={spaces}>
  <div class="flex flex-col gap-8">
    <PageHeader title="Cohorts">
      Every cohort, newest first. Open one to change its dates, its people and who it accepts.
      <Fragment slot="action">
        <ButtonLink variant="primary" href="/admin/programs/new">New cohort</ButtonLink>
      </Fragment>
    </PageHeader>

    {missing && <Notice tone="warning" title="That cohort no longer exists">It may have been removed. The list below is up to date.</Notice>}

    <DataTable
      caption="Cohorts"
      columns={[{ label: "Cohort" }, { label: "Curriculum" }, { label: "Starts" }, { label: "Ends" }, { label: "Applications" }]}
      isEmpty={programs.length === 0}
    >
      {
        programs.map((program) => (
          <DataRow>
            <DataCell label="Cohort" primary>
              <a href={`/admin/programs/${program.id}`} class={linkClass()}>{program.name}</a>
            </DataCell>
            <DataCell label="Curriculum">{program.curriculum?.title ?? "None"}</DataCell>
            <DataCell label="Starts">{day(program.startDate)}</DataCell>
            <DataCell label="Ends">{day(program.endDate)}</DataCell>
            <DataCell label="Applications">
              <Chip tone={program.applicationsOpen ? "success" : "neutral"}>{program.applicationsOpen ? "Open" : "Closed"}</Chip>
            </DataCell>
          </DataRow>
        ))
      }
      <Fragment slot="empty">
        <EmptyState title="No cohorts yet" headingLevel={2}>
          A cohort brings a curriculum, its dates and its people together. Create the first one with “New cohort”.
        </EmptyState>
      </Fragment>
    </DataTable>
  </div>
</AdminLayout>
