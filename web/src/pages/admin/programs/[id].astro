---
import { env } from "cloudflare:workers";
import { createId } from "@paralleldrive/cuid2";
import { and, asc, eq, inArray } from "drizzle-orm";
import { drizzle } from "drizzle-orm/d1";
import AdminLayout from "@/layouts/AdminLayout.astro";
import CohortMentors from "@/components/admin/CohortMentors.astro";
import { cohortMentorModel, cohortRoleRefusal, teachingRoles } from "@/components/admin/cohort-mentors";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";
import {
  BackLink,
  Button,
  ButtonLink,
  Checkbox,
  ConfirmStep,
  DataCell,
  DataRow,
  DataSelectCell,
  DataTable,
  EmptyState,
  Notice,
  PageHeader,
  RowAction,
  SelectField,
  StatusChip,
  TextAreaField,
  TextField,
  confirmHref,
  confirmingAction,
  linkClass,
  withoutConfirm,
} from "@/components/platform/ui";
import { applyApplicationMutationWithAttention } from "@/lib/attention/mutations";
import {
  MAX_BULK_SELECTION_SIZE,
  ProgramApplicationError,
  buildAdminEnrollmentStatement,
  buildBulkMutationStatement,
  createAdminEnrollment,
  formatDateInputValue,
  getEnrollmentSource,
  parseBulkApplicationAction,
  parseSelectedApplicationIds,
  planBulkProgramApplicationMutation,
  throwAdminEnrollmentFailure,
} from "@/lib/admin/program-application";
import {
  COHORTS_PATH,
  ENROLMENT_STATUS_OPTIONS,
  STAFF_ROLE_OPTIONS,
  STORE_UNAVAILABLE,
  cohortChangeNotice,
  cohortRoleLabel,
  needsCompletionConfirmation,
  type CohortForm,
} from "@/lib/admin/program-detail";
import {
  ProgramManagementError,
  assertProgramRoleRemoved,
  buildAddProgramRoleStatement,
  buildCohortUpdateStatement,
  buildRemoveProgramRoleStatement,
  cohortUpdateErrorField,
  cohortUpdateValuesFromFormData,
  parseCohortUpdate,
  parseProgramStaffRole,
  parseProgramStaffUserId,
  throwAddProgramRoleFailure,
  throwCohortUpdateFailure,
  type CohortUpdateField,
  type CohortUpdateValues,
} from "@/lib/admin/program-management";
import * as schema from "@/lib/db/schema";
import { formatMomentDate } from "@/lib/display-date";
import { redirectWithFlash, takeFlash } from "@/lib/platform/server/flash";
import { isFlagEnabled } from "@/lib/platform/server/flags";

/*
 * One cohort, for an administrator: its details, its staff and mentors, and
 * its roster. Middleware has required ADMIN and same-origin POSTs. Every form
 * posts to the page; a change answers with a 303 and says what changed once,
 * and a rejected one keeps what was typed and says what went wrong at the top
 * of its own section. Removing someone, and completing anyone (which opens
 * their certificate at once), asks first on the page itself, without script.
 */
const db = drizzle(env.DB, { schema });
const { id } = Astro.params;
if (!id) return Astro.redirect(COHORTS_PATH);
const page = `${COHORTS_PATH}/${encodeURIComponent(id)}`;
const today = formatDateInputValue();
// Cohort mentors exist for the channels (owner decision 4), so they appear with them.
const channelsOn = () => isFlagEnabled({ db: env.DB, env, user: Astro.locals.user, isAdmin: Astro.locals.isAdmin, locals: Astro.locals }, "channels");

let failedForm: CohortForm | null = null;
let failure = "";
let submittedCohortValues: CohortUpdateValues | null = null;
const cohortFieldErrors: Partial<Record<CohortUpdateField, string>> = {};
/** What a rejected form held, so it renders again as it was sent. */
const kept: Partial<Record<"staffUserId" | "staffRole" | "mentorUserId" | "enrolUserId" | "enrolStatus" | "enrolDate" | "rosterDate", string>> & { rosterIds?: string[] } = {};
/**
 * A change that asks first, with everything it will post. Its Cancel goes to the plain page: after
 * the POST the address is already the page's, so a link to `#roster` alone would not reload it.
 */
let confirming: { form: "enrol" | "roster"; title: string; body: string; confirmLabel: string; fields: Record<string, string | string[]> } | null = null;

const text = (value: ReturnType<FormData["get"]>) => (typeof value === "string" ? value.trim() : "");
const reject = (form: CohortForm, message: string) => {
  failedForm = form;
  failure = message;
  Astro.response.status = 400;
};
/** The database failed, not the request: the form stays as it was sent, and the page says to try again. */
const unavailable = (form: CohortForm) => {
  failedForm = form;
  failure = STORE_UNAVAILABLE;
  Astro.response.status = 503;
};

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const action = text(formData.get("action"));

  if (action === "update-program") {
    submittedCohortValues = cohortUpdateValuesFromFormData(formData);
    try {
      const update = parseCohortUpdate({ ...submittedCohortValues, applicationsOpen: formData.get("applicationsOpen") });
      const statement = buildCohortUpdateStatement({ programId: id, update });
      const result = await env.DB.prepare(statement.sql).bind(...statement.params).run();
      if (result.meta.changes !== statement.expectedChanges) {
        if (result.meta.changes !== 0) throw new Error(`Atomic cohort update changed ${result.meta.changes} rows; expected ${statement.expectedChanges}.`);
        const [program, curriculum] = await Promise.all([
          db.query.program.findFirst({ where: eq(schema.program.id, id), columns: { id: true } }),
          db.query.curriculum.findFirst({ where: eq(schema.curriculum.id, update.curriculumId), columns: { id: true } }),
        ]);
        throwCohortUpdateFailure({ programExists: Boolean(program), curriculumExists: Boolean(curriculum) });
      }
      return redirectWithFlash(Astro, `${page}#details`, { tone: "success", title: cohortChangeNotice({ kind: "details" }) });
    } catch (error) {
      if (!(error instanceof ProgramManagementError)) {
        unavailable("details");
      } else {
        reject("details", error.message);
        const field = cohortUpdateErrorField(error);
        if (field) cohortFieldErrors[field] = error.message;
      }
    }
  } else if (action === "add-role") {
    const asMentor = text(formData.get("roleName")) === "MENTOR";
    const form: CohortForm = asMentor ? "mentors" : "staff";
    if (asMentor) kept.mentorUserId = text(formData.get("userId"));
    else Object.assign(kept, { staffUserId: text(formData.get("userId")), staffRole: text(formData.get("roleName")) });
    try {
      const userId = parseProgramStaffUserId(formData.get("userId"));
      const role = parseProgramStaffRole(formData.get("roleName"));
      const refused = cohortRoleRefusal(role, await channelsOn());
      if (refused) throw new ProgramManagementError("INVALID_STAFF_ROLE", refused);
      const statement = buildAddProgramRoleStatement({ id: createId(), programId: id, userId, role });
      const result = await env.DB.prepare(statement.sql).bind(...statement.params).run();
      if (result.meta.changes !== statement.expectedChanges) {
        if (result.meta.changes !== 0) throw new Error(`Atomic cohort role insert changed ${result.meta.changes} rows; expected ${statement.expectedChanges}.`);
        const [program, user, duplicate] = await Promise.all([
          db.query.program.findFirst({ where: eq(schema.program.id, id), columns: { id: true } }),
          db.query.user.findFirst({ where: eq(schema.user.id, userId), columns: { id: true } }),
          db.query.programRole.findFirst({
            where: and(eq(schema.programRole.programId, id), eq(schema.programRole.userId, userId), eq(schema.programRole.name, role)),
            columns: { id: true },
          }),
        ]);
        throwAddProgramRoleFailure({ programExists: Boolean(program), userExists: Boolean(user), duplicateRole: Boolean(duplicate) });
      }
      return role === "MENTOR"
        ? redirectWithFlash(Astro, `${page}#cohort-mentors`, { tone: "success", title: cohortChangeNotice({ kind: "mentor-added" }) })
        : redirectWithFlash(Astro, `${page}#staff`, { tone: "success", title: cohortChangeNotice({ kind: "staff-added" }) });
    } catch (error) {
      if (error instanceof ProgramManagementError) reject(form, error.message);
      else unavailable(form);
    }
  } else if (action === "remove-role") {
    const asMentor = formData.get("roleKind") === "MENTOR";
    try {
      const statement = buildRemoveProgramRoleStatement({ programId: id, roleId: text(formData.get("roleId")) });
      const result = await env.DB.prepare(statement.sql).bind(...statement.params).run();
      assertProgramRoleRemoved(result.meta.changes);
      return asMentor
        ? redirectWithFlash(Astro, `${page}#cohort-mentors`, { tone: "success", title: cohortChangeNotice({ kind: "mentor-removed" }) })
        : redirectWithFlash(Astro, `${page}#staff`, { tone: "success", title: cohortChangeNotice({ kind: "staff-removed" }) });
    } catch (error) {
      if (error instanceof ProgramManagementError) reject(asMentor ? "mentors" : "staff", error.message);
      else unavailable(asMentor ? "mentors" : "staff");
    }
  } else if (action === "direct-enroll") {
    Object.assign(kept, { enrolUserId: text(formData.get("userId")), enrolStatus: text(formData.get("status")), enrolDate: text(formData.get("completionDate")) });
    try {
      const enrollment = createAdminEnrollment({
        id: createId(),
        programId: id,
        userId: kept.enrolUserId ?? "",
        status: formData.get("status"),
        completionDate: formData.get("completionDate"),
      });
      if (needsCompletionConfirmation(formData, enrollment.status)) {
        const person = await db.query.user.findFirst({ where: eq(schema.user.id, enrollment.userId), columns: { name: true } });
        confirming = {
          form: "enrol",
          title: `Enroll ${person?.name ?? "this person"} as a past learner?`,
          body: "Completed opens their certificate and builder portfolio at once. Use it only for someone who finished this cohort.",
          confirmLabel: "Enroll as completed",
          fields: { action: "direct-enroll", userId: enrollment.userId, status: "COMPLETED", completionDate: kept.enrolDate ?? today, confirmed: "yes" },
        };
      } else {
        const statement = buildAdminEnrollmentStatement(enrollment);
        const result = await env.DB.prepare(statement.sql).bind(...statement.params).run();
        if (result.meta.changes !== statement.expectedChanges) {
          if (result.meta.changes !== 0) throw new Error(`Atomic admin enrollment changed ${result.meta.changes} rows; expected ${statement.expectedChanges}.`);
          const [program, user, existing] = await Promise.all([
            db.query.program.findFirst({ where: eq(schema.program.id, id), columns: { id: true } }),
            db.query.user.findFirst({ where: eq(schema.user.id, enrollment.userId), columns: { id: true } }),
            db.query.programApplication.findFirst({
              where: and(eq(schema.programApplication.programId, id), eq(schema.programApplication.userId, enrollment.userId)),
              columns: { id: true },
            }),
          ]);
          throwAdminEnrollmentFailure({ programExists: Boolean(program), userExists: Boolean(user), alreadyEnrolled: Boolean(existing) });
        }
        return redirectWithFlash(Astro, `${page}#roster`, { tone: "success", title: cohortChangeNotice({ kind: "enrolled", status: enrollment.status }) });
      }
    } catch (error) {
      if (error instanceof ProgramApplicationError) reject("enrol", error.message);
      else unavailable("enrol");
    }
  } else if (action === "bulk-approve" || action === "bulk-complete") {
    kept.rosterIds = formData.getAll("applicationIds").filter((value): value is string => typeof value === "string");
    kept.rosterDate = text(formData.get("completionDate"));
    try {
      const bulkAction = parseBulkApplicationAction(action);
      const applicationIds = parseSelectedApplicationIds(formData.getAll("applicationIds"));
      const applications = await db.query.programApplication.findMany({
        where: inArray(schema.programApplication.id, [...applicationIds]),
        columns: { id: true, programId: true, status: true },
      });
      const plan = planBulkProgramApplicationMutation({ action: bulkAction, programId: id, applicationIds, applications, completionDate: formData.get("completionDate") });
      if (needsCompletionConfirmation(formData, plan.status)) {
        const count = plan.applicationIds.length;
        confirming = {
          form: "roster",
          title: `Complete ${count} ${count === 1 ? "application" : "applications"}?`,
          body: "Completing opens each person's certificate and builder portfolio at once.",
          confirmLabel: `Complete ${count} ${count === 1 ? "application" : "applications"}`,
          fields: { action, applicationIds: [...plan.applicationIds], completionDate: kept.rosterDate || today, confirmed: "yes" },
        };
      } else {
        await applyApplicationMutationWithAttention({ db: env.DB, env }, {
          statement: buildBulkMutationStatement(plan),
          applicationIds: plan.applicationIds,
          actorId: Astro.locals.user!.id,
          status: plan.status,
          staleCode: "STALE_BULK_SELECTION",
          staleMessage: "The roster changed while this ran, so nothing was updated. Check the roster and choose the rows again.",
        });
        return redirectWithFlash(Astro, `${page}#roster`, {
          tone: "success",
          title: cohortChangeNotice({ kind: "bulk", action: bulkAction, count: plan.applicationIds.length }),
        });
      }
    } catch (error) {
      if (error instanceof ProgramApplicationError) reject("roster", error.message);
      else unavailable("roster");
    }
  } else {
    reject("details", "That isn't something this page can do. Reload it and try again.");
  }
}

// Independent reads, started together: the flag, the curricula, the cohort, the people who could join it,
// community mentors (found in SQL, not by reading every role) and the Admin space.
const [mentorsEnabled, curricula, prog, people, mentorRows, spaces] = await Promise.all([
  channelsOn(),
  db.query.curriculum.findMany({ columns: { id: true, title: true }, orderBy: (curriculum) => [asc(curriculum.title)] }),
  db.query.program.findFirst({
    where: eq(schema.program.id, id),
    with: {
      programRoles: { columns: { id: true, userId: true, name: true }, with: { user: { columns: { name: true, email: true } } } },
      programApplications: {
        columns: { id: true, userId: true, status: true, application: true, createdAt: true, completedAt: true },
        with: { user: { columns: { name: true, email: true } } },
        orderBy: (application) => [asc(application.createdAt)],
      },
    },
  }),
  db.query.user.findMany({ columns: { id: true, name: true, email: true }, orderBy: (user) => [asc(user.name), asc(user.email)] }),
  db
    .select({ userId: schema.userRole.userId })
    .from(schema.userRole)
    .innerJoin(schema.role, eq(schema.role.id, schema.userRole.roleId))
    .where(eq(schema.role.name, "MENTOR")),
  resolveSpacePage(Astro.locals, "adminCohorts"),
]);
if (!prog) return Astro.redirect(`${COHORTS_PATH}${failure ? "?notice=missing" : ""}`);

const flash = takeFlash(Astro);
const roster = prog.programApplications;
const enrolledIds = new Set(roster.map((application) => application.userId));
const available = people.filter((person) => !enrolledIds.has(person.id));
const mentorModel = cohortMentorModel(prog.programRoles, people, new Set(mentorRows.map((row) => row.userId)), enrolledIds);
// While channels are off, mentor rows stay in the staff list as they always have.
const staffRoles = mentorsEnabled ? teachingRoles(prog.programRoles) : prog.programRoles;
const asking = confirmingAction(Astro.url, prog.programRoles.map((role) => `remove-${role.id}`));
const askingStaff = staffRoles.find((role) => asking === `remove-${role.id}`);
const formatDate = (date: Date | null) => (date ? formatDateInputValue(date) : "");
const cohortEditValues: CohortUpdateValues = submittedCohortValues ?? {
  name: prog.name,
  description: prog.description,
  curriculumId: prog.curriculumId ?? "",
  startDate: formatDate(prog.startDate),
  endDate: formatDate(prog.endDate),
  applicationsOpen: prog.applicationsOpen,
};
const personOption = (person: { id: string; name: string; email: string }) => ({ value: person.id, label: `${person.name} (${person.email})` });
const rosterIds = new Set(kept.rosterIds ?? []);
---

<AdminLayout title={prog.name} titlePrefix={failure ? "Error: " : ""} spaces={spaces}>
  <div class="flex flex-col gap-12">
    <div class="flex flex-col gap-4">
      <BackLink href={COHORTS_PATH}>Cohorts</BackLink>
      <PageHeader title={prog.name}>
        {prog.description}
      </PageHeader>
    </div>

    {flash && <Notice tone={flash.tone} title={flash.title}>{flash.message}</Notice>}

    <section id="details" aria-labelledby="details-title" class="flex max-w-3xl flex-col gap-5">
      <h2 id="details-title" class="m-0 text-2xl">Details</h2>
      {failedForm === "details" && <Notice tone="danger" focusOnLoad title="The details weren't saved">{failure}</Notice>}
      <form method="POST" action={page} class="flex flex-col gap-5" data-cohort-details-form>
        <input type="hidden" name="action" value="update-program" />
        <TextField id="name" name="name" label="Name" defaultValue={cohortEditValues.name} error={cohortFieldErrors.name} required />
        <TextAreaField id="description" name="description" label="Description" rows={3} defaultValue={cohortEditValues.description} error={cohortFieldErrors.description} required />
        <div class="grid gap-5 sm:grid-cols-2">
          <TextField id="startDate" name="startDate" type="date" label="Start date" optional defaultValue={cohortEditValues.startDate} error={cohortFieldErrors.startDate} />
          <TextField id="endDate" name="endDate" type="date" label="End date" optional defaultValue={cohortEditValues.endDate} error={cohortFieldErrors.endDate} />
        </div>
        <SelectField
          id="curriculumId"
          name="curriculumId"
          label="Curriculum"
          placeholder="Choose a curriculum"
          options={curricula.map((curriculum) => ({ value: curriculum.id, label: curriculum.title }))}
          defaultValue={cohortEditValues.curriculumId}
          error={cohortFieldErrors.curriculumId}
          required
        />
        <Checkbox
          id="applicationsOpen"
          name="applicationsOpen"
          label="Applications open"
          hint="Shows this cohort on the application page, and accepts new applications."
          defaultChecked={cohortEditValues.applicationsOpen}
          error={cohortFieldErrors.applicationsOpen}
        />
        <div>
          <Button variant="primary" type="submit">Save changes</Button>
        </div>
      </form>
    </section>

    <section id="staff" aria-labelledby="staff-title" class="flex max-w-3xl flex-col gap-5">
      <h2 id="staff-title" class="m-0 text-2xl">Staff</h2>
      {failedForm === "staff" && <Notice tone="danger" focusOnLoad title="The staff didn't change">{failure}</Notice>}
      <DataTable caption="Staff" columns={[{ label: "Name" }, { label: "Role" }, { label: "Actions", hidden: true }]} isEmpty={staffRoles.length === 0}>
        {
          staffRoles.map((role) => (
            <DataRow current={askingStaff?.id === role.id}>
              <DataCell label="Name" primary>
                <a href={`/admin/users/${encodeURIComponent(role.userId)}`} class={linkClass()}>{role.user?.name ?? "Account removed"}</a>
              </DataCell>
              <DataCell label="Role">{cohortRoleLabel(role.name)}</DataCell>
              <DataCell label="" align="end">
                <ButtonLink variant="danger" size="sm" href={`${confirmHref(Astro.url, `remove-${role.id}`)}#staff`}>
                  Remove<span class="sr-only"> {role.user?.name ?? "this person"} from the staff</span>
                </ButtonLink>
              </DataCell>
            </DataRow>
          ))
        }
        <Fragment slot="empty">
          <EmptyState title="No staff yet" headingLevel={3}>Instructors and teaching assistants you add here can run this cohort's sessions.</EmptyState>
        </Fragment>
      </DataTable>
      {
        askingStaff && (
          <ConfirmStep
            title={`Remove ${askingStaff.user?.name ?? "this person"} from the staff?`}
            confirmLabel="Remove from the staff"
            cancelHref={`${withoutConfirm(Astro.url)}#staff`}
            action={page}
            fields={{ action: "remove-role", roleId: askingStaff.id, roleKind: askingStaff.name }}
          >
            They stop running this cohort at once. You can add them again here.
          </ConfirmStep>
        )
      }
      <form method="POST" action={page} class="grid gap-4 sm:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_auto] sm:items-end">
        <input type="hidden" name="action" value="add-role" />
        <SelectField id="staffUserId" name="userId" label="Person" placeholder="Choose a person" options={people.map(personOption)} defaultValue={kept.staffUserId} required />
        <SelectField id="roleName" name="roleName" label="Role" options={STAFF_ROLE_OPTIONS} defaultValue={kept.staffRole ?? "INSTRUCTOR"} required />
        <div>
          <Button type="submit" size="lg">Add to staff</Button>
        </div>
      </form>
    </section>

    {
      mentorsEnabled && (
        <CohortMentors
          model={mentorModel}
          page={page}
          url={Astro.url}
          asking={asking}
          error={failedForm === "mentors" ? failure : undefined}
          keptUserId={kept.mentorUserId}
        />
      )
    }

    <section id="roster" aria-labelledby="roster-title" class="flex flex-col gap-6">
      <div class="flex max-w-3xl flex-col gap-2">
        <h2 id="roster-title" class="m-0 text-2xl">Roster</h2>
        <p class="m-0 text-ink-secondary">Everyone who applied to this cohort or was enrolled in it, oldest first.</p>
      </div>

      <section aria-labelledby="enrol-title" class="flex max-w-3xl flex-col gap-4">
        <h3 id="enrol-title" class="m-0 text-lg">Enroll someone directly</h3>
        <p class="m-0 text-sm text-ink-secondary">
          Accepted is for someone joining now. Completed is only for someone who already finished this cohort: it opens their
          certificate and builder portfolio at once, so it asks first.
        </p>
        {failedForm === "enrol" && <Notice tone="danger" focusOnLoad title="No one was enrolled">{failure}</Notice>}
        {
          confirming?.form === "enrol" ? (
            <ConfirmStep title={confirming.title} confirmLabel={confirming.confirmLabel} cancelHref={page} action={page} fields={confirming.fields}>
              {confirming.body}
            </ConfirmStep>
          ) : available.length > 0 ? (
            <form method="POST" action={page} class="grid gap-4 sm:grid-cols-2">
              <input type="hidden" name="action" value="direct-enroll" />
              <SelectField id="enrollmentUserId" name="userId" label="Person" placeholder="Choose a person" options={available.map(personOption)} defaultValue={kept.enrolUserId} required className="sm:col-span-2" />
              <SelectField id="enrollmentStatus" name="status" label="Status" options={ENROLMENT_STATUS_OPTIONS} defaultValue={kept.enrolStatus ?? "APPROVED"} required />
              <TextField
                id="enrollmentCompletionDate"
                name="completionDate"
                type="date"
                label="Completion date"
                hint="Only used for Completed."
                defaultValue={kept.enrolDate || today}
                max={today}
                required
              />
              <div class="sm:col-span-2">
                <Button type="submit" size="lg">Enroll</Button>
              </div>
            </form>
          ) : (
            <p class="m-0 text-sm text-ink-secondary">Everyone who has signed in is already on this roster.</p>
          )
        }
      </section>

      {failedForm === "roster" && <Notice tone="danger" focusOnLoad title="Nothing on the roster changed">{failure}</Notice>}
      {
        confirming?.form === "roster" && (
          <ConfirmStep title={confirming.title} confirmLabel={confirming.confirmLabel} cancelHref={page} action={page} fields={confirming.fields}>
            {confirming.body}
          </ConfirmStep>
        )
      }
      <form method="POST" action={page} class="flex flex-col gap-5" data-bulk-form data-selection-limit={MAX_BULK_SELECTION_SIZE}>
        <DataTable
          caption={`${prog.name} roster`}
          columns={[{ label: "Select", hidden: true }, { label: "Learner" }, { label: "Status" }, { label: "Joined" }, { label: "Links", hidden: true }]}
          isEmpty={roster.length === 0}
        >
          {
            roster.map((application) => (
              <DataRow data-roster-application={application.id} data-application-status={application.status}>
                <DataSelectCell name="applicationIds" value={application.id} row={application.user?.name ?? "this learner"} defaultChecked={rosterIds.has(application.id)} />
                <DataCell label="Learner" primary>
                  <span class="flex min-w-0 flex-col">
                    <a href={`/admin/users/${encodeURIComponent(application.userId)}`} class={linkClass()}>{application.user?.name ?? "Account removed"}</a>
                    <span class="text-[0.8125rem] font-normal break-all text-ink-secondary">{application.user?.email ?? "No email"}</span>
                  </span>
                </DataCell>
                <DataCell label="Status">
                  <StatusChip domain="application" status={application.status} />
                </DataCell>
                <DataCell label="Joined">
                  {getEnrollmentSource(application.application) === "ADMIN" ? "Enrolled by an admin" : "Applied"}, {formatMomentDate(application.createdAt)}
                </DataCell>
                <DataCell label="" align="end">
                  <span class="inline-flex flex-wrap gap-2">
                    <RowAction href={`/admin/applications/${application.id}`} row={application.user?.name ?? "this learner"}>
                      Application
                    </RowAction>
                    {application.status === "COMPLETED" && application.completedAt && (
                      <RowAction href={`/certificate/${application.id}`} row={application.user?.name ?? "this learner"}>
                        Certificate
                      </RowAction>
                    )}
                  </span>
                </DataCell>
              </DataRow>
            ))
          }
          <Fragment slot="empty">
            <EmptyState title="No one on the roster yet" headingLevel={3}>
              People appear here when they apply to this cohort, or when you enroll them above.
            </EmptyState>
          </Fragment>
        </DataTable>

        {
          roster.length > 0 && (
            <div class="flex flex-col gap-4 border-t border-hairline pt-5">
              <p class="m-0 max-w-prose text-sm text-ink-secondary">
                Choose rows, then accept those waiting for review or auditing, or complete those accepted. If anything you chose
                has changed meanwhile, nothing is updated. Up to {MAX_BULK_SELECTION_SIZE} at a time
                (<output data-selection-count aria-live="polite">{rosterIds.size} chosen</output>).
              </p>
              <div class="flex flex-col gap-4 sm:flex-row sm:items-end">
                <TextField
                  id="rosterCompletionDate"
                  name="completionDate"
                  type="date"
                  label="Completion date"
                  hint="Only used when completing."
                  defaultValue={kept.rosterDate || today}
                  max={today}
                  required
                  className="sm:w-56"
                />
                <div class="flex flex-wrap gap-2">
                  <Button type="submit" size="lg" name="action" value="bulk-approve">Accept selected</Button>
                  <Button type="submit" size="lg" name="action" value="bulk-complete">Complete selected</Button>
                </div>
              </div>
            </div>
          )
        }
      </form>
    </section>
  </div>
</AdminLayout>

<script>
  // Counts the selection as it changes and stops it at the limit. The server checks both again.
  for (const form of document.querySelectorAll<HTMLFormElement>("[data-bulk-form]")) {
    const limit = Number.parseInt(form.dataset.selectionLimit ?? "", 10);
    const boxes = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="applicationIds"]'));
    const count = form.querySelector<HTMLOutputElement>("[data-selection-count]");
    const update = () => {
      const chosen = boxes.filter((box) => box.checked).length;
      if (count) count.value = `${chosen} chosen`;
      for (const box of boxes) box.disabled = Number.isFinite(limit) && chosen >= limit && !box.checked;
    };
    for (const box of boxes) box.addEventListener("change", update);
    update();
  }
</script>
