---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Button from "@/components/common/Button.astro";
import Card from "@/components/common/Card.astro";
import { drizzle } from "drizzle-orm/d1";
import * as schema from "@/lib/db/schema";
import { env } from "cloudflare:workers";
import {
  createCohortValuesFromFormData,
  validateCreateCohort,
  type CreateCohortFieldErrors,
  type CreateCohortValues,
} from "@/lib/admin/cohorts";

const db = drizzle(env.DB, { schema });

const curricula = await db.query.curriculum.findMany({
  orderBy: (c, { asc }) => [asc(c.title)],
});

let values: CreateCohortValues = {
  name: "",
  description: "",
  curriculumId: "",
  startDate: "",
  endDate: "",
  applicationsOpen: false,
};
let fieldErrors: CreateCohortFieldErrors = {};
let formError: string | undefined;

if (Astro.request.method === "POST") {
  values = createCohortValuesFromFormData(await Astro.request.formData());
  const validation = validateCreateCohort(
    values,
    curricula.map((curriculum) => curriculum.id)
  );

  if (!validation.valid) {
    fieldErrors = validation.errors;
  } else {
    try {
      const [created] = await db
        .insert(schema.program)
        .values(validation.data)
        .returning();
      if (!created) throw new Error("Cohort insert did not return a row.");
      return Astro.redirect(`/admin/programs/${created.id}`);
    } catch {
      formError = "The cohort could not be created. Please try again.";
    }
  }
}
---

<AdminLayout title="New Cohort">
  <div class="space-y-6">
    <a href="/admin/programs" class="text-sm text-primary hover:underline">
      &larr; Back to Cohorts
    </a>

    <h2 class="text-2xl font-bold text-white">Create Cohort</h2>

    {curricula.length === 0 ? (
      <Card>
        <div class="py-6 text-center">
          <h3 class="text-lg font-semibold text-white">
            Create a curriculum first
          </h3>
          <p class="mx-auto mt-2 max-w-xl text-sm text-ink-secondary">
            Every cohort needs a curriculum. Add one, then return here to
            create the cohort.
          </p>
          {fieldErrors.curriculumId && (
            <p role="alert" class="mt-3 text-sm text-red-200">
              {fieldErrors.curriculumId}
            </p>
          )}
          <Button href="/admin/curricula/new" class="mt-5">
            Create Curriculum
          </Button>
        </div>
      </Card>
    ) : (
    <Card>
      {formError && (
        <p
          role="alert"
          class="mb-5 rounded-md border border-red-400/40 bg-red-500/15 px-4 py-3 text-sm text-red-100"
        >
          {formError}
        </p>
      )}
      <form method="POST" class="space-y-4">
        <div class="flex flex-col gap-1.5">
          <label for="name" class="text-sm font-medium text-white/90">Name *</label>
          <input
            id="name"
            name="name"
            required
            aria-invalid={Boolean(fieldErrors.name)}
            aria-describedby={fieldErrors.name ? "name-error" : undefined}
            value={values.name}
            placeholder="Cohort name"
            class="form-control placeholder:text-ink-muted"
          />
          {fieldErrors.name && (
            <p id="name-error" class="text-sm text-red-200">
              {fieldErrors.name}
            </p>
          )}
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="description" class="text-sm font-medium text-white/90">Description *</label>
          <textarea
            id="description"
            name="description"
            required
            aria-invalid={Boolean(fieldErrors.description)}
            aria-describedby={fieldErrors.description ? "description-error" : undefined}
            rows="3"
            placeholder="Cohort description"
            class="form-control placeholder:text-ink-muted"
          >{values.description}</textarea>
          {fieldErrors.description && (
            <p id="description-error" class="text-sm text-red-200">
              {fieldErrors.description}
            </p>
          )}
        </div>

        <div class="flex w-full min-w-0 flex-col gap-1.5">
          <label for="curriculumId" class="text-sm font-medium text-white/90">Curriculum *</label>
          <select
            id="curriculumId"
            name="curriculumId"
            required
            aria-invalid={Boolean(fieldErrors.curriculumId)}
            aria-describedby={fieldErrors.curriculumId ? "curriculum-error" : undefined}
            class="form-control w-full min-w-0"
          >
            <option value="">Select curriculum…</option>
            {curricula.map((c) => (
              <option value={c.id} selected={values.curriculumId === c.id}>
                {c.title}
              </option>
            ))}
          </select>
          {fieldErrors.curriculumId && (
            <p id="curriculum-error" class="text-sm text-red-200">
              {fieldErrors.curriculumId}
            </p>
          )}
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="flex flex-col gap-1.5">
            <label for="startDate" class="text-sm font-medium text-white/90">Start Date</label>
            <input
              type="date"
              id="startDate"
              name="startDate"
              aria-invalid={Boolean(fieldErrors.startDate)}
              aria-describedby={fieldErrors.startDate ? "start-date-error" : undefined}
              value={values.startDate}
              class="form-control"
            />
            {fieldErrors.startDate && (
              <p id="start-date-error" class="text-sm text-red-200">
                {fieldErrors.startDate}
              </p>
            )}
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="endDate" class="text-sm font-medium text-white/90">End Date</label>
            <input
              type="date"
              id="endDate"
              name="endDate"
              aria-invalid={Boolean(fieldErrors.endDate)}
              aria-describedby={fieldErrors.endDate ? "end-date-error" : undefined}
              value={values.endDate}
              class="form-control"
            />
            {fieldErrors.endDate && (
              <p id="end-date-error" class="text-sm text-red-200">
                {fieldErrors.endDate}
              </p>
            )}
          </div>
        </div>

        <div class="space-y-1.5">
          <label for="applicationsOpen" class="flex items-center gap-2 text-sm font-medium text-white/90">
            <input
              type="checkbox"
              id="applicationsOpen"
              name="applicationsOpen"
              value="true"
              checked={values.applicationsOpen}
              class="h-4 w-4 rounded border-teal bg-dark/50 text-primary focus:ring-primary/50"
            />
            Applications open
          </label>
          <p class="text-sm text-ink-muted">Leave unchecked to create a closed cohort.</p>
        </div>

        <Button type="submit">
          Create Cohort
        </Button>
      </form>
    </Card>
    )}
  </div>
</AdminLayout>
