---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";
import {
  BackLink,
  Button,
  ButtonLink,
  Card,
  Checkbox,
  EmptyState,
  Notice,
  PageHeader,
  SelectField,
  TextAreaField,
  TextField,
} from "@/components/platform/ui";
import { drizzle } from "drizzle-orm/d1";
import * as schema from "@/lib/db/schema";
import { env } from "cloudflare:workers";
import { redirectWithFlash } from "@/lib/platform/server/flash";
import {
  createCohortValuesFromFormData,
  validateCreateCohort,
  type CreateCohortFieldErrors,
  type CreateCohortValues,
} from "@/lib/admin/cohorts";

const LIST_PATH = "/admin/programs";
const db = drizzle(env.DB, { schema });

// The curricula and the Admin space are independent reads: one round trip.
const [curricula, spaces] = await Promise.all([
  db.query.curriculum.findMany({ columns: { id: true, title: true }, orderBy: (c, { asc }) => [asc(c.title)] }),
  resolveSpacePage(Astro.locals, "adminCohorts"),
]);

let values: CreateCohortValues = { name: "", description: "", curriculumId: "", startDate: "", endDate: "", applicationsOpen: false };
let errors: CreateCohortFieldErrors = {};
let formError: string | undefined;

if (Astro.request.method === "POST") {
  values = createCohortValuesFromFormData(await Astro.request.formData());
  const validation = validateCreateCohort(values, curricula.map((curriculum) => curriculum.id));
  if (!validation.valid) {
    errors = validation.errors;
    Astro.response.status = 400;
  } else {
    try {
      const [created] = await db.insert(schema.program).values(validation.data).returning({ id: schema.program.id });
      if (!created) throw new Error("The cohort insert returned no row.");
      return redirectWithFlash(Astro, `${LIST_PATH}/${encodeURIComponent(created.id)}`, {
        tone: "success",
        title: "Cohort created",
        message: validation.data.applicationsOpen ? "Applications are open." : "Applications are closed until you open them.",
      });
    } catch {
      formError = "The database didn't answer, so the cohort wasn't created. Try again in a moment.";
      Astro.response.status = 503;
    }
  }
}

const rejected = Boolean(formError || Object.keys(errors).length > 0);
const curriculumOptions = curricula.map((curriculum) => ({ value: curriculum.id, label: curriculum.title }));
---

<AdminLayout title="New cohort" titlePrefix={rejected ? "Error: " : ""} spaces={spaces}>
  <div class="mx-auto max-w-3xl space-y-6">
    <BackLink href={LIST_PATH}>Cohorts</BackLink>

    <PageHeader title="New cohort">
      A group of learners following one curriculum, with its own channels, sessions and applications.
    </PageHeader>

    {rejected && (
      <Notice tone="danger" focusOnLoad id="cohort-failure" title="The cohort wasn't created">
        {formError ?? (curricula.length === 0 ? errors.curriculumId : undefined) ?? "Fix the fields marked below. Everything you wrote is kept."}
      </Notice>
    )}

    {curricula.length === 0 ? (
      <EmptyState title="Create a curriculum first" headingLevel={2}>
        Every cohort follows a curriculum. Add one, then come back to create the cohort.
        <Fragment slot="action">
          <ButtonLink variant="primary" href="/admin/curricula/new">New curriculum</ButtonLink>
        </Fragment>
      </EmptyState>
    ) : (
      <Card>
        <form method="POST" action={Astro.url.pathname} class="grid gap-5" data-cohort-form>
          <TextField label="Name" name="name" required placeholder="Cohort 06" defaultValue={values.name} error={errors.name} />
          <TextAreaField label="Description" name="description" required rows={3} defaultValue={values.description} error={errors.description} />
          <SelectField
            label="Curriculum"
            name="curriculumId"
            required
            placeholder="Choose a curriculum"
            options={curriculumOptions}
            defaultValue={values.curriculumId}
            error={errors.curriculumId}
          />
          <div class="grid gap-5 sm:grid-cols-2">
            <TextField label="Starts on" name="startDate" type="date" optional defaultValue={values.startDate} error={errors.startDate} />
            <TextField label="Ends on" name="endDate" type="date" optional defaultValue={values.endDate} error={errors.endDate} />
          </div>
          <Checkbox
            label="Applications open"
            name="applicationsOpen"
            value="true"
            defaultChecked={values.applicationsOpen}
            hint="Leave it unticked to create a closed cohort; you can open applications later."
          />
          <div>
            <Button type="submit" variant="primary">Create cohort</Button>
          </div>
        </form>
      </Card>
    )}
  </div>
</AdminLayout>
