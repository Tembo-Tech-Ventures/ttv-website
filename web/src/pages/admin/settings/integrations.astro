---
import { env } from "cloudflare:workers";
import { drizzle } from "drizzle-orm/d1";
import { eq } from "drizzle-orm";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";
import {
  Button,
  ButtonLink,
  Card,
  Chip,
  ConfirmStep,
  DataCell,
  DataRow,
  DataTable,
  DescriptionItem,
  DescriptionList,
  Notice,
  PageHeader,
  TextAreaField,
  TextField,
  buttonClass,
  confirmHref,
  confirmingAction,
  linkClass,
  withoutConfirm,
} from "@/components/platform/ui";
import { CREDENTIAL_ACTION_LABEL, INTEGRATIONS_PATH, readIntegrationsPage } from "@/lib/admin/integrations";
import { createCredentialCipher } from "@/lib/credentials/crypto";
import { GOOGLE_DRIVE_PROVIDER, ServiceAccountInputError, getGoogleDriveCredentials, saveGoogleDriveCredential } from "@/lib/credentials/google-drive";
import { MissingCredentialError, deleteIntegrationCredential, recordCredentialTest, updateIntegrationCredentialConfig } from "@/lib/credentials/store";
import * as schema from "@/lib/db/schema";
import { formatMomentDateTime } from "@/lib/display-date";
import { redirectWithFlash, takeFlash } from "@/lib/platform/server/flash";
import { testGoogleDriveConnection } from "@/lib/recordings/google-drive";

/*
 * Third-party credentials, encrypted at rest and never shown after saving:
 * today the Google Drive service account that session recordings import
 * with. Save, replace, change the impersonated user or test it, each a 303
 * back here with a flash; removing it takes a confirm step first. The facts
 * and recent activity are one read, beside the Admin space.
 */
Astro.response.headers.set("Cache-Control", "no-store");

const userId = Astro.locals.user?.id;
if (!userId) return Astro.redirect("/auth/login");

const encryptionAvailable = Boolean(env.CREDENTIALS_ENCRYPTION_KEY);
const db = drizzle(env.DB, { schema });
const UNAVAILABLE = "The database didn't answer, so nothing changed. Try again in a moment.";

type Form = "save" | "replace" | "update-config";
let actionError: string | undefined;
// The form a refusal came from, its reason and the impersonated user typed; the JSON is a secret, so it is never echoed back.
let refused: { form: Form; json?: string; user?: string; impersonatedUser: string } | undefined;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const action = String(formData.get("action") ?? "");
  const impersonatedUser = String(formData.get("impersonatedUser") ?? "").trim();
  if (!encryptionAvailable) {
    actionError = "Credential storage isn't set up in this environment, so nothing changed.";
    Astro.response.status = 403;
  } else if (action === "save" || action === "replace") {
    const serviceAccountJson = String(formData.get("serviceAccountJson") ?? "");
    if (!serviceAccountJson.trim()) {
      refused = { form: action, json: "Paste the service account's JSON key file.", impersonatedUser };
      Astro.response.status = 400;
    } else {
      try {
        await saveGoogleDriveCredential(db, createCredentialCipher(env), { serviceAccountJson, impersonatedUser: impersonatedUser || undefined, actorUserId: userId });
        return redirectWithFlash(Astro, INTEGRATIONS_PATH, { tone: "success", title: action === "save" ? "Google Drive credential saved" : "Google Drive credential replaced" });
      } catch (caught) {
        if (caught instanceof ServiceAccountInputError) {
          refused = { form: action, json: `${caught.message} Paste the whole key file again.`, impersonatedUser };
          Astro.response.status = 400;
        } else {
          actionError = UNAVAILABLE;
          Astro.response.status = 503;
        }
      }
    }
    if (refused) actionError = "Check the field marked below.";
  } else if (action === "update-config") {
    try {
      await updateIntegrationCredentialConfig(db, {
        provider: GOOGLE_DRIVE_PROVIDER,
        config: JSON.stringify({ impersonatedUser: impersonatedUser || null }),
        actorUserId: userId,
      });
      return redirectWithFlash(Astro, INTEGRATIONS_PATH, { tone: "success", title: impersonatedUser ? "Impersonated user changed" : "Impersonated user cleared" });
    } catch (caught) {
      if (caught instanceof MissingCredentialError) {
        return redirectWithFlash(Astro, INTEGRATIONS_PATH, { tone: "info", title: "There's no credential to change", message: "It was removed meanwhile. Save a new one below." });
      }
      actionError = UNAVAILABLE;
      Astro.response.status = 503;
    }
  } else if (action === "test") {
    try {
      const credentials = await getGoogleDriveCredentials(db, createCredentialCipher(env));
      if (!credentials) {
        return redirectWithFlash(Astro, INTEGRATIONS_PATH, { tone: "info", title: "There's no credential to test", message: "Save one below first." });
      }
      const sources = await db.query.recordingImportSource.findMany({
        where: eq(schema.recordingImportSource.enabled, true),
        columns: { driveFolderId: true },
      });
      const results = await testGoogleDriveConnection({ credentials, folderIds: sources.map((source) => source.driveFolderId) });
      const ok = results.every((result) => result.ok);
      const detail = results.map((result) => `${result.folderId || "API"}: ${result.ok ? "ok" : result.errorCode}`).join("; ");
      await recordCredentialTest(db, { provider: GOOGLE_DRIVE_PROVIDER, actorUserId: userId, ok, detail });
      return redirectWithFlash(
        Astro,
        INTEGRATIONS_PATH,
        ok ? { tone: "success", title: "Connection test passed" } : { tone: "warning", title: "Connection test failed", message: detail },
      );
    } catch {
      actionError = "The test couldn't run, so nothing was recorded. Try again in a moment.";
      Astro.response.status = 503;
    }
  } else if (action === "remove") {
    const removed = await deleteIntegrationCredential(db, { provider: GOOGLE_DRIVE_PROVIDER, actorUserId: userId }).then(
      () => true,
      () => false,
    );
    if (removed) return redirectWithFlash(Astro, INTEGRATIONS_PATH, { tone: "success", title: "Google Drive credential removed" });
    actionError = UNAVAILABLE;
    Astro.response.status = 503;
  } else {
    actionError = "Choose one of the actions on this page.";
    Astro.response.status = 400;
  }
}

const flash = takeFlash(Astro);
const [page, spaces] = await Promise.all([encryptionAvailable ? readIntegrationsPage(db) : Promise.resolve(null), resolveSpacePage(Astro.locals, "adminIntegrations")]);
const credential = page?.credential ?? null;
const activity = page?.activity ?? [];
const removing = confirmingAction(Astro.url, credential ? ["remove"] : []) === "remove";
const keptUser = (form: Form) => (refused?.form === form ? refused.impersonatedUser : (credential?.impersonatedUser ?? ""));
const externalLink = linkClass();
---

<AdminLayout title="Integrations" titlePrefix={actionError ? "Error: " : undefined} spaces={spaces}>
  <div class="flex max-w-4xl flex-col gap-8">
    <PageHeader title="Integrations">
      Credentials for the services the platform reads from. Each is encrypted before it's stored and never shown again, only replaced or removed.
    </PageHeader>

    {flash && <Notice tone={flash.tone} title={flash.title}>{flash.message}</Notice>}
    {actionError && <Notice tone="danger" focusOnLoad title="Nothing changed">{actionError}</Notice>}

    {
      !encryptionAvailable ? (
        <Notice tone="warning" title="Credential storage isn't set up here">
          This environment has no <code class="font-mono">CREDENTIALS_ENCRYPTION_KEY</code> secret, so it can't store a credential.
        </Notice>
      ) : (
        <>
          <Card as="section" aria-labelledby="google-drive" className="flex flex-col gap-5">
            <div class="flex flex-col gap-1">
              <h2 id="google-drive" class="text-lg text-ink-primary">Google Drive</h2>
              <p class="max-w-prose text-sm text-ink-secondary">The service account that session recordings are imported from Google Drive with.</p>
            </div>

            <details open={!credential} class="group rounded-xl border border-hairline p-4">
              <summary class="cursor-pointer rounded-sm text-sm font-semibold text-ink-primary">Where to get this credential</summary>
              <ol class="mt-3 flex list-decimal flex-col gap-2 pl-5 text-sm text-ink-secondary">
                <li>
                  In Google Cloud Console, pick or create a project and turn on the{" "}
                  <a href="https://console.cloud.google.com/apis/library/drive.googleapis.com" target="_blank" rel="noopener noreferrer" class={externalLink}>Google Drive API</a>.
                </li>
                <li>
                  Create a{" "}
                  <a href="https://console.cloud.google.com/iam-admin/serviceaccounts" target="_blank" rel="noopener noreferrer" class={externalLink}>service account</a>.
                  It needs no project roles.
                </li>
                <li>On the service account, open Keys, then Add key, Create new key, JSON, and download the key file.</li>
                <li>
                  In Google Drive, share the Meet recordings folder with the service account's email (the <code class="font-mono">client_email</code> in the
                  JSON) as a Viewer. The importer only ever reads.
                </li>
                <li>Paste the whole JSON file below and save it. It's encrypted before it's stored and can't be viewed again, only replaced or removed.</li>
              </ol>
              <p class="mt-3 text-sm text-ink-secondary">
                If your Workspace blocks sharing with service accounts, a Workspace super admin can give the service account domain-wide delegation for{" "}
                <code class="font-mono break-all">https://www.googleapis.com/auth/drive.readonly</code> instead. Then set the impersonated user to someone
                in your Workspace who can read the folder.
              </p>
            </details>

            {
              !credential ? (
                <form method="POST" action={INTEGRATIONS_PATH} class="flex flex-col gap-4">
                  <input type="hidden" name="action" value="save" />
                  <TextAreaField
                    label="Service account JSON"
                    name="serviceAccountJson"
                    required
                    rows={6}
                    error={refused?.form === "save" ? refused.json : undefined}
                    hint="The whole key file, as downloaded."
                    className="font-mono"
                  />
                  <TextField
                    label="Impersonated user"
                    name="impersonatedUser"
                    type="email"
                    optional
                    defaultValue={keptUser("save")}
                    hint="Only with domain-wide delegation: a Workspace user who can read the folder."
                  />
                  <div>
                    <Button type="submit" variant="primary">Save credential</Button>
                  </div>
                </form>
              ) : (
                <>
                  <DescriptionList>
                    {credential.facts.clientEmail && <DescriptionItem term="Client email">{credential.facts.clientEmail}</DescriptionItem>}
                    {credential.facts.projectId && <DescriptionItem term="Project">{credential.facts.projectId}</DescriptionItem>}
                    {credential.facts.privateKeyIdFingerprint && (
                      <DescriptionItem term="Key starts with">
                        <code class="font-mono">{credential.facts.privateKeyIdFingerprint}</code>
                      </DescriptionItem>
                    )}
                    <DescriptionItem term="Impersonated user">{credential.impersonatedUser ?? "None"}</DescriptionItem>
                    <DescriptionItem term="Last changed">
                      {formatMomentDateTime(credential.updatedAt)}
                      {credential.updatedByName && <span class="text-ink-secondary"> by {credential.updatedByName}</span>}
                    </DescriptionItem>
                  </DescriptionList>

                  {removing ? (
                    <ConfirmStep
                      title="Remove the Google Drive credential?"
                      confirmLabel="Remove credential"
                      cancelHref={withoutConfirm(Astro.url)}
                      action={INTEGRATIONS_PATH}
                      fields={{ action: "remove" }}
                    >
                      It's deleted for good, and recording imports from Google Drive stop until you save a new one.
                    </ConfirmStep>
                  ) : (
                    <div class="flex flex-col gap-3 border-t border-hairline pt-4">
                      <details open={refused?.form === "replace"} class="group">
                        <summary class={buttonClass({ variant: "quiet", className: "cursor-pointer list-none" })}>Replace credential</summary>
                        <form method="POST" action={INTEGRATIONS_PATH} class="mt-3 flex flex-col gap-4">
                          <input type="hidden" name="action" value="replace" />
                          <TextAreaField
                            label="New service account JSON"
                            name="serviceAccountJson"
                            required
                            rows={4}
                            error={refused?.form === "replace" ? refused.json : undefined}
                            hint="The whole replacement key file."
                            className="font-mono"
                          />
                          <TextField label="Impersonated user" name="impersonatedUser" id="replace-impersonated-user" type="email" optional defaultValue={keptUser("replace")} />
                          <div>
                            <Button type="submit" variant="primary">Replace credential</Button>
                          </div>
                        </form>
                      </details>

                      <details class="group">
                        <summary class={buttonClass({ variant: "quiet", className: "cursor-pointer list-none" })}>Change impersonated user</summary>
                        <form method="POST" action={INTEGRATIONS_PATH} class="mt-3 flex flex-col gap-4">
                          <input type="hidden" name="action" value="update-config" />
                          <TextField
                            label="Impersonated user"
                            name="impersonatedUser"
                            id="config-impersonated-user"
                            type="email"
                            optional
                            defaultValue={keptUser("update-config")}
                            hint="Leave it empty to stop impersonating anyone."
                          />
                          <div>
                            <Button type="submit" variant="quiet">Save impersonated user</Button>
                          </div>
                        </form>
                      </details>

                      <div class="flex flex-wrap gap-2">
                        <form method="POST" action={INTEGRATIONS_PATH}>
                          <input type="hidden" name="action" value="test" />
                          <Button type="submit" variant="quiet">Test connection</Button>
                        </form>
                        <ButtonLink variant="danger" href={confirmHref(Astro.url, "remove")}>Remove credential</ButtonLink>
                      </div>
                    </div>
                  )}
                </>
              )
            }
          </Card>

          {activity.length > 0 && (
            <section aria-labelledby="recent-activity" class="flex flex-col gap-4">
              <h2 id="recent-activity" class="text-lg text-ink-primary">Recent activity</h2>
              <DataTable caption="Recent activity" columns={[{ label: "What happened" }, { label: "Result" }, { label: "By" }, { label: "When", align: "end" }]}>
                {activity.map((entry) => (
                  <DataRow>
                    <DataCell label="What happened" primary>
                      <Chip tone="neutral">{CREDENTIAL_ACTION_LABEL[entry.action]}</Chip>
                    </DataCell>
                    <DataCell label="Result">{entry.outcome ?? "Not recorded"}</DataCell>
                    <DataCell label="By">{entry.by}</DataCell>
                    <DataCell label="When" align="end">
                      {formatMomentDateTime(entry.createdAt)}
                    </DataCell>
                  </DataRow>
                ))}
              </DataTable>
            </section>
          )}
        </>
      )
    }
  </div>
</AdminLayout>
