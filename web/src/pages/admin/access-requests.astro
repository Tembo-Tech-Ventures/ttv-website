---
import { env } from "cloudflare:workers";
import { PiInfo } from "react-icons/pi";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";
import { EmptyState, FOCUS_RING, Notice, PageHeader, PillNav } from "@/components/platform/ui";
import AccessRequestCard from "@/components/admin/AccessRequestCard.astro";
import {
  ACCESS_REQUESTS_PATH, decisionFailure, decisionNotice, isDelegatedCredential, isOwnRepeatDecision, parseDecisionForm,
} from "@/lib/admin/access-requests";
import {
  AccessRequestCursorError, decideAccessRequest, getAdminAccessRequest, listAccessRequests,
} from "@/lib/onboarding/decisions";
import { AccessRequestQueueState, Cursor } from "@/lib/platform/contracts";
import { redirectWithFlash, takeFlash, type Flash } from "@/lib/platform/server/flash";

/*
 * Mentor and institution access requests (onboarding SPEC S6). Middleware has required ADMIN, and
 * admin POSTs must be same-origin. The page also refuses personal access tokens and agent sessions,
 * as /api/admin/access-requests does: notes are for human administrators, and no agent grants roles.
 * Not flag-gated, so pending requests are never stranded while onboarding is off.
 */
if (isDelegatedCredential(Astro.locals)) {
  return new Response("Forbidden: decide access requests in a browser session.", {
    status: 403,
    headers: { "Cache-Control": "no-store", "Content-Type": "text/plain; charset=utf-8" },
  });
}
const adminId = Astro.locals.user?.id;
if (!adminId) return Astro.redirect("/auth/login");

const search = Astro.url.searchParams;
const state = AccessRequestQueueState.safeParse(search.get("status")).data ?? "PENDING";
const cursor = Cursor.safeParse(search.get("cursor")).data;

let failure: string | undefined;
let rowError: { id: string; message: string; draft: string } | undefined;
// The list the administrator decided from, its tab and page, without an old `?decided=` address.
const listHref = (() => {
  const url = new URL(Astro.url);
  url.searchParams.delete("decided");
  return `${url.pathname}${url.search}`;
})();
/** What the list says once, after a decision went through: the decided card has left it. */
const decidedFlash = (request: Parameters<typeof decisionNotice>[0]): Flash => ({
  tone: "success",
  message: decisionNotice(request) ?? "The request was decided.",
});

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const parsed = parseDecisionForm(form);
  if (!parsed.ok) {
    Astro.response.status = 400;
    const draft = form.get("message");
    if (parsed.id) rowError = { id: parsed.id, message: parsed.error, draft: typeof draft === "string" ? draft : "" };
    else failure = parsed.error;
  } else {
    try {
      const decided = await decideAccessRequest({ db: env.DB, env }, { id: parsed.id, actorId: adminId, ...parsed.decision });
      return redirectWithFlash(Astro, listHref, decidedFlash(decided));
    } catch (error) {
      const refused = decisionFailure(error) ?? { status: 503, message: "The database didn't answer. The list below shows what is decided; try again in a moment if this request is still there." };
      // Best effort: if the re-read fails too, the 409 copy still stands.
      const current = refused.status === 409 ? await getAdminAccessRequest(env.DB, parsed.id).catch(() => null) : null;
      // A double-click: the request already says what this administrator decided, so it reads as done.
      if (current && isOwnRepeatDecision(current, adminId, parsed.decision.decision)) {
        return redirectWithFlash(Astro, listHref, decidedFlash(current));
      }
      Astro.response.status = refused.status;
      failure = refused.message;
    }
  }
}

// The list and the Admin space are independent reads: one round trip, not two.
const [list, spaces] = await Promise.all([
  listAccessRequests(env.DB, { status: state, cursor }).catch((error: unknown) => {
    if (error instanceof AccessRequestCursorError) return null;
    throw error;
  }),
  resolveSpacePage(Astro.locals, "adminAccessRequests"),
]);
if (!list) return Astro.redirect(state === "PENDING" ? ACCESS_REQUESTS_PATH : `${ACCESS_REQUESTS_PATH}?status=${state}`, 303);

// A refused form whose request is not on this page still has to say why.
if (rowError && !list.items.some((request) => request.id === rowError?.id)) {
  failure = rowError.message;
  rowError = undefined;
}

// Only after a decision that went through, read once: a POST never carries it, so it never sits beside a refusal.
const notice = Astro.request.method === "GET" ? takeFlash(Astro) : null;

const tabs = [
  { state: "PENDING", label: "Pending", href: ACCESS_REQUESTS_PATH, count: list.pendingCount },
  { state: "DECIDED", label: "Decided", href: `${ACCESS_REQUESTS_PATH}?status=DECIDED`, count: 0 },
] as const;
const current = tabs.find((tab) => tab.state === state) ?? tabs[0];
const PAGER_LINK = "inline-flex min-h-11 items-center rounded-sm font-semibold text-peach-ink hover:underline";
const nextHref = list.nextCursor ? `${current.href}${state === "PENDING" ? "?" : "&"}cursor=${encodeURIComponent(list.nextCursor)}` : null;
---

<AdminLayout title="Access requests" pendingAccessRequests={list.pendingCount} spaces={spaces}>
  <div class="mx-auto max-w-6xl space-y-8 lg:px-6 lg:pt-6">
    <PageHeader title="Access requests">
      People asking for mentor or organisation access. Approving adds the role. Declining leaves them a member, with
      your message if you write one.
    </PageHeader>

    {/* After a decision the decided card leaves the list, so focus goes to the notice that says what happened (QAO-06). */}
    {notice && <Notice tone={notice.tone} title={notice.title} focusOnLoad id="access-request-notice">{notice.message}</Notice>}
    {failure && <Notice tone="danger" focusOnLoad id="access-request-failure">{failure}</Notice>}

    <PillNav
      label="Access request lists"
      countLabel="waiting"
      items={tabs.map((tab) => ({ label: tab.label, href: tab.href, count: tab.count, current: tab.state === state }))}
    />

    {list.items.length === 0 ? (
      state === "PENDING" ? (
        <EmptyState title="No one is waiting for a decision" headingLevel={2}>
          New mentor and organisation requests appear here.
        </EmptyState>
      ) : (
        <EmptyState title="Nothing decided yet" headingLevel={2}>
          Approved and declined requests appear here.
        </EmptyState>
      )
    ) : (
      <ul class="-mt-6" aria-label={state === "PENDING" ? "Pending requests" : "Decided requests"} data-access-request-list={state}>
        {list.items.map((request) => (
          <AccessRequestCard
            request={request}
            action={listHref}
            error={rowError?.id === request.id ? rowError.message : undefined}
            draftMessage={rowError?.id === request.id ? rowError.draft : undefined}
          />
        ))}
      </ul>
    )}

    {(nextHref || cursor) && (
      <nav aria-label="More requests" class="flex flex-wrap gap-4 text-sm">
        {cursor && <a href={current.href} class:list={[PAGER_LINK, FOCUS_RING]}>Back to the start</a>}
        {nextHref && <a href={nextHref} class:list={[PAGER_LINK, FOCUS_RING]}>{state === "PENDING" ? "Next requests" : "Older decisions"}</a>}
      </nav>
    )}

    <p class="flex gap-2 text-sm text-ink-secondary">
      <PiInfo className="mt-0.5 size-4 shrink-0 text-ink-muted" aria-hidden="true" />
      The person sees your message, not your name. Notes in a request are visible only to administrators.
    </p>
  </div>
</AdminLayout>
