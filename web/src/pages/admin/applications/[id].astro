---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";
import {
  BackLink,
  Button,
  ButtonLink,
  Card,
  ConfirmStep,
  DescriptionItem,
  DescriptionList,
  Notice,
  PageHeader,
  StatusChip,
  TextField,
  confirmHref,
  confirmingAction,
  linkClass,
  statusTone,
  withoutConfirm,
} from "@/components/platform/ui";
import { drizzle } from "drizzle-orm/d1";
import * as schema from "@/lib/db/schema";
import { eq } from "drizzle-orm";
import { env } from "cloudflare:workers";
import { applyApplicationMutationWithAttention } from "@/lib/attention/mutations";
import { redirectWithFlash, takeFlash } from "@/lib/platform/server/flash";
import { formatCalendarDate, formatMomentDate } from "@/lib/display-date";
import {
  ProgramApplicationError,
  buildApplicationTransitionStatement,
  formatDateInputValue,
  getAvailableApplicationTransitions,
  isProgramApplicationStatus,
  parseCompletionDate,
  planApplicationTransition,
  type ProgramApplicationStatus,
} from "@/lib/admin/program-application";
import { formatAnswer, parseApplicationAnswers, plainLabel, summaryQuestions } from "@/lib/student/application-answers";

const LIST_PATH = "/admin/applications";
const db = drizzle(env.DB, { schema });
const { id } = Astro.params;
const today = formatDateInputValue();

if (!id) return Astro.redirect(LIST_PATH);

/** What each change says on its button, and once it is done. */
const ACTIONS: Record<ProgramApplicationStatus, { label: string; done: string }> = {
  PENDING: { label: "Back to review", done: "Application back in review" }, // No change leads here.
  APPROVED: { label: "Accept", done: "Application accepted" },
  REJECTED: { label: "Decline", done: "Application declined" },
  AUDIT: { label: "Move to audit", done: "Application moved to audit" },
  COMPLETED: { label: "Mark completed", done: "Application marked completed" },
};
// Declining and completing are final: nothing moves an application on from either, and completing
// unlocks a certificate at once. They ask first, on the page itself. The others can still change.
const CONFIRMED = { decline: "REJECTED", complete: "COMPLETED" } as const satisfies Record<string, ProgramApplicationStatus>;
const label = (status: ProgramApplicationStatus) => statusTone("application", status).label;

let actionError: string | undefined;
let actionCode: string | undefined;
let postedDate: string | undefined;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const target = formData.get("status");
  postedDate = typeof formData.get("completionDate") === "string" ? String(formData.get("completionDate")) : undefined;
  const current = await db.query.programApplication.findFirst({
    where: eq(schema.programApplication.id, id),
    columns: { status: true },
  });

  if (!current) {
    return Astro.redirect(`${LIST_PATH}?notice=missing`, 303);
  }

  try {
    const transition = planApplicationTransition({
      expectedStatus: formData.get("expectedStatus"),
      currentStatus: current.status,
      targetStatus: target,
      completionDate: formData.get("completionDate"),
    });
    const statement = buildApplicationTransitionStatement({
      applicationId: id,
      transition,
    });
    await applyApplicationMutationWithAttention({ db: env.DB, env }, {
      statement,
      applicationIds: [id],
      actorId: Astro.locals.user!.id,
      status: transition.status,
      staleCode: "STALE_TRANSITION",
      staleMessage:
        "This application changed while you were updating it. Check its status below before changing it again.",
    });

    return redirectWithFlash(Astro, Astro.url.pathname, { tone: "success", title: ACTIONS[transition.status].done });
  } catch (error) {
    if (!(error instanceof ProgramApplicationError)) throw error;
    actionCode = error.code;
    // The library's messages name stored values ("from PENDING to APPROVED"); say them as the page does.
    actionError =
      error.code === "STALE_TRANSITION"
        ? "Someone changed this application while you were looking at it. Check its status below before changing it again."
        : error.code === "INVALID_TRANSITION" && isProgramApplicationStatus(target) && isProgramApplicationStatus(current.status)
          ? `An application that is ${label(current.status).toLowerCase()} can't be changed to ${label(target).toLowerCase()}.`
          : error.code === "INVALID_STATUS"
            ? "Choose one of the changes below."
            : error.message;
    Astro.response.status = 400;
  }
}

// The application and the Admin space are independent reads: one round trip, not two.
const [application, spaces] = await Promise.all([
  db.query.programApplication.findFirst({
    where: eq(schema.programApplication.id, id),
    with: { user: true, program: true },
  }),
  resolveSpacePage(Astro.locals, "adminApplications"),
]);

if (!application) return Astro.redirect(LIST_PATH);

const flash = Astro.request.method === "GET" ? takeFlash(Astro) : null;
const status = application.status;
const name = application.user?.name ?? "Unknown applicant";
const answers = parseApplicationAnswers(application.application);
const questions = answers.kind === "questions" ? summaryQuestions(answers.questions) : [];
const available = getAvailableApplicationTransitions(status);
const offers = (target: ProgramApplicationStatus) => available.some((candidate) => candidate === target);

// A final change waits at ?confirm=: the step names it before the POST does it.
const asking = confirmingAction(
  Astro.url,
  (Object.keys(CONFIRMED) as (keyof typeof CONFIRMED)[]).filter((action) => offers(CONFIRMED[action])),
);
// Completing takes its date from the step's address; a date that can't be used stays in the field with its error.
const askedDate = Astro.url.searchParams.get("completionDate") ?? today;
let dateError: string | undefined;
let confirmedDate: Date | undefined;
if (asking === "complete") {
  try {
    confirmedDate = parseCompletionDate(askedDate);
  } catch (error) {
    if (!(error instanceof ProgramApplicationError)) throw error;
    dateError = error.message;
  }
}
if (actionCode === "INVALID_COMPLETION_DATE") dateError = actionError;
const completionValue = postedDate ?? askedDate;
const confirmComplete = asking === "complete" && confirmedDate;
const confirmDecline = asking === "decline";
const fields = (target: ProgramApplicationStatus) => ({ expectedStatus: status, status: target });
---

<AdminLayout title={`Application from ${name}`} titlePrefix={actionError ? "Error: " : ""} spaces={spaces}>
  <div class="space-y-6">
    <BackLink href={LIST_PATH}>Applications</BackLink>

    <PageHeader title={`Application from ${name}`}>
      <span class="inline-flex flex-wrap items-center gap-x-3 gap-y-1">
        <StatusChip domain="application" status={status} />
        <span>{application.program?.name ?? "No cohort"} · applied {formatMomentDate(application.createdAt)}</span>
      </span>
    </PageHeader>

    {flash && <Notice tone={flash.tone} title={flash.title}>{flash.message}</Notice>}
    {actionError && (
      <Notice tone="danger" focusOnLoad id="application-failure" title="The status didn't change">
        {actionError}
      </Notice>
    )}

    <Card>
      <div class="grid gap-4">
        <h2 class="text-lg text-ink-primary">Details</h2>
        <DescriptionList>
          <DescriptionItem term="Applicant">
            <a href={`/admin/users/${application.userId}`} class={linkClass()}>{name}</a>
          </DescriptionItem>
          <DescriptionItem term="Email">{application.user?.email ?? "Not recorded"}</DescriptionItem>
          <DescriptionItem term="Cohort">
            {application.program ? (
              <a href={`/admin/programs/${application.program.id}`} class={linkClass()}>{application.program.name}</a>
            ) : (
              "No cohort"
            )}
          </DescriptionItem>
          <DescriptionItem term="Applied">{formatMomentDate(application.createdAt)}</DescriptionItem>
          {application.completedAt && (
            <DescriptionItem term="Completed">{formatCalendarDate(application.completedAt)}</DescriptionItem>
          )}
          {status === "COMPLETED" && application.completedAt && (
            <DescriptionItem term="Certificate">
              <a href={`/certificate/${application.id}`} class={linkClass()}>View certificate</a>
            </DescriptionItem>
          )}
        </DescriptionList>
      </div>
    </Card>

    <Card>
      <div class="grid gap-4" data-application-answers>
        <h2 class="text-lg text-ink-primary">Answers</h2>
        {questions.length > 0 ? (
          <DescriptionList>
            {questions.map((question) => {
              const answer = formatAnswer(question);
              return (
                <DescriptionItem term={plainLabel(question.label)}>
                  <span class:list={["whitespace-pre-line", !answer && "text-ink-muted"]}>{answer ?? "Not answered"}</span>
                </DescriptionItem>
              );
            })}
          </DescriptionList>
        ) : answers.kind === "details" && answers.details.length > 0 ? (
          <DescriptionList>
            {answers.details.map((detail) => (
              <DescriptionItem term={detail.label}>
                <span class="whitespace-pre-line">{detail.value}</span>
              </DescriptionItem>
            ))}
          </DescriptionList>
        ) : (
          <p class="text-sm text-ink-secondary">
            {answers.kind === "enrollment"
              ? "An admin added them to the cohort directly, so nothing was asked."
              : "No answers were recorded with this application."}
          </p>
        )}
        {answers.kind === "details" && answers.hidden && (
          <p class="text-sm text-ink-muted">Some details recorded with this application can't be shown here.</p>
        )}
      </div>
    </Card>

    {available.length > 0 && (
      <Card>
        <div class="grid gap-4" data-status-actions>
          <h2 class="text-lg text-ink-primary">Change status</h2>
          {confirmDecline ? (
            <ConfirmStep
              title={`Decline ${name}'s application?`}
              confirmLabel="Decline application"
              cancelHref={withoutConfirm(Astro.url)}
              action={Astro.url.pathname}
              fields={fields("REJECTED")}
            >
              They see “Declined” on their application, and nothing moves it on from there.
            </ConfirmStep>
          ) : confirmComplete ? (
            <ConfirmStep
              title={`Mark ${name} completed on ${formatCalendarDate(confirmedDate!)}?`}
              confirmLabel="Mark completed"
              cancelHref={Astro.url.pathname}
              action={Astro.url.pathname}
              fields={{ ...fields("COMPLETED"), completionDate: askedDate }}
            >
              Their certificate and builder portfolio unlock at once. This can't be undone.
            </ConfirmStep>
          ) : (
            <>
              <p class="text-sm text-ink-secondary">
                It's {label(status).toLowerCase()} now. They see each change on their application page.
              </p>
              <div class="flex flex-wrap items-end gap-3">
                {(["APPROVED", "AUDIT"] as const).filter(offers).map((target) => (
                  <form method="POST" action={Astro.url.pathname}>
                    <input type="hidden" name="expectedStatus" value={status} />
                    <input type="hidden" name="status" value={target} />
                    <Button type="submit" variant="quiet">{ACTIONS[target].label}</Button>
                  </form>
                ))}
                {offers("REJECTED") && (
                  <ButtonLink variant="quiet" href={confirmHref(Astro.url, "decline")}>{ACTIONS.REJECTED.label}</ButtonLink>
                )}
              </div>
              {offers("COMPLETED") && (
                <form method="GET" action={Astro.url.pathname} class="flex flex-wrap items-end gap-3" data-complete-form>
                  <input type="hidden" name="confirm" value="complete" />
                  <TextField
                    type="date"
                    name="completionDate"
                    label="Completion date"
                    max={today}
                    required
                    defaultValue={completionValue}
                    error={dateError}
                  />
                  <Button type="submit" variant="quiet">{ACTIONS.COMPLETED.label}</Button>
                </form>
              )}
            </>
          )}
        </div>
      </Card>
    )}
  </div>
</AdminLayout>
