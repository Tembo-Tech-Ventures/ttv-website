---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Card from "@/components/common/Card.astro";
import Badge from "@/components/common/Badge.astro";
import { drizzle } from "drizzle-orm/d1";
import * as schema from "@/lib/db/schema";
import { eq } from "drizzle-orm";
import { env } from "cloudflare:workers";
import {
  APPLICATION_COMPLETION_CONFIRMATION,
  ProgramApplicationError,
  assertAtomicMutationApplied,
  buildApplicationTransitionStatement,
  formatDateInputValue,
  getAvailableApplicationTransitions,
  planApplicationTransition,
  toProgramApplicationBadgeVariant,
} from "@/lib/admin/program-application";

const db = drizzle(env.DB, { schema });
const { id } = Astro.params;
const defaultCompletionDate = formatDateInputValue();

if (!id) return Astro.redirect("/admin/applications");

// Handle POST — update status
if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const current = await db.query.programApplication.findFirst({
    where: eq(schema.programApplication.id, id),
    columns: { status: true },
  });

  if (!current) {
    return new Response(
      "Application not found. Return to the application list and try again.",
      { status: 400 }
    );
  }

  try {
    const transition = planApplicationTransition({
      expectedStatus: formData.get("expectedStatus"),
      currentStatus: current.status,
      targetStatus: formData.get("status"),
      completionDate: formData.get("completionDate"),
    });
    const statement = buildApplicationTransitionStatement({
      applicationId: id,
      transition,
    });
    const result = await env.DB.prepare(statement.sql)
      .bind(...statement.params)
      .run();

    assertAtomicMutationApplied({
      actualChanges: result.meta.changes,
      statement,
      staleCode: "STALE_TRANSITION",
      staleMessage:
        "This application changed while you were updating it. Refresh the page before trying again.",
    });
  } catch (error) {
    if (error instanceof ProgramApplicationError) {
      return new Response(error.message, { status: 400 });
    }
    throw error;
  }

  return Astro.redirect(`/admin/applications/${id}`);
}

const application = await db.query.programApplication.findFirst({
  where: eq(schema.programApplication.id, id),
  with: { user: true, program: true },
});

if (!application) return Astro.redirect("/admin/applications");

// Parse application JSON without trusting its shape.
let appData: Record<string, unknown> = {};
try {
  const parsed: unknown = JSON.parse(application.application);
  appData =
    typeof parsed === "object" && parsed !== null && !Array.isArray(parsed)
      ? (parsed as Record<string, unknown>)
      : { value: parsed };
} catch {
  appData = { raw: application.application };
}

const availableStatuses = getAvailableApplicationTransitions(
  application.status
);
---

<AdminLayout title="Application Detail">
  <div class="space-y-6">
    <a href="/admin/applications" class="text-sm text-primary hover:underline">
      &larr; Back to Applications
    </a>

    <div class="flex items-center gap-3">
      <h2 class="text-2xl font-bold text-white">Application</h2>
      <Badge variant={toProgramApplicationBadgeVariant(application.status)} />
    </div>

    <div class="grid gap-6 lg:grid-cols-2">
      <Card>
        <h3 class="mb-4 text-lg font-semibold text-white">Applicant</h3>
        <dl class="space-y-2 text-sm">
          <div class="flex justify-between">
            <dt class="text-white/60">Name</dt>
            <dd class="text-white">{application.user?.name ?? "Unknown"}</dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-white/60">Email</dt>
            <dd class="text-white">{application.user?.email ?? "—"}</dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-white/60">User</dt>
            <dd>
              <a
                href={`/admin/users/${application.userId}`}
                class="text-primary hover:underline"
              >
                View Profile
              </a>
            </dd>
          </div>
        </dl>
      </Card>

      <Card>
        <h3 class="mb-4 text-lg font-semibold text-white">Cohort</h3>
        <dl class="space-y-2 text-sm">
          <div class="flex justify-between">
            <dt class="text-white/60">Cohort</dt>
            <dd class="text-white">{application.program?.name ?? "—"}</dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-white/60">Applied</dt>
            <dd class="text-white">
              {application.createdAt
                ? new Date(application.createdAt).toLocaleDateString()
                : "—"}
            </dd>
          </div>
          {application.completedAt && (
            <div class="flex justify-between">
              <dt class="text-white/60">Completed</dt>
              <dd class="text-white">
                {new Date(application.completedAt).toLocaleDateString()}
              </dd>
            </div>
          )}
          {application.status === "COMPLETED" && application.completedAt && (
            <div class="flex justify-between">
              <dt class="text-white/60">Certificate</dt>
              <dd>
                <a
                  href={`/certificate/${application.id}`}
                  class="text-primary hover:underline"
                >
                  View certificate
                </a>
              </dd>
            </div>
          )}
        </dl>
      </Card>
    </div>

    <Card>
      <h3 class="mb-4 text-lg font-semibold text-white">Application Data</h3>
      <dl class="space-y-3 text-sm">
        {Object.entries(appData).map(([key, value]) => (
          <div>
            <dt class="font-medium capitalize text-white/60">
              {key.replace(/([A-Z])/g, " $1").replace(/_/g, " ")}
            </dt>
            <dd class="mt-0.5 text-white">
              {typeof value === "object" ? JSON.stringify(value, null, 2) : String(value)}
            </dd>
          </div>
        ))}
      </dl>
    </Card>

    {availableStatuses.length > 0 && (
      <Card>
        <h3 class="mb-4 text-lg font-semibold text-white">Change Status</h3>
        <div class="flex flex-wrap gap-2">
          {availableStatuses.map((status) => (
            <form method="POST" class="flex flex-wrap items-end gap-2">
              <input type="hidden" name="expectedStatus" value={application.status} />
              <input type="hidden" name="status" value={status} />
              {status === "COMPLETED" && (
                <label class="flex flex-col gap-1 text-xs font-medium text-white/70">
                  Completion date
                  <input
                    type="date"
                    name="completionDate"
                    value={defaultCompletionDate}
                    max={defaultCompletionDate}
                    required
                    class="rounded-md border border-teal bg-dark/70 px-3 py-2 text-sm text-white focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/50"
                  />
                </label>
              )}
              <button
                type="submit"
                class:list={[
                  "rounded-md px-4 py-2 text-sm font-medium transition-colors",
                  status === "APPROVED" && "bg-green-600 text-white hover:bg-green-700",
                  status === "REJECTED" && "bg-red-600 text-white hover:bg-red-700",
                  status === "AUDIT" && "bg-blue-600 text-white hover:bg-blue-700",
                  status === "COMPLETED" && "bg-purple-600 text-white hover:bg-purple-700",
                ]}
                onclick={`return confirm(${JSON.stringify(
                  status === "COMPLETED"
                    ? APPLICATION_COMPLETION_CONFIRMATION
                    : `Change application status to ${status}?`
                )})`}
              >
                {status === "COMPLETED" ? "Mark Completed" : status.charAt(0) + status.slice(1).toLowerCase()}
              </button>
            </form>
          ))}
        </div>
      </Card>
    )}
  </div>
</AdminLayout>
