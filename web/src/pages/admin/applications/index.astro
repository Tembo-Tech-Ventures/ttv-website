---
import { env } from "cloudflare:workers";
import { asc, count, desc, eq } from "drizzle-orm";
import { drizzle } from "drizzle-orm/d1";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";
import { ButtonLink, DataCell, DataRow, DataTable, EmptyState, Notice, PageHeader, Pager, PillNav, StatusChip, linkClass, statusTone } from "@/components/platform/ui";
import { emptyFilterCopy } from "@/lib/admin/applications";
import { ADMIN_PAGE_SIZE, lastPage as lastPageOf, pageHref, pageSummary, parsePage } from "@/lib/admin/paging";
import * as schema from "@/lib/db/schema";
import { formatMomentDate } from "@/lib/display-date";

/*
 * Every application, newest first, a page at a time, filtered by status
 * through links, so the filter has an address and works without JavaScript.
 * The page of applications, the count for each status and the Admin space are
 * independent reads, started together.
 */
const db = drizzle(env.DB, { schema });
const PATH = "/admin/applications";
const STATUSES = schema.programApplication.status.enumValues;
type ApplicationStatus = (typeof STATUSES)[number];

const requested = Astro.url.searchParams.get("status");
const statusFilter = STATUSES.find((status) => status === requested);
const page = parsePage(Astro.url.searchParams.get("page"));

const [applications, counts, spaces] = await Promise.all([
  db.query.programApplication.findMany({
    where: statusFilter ? eq(schema.programApplication.status, statusFilter) : undefined,
    columns: { id: true, status: true, createdAt: true },
    with: { user: { columns: { name: true } }, program: { columns: { name: true } } },
    orderBy: (application) => [desc(application.createdAt), asc(application.id)],
    limit: ADMIN_PAGE_SIZE,
    offset: (page - 1) * ADMIN_PAGE_SIZE,
  }),
  db
    .select({ status: schema.programApplication.status, total: count() })
    .from(schema.programApplication)
    .groupBy(schema.programApplication.status),
  resolveSpacePage(Astro.locals, "adminApplications"),
]);

const byStatus = new Map<ApplicationStatus, number>(counts.map((row) => [row.status, row.total]));
const allTotal = counts.reduce((sum, row) => sum + row.total, 0);
const total = statusFilter ? (byStatus.get(statusFilter) ?? 0) : allTotal;
const lastPage = lastPageOf(total);
const filterHref = (status?: ApplicationStatus) => (status ? `${PATH}?status=${status}` : PATH);
// Only applications in review wait on an administrator, so only they carry a count.
const filters = [
  { label: "All", href: filterHref(), current: !statusFilter },
  ...STATUSES.map((status) => ({
    label: statusTone("application", status).label,
    href: filterHref(status),
    current: statusFilter === status,
    count: status === "PENDING" ? (byStatus.get(status) ?? 0) : undefined,
  })),
];
const filterName = statusFilter ? statusTone("application", statusFilter).label.toLowerCase() : null;
// The application page sends a reader here when the one they opened is gone.
const missing = Astro.url.searchParams.get("notice") === "missing";
---

<AdminLayout title={filterName ? `Applications, ${filterName}` : "Applications"} spaces={spaces}>
  <div class="flex flex-col gap-8">
    <PageHeader title="Applications">Every application to a cohort, newest first. Open one to read it and decide.</PageHeader>

    {missing && <Notice tone="warning" title="That application no longer exists">It may have been removed. The list below is up to date.</Notice>}

    <PillNav label="Application status" items={filters} countLabel="waiting" />

    <DataTable
      caption={filterName ? `Applications, ${filterName}` : "Applications"}
      columns={[{ label: "Applicant" }, { label: "Cohort" }, { label: "Status" }, { label: "Applied", align: "end" }]}
      isEmpty={applications.length === 0}
    >
      {
        applications.map((application) => (
          <DataRow>
            <DataCell label="Applicant" primary>
              <a href={`${PATH}/${application.id}`} class={linkClass()}>{application.user?.name ?? "Account removed"}</a>
            </DataCell>
            <DataCell label="Cohort">{application.program?.name ?? "Cohort removed"}</DataCell>
            <DataCell label="Status">
              <StatusChip domain="application" status={application.status} />
            </DataCell>
            <DataCell label="Applied" align="end">{formatMomentDate(application.createdAt)}</DataCell>
          </DataRow>
        ))
      }
      <Fragment slot="empty">
        {
          page > 1 && total > 0 ? (
            <EmptyState title="No applications on this page" headingLevel={2}>
              The list has {lastPage} {lastPage === 1 ? "page" : "pages"}.
              <Fragment slot="action">
                <ButtonLink href={pageHref(Astro.url, 1)}>Back to the first page</ButtonLink>
              </Fragment>
            </EmptyState>
          ) : statusFilter ? (
            <EmptyState title={emptyFilterCopy(statusFilter).title} headingLevel={2}>
              {emptyFilterCopy(statusFilter).body}
              <Fragment slot="action">
                <ButtonLink href={PATH}>See every application</ButtonLink>
              </Fragment>
            </EmptyState>
          ) : (
            <EmptyState title="No applications yet" headingLevel={2}>
              Applications appear here when people apply to a cohort.
            </EmptyState>
          )
        }
      </Fragment>
    </DataTable>

    <Pager
      previousHref={page > 1 && applications.length > 0 ? pageHref(Astro.url, page - 1) : null}
      nextHref={page < lastPage ? pageHref(Astro.url, page + 1) : null}
      summary={pageSummary(page, applications.length, total)}
      label="Applications pages"
    />
  </div>
</AdminLayout>
