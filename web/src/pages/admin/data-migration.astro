---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";
import {
  Button,
  ButtonLink,
  Card,
  DataCell,
  DataRow,
  DataTable,
  DescriptionItem,
  DescriptionList,
  FileField,
  Notice,
  PageHeader,
} from "@/components/platform/ui";
import { env } from "cloudflare:workers";
import { isAgentSession } from "@/lib/agent-auth";
import { executeLegacyImport, isLegacyImportEnabled, legacyImportDisabledMessage } from "@/lib/admin/import";
import {
  LegacyImportValidationError,
  MAX_EXPORT_BYTES,
  exportFromForm,
  importSummary,
  reviewExport,
  type ExportReview,
} from "@/lib/admin/data-migration";
import { redirectWithFlash, takeFlash } from "@/lib/platform/server/flash";
import { formatMomentDateTime } from "@/lib/display-date";

/*
 * Legacy data migration, as two server forms: choose an export and review
 * what it holds (the import's own checks run, and nothing is written), then
 * import what was reviewed. An import writes many rows at once, so a personal
 * access token can't use this page, and an agent session may review but not
 * import.
 */
Astro.response.headers.set("Cache-Control", "no-store");
if (Astro.locals.personalAccessToken) {
  return new Response("Forbidden: personal access tokens cannot run a legacy data migration.", { status: 403 });
}

const deploymentEnvironment = env.DEPLOYMENT_ENVIRONMENT;
const importEnabled = isLegacyImportEnabled(deploymentEnvironment);
const agentSession = isAgentSession(Astro.locals.session?.userAgent);
const spaces = await resolveSpacePage(Astro.locals, "adminMigration");
const SELF = Astro.url.pathname;

let review: (ExportReview & { text: string }) | undefined;
/** What went wrong, said at the top of the review form: a refused import leaves no review on the page. */
let failure: { title: string; message: string } | undefined;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData().catch(() => null);
  const action = formData?.get("action");
  if (!importEnabled) {
    failure = { title: "Nothing was imported", message: legacyImportDisabledMessage(deploymentEnvironment) };
    Astro.response.status = 403;
  } else if (!formData || (action !== "review" && action !== "import")) {
    failure = { title: "Nothing was reviewed", message: "Choose the export file, then review it." };
    Astro.response.status = 400;
  } else if (action === "import" && agentSession) {
    failure = { title: "Nothing was imported", message: "Agent sessions can review an export, but can't run a legacy import." };
    Astro.response.status = 403;
  } else {
    const file = await exportFromForm(formData);
    if (!file.ok) {
      failure = { title: action === "review" ? "The export wasn't reviewed" : "Nothing was imported", message: file.error };
      Astro.response.status = 400;
    } else if (action === "review") {
      try {
        review = { ...(await reviewExport(env.DB, file.payload)), text: file.text };
      } catch (error) {
        failure = error instanceof LegacyImportValidationError
          ? { title: "The export can't be imported", message: error.message }
          : { title: "The export wasn't reviewed", message: "The database didn't answer, so the export couldn't be checked. Try again in a moment." };
        Astro.response.status = error instanceof LegacyImportValidationError ? 400 : 503;
      }
    } else {
      try {
        const result = await executeLegacyImport(env.DB, file.payload);
        return redirectWithFlash(Astro, SELF, { tone: "success", title: "Import complete", message: importSummary(result) });
      } catch (error) {
        failure = error instanceof LegacyImportValidationError
          ? { title: "Nothing was imported", message: error.message }
          : { title: "Nothing was imported", message: "The import failed without applying any changes. Try again in a moment." };
        Astro.response.status = error instanceof LegacyImportValidationError ? 400 : 503;
      }
    }
  }
}

// A POST never carries a flash, and a refused one says what went wrong instead.
const flash = Astro.request.method === "GET" ? takeFlash(Astro) : null;
const count = (value: number) => value.toLocaleString("en-GB");
const records = (value: number) => `${count(value)} ${value === 1 ? "record" : "records"}`;
---

<AdminLayout title="Data migration" titlePrefix={failure ? "Error: " : ""} spaces={spaces}>
  <div class="max-w-4xl space-y-6">
    <PageHeader title="Data migration">
      Review a legacy Vercel/Prisma export, then import the records it can into this environment.
    </PageHeader>

    {flash && <Notice tone={flash.tone} title={flash.title}>{flash.message}</Notice>}

    {!importEnabled ? (
      <div data-testid="legacy-import-disabled">
        <Notice tone="warning" title="Legacy import unavailable" announce="none">
          {legacyImportDisabledMessage(deploymentEnvironment)} The ADMIN role is migration-owned, and role assignments are
          managed through guarded admin tools.
        </Notice>
      </div>
    ) : (
      <>
        <Notice tone="warning" title="Migration testing only" announce="none">
          This importer works only in staging and isolated agent previews. Full OAuth identity reconciliation is deferred: an
          existing email tied to a different user stops the whole import before anything changes.
        </Notice>
        <div data-testid="privilege-import-policy">
          <Notice tone="info" title="Privilege data is always ignored" announce="none">
            Roles and User roles never become import statements or grants. The ADMIN role is migration-owned, and role
            assignments are managed through guarded admin tools.
          </Notice>
        </div>
        {agentSession && (
          <div id="agent-import-warning" data-testid="agent-import-warning">
            <Notice tone="info" title="Review only" announce="none">
              Temporary agent bearer sessions may review an export here, but cannot run a legacy import or create persistent data.
            </Notice>
          </div>
        )}

        <Card>
          <form method="POST" action={SELF} enctype="multipart/form-data" class="grid gap-5" aria-labelledby="review-heading" data-review-form>
            <div class="grid gap-1">
              <h2 id="review-heading" class="text-lg text-ink-primary">Review an export</h2>
              <p class="max-w-prose text-sm text-ink-secondary">
                Nothing is written while you review. The same checks the import makes run first, so a clash with an
                existing account or a broken reference shows here.
              </p>
            </div>
            {failure && (
              <Notice tone="danger" focusOnLoad id="migration-failure" title={failure.title}>{failure.message}</Notice>
            )}
            <input type="hidden" name="action" value="review" />
            <FileField
              label="Legacy JSON export"
              name="export"
              required
              accept=".json,application/json"
              hint={`The JSON file the legacy export tool wrote, with a version and the time it was exported, up to ${MAX_EXPORT_BYTES / 1024 / 1024} MB.`}
            />
            <div>
              <Button type="submit" variant={review && review.importable > 0 && !agentSession ? "quiet" : "primary"}>Review export</Button>
            </div>
          </form>
        </Card>

        {review && (
          <Card>
            <section class="grid gap-5" aria-labelledby="preview-heading" data-preview>
              <h2 id="preview-heading" class="text-lg text-ink-primary">What this export holds</h2>
              <DescriptionList>
                <DescriptionItem term="Version">{review.version}</DescriptionItem>
                <DescriptionItem term="Exported">{formatMomentDateTime(review.exportedAt)}</DescriptionItem>
                <DescriptionItem term="To import">{records(review.importable)}</DescriptionItem>
                <DescriptionItem term="Ignored privilege records">{records(review.ignored)}</DescriptionItem>
              </DescriptionList>
              <DataTable caption="Records in this export" captionVisible columns={[{ label: "Table" }, { label: "Handling" }, { label: "Records", align: "end" }]}>
                {review.rows.map((row) => (
                  <DataRow>
                    <DataCell label="Table" primary>{row.label}</DataCell>
                    <DataCell label="Handling">{row.privilege ? "Always ignored" : "Checked, then imported"}</DataCell>
                    <DataCell label="Records" align="end">{count(row.records)}</DataCell>
                  </DataRow>
                ))}
              </DataTable>
              {agentSession ? (
                <p class="text-sm text-ink-secondary">Import unavailable for agent sessions: they can review an export, not import it.</p>
              ) : review.importable === 0 ? (
                <p class="text-sm text-ink-secondary">There's nothing to import: this export holds only privilege records, which are always ignored.</p>
              ) : (
                <form method="POST" action={SELF} enctype="multipart/form-data" class="flex flex-wrap items-center gap-3">
                  <input type="hidden" name="action" value="import" />
                  <input type="hidden" name="exportText" value={review.text} />
                  <Button type="submit" variant="primary">Import {records(review.importable)}</Button>
                  <ButtonLink variant="ghost" href={SELF}>Choose another file</ButtonLink>
                </form>
              )}
            </section>
          </Card>
        )}

      </>
    )}

    {!importEnabled && failure && (
      <Notice tone="danger" focusOnLoad id="migration-failure" title={failure.title}>{failure.message}</Notice>
    )}
  </div>
</AdminLayout>
