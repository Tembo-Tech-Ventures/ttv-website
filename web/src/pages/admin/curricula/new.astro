---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";
import { BackLink, Button, ButtonLink, Card, Notice, PageHeader, TextAreaField, TextField } from "@/components/platform/ui";
import { drizzle } from "drizzle-orm/d1";
import { env } from "cloudflare:workers";
import * as schema from "@/lib/db/schema";
import { redirectWithFlash } from "@/lib/platform/server/flash";
import {
  createCurriculum,
  createDrizzleCurriculumStore,
  curriculumSaveErrorMessage,
  curriculumValuesFromFormData,
  type CurriculumFieldErrors,
  type CurriculumValues,
} from "@/lib/admin/curricula";

const LIST_PATH = "/admin/curricula";
const db = drizzle(env.DB, { schema });
const store = createDrizzleCurriculumStore(db);
// The Admin space is read beside the save, not after it: a rejected form renders without a second wait.
const spacesRead = resolveSpacePage(Astro.locals, "adminCurricula");
let values: CurriculumValues = { title: "", description: "" };
let errors: CurriculumFieldErrors = {};
let formError: string | undefined;

if (Astro.request.method === "POST") {
  values = curriculumValuesFromFormData(await Astro.request.formData());
  try {
    const result = await createCurriculum(store, values);
    if (result.ok) {
      return redirectWithFlash(Astro, `${LIST_PATH}/${encodeURIComponent(result.curriculum.id)}`, {
        tone: "success",
        title: "Curriculum created",
      });
    }
    if (result.reason === "validation") {
      errors = result.errors;
      values = result.values;
    } else {
      formError = result.message;
    }
  } catch {
    formError = curriculumSaveErrorMessage();
  }
}
const spaces = await spacesRead;
const rejected = Boolean(formError || errors.title || errors.description);
---

<AdminLayout title="New curriculum" titlePrefix={rejected ? "Error: " : ""} spaces={spaces}>
  <div class="mx-auto max-w-3xl space-y-6">
    <BackLink href={LIST_PATH}>Curricula</BackLink>

    <PageHeader title="New curriculum">
      A reusable learning plan that programs and cohorts can follow.
    </PageHeader>

    {rejected && (
      <Notice tone="danger" focusOnLoad id="curriculum-failure" title="The curriculum wasn't created">
        {formError ?? "Fix the fields marked below. Everything you wrote is kept."}
      </Notice>
    )}

    <Card>
      <form method="POST" action={Astro.url.pathname} class="grid gap-5">
        <TextField label="Title" name="title" required defaultValue={values.title} error={errors.title} />
        <TextAreaField
          label="Description"
          name="description"
          hint="Its learning goals and scope."
          required
          rows={7}
          defaultValue={values.description}
          error={errors.description}
        />
        <div class="flex flex-wrap gap-2">
          <Button type="submit" variant="primary">Create curriculum</Button>
          <ButtonLink variant="ghost" href={LIST_PATH}>Cancel</ButtonLink>
        </div>
      </form>
    </Card>
  </div>
</AdminLayout>
