---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";
import { ButtonLink, Card, EmptyState, FOCUS_RING, Notice, PageHeader } from "@/components/platform/ui";
import { drizzle } from "drizzle-orm/d1";
import { env } from "cloudflare:workers";
import * as schema from "@/lib/db/schema";
import {
  createDrizzleCurriculumStore,
  listCurricula,
} from "@/lib/admin/curricula";

const db = drizzle(env.DB, { schema });
// The curricula and the Admin space are independent reads: one round trip, not two.
const [curricula, spaces] = await Promise.all([
  listCurricula(createDrizzleCurriculumStore(db)),
  resolveSpacePage(Astro.locals, "adminCurricula"),
]);

const noticeByOutcome: Record<string, { tone: "success" | "warning"; text: string }> = {
  deleted: { tone: "success", text: "Curriculum deleted." },
  missing: { tone: "warning", text: "That curriculum no longer exists." },
};
const outcome = Astro.url.searchParams.get("notice");
const notice = outcome ? noticeByOutcome[outcome] : undefined;
const NEW_PATH = "/admin/curricula/new";
const INTRO = "Manage the reusable learning plans required by programs and cohorts.";
const TEXT_LINK = `inline-flex min-h-11 items-center rounded-sm text-sm font-semibold text-peach-ink hover:underline ${FOCUS_RING}`;
---

<AdminLayout title="Curricula" spaces={spaces}>
  <div class="space-y-6">
    {/* With no curricula yet, the empty state below carries the one way to start. A named slot inside a
        condition still reaches the header as a (blank) action, so the header itself is chosen here. */}
    {curricula.length > 0 ? (
      <PageHeader title="Curricula">
        {INTRO}
        <Fragment slot="action">
          <ButtonLink href={NEW_PATH} variant="primary" size="lg">New curriculum</ButtonLink>
        </Fragment>
      </PageHeader>
    ) : (
      <PageHeader title="Curricula">{INTRO}</PageHeader>
    )}

    {notice && (
      // A deletion is announced like any saved change; a missing one is a quiet caution read in turn.
      <Notice tone={notice.tone} announce="polite">{notice.text}</Notice>
    )}

    {curricula.length === 0 ? (
      <EmptyState title="No curricula yet" headingLevel={2}>
        Create a curriculum before setting up a program or cohort.
        <Fragment slot="action">
          <ButtonLink href={NEW_PATH} variant="primary" size="lg">Create your first curriculum</ButtonLink>
        </Fragment>
      </EmptyState>
    ) : (
      <ul class="grid gap-4">
        {curricula.map((curriculum) => (
          <li>
            <Card as="article">
              <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
                <div class="min-w-0 flex-1">
                  <h2 class="text-lg text-ink-primary">{curriculum.title}</h2>
                  <p class="mt-2 whitespace-pre-wrap text-sm text-ink-secondary">{curriculum.description}</p>
                </div>

                <div class="w-full shrink-0 lg:w-80">
                  <h3 class="text-sm text-ink-secondary">Programs and cohorts using it</h3>
                  {curriculum.programs.length === 0 ? (
                    <p class="mt-2 text-sm text-ink-muted">Not used yet</p>
                  ) : (
                    <ul class="mt-1">
                      {curriculum.programs.map((program) => (
                        <li>
                          <a href={`/admin/programs/${program.id}`} class={TEXT_LINK}>{program.name}</a>
                        </li>
                      ))}
                    </ul>
                  )}
                  <a href={`/admin/curricula/${curriculum.id}`} class:list={["mt-2 min-w-11", TEXT_LINK]}>
                    Edit<span class="sr-only"> {curriculum.title}</span>
                  </a>
                </div>
              </div>
            </Card>
          </li>
        ))}
      </ul>
    )}
  </div>
</AdminLayout>
