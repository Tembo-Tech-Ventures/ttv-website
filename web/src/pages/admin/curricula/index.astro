---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Button from "@/components/common/Button.astro";
import Card from "@/components/common/Card.astro";
import { drizzle } from "drizzle-orm/d1";
import { env } from "cloudflare:workers";
import * as schema from "@/lib/db/schema";
import {
  createDrizzleCurriculumStore,
  listCurricula,
} from "@/lib/admin/curricula";

const db = drizzle(env.DB, { schema });
const curricula = await listCurricula(createDrizzleCurriculumStore(db));

const noticeByOutcome: Record<string, string> = {
  deleted: "Curriculum deleted.",
  missing: "That curriculum no longer exists.",
};
const outcome = Astro.url.searchParams.get("notice");
const notice = outcome ? noticeByOutcome[outcome] : undefined;
---

<AdminLayout title="Curricula">
  <div class="space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h2 class="text-2xl font-bold text-white">Curricula</h2>
        <p class="mt-1 max-w-2xl text-sm text-ink-secondary">
          Manage the reusable learning plans required by programs and cohorts.
        </p>
      </div>
      <Button href="/admin/curricula/new" class="w-fit">
        New Curriculum
      </Button>
    </div>

    {notice && (
      <p
        role="status"
        class="rounded-md border border-emerald-400/40 bg-emerald-500/15 px-4 py-3 text-sm text-emerald-100"
      >
        {notice}
      </p>
    )}

    {curricula.length === 0 ? (
      <Card>
        <div class="py-6 text-center">
          <h3 class="text-lg font-semibold text-white">No curricula yet</h3>
          <p class="mx-auto mt-2 max-w-xl text-sm text-ink-secondary">
            Create a curriculum before setting up a program or cohort.
          </p>
          <Button href="/admin/curricula/new" class="mt-5">
            Create your first curriculum
          </Button>
        </div>
      </Card>
    ) : (
      <div class="grid gap-4">
        {curricula.map((curriculum) => (
          <Card>
            <article class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
              <div class="min-w-0 flex-1">
                <h3 class="text-lg font-semibold text-white">
                  {curriculum.title}
                </h3>
                <p class="mt-2 whitespace-pre-wrap text-sm text-white/70">
                  {curriculum.description}
                </p>
              </div>

              <div class="w-full shrink-0 lg:w-80">
                <p class="text-xs font-semibold uppercase tracking-wide text-ink-muted">
                  Program / cohort usage
                </p>
                {curriculum.programs.length === 0 ? (
                  <p class="mt-2 text-sm text-ink-muted">Not used yet</p>
                ) : (
                  <ul class="mt-2 space-y-1.5">
                    {curriculum.programs.map((program) => (
                      <li>
                        <a
                          href={`/admin/programs/${program.id}`}
                          class="text-sm text-primary hover:underline"
                        >
                          {program.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
                <a
                  href={`/admin/curricula/${curriculum.id}`}
                  aria-label={`Edit ${curriculum.title}`}
                  class="mt-4 inline-flex text-sm font-medium text-primary hover:underline"
                >
                  Edit curriculum
                </a>
              </div>
            </article>
          </Card>
        ))}
      </div>
    )}
  </div>
</AdminLayout>
