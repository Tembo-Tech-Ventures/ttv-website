---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Card from "@/components/common/Card.astro";
import { drizzle } from "drizzle-orm/d1";
import { env } from "cloudflare:workers";
import * as schema from "@/lib/db/schema";
import {
  createDrizzleCurriculumStore,
  curriculumSaveErrorMessage,
  curriculumValuesFromFormData,
  deleteCurriculum,
  getCurriculum,
  updateCurriculum,
  type CurriculumFieldErrors,
  type CurriculumValues,
} from "@/lib/admin/curricula";

const { id } = Astro.params;
if (!id) return Astro.redirect("/admin/curricula");

const db = drizzle(env.DB, { schema });
const store = createDrizzleCurriculumStore(db);
const curriculum = await getCurriculum(store, id);
if (!curriculum) {
  return Astro.redirect("/admin/curricula?notice=missing");
}

let values: CurriculumValues = {
  title: curriculum.title,
  description: curriculum.description,
};
let errors: CurriculumFieldErrors = {};
let formError: string | undefined;
let deleteError: string | undefined;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const action = formData.get("action");

  if (action === "save") {
    values = curriculumValuesFromFormData(formData);
    try {
      const result = await updateCurriculum(store, id, values);
      if (result.ok) {
        return Astro.redirect(`/admin/curricula/${id}?notice=saved`);
      }
      if (result.reason === "not-found") {
        return Astro.redirect("/admin/curricula?notice=missing");
      }
      errors = result.errors;
      values = result.values;
    } catch {
      formError = curriculumSaveErrorMessage();
    }
  } else if (action === "delete") {
    try {
      const result = await deleteCurriculum(store, id);
      if (result.ok) {
        return Astro.redirect("/admin/curricula?notice=deleted");
      }
      if (result.reason === "not-found") {
        return Astro.redirect("/admin/curricula?notice=missing");
      }
      deleteError = result.message;
    } catch {
      deleteError = "The curriculum could not be deleted. Please try again.";
    }
  } else {
    formError = "Choose a valid curriculum action.";
  }
}

const noticeByOutcome: Record<string, string> = {
  created: "Curriculum created.",
  saved: "Curriculum changes saved.",
};
const outcome = Astro.url.searchParams.get("notice");
const notice = outcome ? noticeByOutcome[outcome] : undefined;
const isInUse = curriculum.programs.length > 0;
---

<AdminLayout title={`Edit ${curriculum.title}`}>
  <div class="mx-auto max-w-3xl space-y-6">
    <a href="/admin/curricula" class="text-sm text-primary hover:underline">
      &larr; Back to Curricula
    </a>

    <div>
      <h2 class="text-2xl font-bold text-white">Edit Curriculum</h2>
      <p class="mt-1 text-sm text-white/60">
        Changes apply to every program or cohort using this curriculum.
      </p>
    </div>

    {notice && (
      <p
        role="status"
        class="rounded-md border border-emerald-400/40 bg-emerald-500/15 px-4 py-3 text-sm text-emerald-100"
      >
        {notice}
      </p>
    )}

    <Card>
      {formError && (
        <p
          role="alert"
          class="mb-5 rounded-md border border-red-400/40 bg-red-500/15 px-4 py-3 text-sm text-red-100"
        >
          {formError}
        </p>
      )}

      <form method="POST" class="space-y-5">
        <input type="hidden" name="action" value="save" />
        <div class="flex flex-col gap-1.5">
          <label for="title" class="text-sm font-medium text-white/90">
            Title *
          </label>
          <input
            id="title"
            name="title"
            required
            value={values.title}
            aria-invalid={Boolean(errors.title)}
            aria-describedby={errors.title ? "title-error" : undefined}
            class:list={[
              "rounded-md border bg-dark/50 px-3 py-2 text-white focus:outline-none focus:ring-2 focus:ring-primary/50",
              errors.title ? "border-red-400" : "border-teal focus:border-primary",
            ]}
          />
          {errors.title && (
            <p id="title-error" class="text-sm text-red-200">
              {errors.title}
            </p>
          )}
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="description" class="text-sm font-medium text-white/90">
            Description *
          </label>
          <textarea
            id="description"
            name="description"
            required
            rows="7"
            aria-invalid={Boolean(errors.description)}
            aria-describedby={errors.description ? "description-error" : undefined}
            class:list={[
              "rounded-md border bg-dark/50 px-3 py-2 text-white focus:outline-none focus:ring-2 focus:ring-primary/50",
              errors.description
                ? "border-red-400"
                : "border-teal focus:border-primary",
            ]}
          >{values.description}</textarea>
          {errors.description && (
            <p id="description-error" class="text-sm text-red-200">
              {errors.description}
            </p>
          )}
        </div>

        <button
          type="submit"
          class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-dark hover:bg-primary/90"
        >
          Save Changes
        </button>
      </form>
    </Card>

    <Card>
      <h3 class="text-lg font-semibold text-white">Program / cohort usage</h3>
      {isInUse ? (
        <>
          <p class="mt-2 text-sm text-white/60">
            This curriculum is currently used by:
          </p>
          <ul class="mt-3 space-y-2">
            {curriculum.programs.map((program) => (
              <li>
                <a
                  href={`/admin/programs/${program.id}`}
                  class="text-sm text-primary hover:underline"
                >
                  {program.name}
                </a>
              </li>
            ))}
          </ul>
        </>
      ) : (
        <p class="mt-2 text-sm text-white/50">
          No programs or cohorts use this curriculum yet.
        </p>
      )}
    </Card>

    <Card>
      <h3 class="text-lg font-semibold text-white">Delete Curriculum</h3>
      {deleteError && (
        <p
          role="alert"
          class="mt-4 rounded-md border border-red-400/40 bg-red-500/15 px-4 py-3 text-sm text-red-100"
        >
          {deleteError}
        </p>
      )}
      {isInUse ? (
        <p class="mt-2 text-sm text-white/60">
          This curriculum cannot be deleted while a program or cohort references it.
          Programs are never deleted with a curriculum.
        </p>
      ) : (
        <>
          <p class="mt-2 text-sm text-white/60">
            This permanently deletes the unused curriculum. Programs are never
            cascade-deleted.
          </p>
          <form method="POST" class="mt-4">
            <input type="hidden" name="action" value="delete" />
            <button
              type="submit"
              class="rounded-md bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700"
              onclick="return confirm('Delete this unused curriculum?')"
            >
              Delete Curriculum
            </button>
          </form>
        </>
      )}
    </Card>
  </div>
</AdminLayout>
