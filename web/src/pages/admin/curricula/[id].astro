---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";
import {
  BackLink,
  Button,
  ButtonLink,
  Card,
  ConfirmStep,
  Notice,
  PageHeader,
  TextAreaField,
  TextField,
  linkClass,
  confirmHref,
  confirmingAction,
  withoutConfirm,
} from "@/components/platform/ui";
import { redirectWithFlash, takeFlash } from "@/lib/platform/server/flash";
import { drizzle } from "drizzle-orm/d1";
import { env } from "cloudflare:workers";
import * as schema from "@/lib/db/schema";
import {
  createDrizzleCurriculumStore,
  curriculumSaveErrorMessage,
  curriculumValuesFromFormData,
  deleteCurriculum,
  getCurriculum,
  updateCurriculum,
  type CurriculumFieldErrors,
  type CurriculumValues,
} from "@/lib/admin/curricula";

const { id } = Astro.params;
if (!id) return Astro.redirect("/admin/curricula");

const db = drizzle(env.DB, { schema });
const store = createDrizzleCurriculumStore(db);
// The curriculum and the Admin space are independent reads: one round trip, not two.
const [curriculum, spaces] = await Promise.all([
  getCurriculum(store, id),
  resolveSpacePage(Astro.locals, "adminCurricula"),
]);
if (!curriculum) {
  return Astro.redirect("/admin/curricula?notice=missing", 303);
}

let values: CurriculumValues = {
  title: curriculum.title,
  description: curriculum.description,
};
let errors: CurriculumFieldErrors = {};
let formError: string | undefined;
let deleteError: string | undefined;
// A cohort can take the curriculum between this page's read and a delete.
let refusedInUse = false;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const action = formData.get("action");

  if (action === "save") {
    values = curriculumValuesFromFormData(formData);
    try {
      const result = await updateCurriculum(store, id, values);
      if (result.ok) {
        return redirectWithFlash(Astro, Astro.url.pathname, { tone: "success", title: "Curriculum saved" });
      }
      if (result.reason === "not-found") {
        return Astro.redirect("/admin/curricula?notice=missing", 303);
      }
      errors = result.errors;
      values = result.values;
    } catch {
      formError = curriculumSaveErrorMessage();
    }
  } else if (action === "delete") {
    try {
      const result = await deleteCurriculum(store, id);
      if (result.ok) {
        return Astro.redirect("/admin/curricula?notice=deleted", 303);
      }
      if (result.reason === "not-found") {
        return Astro.redirect("/admin/curricula?notice=missing", 303);
      }
      refusedInUse = result.reason === "in-use";
      deleteError = result.message;
    } catch {
      deleteError = "The database didn't answer. Try again in a moment.";
    }
  } else {
    formError = "Choose a valid curriculum action.";
  }
}

const rejected = Boolean(formError || errors.title || errors.description);
// A POST never carries a flash, and a rejected one says what went wrong instead.
const flash = Astro.request.method === "GET" ? takeFlash(Astro) : null;
const isInUse = curriculum.programs.length > 0 || refusedInUse;
const confirming = !isInUse && confirmingAction(Astro.url, ["delete"]) === "delete";
// Every form posts to the page's own path, so a `?confirm=` in the address never reaches a POST.
const SELF = Astro.url.pathname;
const PROGRAM_LINK = linkClass("inline-flex min-h-11 items-center text-sm");
---

<AdminLayout title={curriculum.title} titlePrefix={rejected || deleteError ? "Error: " : ""} spaces={spaces}>
  <div class="mx-auto max-w-3xl space-y-6">
    <BackLink href="/admin/curricula">Curricula</BackLink>

    <PageHeader title={curriculum.title}>
      Changes apply to every program or cohort using this curriculum.
    </PageHeader>

    {flash && <Notice tone={flash.tone} title={flash.title}>{flash.message}</Notice>}

    {rejected && (
      <Notice tone="danger" focusOnLoad id="curriculum-failure" title="The curriculum wasn't saved">
        {formError ?? "Fix the fields marked below. Everything you wrote is kept."}
      </Notice>
    )}

    <Card>
      <form method="POST" action={SELF} class="grid gap-5">
        <input type="hidden" name="action" value="save" />
        <TextField label="Title" name="title" required defaultValue={values.title} error={errors.title} />
        <TextAreaField label="Description" name="description" required rows={7} defaultValue={values.description} error={errors.description} />
        <div>
          <Button type="submit" variant="primary">Save changes</Button>
        </div>
      </form>
    </Card>

    <Card>
      <div class="grid gap-2">
        <h2 class="text-lg text-ink-primary">Programs and cohorts using it</h2>
        {curriculum.programs.length > 0 ? (
          <ul>
            {curriculum.programs.map((program) => (
              <li>
                <a href={`/admin/programs/${program.id}`} class={PROGRAM_LINK}>{program.name}</a>
              </li>
            ))}
          </ul>
        ) : refusedInUse ? (
          <p class="text-sm text-ink-secondary">A program or cohort started using it just now. Reload the page to see which.</p>
        ) : (
          <p class="text-sm text-ink-muted">No programs or cohorts use this curriculum yet.</p>
        )}
      </div>
    </Card>

    <Card>
      <div class="grid gap-4">
        <h2 class="text-lg text-ink-primary">Delete curriculum</h2>
        {deleteError && (
          <Notice tone="danger" focusOnLoad id="curriculum-delete-failure" title="The curriculum wasn't deleted">
            {deleteError}
          </Notice>
        )}
        {isInUse ? (
          <p class="text-sm text-ink-secondary">
            This curriculum cannot be deleted while a program or cohort references it. Move them to another
            curriculum first.
          </p>
        ) : confirming ? (
          <ConfirmStep
            title={`Delete ${curriculum.title}?`}
            confirmLabel="Delete curriculum"
            cancelHref={withoutConfirm(Astro.url)}
            action={SELF}
            fields={{ action: "delete" }}
          >
            This can't be undone. No program or cohort uses it, so none is affected.
          </ConfirmStep>
        ) : (
          <>
            <p class="text-sm text-ink-secondary">
              No program or cohort uses it, so deleting it does not affect any cohort.
            </p>
            <div>
              <ButtonLink variant="danger" href={confirmHref(Astro.url, "delete")}>Delete curriculum</ButtonLink>
            </div>
          </>
        )}
      </div>
    </Card>
  </div>
</AdminLayout>
