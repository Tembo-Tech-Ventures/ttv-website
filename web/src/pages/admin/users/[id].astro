---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Card from "@/components/common/Card.astro";
import Badge from "@/components/common/Badge.astro";
import { drizzle } from "drizzle-orm/d1";
import * as schema from "@/lib/db/schema";
import { eq } from "drizzle-orm";
import { env } from "cloudflare:workers";
import {
  adminRoleErrorMessage,
  assertPersistentAdminRoleMutationAllowed,
  assignAdminRole,
  createDrizzleAdminRoleStore,
  revokeAdminRole,
} from "@/lib/admin/roles";

const db = drizzle(env.DB, { schema });
const { id } = Astro.params;

if (!id) return Astro.redirect("/admin/users");

const signedInAdminId = Astro.locals.user?.id;
if (!signedInAdminId) return Astro.redirect("/auth/login");

const targetUser = await db.query.user.findFirst({
  where: eq(schema.user.id, id),
  with: {
    userRoles: { with: { role: true } },
    programApplications: { with: { program: true } },
  },
});

if (!targetUser) return Astro.redirect("/admin/users");

const roleStore = createDrizzleAdminRoleStore(db);
let roleError: string | undefined;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const action = formData.get("action");

  try {
    assertPersistentAdminRoleMutationAllowed(
      action,
      Astro.locals.session?.userAgent
    );

    if (action === "add-admin") {
      const result = await assignAdminRole(roleStore, id);
      const outcome = result.changed ? "assigned" : "unchanged";
      return Astro.redirect(`/admin/users/${id}?role=${outcome}`);
    }
    if (action === "remove-admin") {
      const result = await revokeAdminRole(roleStore, id, signedInAdminId);
      const outcome = result.changed ? "revoked" : "unchanged";
      return Astro.redirect(`/admin/users/${id}?role=${outcome}`);
    }
    roleError = "Choose a valid role action.";
  } catch (error) {
    roleError = adminRoleErrorMessage(error);
  }
}

const isTargetAdmin = targetUser.userRoles.some((ur) => ur.role.name === "ADMIN");
const isSignedInUser = targetUser.id === signedInAdminId;
const roleNoticeByOutcome: Record<string, string> = {
  assigned: "ADMIN access was granted.",
  revoked: "ADMIN access was removed.",
  unchanged: "ADMIN access was already up to date.",
};
const roleOutcome = Astro.url.searchParams.get("role");
const roleNotice = roleOutcome
  ? roleNoticeByOutcome[roleOutcome]
  : undefined;
const applicationBadgeVariants = {
  PENDING: "pending",
  APPROVED: "approved",
  REJECTED: "rejected",
  AUDIT: "audit",
  COMPLETED: "completed",
} as const;
---

<AdminLayout title={targetUser.name}>
  <div class="space-y-6">
    <a href="/admin/users" class="text-sm text-primary hover:underline">
      &larr; Back to Users
    </a>

    <Card>
      <div class="flex items-start gap-4">
        {targetUser.image && (
          <img
            src={targetUser.image}
            alt={targetUser.name}
            class="h-16 w-16 rounded-full"
          />
        )}
        <div>
          <h2 class="text-2xl font-bold text-white">{targetUser.name}</h2>
          <p class="text-ink-secondary">{targetUser.email}</p>
          <p class="mt-1 text-sm text-ink-muted">
            Joined {targetUser.createdAt ? new Date(targetUser.createdAt).toLocaleDateString() : "—"}
          </p>
        </div>
      </div>
    </Card>

    <Card>
      <h3 class="mb-4 text-lg font-semibold text-white">Roles</h3>
      {roleError && (
        <p
          role="alert"
          class="mb-4 rounded-md border border-red-400/40 bg-red-500/15 px-4 py-3 text-sm text-red-100"
        >
          {roleError}
        </p>
      )}
      {roleNotice && (
        <p
          role="status"
          class="mb-4 rounded-md border border-emerald-400/40 bg-emerald-500/15 px-4 py-3 text-sm text-emerald-100"
        >
          {roleNotice}
        </p>
      )}
      <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center">
        <div class="flex flex-wrap gap-2">
          {targetUser.userRoles.length > 0
            ? targetUser.userRoles.map((ur) => (
                <span class="rounded-full bg-teal/30 px-3 py-1 text-sm text-white">
                  {ur.role.name}
                </span>
              ))
            : <span class="text-ink-muted">No roles assigned</span>}
        </div>
        {isTargetAdmin && isSignedInUser ? (
          <p class="text-sm text-ink-secondary">
            You cannot remove your own ADMIN role.
          </p>
        ) : (
          <form method="POST">
            {isTargetAdmin ? (
              <>
                <input type="hidden" name="action" value="remove-admin" />
                <button
                  type="submit"
                  class="rounded-md bg-red-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-red-700"
                  onclick="return confirm('Remove admin privileges from this user?')"
                >
                  Remove Admin
                </button>
              </>
            ) : (
              <>
                <input type="hidden" name="action" value="add-admin" />
                <button
                  type="submit"
                  class="rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-dark hover:bg-primary/90"
                >
                  Make Admin
                </button>
              </>
            )}
          </form>
        )}
      </div>
    </Card>

    <Card>
      <h3 class="mb-4 text-lg font-semibold text-white">Applications</h3>
      {targetUser.programApplications.length > 0 ? (
        <div class="overflow-x-auto rounded-lg border border-teal/20">
          <table class="w-full text-left text-sm">
            <thead class="bg-teal/30 text-xs uppercase text-white/80">
              <tr>
                <th class="px-4 py-3 font-medium">Program</th>
                <th class="px-4 py-3 font-medium">Status</th>
                <th class="px-4 py-3 font-medium">Date</th>
                <th class="px-4 py-3 font-medium">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-teal/10">
              {targetUser.programApplications.map((app) => (
                <tr class="text-white/80 hover:bg-teal/10">
                  <td class="px-4 py-3">{app.program?.name ?? "—"}</td>
                  <td class="px-4 py-3">
                    <Badge variant={applicationBadgeVariants[app.status]} />
                  </td>
                  <td class="px-4 py-3">
                    {app.createdAt ? new Date(app.createdAt).toLocaleDateString() : "—"}
                  </td>
                  <td class="px-4 py-3">
                    <a
                      href={`/admin/applications/${app.id}`}
                      class="text-primary hover:underline"
                    >
                      View
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="text-ink-muted">No applications</p>
      )}
    </Card>
  </div>
</AdminLayout>
