---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Card from "@/components/common/Card.astro";
import Badge from "@/components/common/Badge.astro";
import Button from "@/components/common/Button.astro";
import PersonMarker from "@/components/platform/ui/PersonMarker";
import { drizzle } from "drizzle-orm/d1";
import * as schema from "@/lib/db/schema";
import { eq } from "drizzle-orm";
import { env } from "cloudflare:workers";
import {
  adminRoleErrorMessage,
  assertPersistentAdminRoleMutationAllowed,
  assignAdminRole,
  createDrizzleAdminRoleStore,
  revokeAdminRole,
} from "@/lib/admin/roles";
import {
  ACCESS_REQUESTS_PATH,
  ACCESS_ROLE_LABELS,
  communityRoleNotice,
  communityRoleRedirect,
  COMMUNITY_ROLE_FAILED,
  isDelegatedCredential,
  parseCommunityRoleAction,
} from "@/lib/admin/access-requests";
import { grantCommunityRole, revokeCommunityRole } from "@/lib/onboarding/decisions";
import { AccessRole } from "@/lib/platform/contracts";

const db = drizzle(env.DB, { schema });
const { id } = Astro.params;

if (!id) return Astro.redirect("/admin/users");

const signedInAdminId = Astro.locals.user?.id;
if (!signedInAdminId) return Astro.redirect("/auth/login");

const targetUser = await db.query.user.findFirst({
  where: eq(schema.user.id, id),
  with: {
    userRoles: { with: { role: true } },
    programApplications: { with: { program: true } },
  },
});

if (!targetUser) return Astro.redirect("/admin/users");

const roleStore = createDrizzleAdminRoleStore(db);
let roleError: string | undefined;
let communityError: string | undefined;
let changedAccess: string | undefined;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const action = formData.get("action");
  const communityAction = parseCommunityRoleAction(action);

  // Mentor and institution access: the same writers as the access-request queue, and like it,
  // browser sessions only. Granting also approves a request pending for that role.
  if (communityAction) {
    if (isDelegatedCredential(Astro.locals)) {
      Astro.response.status = 403;
      communityError =
        "Agent sessions and personal access tokens cannot change mentor or institution access. Sign in with a browser session.";
    } else {
      try {
        if (communityAction.kind === "grant") {
          await grantCommunityRole(
            { db: env.DB, env },
            { userId: id, role: communityAction.role, actorId: signedInAdminId }
          );
        } else {
          await revokeCommunityRole(env.DB, id, communityAction.role);
        }
        changedAccess = communityRoleRedirect(id, communityAction);
      } catch (error) {
        console.error("Community role change failed", error);
        Astro.response.status = 500;
        communityError = COMMUNITY_ROLE_FAILED;
      }
    }
  } else {
    try {
      assertPersistentAdminRoleMutationAllowed(
        action,
        Astro.locals.session?.userAgent
      );

      if (action === "add-admin") {
        const result = await assignAdminRole(roleStore, id);
        const outcome = result.changed ? "assigned" : "unchanged";
        return Astro.redirect(`/admin/users/${id}?role=${outcome}`);
      }
      if (action === "remove-admin") {
        const result = await revokeAdminRole(roleStore, id, signedInAdminId);
        const outcome = result.changed ? "revoked" : "unchanged";
        return Astro.redirect(`/admin/users/${id}?role=${outcome}`);
      }
      roleError = "Choose a valid role action.";
    } catch (error) {
      roleError = adminRoleErrorMessage(error);
    }
  }
}
if (changedAccess) return Astro.redirect(changedAccess, 303);

const isTargetAdmin = targetUser.userRoles.some((ur) => ur.role.name === "ADMIN");
const isSignedInUser = targetUser.id === signedInAdminId;
const roleNoticeByOutcome: Record<string, string> = {
  assigned: "ADMIN access was granted.",
  revoked: "ADMIN access was removed.",
  unchanged: "ADMIN access was already up to date.",
};
const roleOutcome = Astro.url.searchParams.get("role");
const roleNotice = roleOutcome
  ? roleNoticeByOutcome[roleOutcome]
  : undefined;
const heldRoles = new Set(targetUser.userRoles.map((ur) => ur.role.name));
const { results: pendingRequests } = await env.DB
  .prepare("SELECT role FROM access_request WHERE userId = ? AND status = 'PENDING'")
  .bind(id)
  .all<{ role: string }>();
const pendingRoles = new Set(pendingRequests.map((request) => request.role));
const communityRoles = AccessRole.options.map((role) => ({
  role,
  label: ACCESS_ROLE_LABELS[role],
  marker: role === "MENTOR" ? ("mentor" as const) : ("institution" as const),
  held: heldRoles.has(role),
  pending: pendingRoles.has(role),
}));
// Delegated credentials cannot change these roles, so they are not offered the buttons.
const delegated = isDelegatedCredential(Astro.locals);
const communityNotice = communityRoleNotice(
  Astro.url.searchParams.get("access"),
  Astro.url.searchParams.get("accessRole")
);
const applicationBadgeVariants = {
  PENDING: "pending",
  APPROVED: "approved",
  REJECTED: "rejected",
  AUDIT: "audit",
  COMPLETED: "completed",
} as const;
---

<AdminLayout title={targetUser.name}>
  <div class="space-y-6">
    <a href="/admin/users" class="text-sm text-primary hover:underline">
      &larr; Back to Users
    </a>

    <Card>
      <div class="flex items-start gap-4">
        {targetUser.image && (
          <img
            src={targetUser.image}
            alt={targetUser.name}
            class="h-16 w-16 rounded-full"
          />
        )}
        <div>
          <h2 class="text-2xl font-bold text-white">{targetUser.name}</h2>
          <p class="text-ink-secondary">{targetUser.email}</p>
          <p class="mt-1 text-sm text-ink-muted">
            Joined {targetUser.createdAt ? new Date(targetUser.createdAt).toLocaleDateString() : "—"}
          </p>
        </div>
      </div>
    </Card>

    <Card>
      <h3 class="mb-4 text-lg font-semibold text-white">Roles</h3>
      {roleError && (
        <p
          role="alert"
          class="mb-4 rounded-md border border-red-400/40 bg-red-500/15 px-4 py-3 text-sm text-red-100"
        >
          {roleError}
        </p>
      )}
      {roleNotice && (
        <p
          role="status"
          class="mb-4 rounded-md border border-emerald-400/40 bg-emerald-500/15 px-4 py-3 text-sm text-emerald-100"
        >
          {roleNotice}
        </p>
      )}
      <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center">
        <div class="flex flex-wrap gap-2">
          {targetUser.userRoles.length > 0
            ? targetUser.userRoles.map((ur) => (
                <span class="rounded-full bg-teal/30 px-3 py-1 text-sm text-white">
                  {ur.role.name}
                </span>
              ))
            : <span class="text-ink-muted">No roles assigned</span>}
        </div>
        {isTargetAdmin && isSignedInUser ? (
          <p class="text-sm text-ink-secondary">
            You cannot remove your own ADMIN role.
          </p>
        ) : (
          <form method="POST">
            {isTargetAdmin ? (
              <>
                <input type="hidden" name="action" value="remove-admin" />
                <Button
                  type="submit"
                  variant="danger"
                  size="sm"
                  onclick="return confirm('Remove admin privileges from this user?')"
                >
                  Remove Admin
                </Button>
              </>
            ) : (
              <>
                <input type="hidden" name="action" value="add-admin" />
                <Button type="submit" size="sm">
                  Make Admin
                </Button>
              </>
            )}
          </form>
        )}
      </div>
    </Card>

    <section id="community-access" aria-labelledby="community-access-title">
      <Card>
        <h3 id="community-access-title" class="text-lg font-semibold text-white">Mentor and institution access</h3>
        <p class="mt-1 max-w-2xl text-sm text-ink-secondary">
          Approved access stays on until an administrator removes it. Removing it keeps their own work and
          request history.
        </p>
        {communityError && (
          <p role="alert" class="mt-4 rounded-md border border-red-400/40 bg-red-500/15 px-4 py-3 text-sm text-red-100">
            {communityError}
          </p>
        )}
        {communityNotice && (
          <p role="status" class="mt-4 rounded-md border border-emerald-400/40 bg-emerald-500/15 px-4 py-3 text-sm text-emerald-100">
            {communityNotice}
          </p>
        )}
        <ul class="mt-4 divide-y divide-teal/20">
          {communityRoles.map((access) => (
            <li class="flex flex-col gap-3 py-4 sm:flex-row sm:items-center sm:justify-between" data-community-role={access.role}>
              <div class="flex items-start gap-3">
                <PersonMarker kind={access.marker} className="mt-1" />
                <div>
                  <p class="font-semibold text-ink-primary">{access.label}</p>
                  <p class="text-sm text-ink-secondary">
                    {access.held ? `Has ${access.label.toLowerCase()} access.` : `No ${access.label.toLowerCase()} access.`}
                    {!access.held && access.pending && (
                      <>
                        {" "}A request is waiting in{" "}
                        <a href={ACCESS_REQUESTS_PATH} class="text-primary hover:underline">Access requests</a>.
                      </>
                    )}
                  </p>
                </div>
              </div>
              {!delegated && <form method="POST" class="shrink-0">
                {access.held ? (
                  <>
                    <input type="hidden" name="action" value={`revoke-${access.role}`} />
                    <Button
                      type="submit"
                      variant="danger"
                      class="min-h-11"
                      onclick={`return confirm('Remove ${access.label.toLowerCase()} access from this user?')`}
                    >
                      Remove {access.label.toLowerCase()} access
                    </Button>
                  </>
                ) : (
                  <>
                    <input type="hidden" name="action" value={`grant-${access.role}`} />
                    <Button type="submit" variant="secondary" class="min-h-11">
                      {access.pending ? "Approve and give access" : `Give ${access.label.toLowerCase()} access`}
                    </Button>
                  </>
                )}
              </form>}
            </li>
          ))}
        </ul>
      </Card>
    </section>

    <Card>
      <h3 class="mb-4 text-lg font-semibold text-white">Applications</h3>
      {targetUser.programApplications.length > 0 ? (
        <div class="overflow-x-auto rounded-lg border border-teal/20">
          <table class="w-full text-left text-sm">
            <thead class="bg-teal/30 text-xs uppercase text-white/80">
              <tr>
                <th class="px-4 py-3 font-medium">Program</th>
                <th class="px-4 py-3 font-medium">Status</th>
                <th class="px-4 py-3 font-medium">Date</th>
                <th class="px-4 py-3 font-medium">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-teal/10">
              {targetUser.programApplications.map((app) => (
                <tr class="text-white/80 hover:bg-teal/10">
                  <td class="px-4 py-3">{app.program?.name ?? "—"}</td>
                  <td class="px-4 py-3">
                    <Badge variant={applicationBadgeVariants[app.status]} />
                  </td>
                  <td class="px-4 py-3">
                    {app.createdAt ? new Date(app.createdAt).toLocaleDateString() : "—"}
                  </td>
                  <td class="px-4 py-3">
                    <a
                      href={`/admin/applications/${app.id}`}
                      class="text-primary hover:underline"
                    >
                      View
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="text-ink-muted">No applications</p>
      )}
    </Card>
  </div>
</AdminLayout>
