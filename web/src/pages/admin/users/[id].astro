---
import { env } from "cloudflare:workers";
import { desc, eq } from "drizzle-orm";
import { drizzle } from "drizzle-orm/d1";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";
import {
  Avatar,
  BackLink,
  Button,
  ButtonLink,
  Chip,
  ConfirmStep,
  DataCell,
  DataRow,
  DataTable,
  DescriptionItem,
  DescriptionList,
  EmptyState,
  Notice,
  PageHeader,
  PersonMarker,
  StatusChip,
  confirmHref,
  confirmingAction,
  linkClass,
  withoutConfirm,
} from "@/components/platform/ui";
import {
  ACCESS_REQUESTS_PATH,
  ACCESS_ROLE_LABELS,
  changeCommunityRole,
  communityRoleNotice,
  isDelegatedCredential,
  parseCommunityRoleAction,
} from "@/lib/admin/access-requests";
import {
  AdminRoleOperationError,
  adminRoleErrorMessage,
  assertPersistentAdminRoleMutationAllowed,
  assignAdminRole,
  createDrizzleAdminRoleStore,
  revokeAdminRole,
} from "@/lib/admin/roles";
import { USERS_PATH, adminRoleNotice, roleLabel } from "@/lib/admin/users";
import * as schema from "@/lib/db/schema";
import { formatMomentDate } from "@/lib/display-date";
import { grantCommunityRole, revokeCommunityRole } from "@/lib/onboarding/decisions";
import { AccessRole } from "@/lib/platform/contracts";
import { redirectWithFlash, takeFlash } from "@/lib/platform/server/flash";

/*
 * One person, for an administrator: who they are, their admin, mentor and
 * institution access, and their applications. Middleware has required ADMIN
 * and same-origin POSTs. Removing access asks first, at ?confirm=, with no
 * script; a change answers with a 303 and says what changed once.
 */
const db = drizzle(env.DB, { schema });
const { id } = Astro.params;
if (!id) return Astro.redirect(USERS_PATH);
const adminId = Astro.locals.user?.id;
if (!adminId) return Astro.redirect("/auth/login");

const page = `/admin/users/${encodeURIComponent(id)}`;
const loadUser = () =>
  db.query.user.findFirst({
    where: eq(schema.user.id, id),
    columns: { id: true, name: true, email: true, image: true, createdAt: true },
    with: {
      userRoles: { columns: {}, with: { role: { columns: { name: true } } } },
      programApplications: {
        columns: { id: true, status: true, createdAt: true },
        with: { program: { columns: { name: true } } },
        orderBy: (application) => [desc(application.createdAt)],
      },
    },
  });
const loadPendingRoles = () =>
  env.DB.prepare("SELECT role FROM access_request WHERE userId = ? AND status = 'PENDING'").bind(id).all<{ role: string }>();

// Agent sessions and personal access tokens cannot change mentor or institution access, so they are not offered it.
const delegated = isDelegatedCredential(Astro.locals);
let roleError: string | undefined;
let communityError: string | undefined;

if (Astro.request.method === "POST") {
  if (!(await loadUser())) return Astro.redirect(USERS_PATH, 303);
  const action = (await Astro.request.formData()).get("action");
  const communityAction = parseCommunityRoleAction(action);

  // Mentor and institution access: the same writers as the access-request queue. Granting also
  // approves a request pending for that role.
  if (communityAction) {
    if (delegated) {
      Astro.response.status = 403;
      communityError = "Agent sessions and personal access tokens cannot change mentor or institution access. Sign in with a browser session.";
    } else {
      const result = await changeCommunityRole(
        { grant: grantCommunityRole, revoke: revokeCommunityRole },
        { db: env.DB, env },
        { userId: id, actorId: adminId, action: communityAction },
      );
      if (result.ok) {
        const notice = communityRoleNotice(communityAction.kind === "grant" ? "granted" : "revoked", communityAction.role);
        return redirectWithFlash(Astro, `${page}#community-access`, { tone: "success", title: notice ?? "Access updated." });
      }
      Astro.response.status = 500;
      communityError = result.error;
    }
  } else {
    try {
      assertPersistentAdminRoleMutationAllowed(action, Astro.locals.session?.userAgent);
      if (action === "add-admin" || action === "remove-admin") {
        const result = action === "add-admin" ? await assignAdminRole(createDrizzleAdminRoleStore(db), id) : await revokeAdminRole(createDrizzleAdminRoleStore(db), id, adminId);
        return redirectWithFlash(Astro, `${page}#admin-access`, { tone: result.changed ? "success" : "info", title: adminRoleNotice(action, result.changed) });
      }
      Astro.response.status = 400;
      roleError = "Choose a valid role action.";
    } catch (error) {
      // A refused change (the last admin, yourself, an agent session) is the request's fault; anything else is the database's.
      Astro.response.status = error instanceof AdminRoleOperationError ? 400 : 503;
      roleError = adminRoleErrorMessage(error);
    }
  }
}

const [targetUser, { results: pendingRequests }, spaces] = await Promise.all([
  loadUser(),
  loadPendingRoles(),
  resolveSpacePage(Astro.locals, "adminUsers"),
]);
if (!targetUser) return Astro.redirect(USERS_PATH);

const flash = takeFlash(Astro);
const heldRoles = new Set(targetUser.userRoles.map((userRole) => userRole.role.name));
const pendingRoles = new Set(pendingRequests.map((request) => request.role));
const isAdmin = heldRoles.has("ADMIN");
const isSelf = targetUser.id === adminId;
const communityRoles = AccessRole.options.map((role) => ({
  role,
  label: ACCESS_ROLE_LABELS[role],
  marker: role === "MENTOR" ? ("mentor" as const) : ("institution" as const),
  held: heldRoles.has(role),
  pending: pendingRoles.has(role),
}));
const asking = confirmingAction(Astro.url, ["remove-admin", ...AccessRole.options.map((role) => `revoke-${role}` as const)]);
const failed = Boolean(roleError || communityError);
---

<AdminLayout title={targetUser.name} titlePrefix={failed ? "Error: " : ""} spaces={spaces}>
  <div class="flex flex-col gap-10">
    <div class="flex flex-col gap-4">
      <BackLink href={USERS_PATH}>Users</BackLink>
      <div class="flex min-w-0 items-center gap-4">
        <Avatar id={targetUser.id} name={targetUser.name} src={targetUser.image ?? undefined} size="xl" decorative />
        <PageHeader title={targetUser.name} className="min-w-0 flex-1" />
      </div>
    </div>

    {flash && <Notice tone={flash.tone} title={flash.title}>{flash.message}</Notice>}

    <DescriptionList className="max-w-3xl">
      <DescriptionItem term="Email">{targetUser.email}</DescriptionItem>
      <DescriptionItem term="Joined">{formatMomentDate(targetUser.createdAt)}</DescriptionItem>
      <DescriptionItem term="Roles">
        {
          targetUser.userRoles.length > 0 ? (
            <span class="inline-flex flex-wrap gap-1.5">
              {targetUser.userRoles.map((userRole) => (
                <Chip>{roleLabel(userRole.role.name)}</Chip>
              ))}
            </span>
          ) : (
            "None"
          )
        }
      </DescriptionItem>
    </DescriptionList>

    <section id="admin-access" aria-labelledby="admin-access-title" class="flex max-w-3xl flex-col gap-4">
      <h2 id="admin-access-title" class="m-0 text-2xl">Admin access</h2>
      {roleError && <Notice tone="danger" focusOnLoad title="Admin access didn't change">{roleError}</Notice>}
      <p class="m-0 text-ink-secondary">
        {isAdmin ? "Has admin access: every admin page, and the Admin space." : "No admin access."}
      </p>
      {
        isAdmin && isSelf ? (
          <p class="m-0 text-sm text-ink-secondary">You can't remove your own admin access. Ask another administrator.</p>
        ) : isAdmin ? (
          asking === "remove-admin" ? (
            <ConfirmStep
              title={`Remove admin access from ${targetUser.name}?`}
              confirmLabel="Remove admin access"
              cancelHref={`${withoutConfirm(Astro.url)}#admin-access`}
              action={`${page}#admin-access`}
              fields={{ action: "remove-admin" }}
            >
              They lose every admin page and the Admin space at once. You can give it back from this page.
            </ConfirmStep>
          ) : (
            <div>
              <ButtonLink variant="danger" href={`${confirmHref(Astro.url, "remove-admin")}#admin-access`}>Remove admin access</ButtonLink>
            </div>
          )
        ) : (
          <form method="POST" action={`${page}#admin-access`}>
            <input type="hidden" name="action" value="add-admin" />
            <Button type="submit">Give admin access</Button>
          </form>
        )
      }
    </section>

    <section id="community-access" aria-labelledby="community-access-title" class="flex max-w-3xl flex-col gap-4">
      <h2 id="community-access-title" class="m-0 text-2xl">Mentor and institution access</h2>
      <p class="m-0 max-w-prose text-ink-secondary">
        Approved access stays on until an administrator removes it. Removing it keeps their own work and request history.
      </p>
      {communityError && <Notice tone="danger" focusOnLoad title="Access didn't change">{communityError}</Notice>}
      <ul class="m-0 flex list-none flex-col p-0">
        {
          communityRoles.map((access) => (
            <li class="flex flex-col gap-3 border-b border-hairline py-4 first:pt-0" data-community-role={access.role}>
              <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex items-start gap-3">
                  <PersonMarker kind={access.marker} className="mt-1.5" />
                  <div>
                    <p class="m-0 font-semibold text-ink-primary">{access.label}</p>
                    <p class="m-0 text-sm text-ink-secondary">
                      {access.held ? `Has ${access.label.toLowerCase()} access.` : `No ${access.label.toLowerCase()} access.`}
                      {!access.held && access.pending && (
                        <>
                          {" "}A request is waiting in <a href={ACCESS_REQUESTS_PATH} class={linkClass()}>Access requests</a>.
                        </>
                      )}
                    </p>
                  </div>
                </div>
                {!delegated && asking !== `revoke-${access.role}` && (
                  access.held ? (
                    <ButtonLink variant="danger" href={`${confirmHref(Astro.url, `revoke-${access.role}`)}#community-access`} className="self-start sm:self-auto">
                      Remove {access.label.toLowerCase()} access
                    </ButtonLink>
                  ) : (
                    <form method="POST" action={`${page}#community-access`} class="shrink-0 self-start sm:self-auto">
                      <input type="hidden" name="action" value={`grant-${access.role}`} />
                      <Button type="submit">{access.pending ? "Approve and give access" : `Give ${access.label.toLowerCase()} access`}</Button>
                    </form>
                  )
                )}
              </div>
              {!delegated && access.held && asking === `revoke-${access.role}` && (
                <ConfirmStep
                  title={`Remove ${access.label.toLowerCase()} access from ${targetUser.name}?`}
                  confirmLabel={`Remove ${access.label.toLowerCase()} access`}
                  cancelHref={`${withoutConfirm(Astro.url)}#community-access`}
                  action={`${page}#community-access`}
                  fields={{ action: `revoke-${access.role}` }}
                >
                  {access.role === "MENTOR"
                    ? "They leave the Mentoring space and the mentor directory at once. Their conversations and confirmations stay."
                    : "They lose institutional discovery at once. Their own work and request history stay."}
                </ConfirmStep>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="applications-title" class="flex flex-col gap-4">
      <h2 id="applications-title" class="m-0 text-2xl">Applications</h2>
      <DataTable
        caption={`${targetUser.name}'s applications`}
        columns={[{ label: "Cohort" }, { label: "Status" }, { label: "Applied", align: "end" }]}
        isEmpty={targetUser.programApplications.length === 0}
      >
        {
          targetUser.programApplications.map((application) => (
            <DataRow>
              <DataCell label="Cohort" primary>
                <a href={`/admin/applications/${application.id}`} class={linkClass()}>{application.program?.name ?? "Cohort removed"}</a>
              </DataCell>
              <DataCell label="Status">
                <StatusChip domain="application" status={application.status} />
              </DataCell>
              <DataCell label="Applied" align="end">{formatMomentDate(application.createdAt)}</DataCell>
            </DataRow>
          ))
        }
        <Fragment slot="empty">
          <EmptyState title="No applications" headingLevel={3}>
            {targetUser.name} hasn't applied to a cohort.
          </EmptyState>
        </Fragment>
      </DataTable>
    </section>
  </div>
</AdminLayout>
