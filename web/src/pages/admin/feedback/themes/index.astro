---
import { PiArrowLeft } from "react-icons/pi";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";
import { Card, Chip, EmptyState, FOCUS_RING, PageTitle, PillNav } from "@/components/platform/ui";
import { THEME_STATUS_TONES } from "@/components/feedback/status-tones";
import { env } from "cloudflare:workers";
import { FEEDBACK_KIND_LABELS, FeedbackValidationError } from "@/lib/feedback/model";
import { listThemes } from "@/lib/feedback/theme-store";
import { themeAdminPath } from "@/lib/feedback/theme-api";
import {
  FEEDBACK_THEME_STATUS_LABELS,
  FEEDBACK_THEME_STATUSES,
  THEME_AGREEMENT_STUDENTS,
  THEME_AGREEMENT_WINDOW_DAYS,
  assessTheme,
  parseThemeStatusFilter,
} from "@/lib/feedback/themes";

const THEMES_PATH = "/admin/feedback/themes";
const requested = Astro.url.searchParams.get("status") ?? "open";
let statuses;
try {
  statuses = parseThemeStatusFilter(requested);
} catch (error) {
  if (!(error instanceof FeedbackValidationError)) throw error;
  return Astro.redirect(THEMES_PATH, 303);
}
const now = new Date();
// The themes and the Admin space are independent reads: one round trip, not two.
const [themes, spaces] = await Promise.all([
  listThemes(env.DB, { statuses, now }),
  resolveSpacePage(Astro.locals, "adminFeedback"),
]);
const tabs = [
  { value: "open", label: "Open" },
  ...FEEDBACK_THEME_STATUSES.map((status) => ({ value: status, label: FEEDBACK_THEME_STATUS_LABELS[status] })),
  { value: "all", label: "All" },
];
const all = requested === "all";

const students = (count: number) => `${count} ${count === 1 ? "student" : "students"}`;
---

<AdminLayout title="Feedback themes" spaces={spaces}>
  <div class="space-y-6">
    <a href="/admin/feedback" class:list={["inline-flex min-h-11 items-center gap-1.5 rounded-sm text-sm font-semibold text-peach-ink hover:underline", FOCUS_RING]}>
      <PiArrowLeft className="size-4 shrink-0" aria-hidden="true" />
      Back to Feedback
    </a>
    <header class="space-y-2">
      <PageTitle>Themes</PageTitle>
      <p class="max-w-2xl text-sm leading-relaxed text-ink-secondary">
        One problem or wish that several students raised. Ideas and confusing spots are put forward
        once {THEME_AGREEMENT_STUDENTS} students raise them within {THEME_AGREEMENT_WINDOW_DAYS} days; a bug
        needs one report. Titles and summaries may be published, so they never identify a student.
      </p>
    </header>

    <PillNav
      label="Filter by status"
      items={tabs.map((tab) => ({ label: tab.label, href: `${THEMES_PATH}?status=${tab.value}`, current: requested === tab.value }))}
    />

    {
      themes.length === 0 ? (
        <EmptyState title={all ? "No themes yet" : "No themes in this view"} headingLevel={2}>
          {all
            ? "The weekly feedback triage gathers notes that share one problem or wish into a theme. Themes appear here."
            : "Themes with this status appear here. All shows every theme."}
        </EmptyState>
      ) : (
        <ul class="space-y-3" data-testid="admin-theme-list">
          {themes.map((theme) => {
            const assessment = assessTheme(
              {
                kind: theme.kind,
                status: theme.status,
                change: theme.change,
                recentStudents: theme.stats.recentStudents,
                lastReportAt: theme.stats.lastReportAt,
              },
              now
            );
            return (
              <Card as="li" className="relative transition-colors hover:border-ink-primary/30 motion-reduce:transition-none">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
                  <Chip tone={THEME_STATUS_TONES[theme.status]}>{FEEDBACK_THEME_STATUS_LABELS[theme.status]}</Chip>
                  <h2 class="min-w-0 font-body text-base font-bold text-ink-primary">
                    {/* The title is the row's link; it stretches over the card, so the whole card opens the theme. */}
                    <a
                      href={themeAdminPath(theme.id)}
                      class:list={["rounded-sm after:absolute after:inset-0 after:rounded-[1.125rem] hover:underline", FOCUS_RING]}
                    >
                      {theme.title}
                    </a>
                  </h2>
                  {assessment.readyToPropose && <Chip tone="peach">Ready to propose</Chip>}
                </div>
                <p class="mt-2 text-xs text-ink-muted">
                  {FEEDBACK_KIND_LABELS[theme.kind]} · {students(theme.stats.students)} ({theme.stats.recentStudents} in {THEME_AGREEMENT_WINDOW_DAYS} days) · {assessment.reason}
                </p>
              </Card>
            );
          })}
        </ul>
      )
    }
  </div>
</AdminLayout>
