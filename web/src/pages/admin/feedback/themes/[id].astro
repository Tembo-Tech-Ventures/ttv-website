---
import { PiArrowLeft } from "react-icons/pi";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";
import {
  Button, Card, Chip, FOCUS_RING, Notice, PageTitle, SelectField, TextAreaField, TextField,
} from "@/components/platform/ui";
import { NOTE_STATUS_TONES, THEME_STATUS_TONES } from "@/components/feedback/status-tones";
import { env } from "cloudflare:workers";
import {
  FEEDBACK_ADMIN_STATUS_LABELS,
  FEEDBACK_KIND_LABELS,
  FEEDBACK_KINDS,
  FEEDBACK_STATUSES,
  FeedbackValidationError,
  feedbackPagePath,
} from "@/lib/feedback/model";
import { listFeedback } from "@/lib/feedback/store";
import { getTheme, updateTheme } from "@/lib/feedback/theme-store";
import { themeUpdateFromForm } from "@/lib/feedback/theme-api";
import {
  FEEDBACK_THEME_CHANGES,
  FEEDBACK_THEME_STATUS_LABELS,
  FEEDBACK_THEME_STATUSES,
  THEME_AGREEMENT_WINDOW_DAYS,
  assessTheme,
} from "@/lib/feedback/themes";

const THEMES_PATH = "/admin/feedback/themes";
const id = Astro.params.id ?? "";
let actionError = "";
const saved = Astro.url.searchParams.get("saved") === "1";
const FIELDS = ["title", "summary", "status", "kind", "change", "issueUrl", "prUrl", "studentMessage", "decisionNote"] as const;
/** What the admin typed, kept when a save is refused so nothing they wrote is lost (patterns.md, Forms). */
let posted: Record<(typeof FIELDS)[number], string> | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  try {
    const update = themeUpdateFromForm(form);
    const result = await updateTheme(env.DB, id, update.patch, {
      actorId: Astro.locals.user!.id,
      studentMessage: update.studentMessage,
    });
    if (!result) return Astro.redirect(THEMES_PATH, 303);
    return Astro.redirect(`${THEMES_PATH}/${encodeURIComponent(id)}?saved=1`, 303);
  } catch (error) {
    if (!(error instanceof FeedbackValidationError)) throw error;
    actionError = error.message;
    posted = Object.fromEntries(FIELDS.map((name) => {
      const value = form.get(name);
      return [name, typeof value === "string" ? value : ""];
    })) as Record<(typeof FIELDS)[number], string>;
    Astro.response.status = 400;
  }
}

const now = new Date();
// The theme, its notes and the Admin space are independent reads (the notes are keyed by the
// address's id): one round trip, not three.
const [theme, notes, spaces] = await Promise.all([
  getTheme(env.DB, id, now),
  listFeedback(env.DB, { statuses: FEEDBACK_STATUSES, themeId: id, limit: 200 }),
  resolveSpacePage(Astro.locals, "adminFeedback"),
]);
if (!theme) return Astro.redirect(THEMES_PATH, 303);
const assessment = assessTheme(
  {
    kind: theme.kind,
    status: theme.status,
    change: theme.change,
    recentStudents: theme.stats.recentStudents,
    lastReportAt: theme.stats.lastReportAt,
  },
  now
);
const values = posted ?? {
  title: theme.title,
  summary: theme.summary,
  status: theme.status,
  kind: theme.kind,
  change: theme.change ?? "",
  issueUrl: theme.issueUrl ?? "",
  prUrl: theme.prUrl ?? "",
  studentMessage: "",
  decisionNote: theme.decisionNote ?? "",
};
const APPROVAL_LABELS = {
  owner: "Needs the owner's yes",
  default: "Proceeds after 7 days without an answer",
  none: "No approval needed",
} as const;
const CHANGE_LABELS = {
  FIX: "Fix: repairs something broken",
  SIMPLIFY: "Simplify: removes a step, page or rule",
  ADD: "Add: a new page, step, status or cost",
} as const;
const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
const SECTION = "mb-3 text-lg text-ink-primary";
const TEXT_LINK = `rounded-sm text-peach-ink hover:underline ${FOCUS_RING}`;
---

<AdminLayout title="Feedback theme" spaces={spaces}>
  <div class="space-y-6">
    <a href={THEMES_PATH} class:list={["inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold", TEXT_LINK]}>
      <PiArrowLeft className="size-4 shrink-0" aria-hidden="true" />
      Back to Themes
    </a>

    {actionError && (
      <Notice tone="danger" focusOnLoad id="theme-failure" title="The theme wasn't saved">
        {actionError} Everything you wrote is kept below.
      </Notice>
    )}
    {saved && (
      <Notice tone="success" id="theme-saved">Saved. Students on this theme see the new status on their feedback page.</Notice>
    )}

    <header class="space-y-3">
      <PageTitle>{theme.title}</PageTitle>
      <Chip tone={THEME_STATUS_TONES[theme.status]}>{FEEDBACK_THEME_STATUS_LABELS[theme.status]}</Chip>
    </header>

    <div class="grid gap-6 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
      <div class="min-w-0 space-y-6">
        <Card as="section" aria-labelledby="theme-standing">
          <h2 id="theme-standing" class={SECTION}>Where it stands</h2>
          <dl class="grid gap-3 text-sm sm:grid-cols-2">
            <div>
              <dt class="text-ink-muted">Students</dt>
              <dd class="text-ink-primary">{theme.stats.students} ({theme.stats.recentStudents} in the last {THEME_AGREEMENT_WINDOW_DAYS} days)</dd>
            </div>
            <div>
              <dt class="text-ink-muted">Last report</dt>
              <dd class="text-ink-primary">{theme.stats.lastReportAt ? formatDate(theme.stats.lastReportAt) : "—"}</dd>
            </div>
            <div>
              <dt class="text-ink-muted">Triage rules</dt>
              <dd class="text-ink-primary">{assessment.reason}</dd>
            </div>
            <div>
              <dt class="text-ink-muted">Approval</dt>
              <dd class="text-ink-primary">{APPROVAL_LABELS[assessment.approval]}</dd>
            </div>
          </dl>
          {theme.summary && (
            <p class="mt-4 whitespace-pre-wrap break-words text-sm leading-relaxed text-ink-secondary">{theme.summary}</p>
          )}
        </Card>

        <Card as="section" aria-labelledby="theme-notes">
          <h2 id="theme-notes" class={SECTION}>Notes on this theme</h2>
          {notes.length === 0 ? (
            <p class="text-sm text-ink-secondary">No notes yet. A note joins this theme when someone picks it on the note's page in Feedback.</p>
          ) : (
            <ul class="divide-y divide-hairline" data-theme-notes>
              {notes.map((note) => (
                <li class="relative py-3 first:pt-0 last:pb-0">
                  <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-ink-muted">
                    <Chip tone={NOTE_STATUS_TONES[note.status]}>{FEEDBACK_ADMIN_STATUS_LABELS[note.status]}</Chip>
                    <a href={`/admin/feedback/${encodeURIComponent(note.id)}`} class:list={["rounded-sm text-sm font-semibold text-ink-primary after:absolute after:inset-0 hover:underline pointer-coarse:py-3", FOCUS_RING]}>
                      {note.user.name}
                    </a>
                    <span>{FEEDBACK_KIND_LABELS[note.kind]} · {formatDate(note.createdAt)} · {feedbackPagePath(note.pageUrl)}</span>
                  </div>
                  <p class="mt-1 break-words text-sm text-ink-secondary">{note.message || "Screenshot only"}</p>
                </li>
              ))}
            </ul>
          )}
        </Card>
      </div>

      <div class="min-w-0 space-y-6">
        <Card as="section" aria-labelledby="theme-update">
          <h2 id="theme-update" class={SECTION}>Update</h2>
          <form method="POST" class="space-y-4">
            <TextField name="title" label="Title" hint="May be published." maxLength={120} required defaultValue={values.title} />
            <TextAreaField name="summary" label="Summary" hint="May be published, so it never identifies a student." optional rows={4} maxLength={4000} defaultValue={values.summary} />
            <div class="grid gap-4 sm:grid-cols-2">
              <SelectField
                name="status"
                label="Status"
                defaultValue={values.status}
                options={FEEDBACK_THEME_STATUSES.map((status) => ({ value: status, label: FEEDBACK_THEME_STATUS_LABELS[status] }))}
              />
              <SelectField
                name="kind"
                label="Kind"
                defaultValue={values.kind}
                options={FEEDBACK_KINDS.map((kind) => ({ value: kind, label: FEEDBACK_KIND_LABELS[kind] }))}
              />
            </div>
            <SelectField
              name="change"
              label="Change"
              defaultValue={values.change}
              placeholder="Not decided yet"
              options={FEEDBACK_THEME_CHANGES.map((change) => ({ value: change, label: CHANGE_LABELS[change] }))}
            />
            <TextField name="issueUrl" type="url" label="Public issue" optional defaultValue={values.issueUrl} />
            <TextField name="prUrl" type="url" label="Pull request" optional defaultValue={values.prUrl} />
            <TextAreaField
              name="studentMessage"
              label="Message to students"
              hint="Needed to ship or decline the theme. It becomes the reply on every open note."
              optional
              rows={3}
              maxLength={2000}
              defaultValue={values.studentMessage}
            />
            <TextAreaField name="decisionNote" label="Decision note" hint="Private: staff and agents only." optional rows={3} maxLength={5000} defaultValue={values.decisionNote} />
            <Notice tone="warning" title="Shipping or declining replies to every open note">
              The message to students replaces the reply on each open note on this theme, and those students see it.
            </Notice>
            <Button type="submit" variant="primary" size="lg">Save theme</Button>
          </form>
        </Card>
      </div>
    </div>
  </div>
</AdminLayout>
