---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Card from "@/components/common/Card.astro";
import FeedbackStatusPill from "@/components/feedback/FeedbackStatusPill.astro";
import { env } from "cloudflare:workers";
import { countFeedbackByStatus, listFeedback } from "@/lib/feedback/store";
import { feedbackAttachmentPath } from "@/lib/feedback/api";
import {
  FEEDBACK_ADMIN_STATUS_LABELS,
  FEEDBACK_KIND_LABELS,
  FEEDBACK_STATUSES,
  FeedbackValidationError,
  feedbackPagePath,
  parseFeedbackStatusFilter,
} from "@/lib/feedback/model";

const requested = Astro.url.searchParams.get("status") ?? "open";
let statuses;
try {
  statuses = parseFeedbackStatusFilter(requested);
} catch (error) {
  if (!(error instanceof FeedbackValidationError)) throw error;
  return Astro.redirect("/admin/feedback");
}

const [items, counts] = await Promise.all([
  listFeedback(env.DB, { statuses, limit: 100 }),
  countFeedbackByStatus(env.DB),
]);

const tabs = [
  { value: "open", label: "Open", count: counts.NEW + counts.IN_PROGRESS },
  ...FEEDBACK_STATUSES.map((status) => ({
    value: status,
    label: FEEDBACK_ADMIN_STATUS_LABELS[status],
    count: counts[status],
  })),
  {
    value: "all",
    label: "All",
    count: Object.values(counts).reduce((sum, count) => sum + count, 0),
  },
];

const formatDate = (date: Date) =>
  date.toLocaleString("en-GB", {
    day: "numeric",
    month: "short",
    hour: "2-digit",
    minute: "2-digit",
    timeZone: "UTC",
  });
const excerpt = (text: string) =>
  text.length > 220 ? `${text.slice(0, 219)}…` : text;
---

<AdminLayout title="Feedback">
  <div class="space-y-6">
    <header>
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="text-2xl font-bold text-white">Feedback</h2>
        <a href="/admin/feedback/themes" class="text-sm text-primary hover:underline">
          Themes &rarr;
        </a>
      </div>
      <p class="mt-1 max-w-2xl text-sm text-ink-secondary">
        Notes and screenshots from signed-in students. Agents read and update
        the same queue through <code class="text-ink-primary">/api/admin/feedback</code>
        with an admin personal access token.
      </p>
    </header>

    <nav aria-label="Filter by status" class="flex flex-wrap gap-2">
      {
        tabs.map((tab) => (
          <a
            href={`/admin/feedback?status=${tab.value}`}
            aria-current={requested === tab.value ? "page" : undefined}
            class:list={[
              "rounded-full border px-3 py-1 text-sm transition-colors",
              requested === tab.value
                ? "border-primary bg-primary/15 text-ink-primary"
                : "border-rule text-ink-secondary hover:text-ink-primary",
            ]}
          >
            {tab.label} <span class="text-ink-muted">{tab.count}</span>
          </a>
        ))
      }
    </nav>

    {
      items.length === 0 ? (
        <Card>
          <p class="text-sm text-ink-secondary">No feedback here.</p>
        </Card>
      ) : (
        <ul class="space-y-3" data-testid="admin-feedback-list">
          {items.map((item) => (
            <li>
              <a
                href={`/admin/feedback/${encodeURIComponent(item.id)}`}
                class="flex gap-4 rounded-lg border border-teal/20 bg-dark/80 p-4 transition-colors hover:border-primary/60"
              >
                {item.attachments[0] && (
                  <img
                    src={feedbackAttachmentPath(item.attachments[0].id)}
                    alt=""
                    loading="lazy"
                    class="hidden h-20 w-28 shrink-0 rounded border border-rule object-cover object-top sm:block"
                  />
                )}
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                    <FeedbackStatusPill note={item.status} />
                    <span class="text-sm font-medium text-ink-primary">
                      {FEEDBACK_KIND_LABELS[item.kind]}
                    </span>
                    {item.theme && (
                      <span class="truncate rounded-full border border-rule px-2 py-0.5 text-xs text-ink-secondary">
                        {item.theme.title}
                      </span>
                    )}
                    {item.sensitive && (
                      <span class="rounded-full border border-rose-500/30 px-2 py-0.5 text-xs text-rose-200">
                        Sensitive
                      </span>
                    )}
                    <span class="text-sm text-ink-muted">
                      {item.user.name} · {formatDate(item.createdAt)} UTC
                    </span>
                  </div>
                  <p class="mt-2 break-words text-sm text-ink-secondary">
                    {item.message ? excerpt(item.message) : "(screenshot only)"}
                  </p>
                  <p class="mt-1 truncate text-xs text-ink-muted">
                    {feedbackPagePath(item.pageUrl)}
                    {item.attachments.length > 0 &&
                      ` · ${item.attachments.length} image${item.attachments.length === 1 ? "" : "s"}`}
                    {item.context.errors.length > 0 &&
                      ` · ${item.context.errors.length} client error${item.context.errors.length === 1 ? "" : "s"}`}
                  </p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</AdminLayout>
