---
import { PiArrowLeft } from "react-icons/pi";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";
import {
  Button, Card, Checkbox, Chip, FOCUS_RING, Notice, PageTitle, SelectField, TextAreaField, TextField, type ChipTone,
} from "@/components/platform/ui";
import { env } from "cloudflare:workers";
import { getFeedback, updateFeedback } from "@/lib/feedback/store";
import {
  feedbackAttachmentPath,
  feedbackUpdateFromForm,
} from "@/lib/feedback/api";
import {
  FEEDBACK_ADMIN_STATUS_LABELS,
  FEEDBACK_KIND_LABELS,
  FEEDBACK_STATUSES,
  FeedbackValidationError,
  MAX_FEEDBACK_ADMIN_NOTE_LENGTH,
  MAX_FEEDBACK_RESPONSE_LENGTH,
  feedbackPagePath,
  type FeedbackStatus,
} from "@/lib/feedback/model";
import { formatBytes } from "@/components/feedback/feedback-client";
import { listThemes } from "@/lib/feedback/theme-store";
import { OPEN_FEEDBACK_THEME_STATUSES } from "@/lib/feedback/themes";
import { themeAdminPath } from "@/lib/feedback/theme-api";

const FEEDBACK_PATH = "/admin/feedback";
const id = Astro.params.id ?? "";
let actionError = "";
let saved = Astro.url.searchParams.get("saved") === "1";
/** What the admin typed, kept when a save is refused so nothing they wrote is lost (patterns.md, Forms). */
let posted: Record<"status" | "themeId" | "response" | "resolutionUrl" | "adminNote", string> & { sensitive: boolean } | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const text = (name: string) => {
    const value = form.get(name);
    return typeof value === "string" ? value : "";
  };
  try {
    const update = feedbackUpdateFromForm(form);
    const result = await updateFeedback(env.DB, id, update.patch, {
      actorId: Astro.locals.user!.id,
    });
    if (result.outcome === "not-found") return Astro.redirect(FEEDBACK_PATH, 303);
    if (result.outcome === "invalid") throw new FeedbackValidationError(result.message);
    return Astro.redirect(`${FEEDBACK_PATH}/${encodeURIComponent(id)}?saved=1`, 303);
  } catch (error) {
    if (!(error instanceof FeedbackValidationError)) throw error;
    actionError = error.message;
    saved = false;
    posted = {
      status: text("status"), themeId: text("themeId"), response: text("response"),
      resolutionUrl: text("resolutionUrl"), adminNote: text("adminNote"), sensitive: form.has("sensitive"),
    };
    Astro.response.status = 400;
  }
}

// The note, the open themes and the Admin space are independent reads: one round trip, not three.
const [feedback, openThemes, spaces] = await Promise.all([
  getFeedback(env.DB, id),
  listThemes(env.DB, { statuses: OPEN_FEEDBACK_THEME_STATUSES }),
  resolveSpacePage(Astro.locals, "adminFeedback"),
]);
if (!feedback) return Astro.redirect(FEEDBACK_PATH, 303);

const { context } = feedback;
// Keep a closed theme selectable so saving the form never detaches it silently.
const themeOptions =
  feedback.theme && !openThemes.some((theme) => theme.id === feedback.theme?.id)
    ? [{ id: feedback.theme.id, title: `${feedback.theme.title} (closed)` }, ...openThemes]
    : openThemes;
const values = posted ?? {
  status: feedback.status,
  themeId: feedback.theme?.id ?? "",
  response: feedback.response ?? "",
  resolutionUrl: feedback.resolutionUrl ?? "",
  adminNote: feedback.adminNote ?? "",
  sensitive: feedback.sensitive,
};
// TODO(K2): StatusChip and statusTone("feedback") replace this map once lane K's detail parts merge.
const NOTE_TONES: Record<FeedbackStatus, ChipTone> = { NEW: "peach", IN_PROGRESS: "neutral", RESOLVED: "success", DECLINED: "neutral" };
const formatDateTime = (date: Date) =>
  `${date.toLocaleString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
    timeZone: "UTC",
  })} UTC`;
const facts = [
  ["From", `${feedback.user.name} (${feedback.user.email})`],
  ["Sent", formatDateTime(feedback.createdAt)],
  ["Page title", feedback.pageTitle ?? "—"],
  [
    "Viewport",
    context.viewport
      ? `${context.viewport.width}×${context.viewport.height}${context.devicePixelRatio ? ` @${context.devicePixelRatio}x` : ""}`
      : "—",
  ],
  ["Browser", context.userAgent ?? "—"],
  [
    "Locale",
    [context.language, context.timezone].filter(Boolean).join(" · ") || "—",
  ],
  ["App version", feedback.appVersion ?? "—"],
  [
    "Last handled",
    feedback.handledBy
      ? `${feedback.handledBy.name}, ${formatDateTime(feedback.updatedAt)}`
      : "—",
  ],
] as const;
const SECTION = "mb-3 font-body text-lg font-bold text-ink-primary";
const TEXT_LINK = `rounded-sm text-peach-ink hover:underline ${FOCUS_RING}`;
---

<AdminLayout title="Feedback" spaces={spaces}>
  <div class="space-y-6">
    <a href={FEEDBACK_PATH} class:list={["inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold", TEXT_LINK]}>
      <PiArrowLeft className="size-4 shrink-0" aria-hidden="true" />
      Back to Feedback
    </a>

    {actionError && (
      <Notice tone="danger" focusOnLoad id="feedback-failure" title="This feedback wasn't saved">
        {actionError} Everything you wrote is kept below.
      </Notice>
    )}
    {saved && (
      <Notice tone="success" id="feedback-saved">Saved. The student sees the status and reply on their feedback page.</Notice>
    )}

    <header class="space-y-3">
      <PageTitle>Feedback from {feedback.user.name}</PageTitle>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
        <Chip tone={NOTE_TONES[feedback.status]}>{FEEDBACK_ADMIN_STATUS_LABELS[feedback.status]}</Chip>
        <span class="text-sm font-medium text-ink-primary">{FEEDBACK_KIND_LABELS[feedback.kind]}</span>
        {feedback.sensitive && <Chip tone="warning">Sensitive</Chip>}
        <a href={feedback.pageUrl} class:list={["inline-flex min-h-11 max-w-full items-center truncate text-sm", TEXT_LINK]} target="_blank" rel="noopener">
          <span class="truncate">{feedbackPagePath(feedback.pageUrl)}</span><span class="sr-only"> (opens in a new tab)</span>
        </a>
      </div>
    </header>

    <div class="grid gap-6 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
      <div class="min-w-0 space-y-6">
        <Card as="section" aria-labelledby="feedback-message">
          <h2 id="feedback-message" class={SECTION}>What they said</h2>
          {/* Expression on the tag's own line: pre-wrap would show indentation. */}
          <p class="whitespace-pre-wrap break-words text-sm leading-relaxed text-ink-primary">{feedback.message || "No text. See the screenshots."}</p>
        </Card>

        {feedback.attachments.length > 0 && (
          <Card as="section" aria-labelledby="feedback-screenshots">
            <h2 id="feedback-screenshots" class={SECTION}>Screenshots</h2>
            <ul class="space-y-4">
              {feedback.attachments.map((attachment, index) => (
                <li>
                  <a
                    href={feedbackAttachmentPath(attachment.id)}
                    target="_blank"
                    rel="noopener"
                    class:list={["block overflow-hidden rounded-lg border border-hairline transition-colors hover:border-ink-primary/40 motion-reduce:transition-none", FOCUS_RING]}
                  >
                    <img
                      src={feedbackAttachmentPath(attachment.id)}
                      alt={`Screenshot ${index + 1} from ${feedback.user.name}`}
                      loading="lazy"
                      class="w-full"
                    />
                  </a>
                  <p class="mt-1 text-xs text-ink-muted">
                    {attachment.source === "CAPTURE"
                      ? "Captured in the browser (a redraw of the page, not a pixel-exact screenshot)"
                      : "Uploaded by the student"}
                    {` · ${formatBytes(attachment.size)}`}
                  </p>
                </li>
              ))}
            </ul>
          </Card>
        )}

        {context.errors.length > 0 && (
          <Card as="section" aria-labelledby="feedback-errors">
            <h2 id="feedback-errors" class={SECTION}>Errors the page logged</h2>
            <ol class="space-y-2 font-mono text-xs text-ink-secondary">
              {context.errors.map((clientError) => (
                <li class="break-words rounded-lg border border-hairline bg-ground/50 p-2">
                  <span class="text-ink-primary">{clientError.message}</span>
                  {clientError.source && <span class="block text-ink-muted">{clientError.source}</span>}
                  {clientError.at && <span class="block text-ink-muted">{clientError.at}</span>}
                </li>
              ))}
            </ol>
          </Card>
        )}
      </div>

      <div class="min-w-0 space-y-6">
        <Card as="section" aria-labelledby="feedback-respond">
          <h2 id="feedback-respond" class={SECTION}>Respond</h2>
          <form method="POST" class="space-y-4">
            <SelectField
              name="status"
              label="Status"
              defaultValue={values.status}
              options={FEEDBACK_STATUSES.map((status) => ({ value: status, label: FEEDBACK_ADMIN_STATUS_LABELS[status] }))}
            />
            <div class="space-y-1">
              <SelectField
                name="themeId"
                label="Theme"
                defaultValue={values.themeId}
                placeholder="Not on a theme"
                options={themeOptions.map((theme) => ({ value: theme.id, label: theme.title }))}
              />
              {feedback.theme && (
                <a href={themeAdminPath(feedback.theme.id)} class:list={["inline-flex min-h-11 items-center text-sm font-semibold", TEXT_LINK]}>
                  Open theme
                </a>
              )}
            </div>
            <Checkbox
              name="sensitive"
              label="Sensitive"
              hint="Personal or wellbeing content. Keeps it off themes and out of anything public."
              defaultChecked={values.sensitive}
            />
            <TextAreaField
              name="response"
              label={`Reply to ${feedback.user.name}`}
              hint="They see this on their feedback page."
              optional
              rows={4}
              maxLength={MAX_FEEDBACK_RESPONSE_LENGTH}
              defaultValue={values.response}
            />
            <TextField
              name="resolutionUrl"
              type="url"
              label="Link to the fix"
              hint="They see this too."
              optional
              placeholder="https://github.com/…/pull/123"
              defaultValue={values.resolutionUrl}
            />
            <TextAreaField
              name="adminNote"
              label="Internal note"
              hint="Staff and agents only."
              optional
              rows={3}
              maxLength={MAX_FEEDBACK_ADMIN_NOTE_LENGTH}
              defaultValue={values.adminNote}
            />
            <Button type="submit" variant="primary" size="lg">Save changes</Button>
          </form>
        </Card>

        <Card as="section" aria-labelledby="feedback-context">
          <h2 id="feedback-context" class={SECTION}>Context</h2>
          <dl class="space-y-3 text-sm">
            {facts.map(([label, value]) => (
              <div>
                <dt class="text-ink-muted">{label}</dt>
                <dd class="break-words text-ink-primary">{value}</dd>
              </div>
            ))}
          </dl>
        </Card>
      </div>
    </div>
  </div>
</AdminLayout>
