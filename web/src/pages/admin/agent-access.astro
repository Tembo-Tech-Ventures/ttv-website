---
import { env } from "cloudflare:workers";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { resolveSpacePage } from "@/components/platform/spaces/space-page";
import {
  Button,
  Card,
  ConfirmStep,
  DataCell,
  DataRow,
  DataTable,
  EmptyState,
  Notice,
  PageHeader,
  RowAction,
  SecretValue,
  SelectField,
  StatusChip,
  TextField,
  confirmHref,
  confirmingAction,
  withoutConfirm,
} from "@/components/platform/ui";
import { AGENT_ACCESS_PATH, AGENT_LIFETIME_OPTIONS, DEFAULT_AGENT_LIFETIME, agentSessionStatus, revokeSessionAction } from "@/lib/admin/agent-access";
import {
  AgentSessionInputError,
  createAgentSession,
  isAgentAuthEnabled,
  isAgentSession,
  isSameOriginRequest,
  listAgentSessions,
  parseAgentSessionDuration,
  revokeAgentSession,
} from "@/lib/agent-auth";
import { formatMomentDateTime } from "@/lib/display-date";
import { redirectWithFlash, takeFlash } from "@/lib/platform/server/flash";

/*
 * Short-lived bearer sessions an admin makes for live staging checks: make
 * one, see which still work, and revoke one after a confirm step. The token
 * is shown once, in the response to the form that made it, so that response
 * is never cached and never a redirect. Production never offers this.
 */
Astro.response.headers.set("Cache-Control", "no-store");

const enabled = isAgentAuthEnabled(env.AGENT_AUTH_ENABLED);
const userId = Astro.locals.user?.id;
if (!userId) return Astro.redirect("/auth/login");
if (isAgentSession(Astro.locals.session?.userAgent)) return Astro.redirect("/admin");

type Field = "label" | "duration";
const UNAVAILABLE = "The database didn't answer, so nothing changed. Try again in a moment.";
let created: { label: string; token: string } | undefined;
let actionError: string | undefined;
const fieldErrors: Partial<Record<Field, string>> = {};
// What a refused create keeps, so the person fixes one field rather than starting again.
let kept = { label: "", duration: DEFAULT_AGENT_LIFETIME };

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const action = formData.get("action");
  if (!enabled) {
    actionError = "Agent access is off in this environment, so nothing changed.";
    Astro.response.status = 403;
  } else if (!isSameOriginRequest(Astro.request)) {
    actionError = "This request didn't come from this page, so nothing changed. Reload the page and try again.";
    Astro.response.status = 403;
  } else if (action === "create") {
    kept = { label: String(formData.get("label") ?? ""), duration: String(formData.get("duration") ?? "") };
    try {
      const made = await createAgentSession({ db: env.DB, userId, label: kept.label, durationHours: parseAgentSessionDuration(kept.duration) });
      created = { label: made.label, token: made.token };
      kept = { label: "", duration: DEFAULT_AGENT_LIFETIME };
    } catch (caught) {
      if (caught instanceof AgentSessionInputError) {
        fieldErrors[caught.field] = caught.message;
        actionError = "Check the field marked below.";
        Astro.response.status = 400;
      } else {
        actionError = UNAVAILABLE;
        Astro.response.status = 503;
      }
    }
  } else if (action === "revoke") {
    const revoked = await revokeAgentSession(env.DB, userId, String(formData.get("sessionId") ?? "")).catch(() => null);
    if (revoked === true) return redirectWithFlash(Astro, AGENT_ACCESS_PATH, { tone: "success", title: "Session revoked" });
    if (revoked === false) {
      return redirectWithFlash(Astro, AGENT_ACCESS_PATH, { tone: "info", title: "That session had already ended", message: "It was revoked already, so nothing changed." });
    }
    actionError = UNAVAILABLE;
    Astro.response.status = 503;
  } else {
    actionError = "Choose one of the actions on this page.";
    Astro.response.status = 400;
  }
}

const flash = takeFlash(Astro);
const [sessions, spaces] = await Promise.all([enabled ? listAgentSessions(env.DB, userId) : Promise.resolve([]), resolveSpacePage(Astro.locals, "adminAgentAccess")]);
const now = new Date();
const rows = sessions.map((session) => ({ ...session, status: agentSessionStatus(session, now) }));
const active = rows.filter((session) => session.status === "ACTIVE");
const confirming = confirmingAction(Astro.url, active.map((session) => revokeSessionAction(session.id)));
const toRevoke = confirming ? active.find((session) => revokeSessionAction(session.id) === confirming) : undefined;
---

<AdminLayout title="Agent access" titlePrefix={actionError ? "Error: " : undefined} spaces={spaces}>
  <div class="flex max-w-5xl flex-col gap-8">
    <PageHeader title="Agent access">
      Short-lived bearer sessions for checking a staging deploy live. A session acts as you until it expires, and production never offers them.
    </PageHeader>

    {flash && <Notice tone={flash.tone} title={flash.title}>{flash.message}</Notice>}
    {actionError && <Notice tone="danger" focusOnLoad title="Nothing changed">{actionError}</Notice>}

    {
      !enabled ? (
        <Notice tone="warning" title="Agent access is off here">
          This environment doesn't turn on agent sessions. Use a personal access token for automated checks instead.
        </Notice>
      ) : (
        <>
          {created && (
            <SecretValue id="agent-token" title={`Your new session: ${created.label}`} value={created.token} copyLabel="Copy token">
              Copy it now: it won't be shown again. Anyone holding it can act as your admin account until it expires, so keep it in a secret
              store, never in chat, logs or screenshots.
            </SecretValue>
          )}

          <Card as="section" aria-labelledby="create-session" className="flex flex-col gap-4">
            <h2 id="create-session" class="text-lg text-ink-primary">Create a session</h2>
            <form method="POST" action={AGENT_ACCESS_PATH} class="grid gap-4 sm:grid-cols-2">
              <input type="hidden" name="action" value="create" />
              <TextField
                label="Label"
                name="label"
                required
                maxLength={50}
                autoComplete="off"
                defaultValue={kept.label}
                error={fieldErrors.label}
                hint="What uses it, so you know which one to revoke: letters, numbers, spaces, dots, underscores and hyphens, up to 50."
              />
              <SelectField
                label="Lasts for"
                name="duration"
                options={AGENT_LIFETIME_OPTIONS}
                defaultValue={kept.duration}
                error={fieldErrors.duration}
                hint="As short as the check needs."
              />
              <div class="sm:col-span-2">
                <Button type="submit" variant="primary">Create session</Button>
              </div>
            </form>
          </Card>

          <section aria-labelledby="your-sessions" class="flex flex-col gap-4">
            <h2 id="your-sessions" class="text-lg text-ink-primary">Your sessions</h2>

            {toRevoke && (
              <ConfirmStep
                title={`Revoke “${toRevoke.label}”?`}
                confirmLabel="Revoke session"
                cancelHref={withoutConfirm(Astro.url)}
                action={AGENT_ACCESS_PATH}
                fields={{ action: "revoke", sessionId: toRevoke.id }}
              >
                Anything using it is signed out at once. Make a new session if you need one again.
              </ConfirmStep>
            )}

            <DataTable
              caption="Your sessions"
              columns={[{ label: "Label" }, { label: "Created" }, { label: "Expires" }, { label: "Status" }, { label: "Action", align: "end" }]}
              isEmpty={rows.length === 0}
            >
              {rows.map((session) => (
                <DataRow current={session.id === toRevoke?.id}>
                  <DataCell label="Label" primary>
                    {session.label}
                  </DataCell>
                  <DataCell label="Created">{formatMomentDateTime(session.createdAt)}</DataCell>
                  <DataCell label="Expires">{formatMomentDateTime(session.expiresAt)}</DataCell>
                  <DataCell label="Status">
                    <StatusChip domain="token" status={session.status} />
                  </DataCell>
                  <DataCell label="Action" align="end">
                    {session.status === "ACTIVE" ? (
                      <RowAction href={confirmHref(Astro.url, revokeSessionAction(session.id))} row={session.label}>Revoke</RowAction>
                    ) : (
                      <span class="text-ink-secondary">None</span>
                    )}
                  </DataCell>
                </DataRow>
              ))}
              <Fragment slot="empty">
                <EmptyState title="No sessions yet" headingLevel={3}>
                  Sessions you create appear here, with when they stop working.
                </EmptyState>
              </Fragment>
            </DataTable>
          </section>
        </>
      )
    }
  </div>

  {
    created && (
      <script>
        for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-secret]")) {
          button.addEventListener("click", async () => {
            const secret = document.getElementById(button.dataset.copySecret ?? "")?.textContent?.trim();
            if (secret) await navigator.clipboard.writeText(secret);
          });
        }
      </script>
    )
  }
</AdminLayout>
