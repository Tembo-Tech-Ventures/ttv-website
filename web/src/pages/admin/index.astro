---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Card from "@/components/common/Card.astro";
import { drizzle } from "drizzle-orm/d1";
import * as schema from "@/lib/db/schema";
import { count, eq } from "drizzle-orm";
import { env } from "cloudflare:workers";
import { getAdminAttention } from "@/lib/admin/attention";

const db = drizzle(env.DB, { schema });

const [usersResult] = await db.select({ value: count() }).from(schema.user);
const [programsResult] = await db.select({ value: count() }).from(schema.program);

const statusCounts = await db
  .select({ status: schema.programApplication.status, value: count() })
  .from(schema.programApplication)
  .groupBy(schema.programApplication.status);

const totalApps = statusCounts.reduce((sum, r) => sum + r.value, 0);
const byStatus = Object.fromEntries(statusCounts.map((r) => [r.status, r.value]));

const [profilesInReview] = await db
  .select({ value: count() })
  .from(schema.studentProfile)
  .where(eq(schema.studentProfile.status, "IN_REVIEW"));

const [pendingProjects] = await db
  .select({ value: count() })
  .from(schema.clientProject)
  .where(eq(schema.clientProject.status, "PENDING"));

const attentionGroups = (await getAdminAttention(env.DB)).filter(
  (group) => group.items.length > 0
);

const formatAttentionDate = (value: string) =>
  new Intl.DateTimeFormat("en", {
    dateStyle: "medium",
    timeStyle: "short",
    timeZone: "UTC",
  }).format(new Date(value));
---

<AdminLayout title="Dashboard">
  <div class="space-y-6">
    <h2 class="text-2xl font-bold text-white">Dashboard</h2>

    <section aria-labelledby="attention-heading" class="space-y-4">
      <div>
        <h3 id="attention-heading" class="text-lg font-semibold text-white">
          Attention
        </h3>
        <p class="mt-1 text-sm text-ink-secondary">
          Recent failures and work that has waited beyond its review window.
        </p>
      </div>

      {
        attentionGroups.length === 0 ? (
          <Card>
            <p class="text-sm text-ink-secondary">Nothing needs attention.</p>
          </Card>
        ) : (
          <div class="space-y-4">
            {attentionGroups.map((group) => (
              <Card>
                <div id={`attention-${group.id}`}>
                  <h4 class="font-semibold text-white">{group.label}</h4>
                  <ul class="mt-3 divide-y divide-white/10">
                    {group.items.map((item) => (
                      <li class="py-3 first:pt-0 last:pb-0">
                        <a
                          href={item.href}
                          class="group block rounded-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
                        >
                          <span class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                            <span class="font-medium text-white group-hover:text-primary">
                              {item.title}
                            </span>
                            <time
                              datetime={item.occurredAt}
                              class="shrink-0 text-xs text-ink-secondary"
                            >
                              {formatAttentionDate(item.occurredAt)} UTC
                            </time>
                          </span>
                          <span class="mt-1 block text-sm text-ink-secondary">
                            {item.detail}
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </Card>
            ))}
          </div>
        )
      }
    </section>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <Card>
        <p class="text-sm text-ink-secondary">Total Users</p>
        <p class="mt-1 text-3xl font-bold text-primary">{usersResult.value}</p>
      </Card>
      <Card>
        <p class="text-sm text-ink-secondary">Total Applications</p>
        <p class="mt-1 text-3xl font-bold text-primary">{totalApps}</p>
      </Card>
      <Card>
        <p class="text-sm text-ink-secondary">Total Programs</p>
        <p class="mt-1 text-3xl font-bold text-primary">{programsResult.value}</p>
      </Card>
    </div>

    <h3 class="text-lg font-semibold text-white">Review Queues</h3>
    <div class="grid gap-4 sm:grid-cols-2">
      <Card>
        <p class="text-sm text-ink-secondary">Profiles awaiting review</p>
        <p class="mt-1 text-3xl font-bold text-primary">
          {profilesInReview.value}
        </p>
        <a
          href="/admin/profiles?status=IN_REVIEW"
          class="mt-2 inline-block text-sm text-primary hover:underline"
        >
          View queue &rarr;
        </a>
      </Card>
      <Card>
        <p class="text-sm text-ink-secondary">Pending client projects</p>
        <p class="mt-1 text-3xl font-bold text-primary">
          {pendingProjects.value}
        </p>
        <a
          href="/admin/projects?status=PENDING"
          class="mt-2 inline-block text-sm text-primary hover:underline"
        >
          View queue &rarr;
        </a>
      </Card>
    </div>

    <h3 class="text-lg font-semibold text-white">Applications by Status</h3>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {["PENDING", "APPROVED", "REJECTED", "AUDIT", "COMPLETED"].map((status) => (
        <Card>
          <p class="text-sm text-ink-secondary capitalize">{status.toLowerCase()}</p>
          <p class="mt-1 text-2xl font-bold text-white">{byStatus[status] ?? 0}</p>
        </Card>
      ))}
    </div>
  </div>
</AdminLayout>
