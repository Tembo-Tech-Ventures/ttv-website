---
/**
 * Dev-only harness for the admin/dashboard shell chrome.
 *
 * The real shells only render behind auth, so their layout behaviour was
 * previously only observable in a deployed preview. This renders the actual
 * `AdminShell` with enough filler to overflow any viewport, so the e2e suite
 * can assert that the sidebar and header stay put while the page scrolls —
 * locally, with no credentials.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import AdminShell from "@/components/shells/AdminShell";

if (!import.meta.env.DEV) {
  return new Response("Not found", { status: 404 });
}

const rows = Array.from({ length: 60 }, (_, index) => index + 1);
---

<BaseLayout title="Shell preview | TTV">
  <AdminShell client:load>
    <h2 class="text-2xl font-bold text-white">Shell scroll harness</h2>
    <p class="mt-1 text-sm text-ink-secondary">
      Filler tall enough to scroll. The sidebar and header should not move.
    </p>
    <ul class="mt-6 space-y-3">
      {
        rows.map((row) => (
          <li
            data-filler-row={row}
            class="rounded-lg border border-rule bg-dark/40 px-4 py-3 text-sm text-ink-secondary"
          >
            Row {row}
          </li>
        ))
      }
    </ul>
  </AdminShell>
</BaseLayout>

<style is:global>
  astro-dev-toolbar {
    display: none !important;
  }
</style>
