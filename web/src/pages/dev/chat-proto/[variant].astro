---
/**
 * Dev-only layout prototypes for the full-page chat experience.
 *
 * `/dev/chat-proto/a` | `/b` | `/c` — see the components for what each explores.
 * These render mock data only; they never touch D1, Vectorize or the AI binding,
 * which is what makes them safe to screenshot deterministically.
 */
import ChatLayout from "@/layouts/ChatLayout.astro";
import PrototypeA from "@/components/chat/prototype/PrototypeA";
import PrototypeB from "@/components/chat/prototype/PrototypeB";
import PrototypeC from "@/components/chat/prototype/PrototypeC";

if (!import.meta.env.DEV) {
  return new Response("Not found", { status: 404 });
}

const VARIANTS = {
  a: { title: "Prototype A — Takeover bar" },
  b: { title: "Prototype B — Icon rail, no header" },
  c: { title: "Prototype C — Thumb-first bottom sheet" },
} as const;

type VariantKey = keyof typeof VARIANTS;

const { variant } = Astro.params;

function isVariant(value: string | undefined): value is VariantKey {
  return value === "a" || value === "b" || value === "c";
}

if (!isVariant(variant)) {
  return new Response("Not found", { status: 404 });
}

const { title } = VARIANTS[variant];
---

<ChatLayout title={`${title} | TTV`}>
  {variant === "a" && <PrototypeA client:load />}
  {variant === "b" && <PrototypeB client:load />}
  {variant === "c" && <PrototypeC client:load />}
</ChatLayout>

<style is:global>
  astro-dev-toolbar {
    display: none !important;
  }
</style>
