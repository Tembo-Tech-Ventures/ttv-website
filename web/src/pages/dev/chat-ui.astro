---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ChatInterface from "@/components/recordings/ChatInterface";

if (!import.meta.env.DEV) {
  return new Response("Not found", { status: 404 });
}

const sessions = [
  {
    id: "mock-session-1",
    title: "Customer discovery next steps",
    updatedAt: 1_800_000_000,
    messageCount: 4,
    latestMessage: "Validate the problem with short customer interviews before building.",
  },
  {
    id: "mock-session-2",
    title: "Architecture tradeoffs",
    updatedAt: 1_799_996_400,
    messageCount: 6,
    latestMessage: "Keep the implementation simple until the retrieval quality is proven.",
  },
];

const messages = [
  {
    role: "user",
    content: "What should students do before building the MVP?",
  },
  {
    role: "assistant",
    content:
      "Students should validate the problem before building the MVP. The practical sequence is:\n\n- Run short customer interviews.\n- Look for repeated pain points rather than isolated opinions.\n- Narrow the MVP to the smallest testable workflow. [1]\n\nThis answer cleans up transcript phrasing where speech-to-text likely misheard punctuation or capitalization.",
    citations: [
      {
        sourceNumber: 1,
        recordingId: "recording-1",
        title: "Mentor Hours: Customer Discovery",
        startTime: 384,
        endTime: 431,
        url: "/dashboard/sessions/recording-1?t=384",
        text: "Before you build, talk to customers and check whether this is a repeated problem they already try to solve.",
      },
      {
        sourceNumber: 2,
        recordingId: "recording-2",
        title: "Technical Architecture Workshop",
        startTime: 1020,
        endTime: 1084,
        url: "/dashboard/sessions/recording-2?t=1020",
        text: "The MVP should prove the riskiest assumption first, not include every planned feature.",
      },
    ],
  },
] as const;
---

<BaseLayout title="Chat UI Mock | TTV">
  <main class="min-h-screen bg-dark px-4 py-6 sm:px-6 sm:py-8 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="mb-6">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary">
          Dev preview
        </p>
        <h1 class="mt-2 text-2xl font-bold text-white sm:text-3xl">
          Transcript chat UI
        </h1>
      </div>
      <ChatInterface
        client:load
        mockMode
        initialSessions={sessions}
        initialMessages={messages}
      />
    </div>
  </main>
</BaseLayout>

<style is:global>
  astro-dev-toolbar {
    display: none !important;
  }
</style>
