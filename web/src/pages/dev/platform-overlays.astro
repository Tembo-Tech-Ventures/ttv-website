---
/**
 * Dev-only harness for the attention and search overlays (U-1.3).
 *
 * Renders SpacesLayout with the real overlays, answering from fixtures:
 * `?persona=wanjiku&space=community&scenario=slow`. `?page=attention` renders
 * the attention page instead of a filler page. Scenarios (harness-clients.ts):
 * default, slow, empty, many, error, readfail, expired, off, arrivals.
 *
 * Nothing here is reachable outside `astro dev`. `e2e/platform-overlays.spec.ts`
 * holds the browser contract.
 */
import type { SpaceId } from "@/lib/platform/contracts";
import { SpaceId as SpaceIdSchema } from "@/lib/platform/contracts";
import { FIXTURE_NOTICE } from "@/lib/platform/fixtures";
import SpacesLayout from "@/layouts/SpacesLayout.astro";
import HarnessSidebar from "@/components/platform/shell/harness/HarnessSidebar.astro";
import { HARNESS_PERSONAS, isHarnessPersona } from "@/components/platform/shell/harness/personas";
import { canRenderSpace } from "@/components/platform/shell/access";
import { SPACE_LABEL } from "@/components/platform/shell/space-routes";
import AttentionPage from "@/components/platform/attention/AttentionPage";
import PlatformOverlays from "@/components/platform/overlays/PlatformOverlays";
import { harnessAttentionPage, isHarnessScenario } from "@/components/platform/overlays/harness-clients";

if (!import.meta.env.DEV) {
  return new Response("Not found", { status: 404 });
}

const params = Astro.url.searchParams;
const personaParam = params.get("persona");
const persona = isHarnessPersona(personaParam) ? personaParam : "wanjiku";
const me = HARNESS_PERSONAS[persona];
const requested = SpaceIdSchema.safeParse(params.get("space"));
const space: SpaceId = requested.success && me.spaces.includes(requested.data) ? requested.data : me.spaces[0];
if (!canRenderSpace(me, space)) {
  return new Response("Not found", { status: 404 });
}

const scenarioParam = params.get("scenario");
const scenario = isHarnessScenario(scenarioParam) ? scenarioParam : "default";
const attentionPage = params.get("page") === "attention";
const keep = `&scenario=${scenario}${attentionPage ? "&page=attention" : ""}`;
const spaceHrefs = Object.fromEntries(
  me.spaces.map((id) => [id, `/dev/platform-overlays?persona=${persona}&space=${id}${keep}`]),
) as Record<SpaceId, string>;
const rows = Array.from({ length: 18 }, (_, index) => index + 1);
const harness = { account: { signOut: { kind: "link", href: "#signed-out", label: "Sign out" }, feedback: true }, spaceHrefs } as const;
---

{
  attentionPage ? (
    <SpacesLayout me={me} space={space} title="Attention" overlays={["search", "attention"]} harness={harness}>
      <AttentionPage client:load me={me} initialList={harnessAttentionPage(scenario)} harness={scenario} />
      <PlatformOverlays slot="overlays" client:load me={me} attention={false} harness={scenario} />
    </SpacesLayout>
  ) : (
    <SpacesLayout me={me} space={space} title={SPACE_LABEL[space]} overlays={["search", "attention"]} harness={harness}>
      <HarnessSidebar slot="sidebar" space={space} />
      <article class="max-w-3xl" data-harness-page={space}>
        <h1 class="text-4xl tracking-heading text-ink-primary sm:text-5xl">{SPACE_LABEL[space]}</h1>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-secondary sm:text-lg">
          {me.user.name}'s {SPACE_LABEL[space]} space, with the real search and attention overlays answering from
          fixtures ({scenario}).
        </p>
        <p class="mt-3 text-sm text-ink-muted">{FIXTURE_NOTICE}</p>
        <ul class="mt-10 flex flex-col gap-3" aria-label="Filler rows">
          {
            rows.map((row) => (
              <li class="rounded-2xl border border-hairline bg-ink-primary/4 px-5 py-4 text-ink-secondary">
                Row {row}: enough content to scroll the page inside the sheet.
              </li>
            ))
          }
        </ul>
      </article>
      <PlatformOverlays slot="overlays" client:load me={me} harness={scenario} />
    </SpacesLayout>
  )
}

<style is:global>
  astro-dev-toolbar {
    display: none !important;
  }
</style>
