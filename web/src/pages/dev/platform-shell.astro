---
/**
 * Dev-only harness for the spaces shell (U-1.1).
 *
 * Renders SpacesLayout itself for a synthetic persona and space:
 * `?persona=wanjiku&space=cohort`. The tabs and bottom bar link back here, so
 * switching spaces, the drawer, the account menu and the overlay triggers can
 * be exercised without a session. `?bare` drops the sidebar; `?overlays=none`
 * mounts no overlays, as production pages do until U-1.3.
 *
 * Nothing here is reachable outside `astro dev`. `e2e/platform-shell.spec.ts`
 * holds the browser contract.
 */
import type { SpaceId } from "@/lib/platform/contracts";
import { SpaceId as SpaceIdSchema } from "@/lib/platform/contracts";
import SpacesLayout from "@/layouts/SpacesLayout.astro";
import HarnessSidebar from "@/components/platform/shell/harness/HarnessSidebar.astro";
import StubOverlays from "@/components/platform/shell/harness/StubOverlays";
import { harnessHref, HARNESS_PERSONAS, isHarnessPersona } from "@/components/platform/shell/harness/personas";
import { canRenderSpace } from "@/components/platform/shell/access";
import { SPACE_LABEL } from "@/components/platform/shell/space-routes";
import { FIXTURE_NOTICE } from "@/lib/platform/fixtures";
import type { ShellOverlay } from "@/components/platform/shell/overlays";

if (!import.meta.env.DEV) {
  return new Response("Not found", { status: 404 });
}

const params = Astro.url.searchParams;
const personaParam = params.get("persona");
const persona = isHarnessPersona(personaParam) ? personaParam : "wanjiku";
const me = HARNESS_PERSONAS[persona];
const requested = SpaceIdSchema.safeParse(params.get("space"));
const space: SpaceId = requested.success && me.spaces.includes(requested.data) ? requested.data : me.spaces[0];
if (!canRenderSpace(me, space)) {
  return new Response("Not found", { status: 404 });
}

const bare = params.has("bare");
const overlays: ShellOverlay[] = params.get("overlays") === "none" ? [] : ["search", "attention"];
const keep = `${bare ? "&bare" : ""}${overlays.length > 0 ? "" : "&overlays=none"}`;
const spaceHrefs = Object.fromEntries(me.spaces.map((id) => [id, harnessHref(persona, id, keep)])) as Record<SpaceId, string>;
const rows = Array.from({ length: 24 }, (_, index) => index + 1);
---

<SpacesLayout
  me={me}
  space={space}
  title={SPACE_LABEL[space]}
  overlays={overlays}
  harness={{ account: { signOut: { kind: "link", href: "#signed-out", label: "Sign out" }, feedback: true }, spaceHrefs }}
>
  {!bare && <HarnessSidebar slot="sidebar" space={space} />}
  <article class="max-w-3xl" data-harness-page={space}>
    <h1 class="text-4xl tracking-heading text-ink-primary sm:text-5xl">{SPACE_LABEL[space]}</h1>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-secondary sm:text-lg">
      {me.user.name}'s {SPACE_LABEL[space]} space. The page content arrives with U-1.2; this harness shows the shell
      around it.
    </p>
    <p class="mt-3 text-sm text-ink-muted">{FIXTURE_NOTICE}</p>
    <ul class="mt-10 flex flex-col gap-3" aria-label="Filler rows">
      {
        rows.map((row) => (
          <li data-filler-row={row} class="rounded-2xl border border-hairline bg-ink-primary/4 px-5 py-4 text-ink-secondary">
            Row {row}: enough content to scroll the page inside the sheet.
          </li>
        ))
      }
    </ul>
  </article>
  {overlays.length > 0 && <StubOverlays slot="overlays" client:load />}
</SpacesLayout>

<style is:global>
  astro-dev-toolbar {
    display: none !important;
  }
</style>
