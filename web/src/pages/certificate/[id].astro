---
import CertificateLayout from "@/layouts/CertificateLayout.astro";
import CertificateDocument from "@/components/certificate/CertificateDocument.astro";
import CertificateCredential from "@/components/certificate/CertificateCredential.astro";
import CertificateCredentialLight from "@/components/certificate/CertificateCredentialLight.astro";
import CertificateEditorial from "@/components/certificate/CertificateEditorial.astro";
import { drizzle } from "drizzle-orm/d1";
import * as schema from "@/lib/db/schema";
import { eq, and } from "drizzle-orm";
import { env } from "cloudflare:workers";
import { isValidCompletion } from "@/lib/talent/eligibility";
import { buildCertificateView } from "@/lib/certificate/view-model";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/");
}

const db = drizzle(env.DB, { schema });

const application = await db.query.programApplication.findFirst({
  where: eq(schema.programApplication.id, id),
  with: {
    user: true,
    program: {
      with: {
        curriculum: true,
        programRoles: {
          with: { user: true },
        },
      },
    },
  },
});

const isValid = isValidCompletion(application) && Boolean(application.program);

if (!isValid) {
  Astro.response.status = 404;
}

const publishedProfile =
  isValid && application?.user
    ? await db.query.studentProfile.findFirst({
        where: and(
          eq(schema.studentProfile.userId, application.user.id),
          eq(schema.studentProfile.status, "PUBLISHED")
        ),
        columns: { handle: true },
      })
    : undefined;

const view =
  isValid && application
    ? buildCertificateView({
        source: application,
        profileHandle: publishedProfile?.handle,
        verifyUrl: new URL(
          Astro.url.pathname,
          Astro.site ?? Astro.url.origin
        ).toString(),
      })
    : null;

// TEMPORARY (design exploration): lets the three candidate treatments be
// previewed side by side. Removed once a direction is chosen.
const variant = Astro.url.searchParams.get("variant") ?? "document";
---

<CertificateLayout
  title={view ? `Certificate - ${view.studentName}` : "Certificate Not Found"}
>
  {!view ? (
    <main class="not-found">
      <h1>Certificate not available</h1>
      <p>This certificate does not exist or has not yet been issued.</p>
      <a href="/">Back to Tembo Tech Ventures</a>
    </main>
  ) : variant === "credential" ? (
    <CertificateCredential view={view} />
  ) : variant === "light-dark-backdrop" ? (
    <CertificateCredentialLight view={view} backdrop="dark" />
  ) : variant === "light-warm-backdrop" ? (
    <CertificateCredentialLight view={view} backdrop="light" />
  ) : variant === "editorial" ? (
    <CertificateEditorial view={view} />
  ) : (
    <CertificateDocument view={view} />
  )}
</CertificateLayout>

<style>
  .not-found {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 2rem 1.5rem;
    text-align: center;
    background: var(--color-dark);
  }

  .not-found h1 {
    font-family: var(--font-body);
    font-size: clamp(1.375rem, 5vw, 1.75rem);
    font-weight: 700;
    color: var(--color-ink-primary);
  }

  .not-found p {
    color: var(--color-ink-secondary);
  }

  .not-found a {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
  }
</style>
