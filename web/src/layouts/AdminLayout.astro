---
import BaseLayout from "./BaseLayout.astro";
import AdminShell from "@/components/shells/AdminShell";
import { env } from "cloudflare:workers";
import { demoEnabled } from "@/lib/staging-demo-policy";
import { isAgentAuthEnabled } from "@/lib/agent-auth";
import { isLegacyImportEnabled } from "@/lib/admin/import";
import { countPendingAccessRequests } from "@/lib/admin/access-requests";
import { countPendingModeration } from "@/lib/channels/moderation/queue";
import { countOpenChecks } from "@/lib/mentoring/checks";
import { isFlagEnabled } from "@/lib/platform/server/flags";

interface Props {
  title?: string;
  /** The queue page already holds the open-request count; every other page reads it here. */
  pendingAccessRequests?: number;
  /** The moderation page (channels on) already holds its waiting count; every other page reads it here. */
  pendingModeration?: number;
  /** Open checks on request notes, when the page already counted them (moderation, Admin Home). */
  pendingRequestNotes?: number;
}

const { title = "Admin" } = Astro.props;

// Defense-in-depth: redirect if middleware didn't set isAdmin
if (!Astro.locals.isAdmin) {
  return Astro.redirect(Astro.locals.user ? "/dashboard" : "/auth/login");
}

const pendingAccessRequests = Astro.props.pendingAccessRequests ?? await countPendingAccessRequests(env.DB);
// No Moderation entry (null) while `channels` is off for this admin: there is no queue to link to.
// The moderation page has already checked the flag and counted the queue. Its badge also counts the
// open request-note checks this admin may decide while `mentor_requests` is on (QA4-04), which the
// Request notes tab lists; the sidebar adds them, so the queue's in-place count stays its own.
const viewerId = Astro.locals.user?.id ?? "";
const flagContext = { db: env.DB, env, user: Astro.locals.user ?? null, isAdmin: true, locals: Astro.locals };
const channelsOn = Astro.props.pendingModeration !== undefined || await isFlagEnabled(flagContext, "channels");
const [pendingModeration, pendingRequestNotes] = channelsOn
  ? await Promise.all([
    Astro.props.pendingModeration ?? countPendingModeration(env.DB, viewerId),
    Astro.props.pendingRequestNotes ?? (await isFlagEnabled(flagContext, "mentor_requests") ? countOpenChecks(env.DB, viewerId) : 0),
  ])
  : [null, 0];
---

<BaseLayout title={`${title} | TTV Admin`}>
  <AdminShell
    client:load
    currentPath={Astro.url.pathname}
    agentAuthEnabled={isAgentAuthEnabled(env.AGENT_AUTH_ENABLED)}
    stagingDemoEnabled={demoEnabled(env.DEPLOYMENT_ENVIRONMENT, env.STAGING_DEMO_ENABLED, Astro.url.origin)}
    dataMigrationEnabled={isLegacyImportEnabled(env.DEPLOYMENT_ENVIRONMENT)}
    pendingAccessRequests={pendingAccessRequests}
    pendingModeration={pendingModeration}
    pendingRequestNotes={pendingRequestNotes}
  >
    <slot />
  </AdminShell>
</BaseLayout>
