---
/**
 * The frame around an admin page.
 *
 * A page that has moved into the spaces shell resolves its context and hands it in
 * (`spaces`): while the `spaces` flag is on for this admin, it renders inside the Admin space,
 * with the space tabs, search and the bell, and the admin navigation as the space's sidebar
 * (T02). Without a context (the flag is off for them, a personal access token, or a failed context
 * load) it renders in PlainFrame with the same admin navigation as its sidebar, built without any
 * per-user context (decision D2). The middleware's ADMIN guard runs first either way, and is unchanged.
 *
 *   const spaces = await resolveSpacePage(Astro.locals, "moderation");
 *   <AdminLayout title="Moderation" spaces={spaces}>…</AdminLayout>
 *
 * After a rejected submit, `titlePrefix="Error: "` puts the failure in the tab title too.
 *
 * The page draws its own title, the screen's one h1, in either frame.
 */
import SpacePage from "@/components/platform/spaces/SpacePage.astro";
import PlainFrame from "@/components/platform/spaces/PlainFrame.astro";
import SpaceSidebar from "@/components/platform/spaces/SpaceSidebar.astro";
import { ADMIN_SPACE_PAGES, adminSidebar } from "@/components/platform/spaces/sidebar";
import { adminSectionFor } from "@/components/admin/admin-nav";
import type { SpacePageContext } from "@/components/platform/spaces/space-page";
import { loadAdminNavFacts } from "@/components/admin/admin-nav-server";

interface Props {
  title?: string;
  /** Said before the title in the tab: "Error: " after a rejected submit, so the tab says it too. */
  titlePrefix?: string;
  /** The queue page already holds the open-request count; every other page reads it here. */
  pendingAccessRequests?: number;
  /** The moderation page (channels on) already holds its waiting count; every other page reads it here. */
  pendingModeration?: number;
  /** Open checks on request notes, when the page already counted them (moderation, Admin Home). */
  pendingRequestNotes?: number;
  /** The Admin space, for a page drawn in the spaces shell; null or absent draws the plain frame. */
  spaces?: SpacePageContext | null;
}

const { title = "Admin", titlePrefix = "", spaces = null } = Astro.props;

// Defense-in-depth: redirect if middleware didn't set isAdmin
if (!Astro.locals.isAdmin) {
  return Astro.redirect(Astro.locals.user ? "/dashboard" : "/auth/login");
}

const nav = await loadAdminNavFacts(Astro.locals, Astro.url, {
  pendingAccessRequests: Astro.props.pendingAccessRequests,
  pendingModeration: Astro.props.pendingModeration,
  pendingRequestNotes: Astro.props.pendingRequestNotes,
});
const inSpaces = spaces?.space === "admin";
const section = adminSectionFor(Astro.url.pathname);
const sidebar = inSpaces ? null : adminSidebar(section ? ADMIN_SPACE_PAGES[section] : undefined, nav);
---

{
  inSpaces ? (
    <SpacePage context={spaces} title={title} titlePrefix={titlePrefix} admin={nav}>
      <div class="pb-16" data-admin-space data-request-notes={nav.pendingRequestNotes}>
        <slot />
      </div>
    </SpacePage>
  ) : (
    <PlainFrame title={title} titlePrefix={titlePrefix} space="admin">
      {sidebar && <SpaceSidebar slot="sidebar" model={sidebar} />}
      <div class="pb-16" data-admin-space data-request-notes={nav.pendingRequestNotes}>
        <slot />
      </div>
    </PlainFrame>
  )
}

<script>
  import { followModerationBadge } from "@/components/admin/moderation/sidebar-badge";

  // The sidebar's Moderation count follows the queue, in the spaces shell and in the plain frame alike.
  const space = document.querySelector<HTMLElement>("[data-admin-space]");
  if (space) followModerationBadge(document, Number(space.dataset.requestNotes) || 0);
</script>
