---
/**
 * A chrome-free shell for routes that should own the whole viewport.
 *
 * Used by the two routes where the app gets out of the way — Ask AI and the
 * post editor. Both put a fixed control strip against the bottom of the screen
 * above a keyboard, which is the whole reason this layout exists.
 *
 * It deliberately does not extend BaseLayout: these pages need a different
 * viewport meta (`viewport-fit=cover` so a bottom bar can pad past the iOS home
 * indicator, `interactive-widget=resizes-content` so the on-screen keyboard
 * shrinks the layout instead of sliding it out from under the browser) and a
 * document that cannot scroll at all. Everything inside is sized against
 * `100dvh`, so the only scrolling region is whichever child declares it.
 */
import "@/styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="h-full overflow-hidden overscroll-none bg-dark">
    <div class="immersive-viewport flex flex-col bg-gradient-to-br from-surface to-dark">
      {/* Children are flex items in a container of definite height: any child
          that wants to scroll needs `min-h-0 flex-1` plus `overflow-y-auto`. */}
      <slot />
    </div>

    <style>
      html {
        overscroll-behavior: none;
      }

      .immersive-viewport {
        /*
         * `svh` first as the safe fallback — plain `vh` is `lvh`, sized as if
         * the browser chrome were retracted, which is what pushes a bottom bar
         * below the fold on a phone. `dvh` then wins wherever it is supported.
         * Nothing here scrolls the document, so `dvh` resolves once and does
         * not thrash layout the way it would on a scrolling page.
         */
        height: 100svh;
        height: 100dvh;
        /* Keyboard inset, measured from visualViewport by the script below. */
        padding-bottom: var(--keyboard-inset, 0px);
      }
    </style>

    <script>
      /*
       * The keyboard is the one part of this that CSS cannot carry alone. Under
       * the default `interactive-widget=resizes-visual`, `100dvh` does NOT
       * shrink when the on-screen keyboard opens, so the bottom bar ends up
       * underneath it. `interactive-widget=resizes-content` in the viewport meta
       * fixes Chrome Android and Firefox; WebKit has not implemented it
       * (bugs.webkit.org #259770 is still open), so iOS needs the measurement
       * below.
       *
       * Deliberately NOT opting into the VirtualKeyboard API: setting
       * `overlaysContent = true` overrides `interactive-widget` on Chromium,
       * trading a mechanism that already works there for one that depends on
       * `env(keyboard-inset-height)` resolving — which it does not in every
       * embedded WebView. Where `interactive-widget` is honoured the layout
       * viewport shrinks with the keyboard, so the measurement below reads ~0
       * and this costs nothing.
       */
      const viewport = window.visualViewport;
      if (viewport) {
        const root = document.documentElement;
        const sync = () => {
          // Pinch-zoom also shrinks the visual viewport. Measuring it as a
          // keyboard would crush the layout to half height on a zoomed page.
          const inset =
            viewport.scale > 1
              ? 0
              : Math.max(0, window.innerHeight - (viewport.height + viewport.offsetTop));
          root.style.setProperty("--keyboard-inset", `${inset}px`);
        };
        viewport.addEventListener("resize", sync);
        viewport.addEventListener("scroll", sync);
        // iOS has shipped builds where offsetTop does not settle back to 0 on
        // dismiss, so re-measure after the blur has actually landed.
        window.addEventListener("focusout", () => requestAnimationFrame(sync));
        sync();
      }
    </script>
  </body>
</html>
