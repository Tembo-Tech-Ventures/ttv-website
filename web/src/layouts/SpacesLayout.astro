---
/**
 * The spaces shell, for pages that belong to a space (Cohort, Community,
 * Mentoring, Discover, Admin, Profile).
 *
 * The page resolves its context first and hands it in:
 *
 *   const me = await getSpaceContext(Astro);          // 404 on flag_off
 *   if (!canRenderSpace(me, "community")) return notFound;
 *   <SpacesLayout me={me} space="community" title="What's new">
 *     <Fragment slot="sidebar">…SidebarHeader, SidebarGroup, SidebarLink…</Fragment>
 *     …the page, with its one Mattone h1…
 *   </SpacesLayout>
 *
 * It refuses to render a space the person cannot open, or any space while the
 * `spaces` flag is off for them, so a page that forgets its guard fails loudly
 * instead of showing a shell that does not exist yet.
 *
 * Only the `Me` contract and the parsed `ttv-last-space` value reach the
 * island. The Cookie header, the session and auth objects never do: Astro
 * serialises island props into the HTML.
 *
 * Like ImmersiveLayout, the document itself never scrolls: the frame is one
 * viewport tall and the sidebar and page scroll inside the sheet.
 */
import "@/styles/global.css";
import type { Me, SpaceId } from "@/lib/platform/contracts";
import { readLastSpaceCookie } from "@/lib/platform/client/spaces-selection";
import ClientErrorBuffer from "@/components/feedback/ClientErrorBuffer.astro";
import FeedbackWidget from "@/components/feedback/FeedbackWidget";
import { PersonFooter } from "@/components/platform/shell/SpacesShell";
import SpacesChrome from "@/components/platform/shell/SpacesChrome";
import { ClientRouter } from "astro:transitions";
import { PiX } from "react-icons/pi";
import { canRenderSpace } from "@/components/platform/shell/access";
import type { ShellAccount } from "@/components/platform/shell/AccountMenu";
import type { ShellOverlay } from "@/components/platform/shell/overlays";
import { SPACE_LABEL } from "@/components/platform/shell/space-routes";
import { shellAccount } from "@/components/platform/shell/account";
import SheetTransition from "@/components/platform/shell/SheetTransition.astro";
import { pageTitle } from "@/lib/seo";

interface Props {
  me: Me;
  space: SpaceId;
  /** The page's own name, for the tab title and the phone's top bar. */
  title: string;
  /** Prepended to the tab title only, never the visible bar: "Error: " after a rejected form. */
  titlePrefix?: string;
  /** A page of its own, shown in `space` without belonging to it (Attention): the phone's bar marks no space current (T12). */
  outsideSpaces?: boolean;
  /** Overlay islands the page mounts in the `overlays` slot; their triggers appear in the top bar. */
  overlays?: readonly ShellOverlay[];
  /** Fixture harnesses only: they live outside the preference cookie's path and have no session. */
  harness?: { account: ShellAccount; spaceHrefs: Readonly<Record<SpaceId, string>> };
}

const { me, space, outsideSpaces = false, title, titlePrefix = "", overlays = [], harness } = Astro.props;

if (!canRenderSpace(me, space)) {
  throw new Error(`SpacesLayout: the ${space} space is not open to this person. Check canRenderSpace before rendering.`);
}

const signedIn = Boolean(Astro.locals.user);
const account: ShellAccount = harness?.account ?? shellAccount(Astro.locals);
// Parsed here, on the server: the island gets a SpaceId or null, never the header.
const lastSpace = readLastSpaceCookie(Astro.request.headers.get("cookie"));
const shell = {
  me,
  space,
  outsideSpaces,
  lastSpace,
  heading: title,
  account,
  overlays,
  persistPreference: !harness,
  spaceHrefs: harness?.spaceHrefs,
  hasSidebar: Astro.slots.has("sidebar"),
};
const hasSidebar = shell.hasSidebar;
const sidebarLabel = `${SPACE_LABEL[space]} menu`;
// ARCH-1 spike: `?mpa` (or the ttv-arch=mpa cookie) turns the router off to compare in one build.
const router = !Astro.url.searchParams.has("mpa") && !(Astro.request.headers.get("cookie") ?? "").includes("ttv-arch=mpa");
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{pageTitle(titlePrefix + (title === SPACE_LABEL[space] ? title : `${title} · ${SPACE_LABEL[space]}`))}</title>
    {signedIn && <ClientErrorBuffer />}
    <SheetTransition sheet={`space:${space}`} />
    {router && <ClientRouter fallback="none" />}
    <style is:inline>
      /* ARCH-1 motion spike: tokens for the card-file gesture, and its click-time first beat. */
      :root {
        --motion-file-press: 180ms;
        --motion-file-rise: 250ms;
        --ease-file-rise: cubic-bezier(0.16, 0.9, 0.3, 1);
        --ease-file-settle: cubic-bezier(0.3, 0, 0.2, 1);
      }
      @media (prefers-reduced-motion: no-preference) {
        .spaces-shell .space-file > .platform-sheet {
          transition:
            filter var(--motion-file-press) var(--ease-file-settle),
            translate var(--motion-file-press) var(--ease-file-settle);
        }
        .spaces-shell[data-nav-pending]:not([data-nav-pending="page"]) .space-file > .platform-sheet {
          filter: brightness(0.9);
          translate: 0 0.375rem;
        }
        /* Within a space nothing moves; a slow answer only quiets the page after 150ms. */
        .spaces-shell[data-nav-pending="page"] #spaces-main {
          opacity: 0.72;
          transition: opacity 120ms linear 150ms;
        }
      }
    </style>
    <script>
      // ARCH-1 spike: T15's same-sheet skip, for soft navigations (pagereveal does not fire for them).
      document.addEventListener("astro:before-swap", (event) => {
        const from = document.querySelector<HTMLElement>(".spaces-shell")?.dataset.space;
        const to = event.newDocument.querySelector<HTMLElement>(".spaces-shell")?.dataset.space;
        if (from && from === to) event.viewTransition.skipTransition();
      });
      // Route-change focus, as a full load leaves it: unless the new page placed focus itself, the next
      // Tab reaches "Skip to content". The router's own announcer reads the new title.
      document.addEventListener("astro:page-load", () => {
        const active = document.activeElement;
        if (active && active !== document.body && !active.closest("[data-astro-transition-persist]")) return;
        document.getElementById("spaces-route-start")?.focus({ preventScroll: true });
      });
      // Timing for the spike's measurements: when the new page's h1 is in the DOM.
      document.addEventListener("astro:after-swap", () => {
        (window as unknown as { __archSwaps?: number }).__archSwaps = ((window as unknown as { __archSwaps?: number }).__archSwaps ?? 0) + 1;
      });
    </script>
  </head>
  <body class="h-full overflow-hidden overscroll-none bg-ground">
    {/* ARCH-1 spike: the chrome is two persisted islands; the sheet, sidebar and page are server HTML the router swaps. */}
    <div class="spaces-shell" data-space={space} data-sidebar={hasSidebar ? "" : undefined} data-drawer="closed">
      <span id="spaces-route-start" tabindex="-1" class="sr-only"></span>
      <a href="#spaces-main" class="spaces-shell__skip">Skip to content</a>
      <div class="space-file spaces-shell__file" data-space-file={space} data-tabs={me.spaces.length}>
        <SpacesChrome client:load transition:persist="spaces-chrome-row" {...shell} part="row" />
        <div data-sheet={space} data-space-tone={space} class="platform-sheet">
          <div class="spaces-shell__body">
            {
              hasSidebar && (
                <>
                  <div aria-hidden="true" class="spaces-shell__scrim" />
                  <aside id="space-sidebar" aria-label={sidebarLabel} tabindex="-1" class="spaces-shell__sidebar">
                    <a href="#spaces-main" data-drawer-close aria-label={`Close ${sidebarLabel}`} class="spaces-shell__close inline-grid size-10 place-items-center rounded-xl text-ink-secondary hover:bg-ink-primary/7 hover:text-ink-primary pointer-coarse:size-11">
                      <PiX aria-hidden="true" className="size-5" />
                    </a>
                    <div class="spaces-shell__sidebar-content"><slot name="sidebar" /></div>
                    <PersonFooter person={me.user} />
                  </aside>
                </>
              )
            }
            <main id="spaces-main" tabindex="0" class="spaces-shell__main">
              <slot />
            </main>
          </div>
        </div>
      </div>
      <SpacesChrome client:load transition:persist="spaces-chrome-bottom" {...shell} part="bottom" />
    </div>
    <slot name="overlays" />
    {
      /* No floating button: it would sit on the bottom bar. The account menu opens the form. */
      account.feedback && <FeedbackWidget client:idle transition:persist="feedback-widget" showLauncher={false} />
    }
  </body>
</html>

