---
/**
 * The spaces shell, for pages that belong to a space (Cohort, Community,
 * Mentoring, Discover, Admin, Profile).
 *
 * The page resolves its context first and hands it in:
 *
 *   const me = await getSpaceContext(Astro);          // 404 on flag_off
 *   if (!canRenderSpace(me, "community")) return notFound;
 *   <SpacesLayout me={me} space="community" title="What's new">
 *     <Fragment slot="sidebar">…SidebarHeader, SidebarGroup, SidebarLink…</Fragment>
 *     …the page, with its one Mattone h1…
 *   </SpacesLayout>
 *
 * It refuses to render a space the person cannot open, or any space while the
 * `spaces` flag is off for them, so a page that forgets its guard fails loudly
 * instead of showing a shell that does not exist yet.
 *
 * Only the `Me` contract and the parsed `ttv-last-space` value reach the
 * island. The Cookie header, the session and auth objects never do: Astro
 * serialises island props into the HTML.
 *
 * Like ImmersiveLayout, the document itself never scrolls: the frame is one
 * viewport tall and the sidebar and page scroll inside the sheet.
 */
import "@/styles/global.css";
import type { Me, SpaceId } from "@/lib/platform/contracts";
import { readLastSpaceCookie } from "@/lib/platform/client/spaces-selection";
import ClientErrorBuffer from "@/components/feedback/ClientErrorBuffer.astro";
import FeedbackWidget from "@/components/feedback/FeedbackWidget";
import SpacesShell from "@/components/platform/shell/SpacesShell";
import { canRenderSpace } from "@/components/platform/shell/access";
import type { ShellAccount } from "@/components/platform/shell/AccountMenu";
import type { ShellOverlay } from "@/components/platform/shell/overlays";
import { SPACE_LABEL } from "@/components/platform/shell/space-routes";
import { shellAccount } from "@/components/platform/shell/account";
import SheetTransition from "@/components/platform/shell/SheetTransition.astro";
import { pageTitle } from "@/lib/seo";

interface Props {
  me: Me;
  space: SpaceId;
  /** The page's own name, for the tab title and the phone's top bar. */
  title: string;
  /** Prepended to the tab title only, never the visible bar: "Error: " after a rejected form. */
  titlePrefix?: string;
  /** Overlay islands the page mounts in the `overlays` slot; their triggers appear in the top bar. */
  overlays?: readonly ShellOverlay[];
  /** Fixture harnesses only: they live outside the preference cookie's path and have no session. */
  harness?: { account: ShellAccount; spaceHrefs: Readonly<Record<SpaceId, string>> };
}

const { me, space, title, titlePrefix = "", overlays = [], harness } = Astro.props;

if (!canRenderSpace(me, space)) {
  throw new Error(`SpacesLayout: the ${space} space is not open to this person. Check canRenderSpace before rendering.`);
}

const signedIn = Boolean(Astro.locals.user);
const account: ShellAccount = harness?.account ?? shellAccount(Astro.locals);
// Parsed here, on the server: the island gets a SpaceId or null, never the header.
const lastSpace = readLastSpaceCookie(Astro.request.headers.get("cookie"));
const shell = {
  me,
  space,
  lastSpace,
  heading: title,
  account,
  overlays,
  persistPreference: !harness,
  spaceHrefs: harness?.spaceHrefs,
};
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{pageTitle(titlePrefix + (title === SPACE_LABEL[space] ? title : `${title} · ${SPACE_LABEL[space]}`))}</title>
    {signedIn && <ClientErrorBuffer />}
    <SheetTransition />
  </head>
  <body class="h-full overflow-hidden overscroll-none bg-ground">
    {
      /*
       * Two branches, not a conditional slot: an island receives a named slot
       * whenever one is written, even inside a false expression, and an empty
       * sidebar would still bring its drawer and menu button.
       */
      Astro.slots.has("sidebar") ? (
        <SpacesShell client:load {...shell}>
          <slot name="sidebar" slot="sidebar" />
          <slot />
        </SpacesShell>
      ) : (
        <SpacesShell client:load {...shell}>
          <slot />
        </SpacesShell>
      )
    }
    <slot name="overlays" />
    {
      /* No floating button: it would sit on the bottom bar. The account menu opens the form. */
      account.feedback && <FeedbackWidget client:idle showLauncher={false} />
    }
  </body>
</html>

