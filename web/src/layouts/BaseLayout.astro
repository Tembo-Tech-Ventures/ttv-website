---
import "@/styles/global.css";
import ClientErrorBuffer from "@/components/feedback/ClientErrorBuffer.astro";
import DemoSessionControls from "@/components/community/DemoSessionControls";
import { demoPersona } from "@/lib/staging-demo-policy";
import FeedbackWidget from "@/components/feedback/FeedbackWidget";
import {
  absoluteUrl,
  normalizeDescription,
  pageTitle,
  DEFAULT_DESCRIPTION,
  SITE_NAME,
  type SeoProps,
} from "@/lib/seo";

type Props = SeoProps;

const {
  title,
  description,
  canonical,
  ogImage,
  ogType = "website",
  publishedTime,
  noIndex = false,
} = Astro.props;

const resolvedTitle = pageTitle(title);
const resolvedDescription =
  normalizeDescription(description) ?? DEFAULT_DESCRIPTION;

// Default the canonical to the current path (not the full URL) so filtered
// listings like `/talent?skill=react` do not read as duplicate content.
const canonicalUrl = absoluteUrl(Astro.site, canonical ?? Astro.url.pathname);
const ogImageUrl = absoluteUrl(Astro.site, ogImage ?? "/og-default.png");
// Feedback is for people with an account; anonymous visitors never see it.
const signedIn = Boolean(Astro.locals.user);
const demo = Astro.locals.stagingDemo;
const activeDemoPersona = demoPersona(demo?.persona);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={resolvedDescription} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={resolvedDescription} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {
      ogType === "article" && publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }

    <meta
      name="twitter:card"
      content={ogImageUrl ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{resolvedTitle}</title>
    {signedIn && <ClientErrorBuffer />}

    <!-- Page-specific head content, e.g. JSON-LD for blog posts. -->
    <slot name="head" />
  </head>
  <body class="bg-dark min-h-screen">
    {demo && activeDemoPersona && Astro.locals.user && (
      <div class="mx-auto w-full max-w-7xl px-4 py-3 sm:px-8">
        <DemoSessionControls client:load activePersona={activeDemoPersona} displayName={Astro.locals.user.name} expiresAt={new Date(demo.expiresAt * 1000).toISOString()} />
      </div>
    )}
    {Astro.locals.stagingQa && <aside class="px-4 py-3" aria-label="Temporary fictional persona QA">
      <p>Temporary fictional persona QA · {Astro.locals.stagingQa.persona} · expires {new Date(Astro.locals.stagingQa.expiresAt*1000).toISOString()}</p>
      <form method="post" action="/api/qa/logout"><button type="submit">Sign out of this QA persona</button></form>
    </aside>}
    <slot />
    {signedIn && <FeedbackWidget client:idle />}
  </body>
</html>
