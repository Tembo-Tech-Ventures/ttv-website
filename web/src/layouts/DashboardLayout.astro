---
import { createCommunityService } from "@/lib/community/service";
import { hasDiscoveryAccess } from "@/lib/dashboard-presentation";
import BaseLayout from "./BaseLayout.astro";
import { restrictedHrefs, restrictionsFor } from "@/components/platform/spaces/space-page";
import DashboardShell, { DASHBOARD_LINKS } from "@/components/shells/DashboardShell";
import { drizzle } from "drizzle-orm/d1";
import { env } from "cloudflare:workers";
import * as schema from "@/lib/db/schema";
import {
  getStudentJourney,
  type StudentJourney,
} from "@/lib/student/journey";

interface Props {
  title?: string;
  journey?: StudentJourney;
  canDiscover?: boolean;
}

const { title = "Dashboard", journey: suppliedJourney } = Astro.props;
const user = Astro.locals.user!;
// QA personas and staging fixtures only see links their allowlists open, so the sidebar offers no dead ends.
const allowedHrefs = restrictedHrefs(restrictionsFor(Astro.locals), DASHBOARD_LINKS.map(link => link.href));
const canDiscover = Astro.props.canDiscover ?? hasDiscoveryAccess(await createCommunityService(env.DB, user.id, Astro.locals.stagingFixture, env.DEPLOYMENT_ENVIRONMENT).access());
const journey =
  suppliedJourney ??
  (await getStudentJourney(drizzle(env.DB, { schema }), user.id));
---

<BaseLayout title={`${title} | TTV`}>
  <DashboardShell
    client:load
    canDiscover={canDiscover}
    allowedHrefs={allowedHrefs}
    currentPath={Astro.url.pathname}
    visibleLinkIds={journey.visibleLinkIds}
    unreadLeadCount={journey.unreadLeadCount}
    demoSession={Boolean(Astro.locals.stagingDemo)}
  >
    <slot />
  </DashboardShell>
</BaseLayout>
