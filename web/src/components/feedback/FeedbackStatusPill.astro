---
import {
  FEEDBACK_ADMIN_STATUS_LABELS,
  FEEDBACK_STATUS_LABELS,
  type FeedbackStatus,
} from "@/lib/feedback/model";

interface Props {
  status: FeedbackStatus;
  /** Students see outcomes ("Being worked on"); staff see workflow states. */
  audience?: "student" | "admin";
}

const { status, audience = "student" } = Astro.props;

const classes: Record<FeedbackStatus, string> = {
  NEW: "border-cyan-500/30 bg-cyan-500/15 text-cyan-200",
  IN_PROGRESS: "border-yellow-500/30 bg-yellow-500/15 text-yellow-200",
  RESOLVED: "border-green-500/30 bg-green-500/15 text-green-200",
  DECLINED: "border-stone-500/30 bg-stone-500/15 text-stone-200",
};
const labels =
  audience === "admin" ? FEEDBACK_ADMIN_STATUS_LABELS : FEEDBACK_STATUS_LABELS;
---

<span
  class:list={[
    "inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium",
    classes[status],
  ]}
>
  {labels[status]}
</span>
