---
import { FEEDBACK_ADMIN_STATUS_LABELS, type FeedbackStatus } from "@/lib/feedback/model";
import {
  FEEDBACK_THEME_STATUS_LABELS,
  STUDENT_FEEDBACK_STATE_LABELS,
  type FeedbackThemeStatus,
  type StudentFeedbackState,
} from "@/lib/feedback/themes";

/**
 * Students see outcomes derived from the note and its theme ("Planned");
 * staff see the note's workflow state or the theme's.
 */
type Props =
  | { student: StudentFeedbackState }
  | { note: FeedbackStatus }
  | { theme: FeedbackThemeStatus };

type Tone = "new" | "planned" | "progress" | "done" | "closed";

const TONES: Record<Tone, string> = {
  new: "border-cyan-500/30 bg-cyan-500/15 text-cyan-200",
  planned: "border-indigo-500/30 bg-indigo-500/15 text-indigo-200",
  progress: "border-yellow-500/30 bg-yellow-500/15 text-yellow-200",
  done: "border-green-500/30 bg-green-500/15 text-green-200",
  closed: "border-stone-500/30 bg-stone-500/15 text-stone-200",
};

const STUDENT_TONES: Record<StudentFeedbackState, Tone> = {
  RECEIVED: "new",
  PLANNED: "planned",
  IN_PROGRESS: "progress",
  DONE: "done",
  NOT_PLANNED: "closed",
};
const NOTE_TONES: Record<FeedbackStatus, Tone> = {
  NEW: "new",
  IN_PROGRESS: "progress",
  RESOLVED: "done",
  DECLINED: "closed",
};
const THEME_TONES: Record<FeedbackThemeStatus, Tone> = {
  COLLECTING: "new",
  PROPOSED: "planned",
  PLANNED: "planned",
  IN_PROGRESS: "progress",
  SHIPPED: "done",
  DECLINED: "closed",
  DORMANT: "closed",
};

const props = Astro.props;
const [label, tone] =
  "student" in props
    ? [STUDENT_FEEDBACK_STATE_LABELS[props.student], STUDENT_TONES[props.student]]
    : "note" in props
      ? [FEEDBACK_ADMIN_STATUS_LABELS[props.note], NOTE_TONES[props.note]]
      : [FEEDBACK_THEME_STATUS_LABELS[props.theme], THEME_TONES[props.theme]];
---

<span
  class:list={[
    "inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium",
    TONES[tone],
  ]}
>
  {label}
</span>
