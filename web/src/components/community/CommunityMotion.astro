<script>
  import { initCommunityMotion } from "./community-motion";
  const root = document.querySelector<HTMLElement>("[data-community-root]");
  if (root) {
    const stop = initCommunityMotion(root);
    // A bfcache return restores the same document and still needs its handlers.
    window.addEventListener("pagehide", event => { if (!event.persisted) stop(); });
  }
</script>
