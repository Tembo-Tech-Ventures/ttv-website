---
/**
 * A contribution's editor: a new one, or the next revision of one already
 * shared. A plain form that posts to Community (home-forms.ts), so it saves
 * without a script. An edit carries the revision the person saw: if the
 * contribution changed since, the API refuses it and nothing is overwritten.
 */
import { Button, ButtonLink, Notice, TextAreaField, TextField } from "@/components/platform/ui";
import type { JourneyClaim } from "@/components/discovery/types";
import {
  COMMUNITY_HOME_PATH, CONTRIBUTION_EDITOR_ID, DESCRIPTION_MAX, SOURCE_MAX, TITLE_MAX,
  type ContributionErrors, type ContributionValues, type HomeFailure,
} from "./home-forms";

interface Props {
  /** The contribution being revised; none for a new one. */
  claim?: JourneyClaim | null;
  values: ContributionValues;
  errors?: ContributionErrors;
  failure?: HomeFailure | null;
}

const { claim = null, values, errors = {}, failure = null } = Astro.props;
const count = Object.keys(errors).length;
const sharing = claim?.status === "draft"
  ? "Saving keeps this contribution private. Earlier mentor statements remain part of its revision history."
  : "Everyone signed in to TTV can see posted work. If you complete a cohort and publish your profile, it also appears on the public website.";
---

<section id={CONTRIBUTION_EDITOR_ID} aria-labelledby="contribution-editor-title" class="scroll-mt-6" data-contribution-editor={claim ? "edit" : "add"}>
  <h3 id="contribution-editor-title" class="text-lg text-ink-primary">{claim ? "Edit your contribution" : "What did you contribute?"}</h3>
  {claim && (
    <p class="mt-2 max-w-prose text-sm leading-relaxed text-ink-secondary">
      Editing creates a new revision. Earlier mentor statements stay with the revision they reviewed.
    </p>
  )}
  <p class="mt-2 max-w-prose text-sm leading-relaxed text-ink-secondary">
    A project, a useful fix, a talk, or something you learned. Be specific about your part.
  </p>
  <form method="POST" action={COMMUNITY_HOME_PATH} class="mt-5 flex flex-col gap-6">
    <input type="hidden" name="form" value="contribution" />
    {claim && <input type="hidden" name="id" value={claim.id} />}
    {claim && <input type="hidden" name="revision" value={String(claim.version)} />}
    {count > 0 && (
      <Notice tone="danger" focusOnLoad title={`${count === 1 ? "One thing" : `${count} things`} to fix before this can be saved`}>
        Everything you wrote is still here.
      </Notice>
    )}
    {failure && <Notice tone="danger" focusOnLoad title={failure.title}>{failure.detail}</Notice>}
    <TextField
      name="title"
      label="Entry title"
      placeholder="Made the library's borrowing flow keyboard accessible"
      maxLength={TITLE_MAX}
      defaultValue={values.title}
      error={errors.title}
      required
    />
    <TextAreaField
      name="description"
      label="Your contribution"
      placeholder="What did you do? What changed? Who did you work with?"
      rows={5}
      minLength={20}
      maxLength={DESCRIPTION_MAX}
      defaultValue={values.description}
      error={errors.description}
      required
    />
    <TextField type="date" name="date" label="Date" defaultValue={values.date} error={errors.date} required className="max-w-xs" />
    <TextField
      type="url"
      name="sourceUrl"
      label="Source link"
      optional
      hint="A project, code, or writing someone can review. Only share links you have permission to share."
      placeholder="https://…"
      maxLength={SOURCE_MAX}
      defaultValue={values.sourceUrl}
      error={errors.sourceUrl}
    />
    <Notice tone="info" id="contribution-sharing">{sharing}</Notice>
    <div class="flex flex-wrap items-center gap-3">
      <Button type="submit" variant="primary" size="lg" aria-describedby="contribution-sharing">
        {claim ? "Save changes" : "Save contribution"}
      </Button>
      <ButtonLink href={COMMUNITY_HOME_PATH} variant="ghost" size="lg">Cancel</ButtonLink>
    </div>
  </form>
</section>
