---
/**
 * The editor without JavaScript.
 *
 * `PostEditor` is a client island, so with scripting off the page would
 * otherwise render an inert title box and a canvas that cannot be typed into.
 * This form replaces it: the same fields, the same action names, submitted to
 * the same handler. The `<style>` inside `<noscript>` is what hides the island —
 * it only reaches the document when scripting is off, which makes it the one
 * mechanism that cannot get the two states out of step.
 */
import type { PostDraft } from "./editor-state";

interface Props {
  draft: PostDraft;
  status: "DRAFT" | "PUBLISHED" | "SUSPENDED";
  error: string | null;
}

const { draft, status, error } = Astro.props;
const editable = status !== "SUSPENDED";
---

<noscript>
  <style>
    .post-editor {
      display: none;
    }
  </style>

  <div class="min-h-0 flex-1 overflow-y-auto">
    <div class="mx-auto w-full max-w-[44rem] space-y-5 px-5 py-10">
      <a
        href="/dashboard/writing"
        class="text-sm text-ink-secondary underline hover:text-ink-primary"
      >
        &larr; Back to Writing
      </a>

      <h1 class="font-heading text-3xl tracking-display text-ink-primary">
        {editable ? "Edit post" : "Post suspended"}
      </h1>

      {
        error && (
          <p class="rounded-md border border-red-500/30 bg-red-500/10 p-3 text-sm text-red-200">
            {error}
          </p>
        )
      }

      {
        editable && (
          <form method="POST" class="space-y-4">
            <div class="flex flex-col gap-1.5">
              <label for="plain-title" class="text-sm font-medium">Title</label>
              <input
                id="plain-title"
                name="title"
                type="text"
                required
                maxlength="200"
                value={draft.title}
                class="form-control"
              />
            </div>

            <div class="flex flex-col gap-1.5">
              <label for="plain-slug" class="text-sm font-medium">Slug</label>
              <input
                id="plain-slug"
                name="slug"
                type="text"
                maxlength="80"
                value={draft.slug}
                placeholder="auto-generated-from-title"
                class="form-control"
              />
            </div>

            <div class="flex flex-col gap-1.5">
              <label for="plain-body" class="text-sm font-medium">
                Content (Markdown)
              </label>
              <textarea
                id="plain-body"
                name="contentMarkdown"
                required
                rows="18"
                maxlength="40000"
                class="form-control font-mono text-sm">{draft.contentMarkdown}</textarea
              >
            </div>

            <div class="flex flex-col gap-1.5">
              <label for="plain-excerpt" class="text-sm font-medium">Excerpt</label>
              <textarea
                id="plain-excerpt"
                name="excerpt"
                rows="2"
                maxlength="300"
                class="form-control">{draft.excerpt}</textarea
              >
            </div>

            <div class="flex flex-wrap gap-3">
              <button
                type="submit"
                name="_action"
                value="save"
                class="rounded-md bg-primary px-4 py-2 text-sm font-semibold text-dark"
              >
                Save
              </button>
              {
                status === "DRAFT" && (
                  <button
                    type="submit"
                    name="_action"
                    value="publish"
                    class="rounded-md border border-teal px-4 py-2 text-sm font-medium"
                  >
                    Save and publish
                  </button>
                )
              }
              {
                status === "PUBLISHED" && (
                  <button
                    type="submit"
                    name="_action"
                    value="unpublish"
                    class="rounded-md border border-teal px-4 py-2 text-sm font-medium"
                  >
                    Move back to drafts
                  </button>
                )
              }
            </div>
          </form>
        )
      }

      {
        status === "DRAFT" && (
          <form method="POST">
            <button
              type="submit"
              name="_action"
              value="delete"
              class="text-sm text-ink-muted underline"
            >
              Delete draft
            </button>
          </form>
        )
      }

      {
        !editable && (
          <p class="text-ink-secondary">
            An admin has taken this post down. Contact the TTV team for next
            steps.
          </p>
        )
      }
    </div>
  </div>
</noscript>
