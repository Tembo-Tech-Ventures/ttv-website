---
/**
 * One sheet in candidate D's stack. Every major section is a sheet with
 * rounded top corners that slides over the one before it. Without JS (or with
 * reduced motion) sheets simply sit in flow with their corners overlapping;
 * `stack.ts` adds `hd-stacked` to the root, measures each sheet and makes it
 * stick while the next sheet's edge and title are already on screen, so the
 * next one slides over it with no extra scroll.
 */
interface Props {
  id: string;
  tone: "base" | "raised" | "lift" | "peach" | "deep";
  labelledby: string;
  layer: number;
  /** Own the whole screen (below the nav) while held, so nothing shows underneath. */
  fill?: boolean;
}

const { id, tone, labelledby, layer, fill = false } = Astro.props;
---

<section
  id={id}
  class:list={["hd-sheet", `hd-sheet--${tone}`, { "hd-sheet--fill": fill }]}
  style={`--hd-layer:${layer}`}
  aria-labelledby={labelledby}
  data-hd-sheet
>
  <div class="hd-sheet__body">
    <slot />
  </div>
  <div class="hd-sheet__dim" aria-hidden="true" data-hd-dim></div>
</section>

<style>
  .hd-sheet {
    --hd-radius: clamp(1.5rem, 3vw, 2.75rem);
    position: relative;
    z-index: var(--hd-layer);
    border-radius: var(--hd-radius) var(--hd-radius) 0 0;
    background: var(--hd-surface);
    color: var(--hd-text, #fff8f2);
    box-shadow:
      0 -1px 0 var(--hd-edge),
      0 -28px 60px -24px rgb(0 0 0 / 0.5);
    padding-block: clamp(4rem, 8vw, 7.5rem) clamp(5rem, 9vw, 8rem);
    transform-origin: 50% var(--hd-origin, 50%);
    scroll-margin-top: var(--hd-nav, 4.5rem);
  }

  .hd-sheet--fill {
    display: grid;
    align-content: center;
    min-height: calc(100svh - var(--hd-nav, 4.5rem));
    box-sizing: border-box;
  }

  .hd-sheet--fill > .hd-sheet__body {
    width: 100%;
    box-sizing: border-box;
  }

  .hd-sheet + .hd-sheet {
    margin-top: calc(-1 * var(--hd-radius));
  }

  /* Same container as the nav (max-w-7xl, px-4 / sm:px-6 / lg:px-8), so
   * content edges line up with the logo and the Apply button. */
  .hd-sheet__body {
    position: relative;
    box-sizing: border-box;
    margin-inline: auto;
    max-width: 80rem;
    padding-inline: 1rem;
  }

  @media (min-width: 40rem) {
    .hd-sheet__body {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 64rem) {
    .hd-sheet__body {
      padding-inline: 2rem;
    }
  }

  .hd-sheet__dim {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: #00110f;
    opacity: 0;
    pointer-events: none;
  }

  .hd-sheet--base {
    --hd-surface:
      radial-gradient(900px 520px at 8% 0%, rgb(242 141 104 / 0.13), transparent 62%),
      radial-gradient(700px 600px at 100% 40%, rgb(44 105 100 / 0.35), transparent 70%),
      #023f3a;
    --hd-edge: rgb(255 248 242 / 0.08);
    margin-top: clamp(0.5rem, 1.5vw, 1rem);
  }

  .hd-sheet--raised {
    --hd-surface: #0a4842;
    --hd-edge: rgb(255 248 242 / 0.1);
  }

  .hd-sheet--lift {
    --hd-surface: #10524b;
    --hd-edge: rgb(255 248 242 / 0.12);
  }

  .hd-sheet--peach {
    --hd-surface: #f28d68;
    --hd-text: #013d39;
    --hd-edge: rgb(255 248 242 / 0.35);
  }

  .hd-sheet--deep {
    padding-bottom: clamp(3rem, 6vw, 5rem);
    --hd-surface: #012e2b;
    --hd-edge: rgb(242 141 104 / 0.28);
  }

  :global(.hd-stacked) .hd-sheet:not(:last-of-type) {
    position: sticky;
    top: var(--hd-stick, auto);
  }

</style>
