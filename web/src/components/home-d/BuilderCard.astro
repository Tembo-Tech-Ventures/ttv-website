---
import type { HomepageBuilder } from "@/lib/homepage/builders";
import { COHORT } from "@/lib/homepage/content";
import { cohortNumberOf } from "./cohorts";

/**
 * One card in the builders' card file. The top strip (monogram, name, cohort)
 * is what stays visible once later cards cover this one, so the covered
 * cards read as an index of everyone you have passed. The small numbered tab
 * at the strip's end is the builder's cohort card from the hero deck.
 */
interface Props {
  builder: HomepageBuilder;
}

const { builder } = Astro.props;
const cohortNumber = cohortNumberOf(builder);
const cohortIndex = COHORT.timeline.findIndex((cohort) => cohort.number === cohortNumber);
const cohortRunning = cohortIndex >= 0 && COHORT.timeline[cohortIndex].running;
---

<a class="hd-bc" href={builder.href}>
  <span class="hd-bc__strip">
    <span class="hd-bc__mono" aria-hidden="true">
      {builder.image ? (
        <img src={builder.image} alt="" width="96" height="96" loading="lazy" decoding="async" />
      ) : (
        <span class="font-heading tracking-display">{builder.initials}</span>
      )}
    </span>
    <span class="hd-bc__who">
      <span class="hd-bc__name">{builder.name}</span>
      {(builder.cohort || builder.country) && (
        <span class="hd-bc__meta">
          {builder.cohort}
          {builder.country && <span class="hd-bc__country">{builder.cohort ? ` · ${builder.country}` : builder.country}</span>}
        </span>
      )}
    </span>
    {cohortNumber && cohortIndex >= 0 && (
      <span
        class:list={["hd-bc__tab font-heading", { "hd-bc__tab--running": cohortRunning }]}
        style={`--k:${cohortIndex}`}
        aria-hidden="true"
      >
        {cohortNumber}
      </span>
    )}
  </span>
  <span class="hd-bc__body">
    {builder.country && <span class="hd-bc__meta hd-bc__country-body">{builder.country}</span>}
    {builder.headline && <span class="hd-bc__headline">{builder.headline}</span>}
    {builder.project && (
      <span class="hd-bc__project">
        <span class="hd-bc__repo">
          <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14"><path d="M3 2.5h7.5L13 5v8.5H3z M10.5 2.5V5H13" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" /></svg>
          {builder.project.name}
        </span>
        {builder.project.description && <span class="hd-bc__desc">{builder.project.description}</span>}
        {builder.project.language && (
          <span class="hd-bc__lang"><span class="hd-bc__dot" aria-hidden="true" />{builder.project.language}</span>
        )}
      </span>
    )}
    {builder.skills.length > 0 && (
      <span class="hd-bc__skills">
        {builder.skills.map((skill) => <span class="hd-bc__skill">{skill}</span>)}
      </span>
    )}
  </span>
  <span class="hd-bc__dim" aria-hidden="true" data-hd-dim></span>
</a>

<style>
  .hd-bc {
    position: relative;
    display: grid;
    gap: 1rem;
    padding: 0.8rem clamp(1rem, 2.5vw, 1.5rem) clamp(1.1rem, 2.5vw, 1.5rem);
    border-radius: 1.25rem;
    background: linear-gradient(180deg, #155e56, #0f514a 70%);
    border: 1px solid rgb(255 248 242 / 0.13);
    box-shadow:
      0 1px 0 rgb(255 248 242 / 0.1) inset,
      0 -10px 24px -16px rgb(0 0 0 / 0.65),
      0 24px 46px -30px rgb(0 0 0 / 0.75);
    color: var(--color-ink-primary);
    text-decoration: none;
    transform-origin: 50% 0%;
    transition:
      translate 320ms cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 320ms ease,
      border-color 320ms ease;
  }

  /* Focus does not lift: a stuck card would slide under the nav. */
  .hd-bc:hover {
    translate: 0 -0.5rem;
  }

  .hd-bc:hover,
  .hd-bc:focus-visible {
    border-color: rgb(242 141 104 / 0.6);
    box-shadow:
      0 1px 0 rgb(255 248 242 / 0.12) inset,
      0 -14px 30px -16px rgb(0 0 0 / 0.7),
      0 34px 60px -28px rgb(0 0 0 / 0.85);
  }

  .hd-bc:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  /* ---------- The strip that stays visible in the file ---------- */
  .hd-bc__strip {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 2.6rem;
  }

  .hd-bc__mono {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 0.7rem;
    background: var(--color-primary);
    color: var(--color-dark);
    overflow: hidden;
    font-size: 0.95rem;
    line-height: 1;
    transition: rotate 320ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hd-bc:hover .hd-bc__mono,
  .hd-bc:focus-visible .hd-bc__mono {
    rotate: -6deg;
  }

  .hd-bc__mono img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* One line, so the strip a covered card leaves reads "Name  Cohort 01". */
  .hd-bc__who {
    display: flex;
    align-items: baseline;
    gap: 0.35rem 0.6rem;
    min-width: 0;
    flex: 1;
    white-space: nowrap;
  }

  .hd-bc__name {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hd-bc__country-body {
    display: none;
  }

  @media (max-width: 39.99rem) {
    .hd-bc__country {
      display: none;
    }

    .hd-bc__country-body {
      display: block;
      margin-top: -0.5rem;
    }
  }

  .hd-bc__name {
    font-size: clamp(1.05rem, 0.95rem + 0.45vw, 1.3rem);
    font-weight: 700;
    line-height: 1.3;
  }

  .hd-bc__meta {
    flex: none;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-ink-secondary);
  }

  /* The builder's cohort card from the hero deck, in its deck colour. */
  .hd-bc__tab {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 1.6rem;
    border-radius: 0.4rem;
    background: color-mix(in srgb, #0d4f48, #2c6964 calc(var(--k) * 22%));
    border: 1px solid rgb(255 248 242 / 0.25);
    color: var(--color-ink-primary);
    font-size: 0.7rem;
    rotate: calc((var(--k) - 1.5) * 3deg);
    transition: rotate 320ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hd-bc__tab--running {
    background: var(--color-primary);
    color: var(--color-dark);
  }

  .hd-bc:hover .hd-bc__tab,
  .hd-bc:focus-visible .hd-bc__tab {
    rotate: 0deg;
  }

  /* ---------- Body ---------- */
  .hd-bc__body {
    display: grid;
    gap: 0.9rem;
  }

  @media (min-width: 64rem) {
    .hd-bc__body {
      grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) minmax(0, 3fr);
      gap: 2rem;
      align-items: start;
      padding-left: 3.45rem;
    }
  }

  .hd-bc__headline {
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.2rem);
    line-height: 1.45;
    color: var(--color-ink-primary);
  }

  .hd-bc__project {
    display: grid;
    gap: 0.3rem;
    padding: 0.75rem 0.9rem;
    border-radius: 0.8rem;
    background: rgb(1 46 43 / 0.55);
    border: 1px solid rgb(255 248 242 / 0.08);
  }

  .hd-bc__repo {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.875rem;
    color: var(--color-primary);
    overflow-wrap: anywhere;
  }

  .hd-bc__desc {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-ink-secondary);
  }

  .hd-bc__lang {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: var(--color-ink-secondary);
  }

  .hd-bc__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #ffd166;
  }

  .hd-bc__skills {
    display: flex;
    flex-wrap: wrap;
    align-content: start;
    gap: 0.4rem;
  }

  .hd-bc__skill {
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    border: 1px solid rgb(255 248 242 / 0.22);
    font-size: 0.8125rem;
    color: var(--color-ink-primary);
  }

  .hd-bc__dim {
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    background: #00110f;
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hd-bc,
    .hd-bc__mono,
    .hd-bc__tab {
      transition: none;
    }
  }
</style>
