---
import type { HomepageBuilder } from "@/lib/homepage/builders";
import { COHORT, SKILLS_MAP } from "@/lib/homepage/content";
import { CENTRE, COLUMN_LABELS, adjacency, buildSkillsGraph, columnLayout, radialLayout, walkerAt } from "@/lib/homepage/skills-map";

/**
 * The skills map: a 42-style radial picture of the skills on published
 * profiles, around a cohort. The three steps of a cohort (`COHORT.rhythm`)
 * are waypoints on it: as the map's sheet arrives, a peach path lights node
 * by node outward, a small group of builders walks it, engineers (teal
 * rings) join them, and the path carries on past the cohort's ring.
 *
 * It is an illustration, never a syllabus or a progress tracker: the centre
 * is "a cohort" (a group, no number), lit skills are only "on the path" (no
 * skill is drawn as completed by anyone), and the caption saying so is read
 * before the picture. With no published profiles it draws only an
 * unlabelled structure.
 *
 * Wide screens: intro and steps beside the map. Tablets: the map, then the
 * steps in a row. Phones: the map becomes a vertical path (the trunk) through
 * the steps, each ring a station with a short row of skills off it. The
 * finished picture is the server markup; `scripts/map.ts` adds the walk and
 * the node details.
 */
interface Props {
  builders: HomepageBuilder[];
}

const { builders } = Astro.props;
const graph = buildSkillsGraph(builders);
const map = radialLayout(graph);
const bands = columnLayout(graph, { metrics: { ...COLUMN_LABELS, minScale: 0.9 } });
const near = adjacency({ links: map.links });
const hasSkills = map.skills.length > 0;
const W = map.width;
const H = map.height;
const pct = (value: number, of: number) => `${((value / of) * 100).toFixed(3)}%`;
const points = map.path.points.map((point) => `${point.x},${point.y}`).join(" ");
// The walk ends past the outer ring; the solid path stops at the last skill.
const lastSkill = map.path.points.at(-2) ?? map.path.points[0];
const end = map.path.points.at(-1) ?? map.path.points[0];
const resting = walkerAt(map.path.points, map.path.fractions, 1, map.centre);
const mainPoints = map.path.points
  .slice(0, -1)
  .map((point) => `${point.x},${point.y}`)
  .join(" ");
const neighbours = (key: string) => [...(near.get(key) ?? [])].filter((other) => other !== CENTRE).join(" ");
/** A band's skills grouped into their rows, left to right. */
const rowsOf = <T extends { x: number; y: number }>(skills: T[]) =>
  [...Map.groupBy(skills, (skill) => skill.y).values()].map((row) => row.toSorted((a, b) => a.x - b.x));
const plural = (count: number) => `On ${count} published ${count === 1 ? "profile" : "profiles"}`;
/** Four dots in a loose square: a cohort, as a group (the walkers' formation). */
const GROUP = [
  [-6, -6],
  [6, -6],
  [-6, 6],
  [6, 6],
] as const;
---

<div class:list={["hd-map", { "hd-map--empty": !hasSkills }]} data-hd-map>
  <div class="hd-map__intro">
    <h2 class="hd-h2 font-heading tracking-heading">{SKILLS_MAP.title}</h2>
    <p class="hd-lede">{SKILLS_MAP.summary}</p>
    <p class="hd-map__caption">
      <span class="hd-map__caption-mark" aria-hidden="true"></span>
      {hasSkills ? SKILLS_MAP.caption : SKILLS_MAP.emptyCaption}
    </p>
  </div>

  <div class="hd-map__figure" data-hd-map-figure>
    <div class="hd-map__stage" style={`aspect-ratio:${W}/${H}`} data-hd-map-stage>
      <svg class="hd-map__svg" viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="hd-map-tail" gradientUnits="userSpaceOnUse" x1={lastSkill.x} y1={lastSkill.y} x2={end.x} y2={end.y}>
            <stop offset="0" stop-color="#f28d68" />
            <stop offset="1" stop-color="#f28d68" stop-opacity="0.15" />
          </linearGradient>
        </defs>
        <g class="hd-map__rings">
          {map.rings.map((ring) => (
            <ellipse class="hd-map__ring" cx={map.centre.x} cy={map.centre.y} rx={ring.rx} ry={ring.ry} />
          ))}
          <ellipse class="hd-map__cohort-ring" cx={map.centre.x} cy={map.centre.y} rx={map.cohortRing.rx} ry={map.cohortRing.ry} />
        </g>
        <g class="hd-map__dust">
          {map.dust.map((dot) => <circle cx={dot.x} cy={dot.y} r={dot.r} />)}
        </g>
        <g class="hd-map__links">
          {map.links.map((link) => (
            <line
              class:list={["hd-ln", `hd-ln--${link.kind}`, { "hd-ln--loose": link.kind === "branch" && link.weight === 0 }]}
              x1={link.x1}
              y1={link.y1}
              x2={link.x2}
              y2={link.y2}
              data-a={link.a}
              data-b={link.b}
            />
          ))}
        </g>
        <polyline class="hd-map__ahead" points={points} />
        <polyline class="hd-map__lit" points={mainPoints} pathLength="1" data-hd-lit />
        <line class="hd-map__tail" x1={lastSkill.x} y1={lastSkill.y} x2={end.x} y2={end.y} pathLength="1" stroke="url(#hd-map-tail)" data-hd-tail />
        <g class="hd-map__centre" transform={`translate(${map.centre.x} ${map.centre.y})`}>
          <circle class="hd-map__hub" r={map.centre.r} />
          {hasSkills && GROUP.map(([x, y]) => <circle class="hd-map__seat" cx={x * 1.6} cy={y * 1.6} r="6" />)}
        </g>
        <g class="hd-walk is-joined is-home" transform={`translate(${resting.x.toFixed(1)} ${resting.y.toFixed(1)})`} data-hd-walk>
          <g class="hd-walk__group">
            <g class="hd-walk__mentors">
              <circle class="hd-walk__mentor" cx="-17" cy="3" r="6.5" />
              <circle class="hd-walk__mentor" cx="16" cy="-5" r="6.5" />
            </g>
            {GROUP.map(([x, y]) => <circle class="hd-walk__dot" cx={x} cy={y} r="4.6" />)}
            <circle class="hd-walk__alum" cx="6" cy="6" r="8.5" />
          </g>
        </g>
      </svg>

      {/* HTML, not SVG: its pulse is compositor-only, so it costs nothing per frame. */}
      <span
        class="hd-map__halo"
        style={`left:${pct(map.centre.x, W)};top:${pct(map.centre.y, H)};width:${pct(map.centre.r * 2, W)}`}
        aria-hidden="true"
      ></span>

      {/* Under the labels, like the map's own lines, so a leader passes behind them. */}
      <svg class="hd-tip-leader" aria-hidden="true" focusable="false" data-hd-leader><line /></svg>

      {hasSkills && (
        <ul class="hd-map__skills" aria-label="Skills on the map, from the centre out" data-hd-skills>
          {map.skills.map((skill) => (
            <li class="hd-map__node" style={`left:${pct(skill.x, W)};top:${pct(skill.y, H)}`} data-hd-node data-side={skill.x >= map.centre.x ? "right" : "left"}>
              <span
                class={`hd-sk hd-sk--ring${skill.ring} is-${skill.state}`}
                data-hd-skill={skill.key}
                data-at={skill.at ?? undefined}
                data-near={neighbours(skill.key)}
                data-detail={plural(skill.count)}
              >
                {skill.label}
              </span>
            </li>
          ))}
        </ul>
      )}
      <div class="hd-tip" hidden aria-hidden="true" data-hd-tip>
        <strong data-hd-tip-label></strong>
        <span data-hd-tip-detail></span>
      </div>
    </div>
  </div>

  <ol class="hd-way" data-hd-way>
    <li class="hd-way__lit" aria-hidden="true" data-hd-way-lit></li>
    {COHORT.rhythm.map((step, index) => {
      const band = bands.find((candidate) => candidate.ring === index);
      return (
        <li class:list={["hd-way__step is-reached", { "hd-way__step--last": index === COHORT.rhythm.length - 1 }]} data-hd-step>
          <div class="hd-way__text">
            <span class="hd-way__mark" aria-hidden="true" data-hd-mark>
              <svg viewBox="0 0 32 32" width="32" height="32">
                {index === 0 && GROUP.map(([x, y]) => <circle class="hd-g__dot" cx={16 + x * 0.9} cy={16 + y * 0.9} r="3.1" />)}
                {index === 1 && (
                  <>
                    <path class="hd-g__line" d="M9 19L16 11M16 11L23 19M9 19H23" />
                    <circle class="hd-g__dot" cx="9" cy="19" r="3.2" />
                    <circle class="hd-g__dot" cx="23" cy="19" r="3.2" />
                    <circle class="hd-g__ring" cx="16" cy="11" r="4" />
                  </>
                )}
                {index === 2 && (
                  <>
                    <path class="hd-g__arc" d="M5 25A14 14 0 0 1 19 9" />
                    <path class="hd-g__line" d="M12 19L22 12" />
                    <circle class="hd-g__dot" cx="12" cy="19" r="3.2" />
                    <circle class="hd-g__far" cx="24.5" cy="10.5" r="3" />
                  </>
                )}
              </svg>
            </span>
            <h3 class="hd-way__title">{step.title}</h3>
            <p class="hd-way__copy">{step.copy}</p>
          </div>
          {band && (
            <div class="hd-band" style={`aspect-ratio:358/${band.height}`} data-hd-band>
              <svg class="hd-band__svg" viewBox={`0 0 358 ${band.height}`} aria-hidden="true" focusable="false">
                {index === 2 && <line class="hd-band__cohort" x1="0" y1="3" x2="358" y2="3" />}
                {band.lines
                  .filter((line) => line.kind === "branch")
                  .map((line) => (
                    <line class="hd-ln hd-ln--band" x1={line.x1} y1={line.y1} x2={line.x2} y2={line.y2} data-a={line.a} data-b={line.b} />
                  ))}
                {band.skills
                  .filter((skill) => skill.station)
                  .map((skill) => (
                    <circle class="hd-band__station is-lit" cx="20" cy={skill.y} r="6" data-station={skill.key} />
                  ))}
              </svg>
              {/* Rows sit at their computed start; pills in a row take their real widths. */}
              <div class="hd-band__skills" role="list" aria-label={`Skills along "${step.title}"`} data-hd-skills>
                {rowsOf(band.skills).map((row) => (
                  <div class="hd-band__row" style={`left:${pct(row[0].x, 358)};top:${pct(row[0].y, band.height)}`} data-hd-node>
                    {row.map((skill) => (
                      <span class="hd-band__item" role="listitem">
                        <span
                          class:list={[`hd-sk hd-sk--ring${skill.ring} is-${skill.state}`, { "hd-sk--station": skill.station }]}
                          data-hd-skill={skill.key}
                          data-near={neighbours(skill.key)}
                          data-detail={plural(skill.count)}
                          data-station={skill.station ? "" : undefined}
                        >
                          {skill.label}
                        </span>
                      </span>
                    ))}
                    {band.moreAt && band.moreAt.y === row[0].y && (
                      <span class="hd-band__item" role="listitem">
                        <button
                          type="button"
                          class="hd-band__more"
                          aria-expanded="true"
                          aria-controls={`hd-band-rest-${index}`}
                          data-hd-more
                          data-closed={`+${band.more} more`}
                        >
                          +{band.more} more
                        </button>
                      </span>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )}
          {band && band.rest.length > 0 && (
            <ul class="hd-band__rest" id={`hd-band-rest-${index}`} aria-label={`More skills along "${step.title}"`} data-hd-skills data-hd-rest>
              {band.rest.map((skill) => (
                <li class="hd-band__node" data-hd-node>
                  <span
                    class={`hd-sk hd-sk--ring${skill.ring} is-${skill.state}`}
                    data-hd-skill={skill.key}
                    data-near={neighbours(skill.key)}
                    data-detail={plural(skill.count)}
                  >
                    {skill.label}
                  </span>
                </li>
              ))}
            </ul>
          )}
          {band && (
            <p class="hd-band__detail" hidden aria-hidden="true" data-hd-detail>
              <strong data-hd-tip-label></strong> · <span data-hd-tip-detail></span>
            </p>
          )}
        </li>
      );
    })}
    <li class="hd-way__walk" aria-hidden="true" data-hd-way-walk>
      <svg viewBox="-20 -14 40 28" width="40" height="28">
        <circle class="hd-walk__mentor" cx="-12" cy="2" r="5" />
        <circle class="hd-walk__mentor" cx="12" cy="-3" r="5" />
        {GROUP.map(([x, y]) => <circle class="hd-walk__dot" cx={x * 0.7} cy={y * 0.85} r="3.6" />)}
      </svg>
    </li>
  </ol>
</div>

<style>
  /* ---------- Layout ---------- */
  /*
   * Phones: intro, then the steps with the map threaded through them as a
   * vertical path. 48rem up: intro, the radial map, the steps in a row. 80rem
   * up: intro and steps beside the map, which stays put while the steps pass.
   */
  .hd-map {
    --teal-l: #7fbcb2;
    --map-bg: #023b37;
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .hd-map__intro :global(.hd-h2) {
    max-width: 16ch;
  }

  /* Read before the picture: it is an illustration, nobody's record. */
  .hd-map__caption {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    max-width: 34rem;
    margin: 1rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-ink-secondary);
  }

  .hd-map__caption-mark {
    flex: none;
    width: 1.1rem;
    height: 0;
    margin-top: 0.7em;
    border-top: 1.5px dashed rgb(242 141 104 / 0.8);
  }

  .hd-map__figure {
    display: none;
    margin: 0;
  }

  .hd-map__stage {
    position: relative;
    display: none;
    container-type: inline-size;
  }

  @media (min-width: 48rem) {
    .hd-map__figure {
      display: block;
    }

    .hd-map__stage {
      display: block;
      width: 100%;
      max-width: 50rem;
      margin-inline: auto;
    }
  }

  /* Wide: intro and steps in a narrow column, the map given most of the row. */
  @media (min-width: 80rem) {
    .hd-map {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      column-gap: 3.5rem;
      row-gap: 2.25rem;
      align-items: start;
    }

    .hd-map__intro {
      grid-column: 1;
      grid-row: 1;
    }

    .hd-way {
      grid-column: 1;
      grid-row: 2;
    }

    .hd-map__figure {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: center;
    }
  }

  /* ---------- The drawing ---------- */
  .hd-map__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .hd-map__ring {
    fill: none;
    stroke: rgb(127 188 178 / 0.2);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .hd-map__cohort-ring {
    fill: none;
    stroke: rgb(242 141 104 / 0.55);
    stroke-width: 1.25;
    stroke-dasharray: 3 7;
    vector-effect: non-scaling-stroke;
  }

  .hd-map__dust circle {
    fill: rgb(127 188 178 / 0.4);
  }

  .hd-ln {
    stroke-width: 1;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    transition: stroke 240ms ease, opacity 240ms ease;
  }

  .hd-ln--spoke {
    stroke: rgb(127 188 178 / 0.45);
  }

  .hd-ln--branch,
  .hd-ln--band {
    stroke: rgb(127 188 178 / 0.5);
  }

  .hd-ln--loose {
    stroke: rgb(127 188 178 / 0.32);
    stroke-dasharray: 2 5;
  }

  .hd-ln--shared {
    stroke: rgb(242 141 104 / 0.42);
  }

  .hd-map__ahead {
    fill: none;
    stroke: rgb(242 141 104 / 0.45);
    stroke-width: 1.5;
    stroke-dasharray: 1 6;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .hd-map__lit,
  .hd-map__tail {
    fill: none;
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1 1;
    stroke-dashoffset: 0;
  }

  .hd-map__lit {
    stroke: var(--color-primary);
  }

  .hd-map__hub {
    fill: #013d39;
    stroke: var(--color-primary);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .hd-map__halo {
    position: absolute;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgb(242 141 104 / 0.6);
    background: rgb(242 141 104 / 0.08);
    translate: -50% -50%;
    opacity: 0;
    pointer-events: none;
  }

  .hd-map--empty .hd-map__hub {
    stroke: rgb(242 141 104 / 0.5);
  }

  .hd-map--empty .hd-map__lit,
  .hd-map--empty .hd-map__tail,
  .hd-map--empty .hd-walk {
    display: none;
  }

  /* The cohort walking the map: peach builders, teal-ringed engineers. */
  :global(.hd-walk__dot) {
    fill: var(--color-primary);
    stroke: #013d39;
    stroke-width: 1.5;
  }

  :global(.hd-walk__mentor) {
    fill: #013d39;
    stroke: #7fbcb2;
    stroke-width: 2;
  }

  :global(.hd-walk__alum) {
    fill: none;
    stroke: #7fbcb2;
    stroke-width: 1.75;
  }

  /* Once the margin thread has the group (wide screens), it leaves the map. */
  .hd-walk {
    transition: opacity 150ms ease;
  }

  .hd-walk.is-gone {
    opacity: 0;
  }

  .hd-walk__mentors,
  .hd-walk__alum {
    opacity: 0;
    transition: opacity 400ms ease;
  }

  .hd-walk.is-joined .hd-walk__mentors,
  .hd-walk.is-home .hd-walk__alum {
    opacity: 1;
  }

  .hd-way__walk :global(.hd-walk__mentor) {
    opacity: 0;
    transition: opacity 400ms ease;
  }

  .hd-way__walk.is-joined :global(.hd-walk__mentor) {
    opacity: 1;
  }

  .hd-map__seat {
    fill: rgb(242 141 104 / 0.35);
  }

  /* The walking group, a little larger than its formation's units. */
  .hd-walk__group {
    transform: scale(1.35);
  }

  /* ---------- Skill nodes (shared by the map and the phone path) ---------- */
  .hd-map__skills,
  .hd-band__skills {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hd-map__node,
  .hd-band__row {
    position: absolute;
    display: flex;
  }

  .hd-map__node {
    translate: -50% -50%;
  }

  .hd-band__row {
    gap: 0.625rem;
    translate: 0 -50%;
  }

  .hd-band__item {
    position: relative;
    display: flex;
  }

  /* Skills listed together, side by side in a row. */
  .hd-band__item + .hd-band__item::before {
    content: "";
    position: absolute;
    right: 100%;
    top: 50%;
    width: 0.625rem;
    height: 1px;
    background: rgb(127 188 178 / 0.5);
  }

  /* 42's three states: done (filled), reachable (outlined), later (faint). */
  .hd-sk {
    position: relative;
    display: block;
    box-sizing: border-box;
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    border: 1.5px solid rgb(255 248 242 / 0.62);
    background: var(--map-bg);
    color: var(--color-ink-primary);
    font-size: clamp(0.8125rem, 1.85cqi, 0.875rem);
    font-weight: 600;
    line-height: 1.25;
    white-space: nowrap;
    transition:
      background-color 360ms ease,
      border-color 360ms ease,
      color 360ms ease,
      box-shadow 360ms ease,
      scale 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hd-band .hd-sk {
    font-size: 0.8125rem;
  }

  /* On the path: outlined and lit in peach, never filled as if completed. */
  .hd-sk.is-lit {
    border-color: var(--color-primary);
    background: #1e4a40;
    box-shadow:
      0 0 0 3px rgb(242 141 104 / 0.14),
      0 6px 18px -10px rgb(242 141 104 / 0.7);
  }

  .hd-sk.is-later {
    border: 1px dashed rgb(255 248 242 / 0.28);
    color: var(--color-ink-muted);
  }

  /* Buttons only once map.ts is running; the hit area reaches 44px. */
  :global(.hd-map--live) .hd-sk {
    cursor: pointer;
  }

  :global(.hd-map--live) .hd-sk::before {
    content: "";
    position: absolute;
    inset: -0.45rem -0.2rem;
  }

  .hd-sk:focus-visible {
    outline: 2px solid var(--color-ink-primary);
    outline-offset: 3px;
  }

  .hd-sk.is-active {
    scale: 1.06;
    border-color: var(--color-ink-primary);
  }

  /* Pointed at or focused: always reads as live, whatever its state. */
  .hd-sk.is-active {
    border-style: solid;
    color: var(--color-ink-primary);
  }

  .hd-sk.is-near:not(.is-lit) {
    border-style: solid;
    border-color: var(--color-primary);
    color: var(--color-ink-primary);
  }

  :global(.has-active) .hd-ln:not(.is-lit) {
    opacity: 0.35;
  }

  .hd-ln.is-lit {
    stroke: var(--color-primary);
    stroke-dasharray: none;
    opacity: 1;
  }

  /* The details for one node: how many published profiles list it. */
  .hd-tip {
    position: absolute;
    z-index: 3;
    display: grid;
    gap: 0.15rem;
    min-width: 9.5rem;
    padding: 0.55rem 0.8rem;
    border-radius: 0.75rem;
    background: var(--color-ink-primary);
    color: var(--color-dark);
    box-shadow: 0 16px 30px -14px rgb(0 0 0 / 0.75);
    translate: 0 -50%;
    pointer-events: none;
    font-size: 0.875rem;
    line-height: 1.35;
    white-space: nowrap;
  }

  .hd-tip[hidden] {
    display: none;
  }

  /* A docked tip's thin line back to its node. */
  .hd-tip-leader {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .hd-tip-leader:not(.is-shown) {
    display: none;
  }

  .hd-tip-leader line {
    stroke: var(--color-ink-primary);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }

  .hd-tip strong {
    font-weight: 700;
  }



