---
import type { HomepageBuilder } from "@/lib/homepage/builders";
import Sheet from "./Sheet.astro";
import Cohort from "./Cohort.astro";
import SkillsMap from "./SkillsMap.astro";
import Builders from "./Builders.astro";
import Community from "./Community.astro";
import Hire from "./Hire.astro";
import Principles from "./Principles.astro";
// oxlint-disable-next-line import/no-unassigned-import -- Candidate D's prefixed shared pieces.
import "./home-d.css";

/**
 * Homepage candidate D, "Layers + map": candidate B's stack of sheets with C's network
 * language and a 42-style skills map in the opening sheet. The server
 * markup is the finished composition; `scripts/home-d.ts` adds the stacking,
 * deck, tabs and arrival motion when the visitor allows motion.
 */
interface Props {
  builders: HomepageBuilder[];
  isAuthenticated: boolean;
}

const { builders, isAuthenticated } = Astro.props;
---

<div class="hd" data-hd-root>
  <!-- Two layers, one section: the map slides over the hero like every other sheet. -->
  <section id="cohorts" class="hd-group" aria-labelledby="hd-cohorts-title">
    <Sheet tone="base" layer={1}>
      <Cohort builders={builders} />
    </Sheet>
    <Sheet tone="map" layer={2}>
      <SkillsMap builders={builders} />
    </Sheet>
  </section>
  <Sheet id="builders" tone="raised" labelledby="hd-builders-title" layer={3}>
    <Builders builders={builders} />
  </Sheet>
  <Sheet id="community" tone="lift" labelledby="hd-community-title" layer={4}>
    <Community isAuthenticated={isAuthenticated} builders={builders} />
  </Sheet>
  <Sheet id="hire" tone="peach" labelledby="hd-hire-title" layer={5} fill>
    <Hire builders={builders} />
  </Sheet>
  <Sheet id="principles" tone="deep" labelledby="hd-principles-title" layer={6} last>
    <Principles />
  </Sheet>
</div>

<script>
  import { initHomeD } from "./scripts/home-d";

  initHomeD();
</script>
