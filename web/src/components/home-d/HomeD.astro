---
import type { HomepageBuilder } from "@/lib/homepage/builders";
import Sheet from "./Sheet.astro";
import Cohort from "./Cohort.astro";
import Builders from "./Builders.astro";
import Community from "./Community.astro";
import Hire from "./Hire.astro";
import Principles from "./Principles.astro";
// oxlint-disable-next-line import/no-unassigned-import -- Candidate D's prefixed shared pieces.
import "./home-d.css";

/**
 * Homepage candidate D, "Layers": the page as a stack of sheets. The server
 * markup is the finished composition; `scripts/home-d.ts` adds the stacking,
 * deck, tabs and arrival motion when the visitor allows motion.
 */
interface Props {
  builders: HomepageBuilder[];
  isAuthenticated: boolean;
}

const { builders, isAuthenticated } = Astro.props;
---

<div class="hd" data-hd-root>
  <Sheet id="cohorts" tone="base" labelledby="hd-cohorts-title" layer={1}>
    <Cohort builders={builders} />
  </Sheet>
  <Sheet id="builders" tone="raised" labelledby="hd-builders-title" layer={2}>
    <Builders builders={builders} />
  </Sheet>
  <Sheet id="community" tone="lift" labelledby="hd-community-title" layer={3}>
    <Community isAuthenticated={isAuthenticated} builders={builders} />
  </Sheet>
  <Sheet id="hire" tone="peach" labelledby="hd-hire-title" layer={4} fill>
    <Hire builders={builders} />
  </Sheet>
  <Sheet id="principles" tone="deep" labelledby="hd-principles-title" layer={5}>
    <Principles />
  </Sheet>
</div>

<script>
  import { initHomeD } from "./scripts/home-d";

  initHomeD();
</script>
