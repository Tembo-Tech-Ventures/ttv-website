---
/**
 * What onboarding puts at the top of a space's landing page (SPEC §2, §3):
 * the one-time card for older accounts (S4), then the status cards (S3). In
 * Community it adds the welcome for someone just looking around, and the
 * "Your spaces" line for anyone a role has opened Mentoring or Discover to.
 *
 * After a form, the page says what happened and focus lands on it (QAO-02,
 * QAO-05, QAO-10): "Request sent." above the request's own Pending card, or
 * that the one-time card was saved or hidden. "Request sent." is said only
 * while that request is still waiting, and the saved or hidden line only once
 * the card is gone. Each is said once: a script drops its parameter from the
 * address after rendering, so a reload or a bookmark does not repeat it.
 *
 * These sit above the page's h1, so their titles are not headings: each card
 * is a region named by its title, and the page's own h1 comes first in the
 * heading outline.
 *
 * Nothing renders while onboarding is off for the person: the page passes
 * `view` only from its spaces context, which is null then.
 */
import type { AccessRole, SpaceId } from "@/lib/platform/contracts";
import PersonMarker from "@/components/platform/ui/PersonMarker";
import { SPACE_PATHS } from "@/lib/platform/server/space-routes";
import { PiCheckCircleBold } from "react-icons/pi";
import {
  ACCOUNT_PATH, PROMPT_HIDDEN_VALUE, PROMPT_SAVED_VALUE, TAKING_PART_ID, UNSAVED_PARAM, UNSAVED_VALUE,
} from "./account-actions";
import { PROMPT, STATUS, YOUR_SPACES } from "./copy";
import ExistingAccountCard from "./ExistingAccountCard.astro";
import { ROLE_SPACES, cardsFor, yourSpaces, type OnboardingView } from "./framing";
import StatusCard from "./StatusCard.astro";
import { SEAL, action } from "./styles";
import { SENT_PARAM, parseSent } from "./welcome-flow";

interface Props {
  view: OnboardingView;
  /** The landing page this sits on: its space, and where its forms return. */
  space: SpaceId;
  /** Space below the notices, when the page's next card sits closer than its heading would. */
  class?: string;
}

const { view, space, class: spacing = "mb-10" } = Astro.props;
const returnTo = SPACE_PATHS[space];
const cards = cardsFor(view, space);
const community = space === "community";
const opened: AccessRole[] = community ? yourSpaces(view) : [];
const welcome = community && view.framing === "exploring";
const note = Astro.url.searchParams.get(UNSAVED_PARAM);
const unsaved = note === UNSAVED_VALUE;
// Only requests still waiting are confirmed, and only once the card is gone is it said to be saved or hidden.
const sent = parseSent(Astro.url.searchParams).filter((role) => view.pending.includes(role));
const promptDone = view.prompt ? null
  : note === PROMPT_SAVED_VALUE ? PROMPT.saved
  : note === PROMPT_HIDDEN_VALUE ? PROMPT.hidden
  : null;
const shown = unsaved || sent.length > 0 || promptDone || view.prompt || cards.length > 0 || opened.length > 0 || welcome;
const CONFIRMATION = "flex items-start gap-2.5 rounded-xl border border-primary/45 bg-primary/10 px-4 py-3 text-[0.9375rem] font-semibold text-ink-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-peach-ink";
const LINK = "font-semibold text-ink-primary underline underline-offset-3 hover:text-peach-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-peach-ink";
---

{shown && (
  <div data-onboarding-notices class:list={["flex flex-col gap-4", spacing]}>
    {unsaved && (
      <p role="alert" class="rounded-xl border border-danger-ink/40 bg-danger-ink/8 px-4 py-3 text-sm font-semibold text-ink-primary">{STATUS.unsaved}</p>
    )}
    {sent.length > 0 && (
      <p role="status" tabindex="-1" autofocus data-onboarding-sent data-once-param={SENT_PARAM} class={CONFIRMATION}>
        <PiCheckCircleBold aria-hidden className="mt-0.5 size-5 shrink-0 text-peach-ink" />
        <span>{STATUS.justSent(sent.length)}</span>
      </p>
    )}
    {promptDone && (
      <p role="status" tabindex="-1" autofocus data-onboarding-prompt-done={note} data-once-param={UNSAVED_PARAM} class={CONFIRMATION}>
        <PiCheckCircleBold aria-hidden className="mt-0.5 size-5 shrink-0 text-peach-ink" />
        <span>{promptDone} <a href={`${ACCOUNT_PATH}#${TAKING_PART_ID}`} class={LINK}>{PROMPT.account}</a>.</span>
      </p>
    )}
    {view.prompt && <ExistingAccountCard prompt={view.prompt} returnTo={returnTo} />}
    {cards.map((card) => <StatusCard card={card} returnTo={returnTo} />)}
    {welcome && (
      <section aria-labelledby="onboarding-welcome-title" data-onboarding-welcome class="grid grid-cols-[auto_minmax(0,1fr)] items-start gap-x-4 rounded-[1.125rem] border border-hairline bg-ink-primary/4 p-5 sm:items-center sm:gap-x-5 sm:p-6">
        <span aria-hidden="true" class={SEAL}><PersonMarker kind="builder" className="scale-150" /></span>
        <div class="min-w-0">
          <p id="onboarding-welcome-title" class="text-lg leading-snug font-bold text-ink-primary">{STATUS.welcome.title}</p>
          <p class="mt-1 text-[0.9375rem] leading-relaxed text-ink-secondary">
            {STATUS.welcome.body} <a href={`${ACCOUNT_PATH}#${TAKING_PART_ID}`} class={LINK}>{STATUS.welcome.account}</a>.
          </p>
        </div>
      </section>
    )}
    {opened.length > 0 && (
      <section aria-labelledby="onboarding-spaces-title" data-onboarding-spaces class="grid grid-cols-[auto_minmax(0,1fr)] items-start gap-x-4 gap-y-4 rounded-[1.125rem] border border-hairline bg-ink-primary/4 p-5 sm:grid-cols-[auto_minmax(0,1fr)_auto] sm:items-center sm:gap-x-5 sm:p-6">
        <span aria-hidden="true" class={SEAL}><PersonMarker kind={opened[0] === "MENTOR" ? "mentor" : "institution"} className="scale-150" /></span>
        <div class="min-w-0">
          <p id="onboarding-spaces-title" class="text-lg leading-snug font-bold text-ink-primary">{YOUR_SPACES.title}</p>
          <p class="mt-1 text-[0.9375rem] leading-relaxed text-ink-secondary">
            {opened.length > 1 ? YOUR_SPACES.body.both : YOUR_SPACES.body[opened[0]!]} {YOUR_SPACES.keeps}
          </p>
        </div>
        <div class="col-span-2 flex flex-wrap items-center gap-2 sm:col-span-1 sm:justify-end">
          {opened.map((role) => (
            <a href={SPACE_PATHS[ROLE_SPACES[role]]} class:list={action("quiet")}>{YOUR_SPACES.open[role]}</a>
          ))}
        </div>
      </section>
    )}
  </div>
)}

<script>
  // Said once: the address forgets what a shown confirmation was about, so a reload or a bookmark does not say it again.
  const shown = document.querySelectorAll<HTMLElement>("[data-once-param]");
  if (shown.length > 0) {
    const url = new URL(window.location.href);
    for (const notice of shown) url.searchParams.delete(notice.dataset.onceParam ?? "");
    window.history.replaceState(window.history.state, "", url);
  }
</script>
