---
/**
 * What a pending request said (QAO-03), under its row in Account → "How you
 * take part": the person's own answers, under the questions the request step
 * asked, so they can re-read them before deciding to withdraw and resend.
 *
 * Only the requester's own fields: never the administrator, never anything
 * the team wrote. Every value is untrusted text and renders as text; the link
 * is the http(s) address the request step accepted.
 */
import type { AccessRequestSummary } from "@/lib/platform/contracts";
import { REQUEST, TAKING_PART } from "./copy";

interface Props {
  request: AccessRequestSummary;
}

const { request } = Astro.props;
const institution = request.role === "INSTITUTION";
const rows: { label: string; value: string; link?: boolean }[] = [
  ...(institution && request.organisation ? [{ label: REQUEST.organisation, value: request.organisation }] : []),
  ...(institution && request.organisationRole ? [{ label: REQUEST.organisationRole, value: request.organisationRole }] : []),
  { label: institution ? REQUEST.institutionNote : REQUEST.mentorNote, value: request.note },
  ...(request.link ? [{ label: institution ? REQUEST.institutionLink : REQUEST.mentorLink, value: request.link, link: true }] : []),
];
const titleId = `${request.id}-sent-title`;
---

<section aria-labelledby={titleId} data-sent-request={request.role} class="mt-3 rounded-xl border border-hairline bg-dark/40 px-4 py-3">
  <h4 id={titleId} class="text-sm font-bold text-ink-primary">{TAKING_PART.yours}</h4>
  <dl class="mt-2 space-y-2.5 text-sm leading-relaxed">
    {rows.map((row) => (
      <div>
        <dt class="font-semibold text-ink-secondary">{row.label}</dt>
        <dd class="mt-0.5 break-words whitespace-pre-line text-ink-primary">
          {row.link ? (
            <a href={row.value} rel="noopener noreferrer nofollow" class="underline underline-offset-3 hover:text-peach-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-peach-ink">{row.value}</a>
          ) : row.value}
        </dd>
      </div>
    ))}
  </dl>
</section>
