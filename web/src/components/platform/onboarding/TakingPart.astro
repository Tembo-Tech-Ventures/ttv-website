---
/**
 * Account → "How you take part" (onboarding SPEC §2, S5). The choices made at
 * the welcome step, revisitable: building and learning is a switch, and
 * mentor and organisation access each show the one state their request and
 * role are in, with the one thing that can be done about it. Choosing never
 * grants access; asking goes on to the request step, and an administrator
 * decides.
 *
 * Every control is a plain form posting to this page (account-actions.ts).
 */
import { PiHourglassMedium, PiInfo } from "react-icons/pi";
import type { AccessRole } from "@/lib/platform/contracts";
import PersonMarker from "@/components/platform/ui/PersonMarker";
import { CHIP_TONES, type ChipTone } from "@/components/platform/ui/tones";
import { formatMomentDate } from "@/lib/display-date";
import { ACCOUNT_PATH, ACTION_FIELD, RETURN_FIELD, TAKING_PART_ID, UNSAVED_PARAM, UNSAVED_VALUE } from "./account-actions";
import { STATUS, TAKING_PART } from "./copy";
import { heldChoices, type OnboardingView } from "./framing";
import { SEAL, action } from "./styles";
// oxlint-disable-next-line import/no-unassigned-import -- Switch stylesheet.
import "./framing.css";

interface Props {
  view: OnboardingView;
}

const { state } = Astro.props.view;
const held = heldChoices(state);
const member = held.includes("MEMBER");

type Row =
  | { state: "active" }
  | { state: "pending"; id: string; sentAt: number }
  | { state: "declined"; chosen: boolean }
  | { state: "none" };

/** One state per access, from the role and the latest request: role state always wins. */
function rowFor(role: AccessRole): Row {
  if (state.roles.includes(role)) return { state: "active" };
  const request = state.requests.find((candidate) => candidate.role === role);
  if (request?.status === "PENDING") return { state: "pending", id: request.id, sentAt: request.createdAt };
  if (request?.status === "DECLINED") return { state: "declined", chosen: held.includes(role) };
  return { state: "none" };
}

const rows = (["MENTOR", "INSTITUTION"] as const).map((role) => ({ role, row: rowFor(role) }));
const exploring = held.length === 0 && rows.every(({ row }) => row.state === "none");
const unsaved = Astro.url.searchParams.get(UNSAVED_PARAM) === UNSAVED_VALUE;
const CHIPS: Record<Row["state"], { text: string; tone: ChipTone }> = {
  active: { text: TAKING_PART.chips.active, tone: "peach" },
  pending: { text: TAKING_PART.chips.pending, tone: "ring" },
  declined: { text: TAKING_PART.chips.declined, tone: "neutral" },
  none: { text: TAKING_PART.chips.none, tone: "neutral" },
};
const ROW = "grid grid-cols-[auto_minmax(0,1fr)] items-start gap-x-4 gap-y-3 px-5 py-5 sm:grid-cols-[auto_minmax(0,1fr)_auto] sm:items-center sm:px-6";
const ACTS = "col-span-2 flex flex-wrap items-center gap-2 sm:col-span-1 sm:justify-end";
const subject = (role: AccessRole) => TAKING_PART.rows[role].title.toLowerCase();
---

<section id={TAKING_PART_ID} aria-labelledby="taking-part-title" data-taking-part class="scroll-mt-6 overflow-hidden rounded-[1.375rem] border border-hairline bg-ink-primary/4">
  <header class="border-b border-hairline px-5 py-5 sm:px-6">
    <h2 id="taking-part-title" class="text-xl leading-snug font-bold text-ink-primary">{TAKING_PART.title}</h2>
    <p class="mt-1 text-[0.9375rem] leading-relaxed text-ink-secondary">{TAKING_PART.lead}</p>
    {exploring && <p data-taking-part-exploring class="mt-3 text-sm font-semibold text-ink-primary">{TAKING_PART.exploring}</p>}
    {unsaved && <p role="alert" class="mt-3 text-sm font-semibold text-danger-ink">{STATUS.unsaved}</p>}
  </header>
  <ul class="divide-y divide-hairline">
    <li class="grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-x-4 px-5 py-5 sm:px-6" data-taking-part-row="MEMBER">
      <span aria-hidden="true" class={SEAL}><PersonMarker kind="builder" className="scale-150" /></span>
      <div class="min-w-0">
        <h3 id="taking-part-member" class="text-base leading-snug font-bold text-ink-primary">{TAKING_PART.rows.MEMBER.title}</h3>
        <p class="mt-0.5 text-sm leading-relaxed text-ink-secondary">{TAKING_PART.rows.MEMBER.body}</p>
      </div>
      <form method="post" action={ACCOUNT_PATH}>
        <input type="hidden" name={ACTION_FIELD} value="member" />
        <input type="hidden" name="value" value={member ? "off" : "on"} />
        <input type="hidden" name={RETURN_FIELD} value={ACCOUNT_PATH} />
        <button type="submit" role="switch" aria-checked={member ? "true" : "false"} aria-labelledby="taking-part-member" class="onboarding-switch">
          <span aria-hidden="true" class="onboarding-switch__track"><span class="onboarding-switch__knob"></span></span>
        </button>
      </form>
    </li>
    {rows.map(({ role, row }) => (
      <li class={ROW} data-taking-part-row={role} data-state={row.state}>
        <span aria-hidden="true" class={SEAL}><PersonMarker kind={role === "MENTOR" ? "mentor" : "institution"} className="scale-150" /></span>
        <div class="min-w-0">
          <h3 class="text-base leading-snug font-bold text-ink-primary">{TAKING_PART.rows[role].title}</h3>
          <p class="mt-0.5 text-sm leading-relaxed text-ink-secondary">
            {row.state === "active" ? TAKING_PART.active[role]
              : row.state === "pending" ? TAKING_PART.sent(formatMomentDate(new Date(row.sentAt)))
              : row.state === "declined" ? TAKING_PART.declined(role)
              : TAKING_PART.rows[role].body}
          </p>
        </div>
        <div class={ACTS}>
          <span data-chip={CHIPS[row.state].tone} class:list={["inline-flex h-7 shrink-0 items-center gap-1.5 rounded-full px-3 text-xs font-semibold whitespace-nowrap", CHIP_TONES[CHIPS[row.state].tone]]}>
            {row.state === "pending" && <PiHourglassMedium aria-hidden className="size-3.5" />}
            {CHIPS[row.state].text}
          </span>
          {row.state === "pending" && (
            <form method="post" action={ACCOUNT_PATH}>
              <input type="hidden" name={ACTION_FIELD} value="withdraw" />
              <input type="hidden" name="id" value={row.id} />
              <input type="hidden" name={RETURN_FIELD} value={ACCOUNT_PATH} />
              <button type="submit" class:list={action("quiet")}>{TAKING_PART.withdraw}<span class="sr-only">: {subject(role)}</span></button>
            </form>
          )}
          {(row.state === "none" || row.state === "declined") && (
            <form method="post" action={ACCOUNT_PATH}>
              <input type="hidden" name={ACTION_FIELD} value="request" />
              <input type="hidden" name="role" value={role} />
              <input type="hidden" name={RETURN_FIELD} value={ACCOUNT_PATH} />
              <button type="submit" class:list={action("quiet")}>
                {row.state === "none" ? TAKING_PART.request : TAKING_PART.again}<span class="sr-only">: {subject(role)}</span>
              </button>
            </form>
          )}
          {row.state === "declined" && row.chosen && (
            <form method="post" action={ACCOUNT_PATH}>
              <input type="hidden" name={ACTION_FIELD} value="remove" />
              <input type="hidden" name="role" value={role} />
              <input type="hidden" name={RETURN_FIELD} value={ACCOUNT_PATH} />
              <button type="submit" class:list={action("ghost")}>{TAKING_PART.remove}<span class="sr-only">: {subject(role)}</span></button>
            </form>
          )}
        </div>
      </li>
    ))}
  </ul>
</section>
<p class="mt-3 flex items-start gap-2 text-sm leading-relaxed text-ink-muted">
  <PiInfo aria-hidden className="mt-0.5 size-4 shrink-0" />
  <span>{TAKING_PART.note}</span>
</p>
