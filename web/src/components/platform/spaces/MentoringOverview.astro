---
/**
 * The Mentoring space's landing: confirming shared work, then requests and
 * availability. While mentor requests are off for the person, those two say
 * they are not open yet rather than pretending to be empty inboxes.
 */
import { PiArrowRight, PiCalendarCheck, PiChatsCircle, PiShieldCheck } from "react-icons/pi";
import type { MentorAvailability } from "@/lib/platform/contracts";
import { BUTTON_VARIANTS, FOCUS_RING } from "@/components/platform/ui/Button";
import { RAISED } from "@/components/platform/ui/tones";
import { SPACE_PAGE_PATHS } from "./sidebar";
import { awaitingConfirmationText } from "./awaiting-confirmation";
import type { ChannelShortcutsModel } from "./channel-shortcuts";
import ChannelShortcuts from "./ChannelShortcuts.astro";
import { capacityView, listingNote, MENTOR_AVAILABILITY_PATH, MENTOR_REQUESTS_PATH, waitingText } from "@/components/platform/mentors/mentor-display";

interface Props {
  /** The server's derived count (Me.mentoring); null when it is not known, so nothing is claimed. */
  awaiting: number | null;
  /** The channels card (QA2-16); null while `channels` is off for the person. */
  shortcuts?: ChannelShortcutsModel | null;
  /**
   * Mentor requests, while `mentor_requests` is open to the person (U-4.1): how many wait for an
   * answer (null when not known) and the saved availability. Null keeps the "Not open yet" cards.
   */
  requests?: { waiting: number | null; availability: MentorAvailability | null; now: number } | null;
}

const { awaiting, shortcuts = null, requests = null } = Astro.props;
const live = requests
  ? [
    {
      id: "requests",
      icon: PiChatsCircle,
      title: "Requests",
      href: MENTOR_REQUESTS_PATH,
      action: "See requests",
      body: requests.waiting === null
        ? "Members ask for your time with the work they want help on attached. Accept, suggest another mentor, or say not this month."
        : requests.waiting > 0
          ? `${waitingText(requests.waiting)}.`
          : "Nothing is waiting for you. When someone asks for your time, their request appears here.",
      strong: (requests.waiting ?? 0) > 0,
    },
    {
      id: "availability",
      icon: PiCalendarCheck,
      title: "Availability",
      href: MENTOR_AVAILABILITY_PATH,
      action: "Edit availability",
      body: requests.availability
        ? requests.availability.listed
          ? `${listingNote(requests.availability)} This month: ${capacityView(requests.availability.capacity, requests.now).text}.`
          : listingNote(requests.availability)
        : "How many requests you take each month, the areas you help with, and a pause for when you need one.",
      strong: false,
    },
  ]
  : null;

const later = [
  {
    id: "requests",
    icon: PiChatsCircle,
    title: "Requests",
    body: "Mentor requests are planned: a member asks for your time with the work they want help on attached, and you accept, suggest another mentor, or decline.",
  },
  {
    id: "availability",
    icon: PiCalendarCheck,
    title: "Availability",
    body: "Planned with mentor requests: how many requests you take each month, the areas you help with, and a pause for when you need one.",
  },
];
---

<div class="max-w-4xl">
  <h1 class="text-3xl tracking-heading break-words text-ink-primary sm:text-4xl lg:text-5xl">Mentoring</h1>
  <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-secondary sm:text-lg">
    Members share what they built so mentors can confirm the part that was theirs.
  </p>

  <section
    aria-labelledby="mentoring-confirm-title"
    class:list={["mt-10 rounded-[1.125rem] border border-hairline p-5 sm:p-7", RAISED]}
  >
    <div class="flex flex-wrap items-start gap-x-5 gap-y-4">
      <span aria-hidden="true" class="grid size-11 shrink-0 place-items-center rounded-full border-2 border-ring text-ring">
        <PiShieldCheck className="size-5" />
      </span>
      <div class="min-w-0 flex-1 basis-64">
        <h2 id="mentoring-confirm-title" class="text-xl leading-snug text-ink-primary">Confirm work</h2>
        <p class="mt-2 max-w-2xl text-base leading-relaxed text-ink-secondary">
          Review a contribution and its sources, then record what you checked. A confirmation covers that
          piece of work as it was shared; it is not an endorsement of the person.
        </p>
        {
          awaiting !== null && (
            <p
              data-awaiting-confirmation={awaiting}
              class:list={["mt-3 max-w-2xl text-base leading-relaxed", awaiting > 0 ? "font-semibold text-ink-primary" : "text-ink-secondary"]}
            >
              {awaiting > 0
                ? awaitingConfirmationText(awaiting)
                : "Nothing is waiting for your confirmation right now. Work appears here when members share it."}
            </p>
          )
        }
      </div>
      <a
        href={SPACE_PAGE_PATHS.confirm}
        class:list={["inline-flex h-11 shrink-0 items-center gap-2 rounded-xl px-5 text-sm font-semibold transition-colors", BUTTON_VARIANTS.primary, FOCUS_RING]}
      >
        Review shared work
        <PiArrowRight aria-hidden="true" className="size-4" />
      </a>
    </div>
  </section>

  <ChannelShortcuts model={shortcuts} class="mt-6" />

  {live && (
    <div class="mt-6 grid gap-6 md:grid-cols-2" data-mentor-requests-overview>
      {live.map(({ id, icon: Icon, title, href, action, body, strong }) => (
        <section id={id} aria-labelledby={`${id}-title`} class:list={["flex scroll-mt-6 flex-col rounded-[1.125rem] border border-hairline p-5 sm:p-6", RAISED]}>
          <div class="flex items-center gap-3">
            <Icon aria-hidden className="size-5 shrink-0 text-ring" />
            <h2 id={`${id}-title`} class="text-lg text-ink-primary">{title}</h2>
          </div>
          <p class:list={["mt-3 text-sm leading-relaxed", strong ? "font-semibold text-ink-primary" : "text-ink-secondary"]}>{body}</p>
          <a href={href} class:list={["mt-4 inline-flex h-10 w-fit items-center gap-2 rounded-xl px-4 text-sm font-semibold transition-colors", BUTTON_VARIANTS.quiet, FOCUS_RING]}>
            {action}
            <PiArrowRight aria-hidden="true" className="size-4" />
          </a>
        </section>
      ))}
    </div>
  )}

  {!live && (
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {later.map(({ id, icon: Icon, title, body }) => (
        <section
          id={id}
          aria-labelledby={`${id}-title`}
          class="scroll-mt-6 rounded-[1.125rem] border border-dashed border-hairline p-5 sm:p-6"
        >
          <div class="flex items-center gap-3">
            <Icon aria-hidden className="size-5 shrink-0 text-ink-muted" />
            <h2 id={`${id}-title`} class="text-lg text-ink-primary">{title}</h2>
            <span class="ml-auto shrink-0 rounded-full border border-hairline px-2.5 py-0.5 text-xs font-semibold text-ink-secondary">
              Not open yet
            </span>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-ink-secondary">{body}</p>
        </section>
      ))}
    </div>
  )}
</div>
