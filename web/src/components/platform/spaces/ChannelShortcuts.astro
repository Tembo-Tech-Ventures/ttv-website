---
/**
 * A way into the channels from a space's overview (QA2-16): a few of the person's channels, with
 * their unread counts, and where the rest are. Renders nothing without a model, so pages pass
 * channelShortcuts(...) as it is, and nothing shows while `channels` is off.
 */
import { PiChatsCircle } from "react-icons/pi";
import { Card, CountBadge, buttonClass } from "@/components/platform/ui";
import type { ChannelShortcutsModel } from "./channel-shortcuts";

interface Props {
  model: ChannelShortcutsModel | null;
  class?: string;
}

const { model, class: className } = Astro.props;
---

{
  model && (
    <div data-channel-shortcuts class={className}>
      <Card as="section" aria-labelledby="channel-shortcuts-title">
        <div class="flex items-center gap-3">
          <PiChatsCircle aria-hidden className="size-5 shrink-0 text-peach-ink" />
          <h2 id="channel-shortcuts-title" class="text-lg text-ink-primary">Channels</h2>
        </div>
        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-secondary">{model.intro}</p>
        <ul class="mt-3 flex list-none flex-wrap gap-2 p-0">
          {
            model.channels.map((channel) => (
              <li>
                <a
                  href={channel.href}
                  data-channel-shortcut={channel.id}
                  class={buttonClass({ variant: "quiet", size: "lg" })}
                >
                  <span><span aria-hidden="true" class="text-ink-muted">#</span>{channel.name}</span>
                  <CountBadge count={channel.unread} label="unread" />
                </a>
              </li>
            ))
          }
        </ul>
        {model.more && <p class="mt-3 text-sm text-ink-secondary">The rest of your channels are in the menu.</p>}
      </Card>
    </div>
  )
}
