---
/**
 * An existing dashboard page's title, while its flag-off path still renders.
 * In the spaces shell it is the kit's `PageTitle`, the screen's one Mattone
 * heading; in the existing dashboard it keeps the heading and classes the
 * page always had. A page that had no title there (`legacyTag={null}`) gains
 * one in the spaces shell alone. A page that has moved to the kit imports
 * `PageTitle` or `PageHeader` from `@/components/platform/ui` instead.
 *
 * Those pages' spacing was set for a smaller title, often with a link just
 * above or tabs just below it, so the title brings 0.2em of room above and
 * below: more than its text overhangs its box, which a browser hit-tests.
 */
import { PageTitle } from "@/components/platform/ui";

interface Props {
  spaces: boolean;
  /** The classes the existing dashboard gives this heading. */
  legacyClass?: string;
  /** The existing dashboard's heading level. Most pages used an h2; null where it drew none. */
  legacyTag?: "h1" | "h2" | null;
  /**
   * A title that sits inside a card rather than heading the page. Kept, at its
   * old size, only until those pages move to the kit, which has no card size.
   */
  size?: "page" | "card";
}

const { spaces, legacyClass, legacyTag: Legacy = "h2", size = "page" } = Astro.props;
---

{
  spaces ? (
    size === "page" ? (
      <PageTitle className="my-[0.2em]">
        <slot />
      </PageTitle>
    ) : (
      <h1 class="tracking-heading break-words text-2xl text-ink-primary sm:text-3xl">
        <slot />
      </h1>
    )
  ) : (
    Legacy && (
      <Legacy class={legacyClass}>
        <slot />
      </Legacy>
    )
  )
}
