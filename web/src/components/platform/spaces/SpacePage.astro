---
/**
 * The frame around an existing dashboard page.
 *
 * With a spaces context (the `spaces` flag is on for this person and the page
 * opens in one of their spaces) the page renders in SpacesLayout, with its
 * space's sidebar. Without one it renders in DashboardLayout exactly as it did
 * before, so flag-off production, personal access tokens and a failed context
 * load keep the existing dashboard.
 *
 *   const spaces = await resolveSpacePage(Astro.locals, "apply");
 *   <SpacePage context={spaces} title="Apply">…the existing page…</SpacePage>
 *
 * This is the one place space pages mount the search and attention overlays
 * (U-1.3). Only `Me` reaches their island.
 *
 * In Community and Cohort, while `channels` is on for the person, the
 * sidebar lists the channels they can read (U-2.3). A channel page passes
 * the list it already read, and which channel is open.
 */
import { drizzle } from "drizzle-orm/d1";
import { env } from "cloudflare:workers";
import * as schema from "@/lib/db/schema";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import SpacesLayout from "@/layouts/SpacesLayout.astro";
import PlatformOverlays from "@/components/platform/overlays/PlatformOverlays";
import type { ShellOverlay } from "@/components/platform/shell/overlays";
import type { Channel } from "@/lib/platform/contracts";
import { recordError } from "@/lib/observability/errors";
import { getStudentJourney, type StudentJourney } from "@/lib/student/journey";
import { channelsServer } from "@/components/channels/server";
import { loadSidebarChannels } from "@/components/channels/sidebar-channels";
import SpaceSidebar from "./SpaceSidebar.astro";
import { SPACE_PAGE_PATHS, spaceSidebar } from "./sidebar";
import { linkAllowed, loadCertificates, loadCohortHeading, restrictionsFor, type SpacePageContext } from "./space-page";
import { cohortSearchLabel, type CohortHeading } from "./cohort-heading";
import { loadAdminNavFacts } from "@/components/admin/admin-nav-server";
import type { AdminNavFacts } from "@/components/admin/admin-nav";

interface Props {
  context: SpacePageContext | null;
  /** The page's name: the browser tab, and the phone's top bar in the spaces shell. */
  title: string;
  /** The existing dashboard's tab title, when it differs. */
  legacyTitle?: string;
  /** Prepended to the tab title only, never the visible bar: "Error: " after a rejected form. */
  titlePrefix?: string;
  journey?: StudentJourney;
  canDiscover?: boolean;
  /** A full-height view (a chat, a workspace) that sizes itself to the sheet instead of scrolling in it. */
  fill?: boolean;
  /** The channels this person can read, when the page has already read them (a channel page). */
  channels?: readonly Channel[];
  /** The channel this page shows, marked current in the sidebar. */
  channelId?: string;
  /** The Admin space's navigation, when the page has already read it (AdminLayout). */
  admin?: AdminNavFacts;
}

const {
  context, title, legacyTitle = title, titlePrefix = "", journey: suppliedJourney, canDiscover, fill = false, channels: suppliedChannels, channelId,
  admin: suppliedAdmin,
} = Astro.props;
const overlays: readonly ShellOverlay[] = ["search", "attention"];

let sidebar = null;
let cohortLabel: string | null = null;
if (context) {
  const db = drizzle(env.DB, { schema });
  const userId = context.me.user.id;
  const listChannels = suppliedChannels ? async () => suppliedChannels : () => channelsServer(env.DB, context.me).list();
  const reportChannels = (error: unknown) => recordError(env.DB, { source: "request", route: SPACE_PAGE_PATHS[context.page], error, level: "warning" });
  // The cohort's name, for its space and for search's cohort scope (T07). Without it both keep their general names.
  const loadCohort = (): Promise<CohortHeading | null> => context.me.spaces.includes("cohort")
    ? loadCohortHeading(db, context.me).catch((error: unknown) => {
      void recordError(env.DB, { source: "request", route: SPACE_PAGE_PATHS[context.page], error, level: "warning" });
      return null;
    })
    : Promise.resolve(null);
  const [journey, certificates, channels, cohort, admin] = await Promise.all([
    suppliedJourney ?? getStudentJourney(db, userId),
    context.space === "profile" ? loadCertificates(db, userId) : [],
    loadSidebarChannels(context.me, context.space, listChannels, reportChannels, channelId ?? null),
    loadCohort(),
    // The Admin space's sidebar is the admin navigation, with its counts (the mentor review page reads them here).
    context.space === "admin" ? suppliedAdmin ?? loadAdminNavFacts(Astro.locals, Astro.url) : null,
  ]);
  cohortLabel = cohortSearchLabel(context.me, cohort);
  const restrictions = restrictionsFor(Astro.locals);
  sidebar = spaceSidebar(context.space, {
    me: context.me,
    page: context.page,
    visibleLinkIds: journey.visibleLinkIds,
    unreadLeadCount: journey.unreadLeadCount,
    certificates,
    allowed: (href) => linkAllowed(restrictions, href),
    onboarding: context.onboarding,
    channels,
    cohort,
    admin,
  });
}
---

{
  context && sidebar ? (
    <SpacesLayout me={context.me} space={context.space} title={title} titlePrefix={titlePrefix} overlays={overlays}>
      <SpaceSidebar slot="sidebar" model={sidebar} />
      {fill ? (
        <div data-space-fill class="flex min-h-0 flex-1 flex-col">
          <slot />
        </div>
      ) : (
        <slot />
      )}
      <PlatformOverlays slot="overlays" client:load me={context.me} cohortLabel={cohortLabel} />
    </SpacesLayout>
  ) : (
    <DashboardLayout title={titlePrefix + legacyTitle} journey={suppliedJourney} canDiscover={canDiscover}>
      <slot />
    </DashboardLayout>
  )
}
