---
/**
 * The frame around an existing dashboard page.
 *
 * With a spaces context (the `spaces` flag is on for this person and the page
 * opens in one of their spaces) the page renders in SpacesLayout, with its
 * space's sidebar. Without one it renders in DashboardLayout exactly as it did
 * before, so flag-off production, personal access tokens and a failed context
 * load keep the existing dashboard.
 *
 *   const spaces = await resolveSpacePage(Astro.locals, "apply");
 *   <SpacePage context={spaces} title="Apply">…the existing page…</SpacePage>
 *
 * This is the one place space pages mount the search and attention overlays
 * (U-1.3). Only `Me` reaches their island.
 */
import { drizzle } from "drizzle-orm/d1";
import { env } from "cloudflare:workers";
import * as schema from "@/lib/db/schema";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import SpacesLayout from "@/layouts/SpacesLayout.astro";
import PlatformOverlays from "@/components/platform/overlays/PlatformOverlays";
import type { ShellOverlay } from "@/components/platform/shell/overlays";
import { getStudentJourney, type StudentJourney } from "@/lib/student/journey";
import SpaceSidebar from "./SpaceSidebar.astro";
import { spaceSidebar } from "./sidebar";
import { linkAllowed, loadCertificates, restrictionsFor, type SpacePageContext } from "./space-page";

interface Props {
  context: SpacePageContext | null;
  /** The page's name: the browser tab, and the phone's top bar in the spaces shell. */
  title: string;
  /** The existing dashboard's tab title, when it differs. */
  legacyTitle?: string;
  journey?: StudentJourney;
  canDiscover?: boolean;
  /** A full-height view (a chat, a workspace) that sizes itself to the sheet instead of scrolling in it. */
  fill?: boolean;
}

const { context, title, legacyTitle = title, journey: suppliedJourney, canDiscover, fill = false } = Astro.props;
const overlays: readonly ShellOverlay[] = ["search", "attention"];

let sidebar = null;
if (context) {
  const db = drizzle(env.DB, { schema });
  const userId = context.me.user.id;
  const [journey, certificates] = await Promise.all([
    suppliedJourney ?? getStudentJourney(db, userId),
    context.space === "profile" ? loadCertificates(db, userId) : [],
  ]);
  const restrictions = restrictionsFor(Astro.locals);
  sidebar = spaceSidebar(context.space, {
    me: context.me,
    page: context.page,
    visibleLinkIds: journey.visibleLinkIds,
    unreadLeadCount: journey.unreadLeadCount,
    certificates,
    allowed: (href) => linkAllowed(restrictions, href),
  });
}
---

{
  context && sidebar ? (
    <SpacesLayout me={context.me} space={context.space} title={title} overlays={overlays}>
      <SpaceSidebar slot="sidebar" model={sidebar} />
      {fill ? (
        <div data-space-fill class="flex min-h-0 flex-1 flex-col">
          <slot />
        </div>
      ) : (
        <slot />
      )}
      <PlatformOverlays slot="overlays" client:load me={context.me} />
    </SpacesLayout>
  ) : (
    <DashboardLayout title={legacyTitle} journey={suppliedJourney} canDiscover={canDiscover}>
      <slot />
    </DashboardLayout>
  )
}
