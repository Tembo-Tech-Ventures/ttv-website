---
/**
 * The way into a cohort for a member who is not in one yet. Without a cohort
 * there is no Cohort tab, so Community, where they land, carries it. The copy
 * is the existing journey's next step, so it names a cohort only when one is
 * actually taking applications.
 *
 * It follows Community's title, a kit card with a quiet button: the page's one
 * peach action is its own ("Add a contribution"). Its title names the region
 * rather than heading it, so the page's sections lead the outline (F-6, QAO-05).
 */
import { PiPaperPlaneTilt } from "react-icons/pi";
import { ButtonLink, Card } from "@/components/platform/ui";
import { canonicalSpacePath } from "@/lib/platform/server/space-routes";
import type { StudentNextStep } from "@/lib/student/journey";

interface Props {
  step: StudentNextStep;
}

const { step } = Astro.props;
const href = canonicalSpacePath(step.action.href) ?? step.action.href;
---

<Card as="section" aria-labelledby="cohort-invitation-title" className="flex flex-wrap items-center gap-x-5 gap-y-4" data-cohort-invitation>
  <span aria-hidden="true" class="hidden size-11 shrink-0 place-items-center rounded-full border border-hairline text-ink-secondary sm:grid">
    <PiPaperPlaneTilt className="size-5" />
  </span>
  <div class="min-w-0 flex-1 basis-64">
    <p id="cohort-invitation-title" class="text-lg leading-snug font-bold text-ink-primary">{step.title}</p>
    <p class="mt-1 text-sm leading-relaxed text-ink-secondary">{step.description}</p>
    {step.detail && <p class="mt-1 text-sm font-semibold text-ink-muted">{step.detail}</p>}
  </div>
  <ButtonLink href={href} size="lg">{step.action.label}</ButtonLink>
</Card>
