---
/**
 * A member's application answers: the kit's fields while there are questions
 * to answer on a pending application, otherwise a read-only account of what
 * was recorded. Members never see the stored JSON.
 *
 * The form is an ordinary POST with no script. Field names are
 * `answer.<question name>`; the page reads them with readAnswerSubmission and
 * passes back the drafts and errors, so a rejected form keeps what was typed,
 * and its danger notice takes focus as the page loads (no script either).
 */
import { Button, Notice } from "@/components/platform/ui";
import AnswerFields, { AnswerList, answerId } from "./AnswerFields";
import {
  canEditAnswers,
  formatAnswer,
  formatDraft,
  formQuestions,
  plainLabel,
  summaryQuestions,
  type ApplicationAnswerDrafts,
  type ApplicationAnswers,
} from "@/lib/student/application-answers";

interface Props {
  answers: ApplicationAnswers;
  /** The application's status: answers can change only while it is PENDING. */
  status: string;
  drafts: ApplicationAnswerDrafts;
  errors: Readonly<Record<string, string>>;
  /** Answers typed but not saved because the team reviewed the application first. */
  unsaved?: ApplicationAnswerDrafts;
}

const { answers, status, drafts, errors, unsaved = {} } = Astro.props;
const editable = canEditAnswers(answers, status);
const nothingRecorded =
  answers.kind === "enrollment"
    ? "The TTV team added you to this cohort directly, so there were no application questions."
    : status === "PENDING" && answers.kind === "empty"
      ? "This cohort doesn't ask any application questions, so there's nothing to fill in. Your application's status is shown above and changes when the team reviews it."
      : "No answers were recorded with this application.";

const stored = answers.kind === "questions" ? answers.questions : [];
const questions = editable ? formQuestions(stored) : summaryQuestions(stored);
const failed = questions.filter((question) => errors[question.name]);
const unsavedAnswers = formQuestions(stored).flatMap((question) => {
  const typed = formatDraft(question, unsaved[question.name] ?? "");
  return typed === null ? [] : [{ question, typed }];
});
---

{
  !editable && unsavedAnswers.length > 0 && (
    <section data-unsaved-answers aria-labelledby="unsaved-answers-heading" class="mb-8 flex flex-col gap-3">
      <h3 id="unsaved-answers-heading" class="text-lg text-ink-primary">Your unsaved answers</h3>
      <p class="text-sm text-ink-secondary">These weren't saved. Copy anything you want to keep.</p>
      <AnswerList items={unsavedAnswers.map(({ question, typed }) => ({ label: question.label, value: typed }))} />
    </section>
  )
}
{!editable && unsavedAnswers.length > 0 && <h3 class="mb-3 text-lg text-ink-primary">Saved answers</h3>}

{
  answers.kind === "questions" && editable ? (
    <form method="POST" class="flex max-w-3xl flex-col gap-6" data-application-answers-form>
      {failed.length > 0 && (
        <Notice
          tone="danger"
          focusOnLoad
          id="answers-error-summary"
          title={`${failed.length === 1 ? "One answer needs" : `${failed.length} answers need`} another look`}
        >
          <p>Everything you typed is still here.</p>
          <ul class="mt-2 list-disc space-y-1 pl-5">
            {failed.map((question) => (
              <li>
                <a href={`#${answerId(question, question.type)}`} class="underline underline-offset-2">
                  {plainLabel(question.label)} {errors[question.name]}
                </a>
              </li>
            ))}
          </ul>
        </Notice>
      )}

      <p class="text-sm text-ink-secondary">You can change your answers until the team reviews your application.</p>

      <AnswerFields questions={questions} drafts={drafts} errors={errors} />

      <div><Button type="submit" variant="primary" size="lg">Save answers</Button></div>
    </form>
  ) : answers.kind === "questions" && questions.length > 0 ? (
    <div data-application-answers-summary>
      <AnswerList items={questions.map((question) => ({ label: question.label, value: formatAnswer(question) }))} />
    </div>
  ) : answers.kind === "details" ? (
    <div class="flex flex-col gap-4" data-application-answers-summary>
      {answers.details.length > 0 && (
        <AnswerList items={answers.details.map((detail) => ({ label: detail.label, plain: true, value: detail.value }))} />
      )}
      {answers.hidden && (
        <p class="text-sm text-ink-muted">Some details recorded with this application can't be shown here.</p>
      )}
    </div>
  ) : (
    <div data-application-answers-summary>
      <Notice tone="info">{nothingRecorded}</Notice>
    </div>
  )
}
