---
import type { ComponentType } from "react";
import { CountBadge } from "@/components/platform/ui";

/**
 * One destination in a space's sidebar. `current` marks the page you are on.
 * A count is unread attention; `note` is quiet text such as "1 new".
 */
interface Props {
  href: string;
  label: string;
  icon?: ComponentType<{ className?: string; "aria-hidden"?: boolean }>;
  current?: boolean;
  count?: number;
  note?: string;
}

const { href, label, icon: Icon, current = false, count = 0, note } = Astro.props;
---

<li>
  <a
    href={href}
    aria-current={current ? "page" : undefined}
    class:list={[
      "flex min-h-10 items-center gap-3 rounded-xl px-2.5 py-2 text-[0.9375rem] leading-snug font-semibold transition-colors duration-150 motion-reduce:transition-none pointer-coarse:min-h-11",
      "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-peach-ink",
      current ? "bg-ink-primary/8 text-ink-primary" : "text-ink-secondary hover:bg-ink-primary/5 hover:text-ink-primary",
    ]}
  >
    {Icon && <Icon aria-hidden className="size-5 shrink-0" />}
    <span class="min-w-0 flex-1 break-words">{label}</span>
    {count > 0 ? <CountBadge count={count} label="new" /> : note && <span class="shrink-0 text-xs font-semibold text-ink-muted">{note}</span>}
  </a>
</li>
