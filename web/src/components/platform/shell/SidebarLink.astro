---
import type { ComponentType } from "react";
import { PiArrowUpRight } from "react-icons/pi";
import { CountBadge } from "@/components/platform/ui";
import { CHIP_TONES } from "@/components/platform/ui/tones";

/**
 * One destination in a space's sidebar. `current` marks the page you are on.
 * A count is unread attention unless `countLabel` says what it counts
 * instead; `note` is quiet text such as "Not open yet". `publicPage` marks a
 * link that leaves the app for the public website. `noteTone` shows the note
 * as a status chip, such as a request's "Pending". `emphasis` is for channels:
 * the name is bold while there is something unread, and quieter once read.
 */
interface Props {
  href: string;
  label: string;
  icon?: ComponentType<{ className?: string; "aria-hidden"?: boolean }>;
  current?: boolean;
  count?: number;
  /** Read after the number by screen readers. */
  countLabel?: string;
  note?: string;
  noteTone?: "ring";
  publicPage?: boolean;
  emphasis?: "read" | "unread";
}

const { href, label, icon: Icon, current = false, count = 0, countLabel = "new", note, noteTone, publicPage = false, emphasis } = Astro.props;
/*
 * With a note, the link's name is said in one string ("Mentor access, Pending"). The note is a
 * separate box, and a visually hidden separator between them would be read with a stray space
 * before its comma (QAO-09). The plain space before the note keeps the visible words apart for
 * tools that read the text itself (axe's label-in-name check): flex layout does not render it.
 */
const noted = count === 0 && note;
const name = noted ? `${label}${publicPage ? " (public website)" : ""}, ${note}` : undefined;
---

<li>
  <a
    href={href}
    aria-current={current ? "page" : undefined}
    aria-label={name}
    class:list={[
      "flex min-h-10 items-center gap-3 rounded-xl px-2.5 py-2 text-[0.9375rem] leading-snug transition-colors duration-150 motion-reduce:transition-none pointer-coarse:min-h-11",
      "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-peach-ink",
      // One colour and one weight each, so no two utilities compete.
      current ? "bg-ink-primary/8" : "hover:bg-ink-primary/5",
      current || emphasis === "unread" ? "text-ink-primary" : "text-ink-secondary hover:text-ink-primary",
      { read: "font-medium", unread: "font-bold", none: "font-semibold" }[emphasis ?? "none"],
    ]}
    data-emphasis={emphasis}
  >
    {Icon && <Icon aria-hidden className="size-5 shrink-0" />}
    <span class="min-w-0 flex-1 break-words" data-sidebar-label>
      {label}
      {publicPage && <span class="sr-only"> (public website)</span>}
    </span>
    {publicPage && <PiArrowUpRight aria-hidden className="size-4 shrink-0 text-ink-muted" />}
    {count > 0 ? <CountBadge count={count} label={countLabel} /> : note && (
      <>{" "}<span class:list={["shrink-0 text-xs font-semibold", noteTone ? ["rounded-full px-2 py-0.5", CHIP_TONES[noteTone]] : "text-ink-muted"]}>{note}</span></>
    )}
  </a>
</li>
