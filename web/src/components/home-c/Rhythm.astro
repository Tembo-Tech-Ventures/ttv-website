---
import { COHORT } from "@/lib/homepage/content";
import { atStep, rhythmNetwork } from "./graph";
import NetSvg from "./NetSvg.astro";

/**
 * How a cohort runs, told as one network changing state. On wide screens the
 * diagram is sticky and morphs as each step passes; on narrow screens every
 * step carries its own frame of the same diagram.
 */
const net = rhythmNetwork(COHORT.timeline);
const finalStep = atStep(net, 2);
const model = {
  nodeStates: net.nodeStates,
  edgeStates: net.edgeStates,
  ringStates: net.ringStates,
  views: net.views,
};
---

<div class="hc-rhythm hc-wrap" data-hc-rhythm>
  <div class="hc-rhythm__stage" aria-hidden="true">
    <div class="hc-rhythm__frame">
      <NetSvg net={finalStep} opacity={finalStep.opacity} name="rhythm" class="hc-rhythm__svg" />
    </div>
  </div>

  <ol class="hc-rhythm__steps" role="list">
    {
      COHORT.rhythm.map((step, i) => {
        const frame = atStep(net, i);
        return (
          <li class="hc-step" data-hc-step={i}>
            <div class="hc-step__text">
              <span class="hc-step__node" aria-hidden="true" />
              <h3 class="hc-step__title">{step.title}</h3>
              <p class="hc-step__copy">{step.copy}</p>
            </div>
            <div class="hc-step__figure" aria-hidden="true">
              <NetSvg net={frame} opacity={frame.opacity} name={`rhythm-${i}`} class="hc-step__svg" />
            </div>
          </li>
        );
      })
    }
  </ol>
  <script is:inline type="application/json" data-hc-rhythm-model set:html={JSON.stringify(model)} />
</div>

<style>
  .hc-rhythm {
    position: relative;
    margin-top: clamp(4.5rem, 9vw, 6rem);
  }

  .hc-rhythm__stage {
    display: none;
  }

  .hc-rhythm__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(3.5rem, 9vw, 4.5rem);
  }

  .hc-step__figure {
    border: 1px solid var(--hc-rule-t);
    border-radius: 1.25rem;
    background:
      radial-gradient(70% 70% at 50% 50%, rgba(242, 141, 104, 0.07), transparent 70%),
      var(--hc-panel);
    padding: 0.5rem;
    margin-top: 1.25rem;
  }

  .hc-step__text {
    position: relative;
  }

  /* Step frames are scaled down on phones: keep their labels readable. */
  @media (max-width: 639px) {
    .hc-step__figure :global(.hc-label) {
      font-size: 22px;
    }

    .hc-step__figure :global(.hc-label--quiet) {
      font-size: 17px;
    }
  }

  .hc-step__node {
    display: none;
  }

  .hc-step__title {
    margin: 0 0 0.6rem;
    font-size: clamp(1.375rem, 1.1rem + 1vw, 2rem);
    line-height: 1.2;
    color: var(--hc-ink);
  }

  .hc-step__copy {
    margin: 0;
    max-width: 30rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--hc-ink-2);
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .hc-rhythm__steps {
      gap: 3rem;
    }

    .hc-step {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 2rem;
      align-items: center;
    }

    .hc-step__figure {
      margin-top: 0;
    }
  }

  @media (min-width: 1024px) {
    .hc-rhythm {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: clamp(3rem, 6vw, 6rem);
    }

    /* Top-aligned, so the panel and the first step arrive together and the
       panel never waits half a screen below its text. */
    /* Only as tall as the panel, so it stays pinned until the last step has
       been read; top-aligned, so panel and first step arrive together. */
    .hc-rhythm__stage {
      display: block;
      position: sticky;
      top: calc(var(--hc-nav) + 1.5rem);
      align-self: start;
    }

    .hc-rhythm__frame {
      width: 100%;
      border: 1px solid var(--hc-rule-t);
      border-radius: 1.75rem;
      background:
        radial-gradient(60% 60% at 50% 50%, rgba(242, 141, 104, 0.08), transparent 70%),
        var(--hc-panel);
      padding: clamp(0.5rem, 1vw, 1rem);
      box-sizing: border-box;
    }

    .hc-rhythm__frame :global(.hc-rhythm__svg) {
      max-height: calc(100svh - var(--hc-nav) - 6rem);
      margin-inline: auto;
    }

    .hc-rhythm__steps {
      position: relative;
      gap: 0;
      border-left: 1px solid var(--hc-rule);
      padding-block: 6svh 8svh;
    }

    /* The rail fills as the story advances (set by the scroll scrub). */
    .hc-rhythm__steps::before {
      content: "";
      position: absolute;
      left: -1px;
      top: 0;
      width: 1px;
      height: 100%;
      background: var(--hc-peach);
      transform-origin: top;
      transform: scaleY(var(--hc-progress, 1));
    }

    .hc-step {
      min-height: 42svh;
      display: flex;
      align-items: center;
    }

    .hc-step__figure {
      display: none;
    }

    .hc-step__text {
      padding-left: clamp(1.75rem, 3vw, 2.75rem);
    }

    .hc-step__node {
      display: block;
      position: absolute;
      left: -0.4rem;
      top: 0.55rem;
      width: 0.8rem;
      height: 0.8rem;
      border-radius: 50%;
      border: 1.5px solid var(--hc-peach);
      background: var(--hc-dark);
      transition: background-color 400ms ease, transform 500ms var(--hc-ease);
    }

    .hc-step__title,
    .hc-step__copy {
      transition: color 400ms ease;
    }

    :global(.hc-motion) .hc-step:not(.is-active) .hc-step__title {
      color: var(--hc-ink-3);
    }

    :global(.hc-motion) .hc-step:not(.is-active) .hc-step__copy {
      color: rgba(255, 248, 242, 0.6);
    }

    .hc-step.is-active .hc-step__node {
      background: var(--hc-peach);
      transform: scale(1.25);
    }
  }
</style>
