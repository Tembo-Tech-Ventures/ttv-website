---
import { COHORT, COMMUNITY } from "@/lib/homepage/content";
import { heroNetwork } from "./graph";
import NetSvg from "./NetSvg.astro";
import Pill from "./Pill.astro";
import TextLink from "./TextLink.astro";
import Words from "./Words.astro";

const square = heroNetwork("square", COHORT.timeline);
const wide = heroNetwork("wide", COHORT.timeline);
const glyphs = ["builder", "live", "partner"] as const;
---

<div class="hc-hero hc-wrap" data-hc-hero>
  <div class="hc-hero__net">
    <NetSvg net={square} name="hero" class="hc-hero__svg hc-hero__svg--square" align="xMinYMid meet" />
    <NetSvg net={wide} name="hero" class="hc-hero__svg hc-hero__svg--wide" />
    <!-- A key at first sight: the same shapes the whole page uses. -->
    <ul class="hc-hero__legend" role="list">
      {
        COMMUNITY.paths.map((path) => (
          <li>
            <span class={`hc-hero__key hc-hero__key--${path.id}`} aria-hidden="true" />
            {path.role}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="hc-hero__copy">
    <!-- The words rise in CSS at first paint: the hero never waits for JS. -->
    <h1 id="hc-cohorts-title" class="hc-h1 hc-rise-load">
      <Words text={COHORT.title} accent="real software" />
    </h1>
    <p class="hc-lede hc-hero__summary hc-fade-load" style="--hc-fade-delay: 0.28s">{COHORT.summary}</p>
    <div class="hc-hero__cta hc-fade-load" style="--hc-fade-delay: 0.36s">
      <div class="hc-hero__actions">
        <Pill href={COHORT.apply.href} magnetic>{COHORT.apply.label}</Pill>
        <TextLink href={COHORT.secondary.href}>{COHORT.secondary.label}</TextLink>
      </div>
      <p class="hc-hero__eligibility">
        <span class="hc-hero__eligibility-glyph" aria-hidden="true"></span>
        {COHORT.eligibility}
      </p>
    </div>
  </div>

  <ul class="hc-facts" role="list">
    {
      COHORT.facts.map((fact, i) => (
        <li class="hc-fact hc-fade-load" style={`--hc-fade-delay: ${0.46 + i * 0.07}s`}>
          <span class="hc-fact__value">{fact.value}</span>
          <span class="hc-fact__label">
            <span class={`hc-fact__glyph hc-fact__glyph--${glyphs[i]}`} aria-hidden="true" />
            {fact.label}
          </span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .hc-hero {
    display: grid;
    grid-template-areas: "net" "copy" "facts";
    padding-top: clamp(1.25rem, 4vw, 2.5rem);
  }

  .hc-hero__net {
    grid-area: net;
    margin-inline: calc(var(--hc-pad) * -0.5);
    margin-bottom: clamp(1.25rem, 4vw, 2.5rem);
  }

  .hc-hero__net :global(.hc-hero__svg--square) {
    display: none;
  }

  /* Labels in the phone band are set in viewBox units: big enough to read
     (about 14 px numbers, 12 px status) once the band is scaled down. */
  @media (max-width: 639px) {
    .hc-hero__net :global(.hc-hero__svg--wide .hc-label) {
      font-size: 25px;
    }

    .hc-hero__net :global(.hc-hero__svg--wide .hc-label--quiet) {
      font-size: 21px;
    }
  }

  .hc-hero__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    margin: 0.5rem 0 0;
    padding: 0 calc(var(--hc-pad) * 0.5);
    list-style: none;
    color: var(--hc-ink-2);
    font-size: 0.8125rem;
  }

  .hc-hero__legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .hc-hero__key {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--hc-peach);
  }

  .hc-hero__key--mentor {
    background: transparent;
    border: 2px solid var(--hc-teal-l);
    box-sizing: border-box;
    width: 0.7rem;
    height: 0.7rem;
  }

  .hc-hero__key--partner {
    border-radius: 1px;
    background: var(--hc-ink);
    transform: rotate(45deg) scale(0.9);
  }

  .hc-hero__copy {
    grid-area: copy;
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 2.4vw, 1.75rem);
  }

  .hc-hero__summary {
    max-width: 34rem;
  }

  .hc-hero__cta {
    display: grid;
    justify-items: start;
    gap: 0.9rem;
    margin-top: 0.25rem;
  }

  .hc-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
  }

  .hc-hero__eligibility {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    padding-left: 0.35rem;
    color: var(--hc-ink);
    font-size: 1rem;
    font-weight: 500;
  }

  .hc-hero__eligibility-glyph {
    flex: none;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--hc-peach);
  }

  .hc-facts {
    grid-area: facts;
    list-style: none;
    margin: clamp(2.5rem, 6vw, 4rem) 0 0;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--hc-rule);
  }

  .hc-fact {
    display: grid;
    grid-template-columns: 4.75rem minmax(0, 1fr);
    align-items: baseline;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--hc-rule-t);
  }

  .hc-fact__value {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    letter-spacing: var(--tracking-heading);
    color: var(--hc-peach);
    line-height: 1;
  }

  .hc-fact__label {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--hc-ink-2);
    font-size: 0.975rem;
    line-height: 1.4;
  }

  .hc-fact__glyph {
    flex: none;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--hc-peach);
  }

  /* The same live mark as cohort 04 in the network: a peach dot with a halo. */
  .hc-fact__glyph--live {
    box-shadow: 0 0 0 3px var(--hc-dark), 0 0 0 4px rgba(242, 141, 104, 0.7);
  }

  .hc-fact__glyph--partner {
    border-radius: 1px;
    background: var(--hc-ink);
    transform: rotate(45deg) scale(0.9);
  }

  @media (min-width: 640px) {
    .hc-facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }

    .hc-fact {
      grid-template-columns: 1fr;
      gap: 0.85rem;
      padding-block: 1.75rem 0;
      border-bottom: 0;
    }

    .hc-fact__value {
      font-size: clamp(2rem, 1.2rem + 1.8vw, 2.75rem);
    }
  }

  @media (min-width: 1024px) {
    .hc-hero {
      grid-template-columns: var(--hc-split);
      grid-template-areas: "copy net" "facts facts";
      column-gap: var(--hc-gutter);
      align-items: center;
      min-height: calc(100svh - var(--hc-nav));
      align-content: center;
      padding-block: 2rem 2.5rem;
      box-sizing: border-box;
    }

    /* The h1 may use the gutter; the network starts exactly on the column line. */
    .hc-hero__copy {
      margin-right: calc(var(--hc-gutter) * -0.75);
    }

    .hc-hero__net {
      margin: 0 calc(var(--hc-pad) * -0.6) 0 0;
    }

    .hc-hero__net :global(.hc-hero__svg--square) {
      display: block;
      max-height: calc(100svh - var(--hc-nav) - 15rem);
    }

    .hc-hero__net :global(.hc-hero__svg--wide) {
      display: none;
    }

    /* Line the third fact up under the network column. */
    .hc-facts {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) calc((100% - var(--hc-gutter)) / 2);
      column-gap: var(--hc-gutter);
      margin-top: clamp(2rem, 4vh, 3.5rem);
    }
  }
</style>
