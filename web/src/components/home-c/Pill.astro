---
import Arrow from "./Arrow.astro";

interface Props {
  href: string;
  tone?: "peach" | "dark";
  /** Pointer-fine visitors get a magnetic pull towards the cursor. */
  magnetic?: boolean;
  class?: string;
}

const { href, tone = "peach", magnetic = false, class: className } = Astro.props;
---

<a href={href} class:list={["hc-pill", tone === "dark" && "hc-pill--dark", className]} data-hc-magnetic={magnetic ? "" : undefined}>
  <span class="hc-pill__label"><slot /></span>
  <span class="hc-pill__icon"><Arrow /></span>
</a>
