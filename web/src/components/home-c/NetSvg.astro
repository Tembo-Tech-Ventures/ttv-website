---
import type { Net, NetNode } from "./graph";

/**
 * Renders one constellation as inline SVG. The markup is the finished picture;
 * motion scripts read `data-*` positions back and animate from there.
 */
interface Props {
  net: Net;
  class?: string;
  /** Optional per-node opacity (staged networks flattened to one step). */
  opacity?: Record<string, number>;
  /** Hook for scripts. */
  name?: string;
}

const { net, class: className = "", opacity = {}, name } = Astro.props;
const at = new Map<string, NetNode>(net.nodes.map((node) => [node.id, node]));
const diamond = (r: number) => `M0 ${-r}L${r} 0L0 ${r}L${-r} 0Z`;
const view = net.view ?? { x: 0, y: 0, w: net.width, h: net.height };
---

<svg
  class:list={["hc-net", className]}
  viewBox={`${view.x} ${view.y} ${view.w} ${view.h}`}
  aria-hidden="true"
  focusable="false"
  data-hc-net={name}
>
  {
    net.rings.map((ring, i) => (
      <circle
        class={`hc-ring hc-ring--${ring.tone}`}
        data-ring={i}
        cx={ring.cx}
        cy={ring.cy}
        r={ring.r}
        pathLength="100"
        stroke-dasharray={`${100 - ring.gap * 100} ${ring.gap * 100}`}
        transform={`rotate(-58 ${ring.cx} ${ring.cy})`}
      />
    ))
  }
  <g class="hc-net__edges">
    {
      net.edges.map((edge) => {
        const a = at.get(edge.a)!;
        const b = at.get(edge.b)!;
        return (
          <line
            class={`hc-e hc-e--${edge.kind}`}
            data-e={edge.id}
            data-a={edge.a}
            data-b={edge.b}
            data-order={edge.order}
            x1={a.x}
            y1={a.y}
            x2={b.x}
            y2={b.y}
            pathLength="1"
          />
        );
      })
    }
  </g>
  <g class="hc-net__nodes">
    {
      net.nodes.map((node) => (
        <g
          class={`hc-n hc-n--${node.kind}`}
          data-n={node.id}
          data-kind={node.kind}
          data-order={node.order}
          transform={`translate(${node.x} ${node.y})`}
          opacity={opacity[node.id] === undefined ? undefined : opacity[node.id]}
        >
          <g class="hc-n__body">
            {node.kind === "live" && <circle class="hc-n__halo" r={node.r * 3} />}
            {(node.kind === "builder" || node.kind === "live") && <circle class="hc-n__dot" r={node.r} />}
            {node.kind === "mentor" && <circle class="hc-n__ring" r={node.r} />}
            {node.kind === "alum" && <circle class="hc-n__ring hc-n__ring--alum" r={node.r} />}
            {node.kind === "partner" && <path class="hc-n__diamond" d={diamond(node.r)} />}
            {node.kind === "hub" && (
              <>
                <circle class="hc-n__ring hc-n__ring--hub" r={node.r * 2.2} />
                <circle class="hc-n__dot" r={node.r * 0.7} />
              </>
            )}
          </g>
        </g>
      ))
    }
  </g>
  {
    net.labels.map((label) => (
      <text
        class={`hc-label hc-label--${label.tone}`}
        data-from={label.from}
        x={label.x}
        y={label.y}
        dy={label.tone === "quiet" ? "1.35em" : undefined}
        text-anchor={label.anchor}
      >
        {label.text}
      </text>
    ))
  }
</svg>
