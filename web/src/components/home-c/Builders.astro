---
import type { HomepageBuilder } from "@/lib/homepage/builders";
import { BUILDERS } from "@/lib/homepage/content";
import BuilderCard from "./BuilderCard.astro";
import TextLink from "./TextLink.astro";
import Words from "./Words.astro";

interface Props {
  builders: HomepageBuilder[];
}

const { builders } = Astro.props;
const count = builders.length;

/*
 * A closing tile fills whatever a row leaves empty, so 1, 3, 5 or 0 profiles
 * still end on a deliberate shape rather than a ragged hole.
 */
const remainder = (columns: number) => (count === 0 ? columns : (columns - (count % columns)) % columns);
const spanLg = remainder(4);
const spanMd = remainder(2);
// On phones the closing tile ends the rail, so it is always there.
const showSm = true;
// A loose, still-forming constellation for the closing tile: dashed links and
// open rings, waiting for the next profiles.
const ghostRings = [
  { x: 14, y: 48, r: 4 },
  { x: 46, y: 24, r: 3 },
  { x: 78, y: 62, r: 5 },
  { x: 116, y: 40, r: 3.5 },
  { x: 152, y: 70, r: 4 },
  { x: 190, y: 30, r: 3 },
  { x: 228, y: 46, r: 4.5 },
  { x: 266, y: 16, r: 3 },
  { x: 304, y: 56, r: 4 },
  { x: 342, y: 36, r: 3.5 },
];
const ghostPath = `M${ghostRings.map((ring) => `${ring.x} ${ring.y}`).join(" L")}`;
---

<section id="builders" class="hc-section hc-builders" aria-labelledby="hc-builders-title" data-hc-builders>
  <div class="hc-wrap">
    <header class="hc-builders__head">
      <h2 id="hc-builders-title" class="hc-h2" data-hc-words><Words text={BUILDERS.title} /></h2>
      <div class="hc-builders__intro" data-hc-reveal>
        <p class="hc-lede">{BUILDERS.summary}</p>
        <TextLink href={BUILDERS.all.href}>{BUILDERS.all.label}</TextLink>
      </div>
    </header>

    <p class="hc-builders__status" aria-live="polite" data-hc-status></p>
    <div class="hc-builders__grid" data-count={count} data-hc-rail>
      <svg class="hc-threads" aria-hidden="true" focusable="false" data-hc-threads></svg>
      {builders.map((builder) => <BuilderCard builder={builder} />)}
      {
        (spanLg > 0 || spanMd > 0 || showSm) && (
          <div
            class:list={["hc-ghost", { "hc-ghost--sm": showSm, "hc-ghost--md": spanMd > 0, "hc-ghost--lg": spanLg > 0 }]}
            style={`--hc-span-md:${Math.max(spanMd, 1)};--hc-span-lg:${Math.max(spanLg, 1)}`}
            data-hc-reveal
          >
            <svg class="hc-ghost__art" viewBox="0 0 356 84" preserveAspectRatio="xMinYMid meet" aria-hidden="true" focusable="false">
              <path class="hc-ghost__line" d={ghostPath} />
              {ghostRings.map((ring) => <circle class="hc-ghost__node" cx={ring.x} cy={ring.y} r={ring.r} />)}
            </svg>
            {count === 0 && <p class="hc-ghost__note">{BUILDERS.empty}</p>}
            <TextLink href={BUILDERS.all.href}>{BUILDERS.all.label}</TextLink>
          </div>
        )
      }
    </div>
    {
      count > 1 && (
        <div class="hc-rail-dots" aria-hidden="true" data-hc-rail-dots>
          {builders.map(() => <span />)}
          <span />
        </div>
      )
    }
  </div>
</section>

<style>
  .hc-builders__head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .hc-builders__intro {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
  }

  .hc-builders__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }

  .hc-threads {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 2;
  }

  :global(.hc-thread) {
    fill: none;
    stroke: var(--hc-peach);
    stroke-width: 1.25;
    stroke-linecap: round;
  }

  :global(.hc-thread-dot) {
    fill: var(--hc-peach);
  }

  .hc-ghost {
    display: none;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 11rem;
    padding: 1.35rem;
    border: 1px dashed rgba(127, 188, 178, 0.35);
    border-radius: 1.25rem;
    box-sizing: border-box;
  }

  .hc-ghost--sm {
    display: flex;
  }

  .hc-ghost__note {
    margin: 0;
    max-width: 32rem;
    color: var(--hc-ink-2);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .hc-ghost__art {
    width: 100%;
    max-width: 30rem;
    height: auto;
    overflow: visible;
  }

  .hc-ghost__line {
    fill: none;
    stroke: rgba(127, 188, 178, 0.4);
    stroke-dasharray: 2 5;
  }

  .hc-ghost__node {
    fill: var(--hc-dark);
    stroke: rgba(242, 141, 104, 0.7);
    stroke-width: 1.25;
  }

  .hc-builders__status {
    min-height: 0;
    margin: 0;
    color: var(--hc-peach);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .hc-builders__status:not(:empty) {
    margin-bottom: 1rem;
  }

  .hc-rail-dots {
    display: none;
  }

  /*
   * Phones: one swipeable rail instead of eight stacked cards. The next card
   * peeks in from the right; dots show where you are.
   */
  @media (max-width: 639px) {
    .hc-builders__grid {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 84%;
      gap: 0.75rem;
      margin-inline: calc(var(--hc-pad) * -1);
      padding: 0.25rem var(--hc-pad) 0.75rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--hc-pad);
      scrollbar-width: none;
    }

    .hc-builders__grid::-webkit-scrollbar {
      display: none;
    }

    .hc-builders__grid > :global(*) {
      scroll-snap-align: start;
    }

    .hc-threads {
      display: none;
    }

    .hc-rail-dots {
      display: flex;
      justify-content: center;
      gap: 0.5rem;
      margin-top: 0.5rem;
    }

    .hc-rail-dots span {
      width: 0.45rem;
      height: 0.45rem;
      border-radius: 50%;
      border: 1px solid rgba(242, 141, 104, 0.6);
      transition: background-color 250ms ease, transform 250ms ease;
    }

    .hc-rail-dots :global(span.is-on) {
      background: var(--hc-peach);
      transform: scale(1.25);
    }
  }

  @media (min-width: 640px) {
    .hc-builders__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hc-ghost {
      display: none;
    }

    .hc-ghost--md {
      display: flex;
      grid-column: span var(--hc-span-md);
    }
  }

  @media (min-width: 1024px) {
    .hc-builders__head {
      grid-template-columns: var(--hc-split);
      align-items: end;
      column-gap: var(--hc-gutter);
    }

    .hc-builders__intro {
      max-width: 32rem;
    }

    .hc-builders__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .hc-ghost--md {
      display: none;
    }

    .hc-ghost--lg {
      display: flex;
      grid-column: span var(--hc-span-lg);
    }
  }
</style>
