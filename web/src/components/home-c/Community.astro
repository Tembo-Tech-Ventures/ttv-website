---
import { COMMUNITY } from "@/lib/homepage/content";
import { communityNetwork } from "./graph";
import NetSvg from "./NetSvg.astro";
import Pill from "./Pill.astro";
import TextLink from "./TextLink.astro";
import Words from "./Words.astro";

interface Props {
  isAuthenticated: boolean;
}

const { isAuthenticated } = Astro.props;
const net = communityNetwork("square");
const wideNet = communityNetwork("wide");
---

<section id="community" class="hc-section hc-community" aria-labelledby="hc-community-title" data-hc-community>
  <div class="hc-wrap hc-community__grid">
    <div class="hc-community__intro">
      <h2 id="hc-community-title" class="hc-h2" data-hc-words><Words text={COMMUNITY.title} /></h2>
      <p class="hc-lede" data-hc-reveal>{COMMUNITY.summary}</p>
      <div data-hc-reveal>
        <Pill href={COMMUNITY.join(isAuthenticated)}>{COMMUNITY.joinLabel}</Pill>
      </div>
    </div>

    <div class="hc-community__body">
      <div class="hc-community__stage">
        <div class="hc-community__frame" data-role="all" data-hc-community-net>
          <div class="hc-community__art">
            <NetSvg net={net} name="community" class="hc-community__svg hc-community__svg--square" />
            <NetSvg net={wideNet} name="community" class="hc-community__svg hc-community__svg--wide" />
          </div>
          <!-- The legend is the control: each shape's pill pins its role. -->
          <div class="hc-legend">
            {
              COMMUNITY.paths.map((path) => (
                <button type="button" class="hc-legend__pill" data-role={path.id} aria-pressed="false" data-hc-role-toggle>
                  <span class={`hc-role__glyph hc-role__glyph--${path.id}`} aria-hidden="true" />
                  {path.role}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <ul class="hc-roles" role="list">
        {
          COMMUNITY.paths.map((path) => (
            <li class="hc-role" data-role={path.id} data-hc-role data-hc-reveal>
              <h3 class="hc-role__name">
                <span class={`hc-role__glyph hc-role__glyph--${path.id}`} aria-hidden="true" />
                {path.role}
              </h3>
              <p class="hc-role__promise">{path.promise}</p>
              <p class="hc-role__detail">{path.detail}</p>
              <TextLink href={path.href}>{path.cta}</TextLink>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .hc-community__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 3rem);
  }

  .hc-community__intro {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
  }

  /* Phones: the diagram is a sticky band the role cards scroll under, so the
     lit role is always in view beside its card. */
  .hc-community__stage {
    position: sticky;
    top: var(--hc-nav);
    z-index: 3;
    height: 15.5rem;
    margin-inline: calc(var(--hc-pad) * -1);
    padding: 0.5rem var(--hc-pad) 1.5rem;
    background: var(--hc-dark);
    /* Fade only below the pills, so nothing shows through between them. */
    mask-image: linear-gradient(180deg, #000 calc(100% - 1.25rem), transparent);
    box-sizing: border-box;
  }

  .hc-community__frame {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .hc-community__art {
    flex: 1;
    min-height: 0;
  }

  .hc-community__frame :global(.hc-community__svg) {
    height: 100%;
  }

  .hc-community__frame :global(.hc-community__svg--square) {
    display: none;
  }

  /* The band's camera moves in: keep the drawing inside the band. */
  .hc-community__frame :global(.hc-community__svg--wide) {
    overflow: hidden;
  }

  .hc-legend__pill.is-lit {
    border-color: rgba(242, 141, 104, 0.6);
    background: rgba(242, 141, 104, 0.1);
  }

  .hc-legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }

  .hc-legend__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--hc-rule-t);
    border-radius: 999px;
    background: rgba(1, 42, 40, 0.8);
    color: var(--hc-ink);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 250ms ease, background-color 250ms ease, color 250ms ease;
  }

  .hc-legend__pill:hover {
    border-color: rgba(242, 141, 104, 0.6);
  }

  .hc-legend__pill[aria-pressed="true"] {
    border-color: var(--hc-peach);
    background: rgba(242, 141, 104, 0.16);
  }

  .hc-legend .hc-role__glyph {
    width: 0.65rem;
    height: 0.65rem;
  }

  .hc-legend .hc-role__glyph--partner {
    width: 0.55rem;
    height: 0.55rem;
  }

  .hc-roles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .hc-role {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 0.6rem;
    padding: 1.35rem 1.4rem 1rem;
    border: 1px solid var(--hc-rule-t);
    border-radius: 1.25rem;
    background: var(--hc-panel);
    transition:
      border-color 350ms ease,
      background-color 350ms ease,
      transform 500ms var(--hc-ease);
  }

  .hc-role.is-lit {
    border-color: rgba(242, 141, 104, 0.6);
    background: rgba(6, 63, 58, 0.85);
  }

  .hc-role__glyph {
    flex: none;
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    background: var(--hc-peach);
    transition: transform 400ms var(--hc-ease);
  }

  .hc-role__glyph--mentor {
    background: transparent;
    border: 2px solid var(--hc-teal-l);
    box-sizing: border-box;
  }

  .hc-role__glyph--partner {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 1px;
    background: var(--hc-ink);
    transform: rotate(45deg);
  }

  .hc-role.is-lit .hc-role__glyph {
    transform: scale(1.3);
  }

  .hc-role.is-lit .hc-role__glyph--partner {
    transform: rotate(45deg) scale(1.3);
  }

  .hc-role__name {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .hc-role__name {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hc-role__promise {
    margin: 0;
    color: var(--hc-ink);
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .hc-role__detail {
    margin: 0;
    color: var(--hc-teal-l);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  /* Role highlighting: dim everything that is not the lit role. */
  .hc-community__frame :global(.hc-n),
  .hc-community__frame :global(.hc-e) {
    transition: opacity 450ms ease;
  }

  .hc-community__frame:not([data-role="all"]) :global(.hc-e),
  .hc-community__frame:not([data-role="all"]) :global(.hc-n),
  .hc-community__frame:not([data-role="all"]) :global(.hc-ring) {
    opacity: 0.16;
  }

  .hc-community__frame[data-role="builder"] :global(:is(.hc-n--builder, .hc-e--peer)),
  .hc-community__frame[data-role="mentor"] :global(:is(.hc-n--mentor, .hc-e--mentor)),
  .hc-community__frame[data-role="partner"] :global(:is(.hc-n--partner, .hc-e--partner)) {
    opacity: 1;
  }

  .hc-community__frame[data-role="mentor"] :global(.hc-n--builder),
  .hc-community__frame[data-role="partner"] :global(.hc-n--builder) {
    opacity: 0.55;
  }

  .hc-community__frame[data-role="builder"] :global(.hc-n--live),
  .hc-community__frame[data-role="builder"] :global(.hc-ring),
  .hc-community__frame[data-role="builder"] :global(.hc-e--hub) {
    opacity: 0.6;
  }

  /* Tablets and up: the diagram sits beside the cards and stays put. */
  /* Tablets: a tidy left-aligned column of pills under the drawing. */
  @media (min-width: 640px) and (max-width: 1023px) {
    .hc-legend {
      display: grid;
      justify-items: start;
      justify-content: start;
    }
  }

  @media (min-width: 640px) {
    .hc-community__body {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 2rem;
      align-items: start;
    }

    .hc-community__stage {
      position: relative;
      top: auto;
      height: 100%;
      margin: 0;
      padding: 0;
      background: none;
      mask-image: none;
    }

    .hc-community__frame {
      position: sticky;
      top: calc(var(--hc-nav) + 1.5rem);
      height: auto;
    }

    .hc-community__frame :global(.hc-community__svg) {
      height: auto;
      max-height: calc(100svh - var(--hc-nav) - 8rem);
    }

    .hc-community__frame :global(.hc-community__svg--square) {
      display: block;
    }

    .hc-community__frame :global(.hc-community__svg--wide) {
      display: none;
    }

    .hc-legend {
      gap: 0.5rem;
      margin-top: 1rem;
    }

    .hc-legend__pill {
      font-size: 0.875rem;
      padding-inline: 0.9rem;
    }
  }

  @media (min-width: 1024px) {
    .hc-community__grid {
      grid-template-columns: var(--hc-split);
      grid-template-areas: "intro stage" "roles stage";
      grid-template-rows: auto 1fr;
      column-gap: var(--hc-gutter);
      row-gap: 2.5rem;
    }

    .hc-community__body {
      display: contents;
    }

    .hc-community__intro {
      grid-area: intro;
    }

    .hc-community__stage {
      grid-area: stage;
    }

    .hc-roles {
      grid-area: roles;
    }

    .hc-community__frame {
      top: calc(var(--hc-nav) + 2rem);
    }
  }
</style>
