---
import { PRINCIPLES } from "@/lib/homepage/content";
import Words from "./Words.astro";

/*
 * Mattone advance widths at font-size 100 and letter-spacing -0.02em, measured
 * in Chromium. Every word gets its own viewBox from these, and all words share
 * one scale, so none is ever cropped or stretched. Unknown words fall back to
 * a generous estimate (Mattone capitals run just under 1em each).
 */
const ADVANCE: Record<string, number> = {
  COMMUNITY: 878,
  PHILOSOPHY: 930,
  EQUITY: 533,
  CONTINUITY: 882,
  HONESTY: 693,
};
const PAD = 6;
const TOP = 84; // cap height is 78 units
const BOTTOM = 24; // the tail of Q in EQUITY descends 20 units
const words = PRINCIPLES.values.map((value) => {
  const advance = ADVANCE[value.word] ?? Math.ceil(value.word.length * 100);
  return { ...value, width: advance + PAD * 2 };
});
const widest = Math.max(...words.map((word) => word.width));
---

<section id="principles" class="hc-section hc-principles" aria-labelledby="hc-principles-title" data-hc-principles>
  <div class="hc-wrap">
    <h2 id="hc-principles-title" class="hc-h2 hc-principles__title" data-hc-words><Words text={PRINCIPLES.title} /></h2>
    <ol class="hc-principles__list" role="list">
      {
        words.map((value) => (
          <li class="hc-principle" data-hc-principle>
            <h3 class="hc-principle__word">
              <span class="hc-principle__ink" style={`--hc-word-share:${((value.width / widest) * 100).toFixed(3)}%`}>
                <svg
                  class="hc-principle__svg"
                  viewBox={`${-PAD} ${-TOP} ${value.width} ${TOP + BOTTOM}`}
                  focusable="false"
                >
                  <text class="hc-principle__text" x="0" y="0">
                    {value.word}
                  </text>
                </svg>
                <span class="hc-principle__caret" aria-hidden="true"></span>
              </span>
            </h3>
            <p class="hc-principle__commitment" data-hc-commitment>
              {value.commitment}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .hc-principles__title {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .hc-principles__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-block: 1px solid var(--hc-rule);
  }

  .hc-principle {
    display: grid;
    gap: 0.75rem;
    padding-block: clamp(1.5rem, 4vw, 3rem);
  }

  /*
   * The finale, and the one sanctioned exception to "the h1 is the loudest
   * type": the h1 rules above the fold; here the five values close the page at
   * full content width, paired with the footer's outlined wordmark. Every word
   * shares one scale, set so the widest (PHILOSOPHY) fills the column exactly
   * (about 127 px type at 1440, 37 px at 390). The viewBoxes come from measured
   * advance widths, so no word is ever cropped or stretched.
   */
  .hc-principle__word {
    margin: 0;
    width: 100%;
  }

  .hc-principle__ink {
    position: relative;
    display: block;
    width: var(--hc-word-share);
  }

  .hc-principle__svg {
    display: block;
    width: 100%;
    height: auto;
    /* Chromium's text box is taller than the glyphs; the viewBox is sized to
       the glyphs, so let the box breathe rather than clip it. */
    overflow: visible;
  }

  .hc-principle__text {
    font-family: var(--font-heading);
    font-size: 100px;
    letter-spacing: -2px;
    fill: transparent;
    stroke: var(--hc-peach);
    stroke-width: 1.75px;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    transition: fill 450ms ease;
  }

  /*
   * Exactly one word is solid at a time: the one crossing the middle of the
   * screen. Hovering another row moves that single fill rather than adding one.
   */
  .hc-principle:hover .hc-principle__text,
  :global(.hc-principle.is-current) .hc-principle__text {
    fill: var(--hc-peach);
  }

  .hc-principles__list:hover .hc-principle:not(:hover) .hc-principle__text {
    fill: transparent;
  }

  /* The wipe (motion only): the finished outline is uncovered left to right,
     led by a caret, so no frame ever shows a fragment of a letter. */
  .hc-principle__caret {
    display: none;
  }

  :global(.hc-wiping) .hc-principle__svg {
    clip-path: inset(-30% var(--hc-wipe, 0%) -40% -4%);
  }

  :global(.hc-caret-on) .hc-principle__caret {
    display: block;
    position: absolute;
    top: -12%;
    bottom: -18%;
    left: calc(100% - var(--hc-wipe, 0%));
    width: 2px;
    background: var(--hc-peach);
    opacity: var(--hc-caret, 1);
  }

  .hc-principle__commitment {
    margin: 0;
    max-width: 34rem;
    font-size: clamp(1.125rem, 0.95rem + 0.8vw, 1.6rem);
    line-height: 1.45;
    color: var(--hc-ink);
    text-wrap: pretty;
  }

  @media (prefers-reduced-motion: reduce) {
    .hc-principle__text {
      transition: none;
    }
  }
</style>
