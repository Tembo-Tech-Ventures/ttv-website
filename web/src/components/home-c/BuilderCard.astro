---
import type { HomepageBuilder } from "@/lib/homepage/builders";
import { formatCohortLocation } from "@/lib/site";
import { signature, tagKey } from "./graph";

interface Props {
  builder: HomepageBuilder;
}

const { builder } = Astro.props;
const language = builder.project?.language ?? null;
const sig = signature(builder.skills, language);
const tags = [...new Set([...builder.skills.map(tagKey), ...(language ? [tagKey(language)] : [])])];
const meta = formatCohortLocation(builder.cohort, builder.country);
---

<article class="hc-card" data-hc-card data-tags={tags.join("|")} data-href={builder.href}>
  <div class="hc-card__head">
    <div class="hc-sig" aria-hidden="true">
      <svg class="hc-sig__svg" viewBox="0 0 112 112" focusable="false">
        <circle class="hc-sig__orbit" cx="56" cy="56" r="44.8"></circle>
        {sig.arcs.map((arc) => <path class="hc-sig__arc" d={arc.d} pathLength="1" />)}
        {sig.nodes.map((node) => <line class="hc-sig__spoke" x1="56" y1="56" x2={node.x} y2={node.y} pathLength="1" />)}
        {
          sig.nodes.map((node) => (
            <g class={`hc-sig__node hc-sig__node--${node.kind}`} data-sig-tag={node.tag} transform={`translate(${node.x} ${node.y})`}>
              {node.kind === "skill" ? <circle r="5" /> : <path d="M0 -5.5L5.5 0L0 5.5L-5.5 0Z" />}
            </g>
          ))
        }
      </svg>
      <div class="hc-sig__face">
        {builder.image ? <img src={builder.image} alt="" width="56" height="56" loading="lazy" decoding="async" /> : <span>{builder.initials}</span>}
      </div>
    </div>
    <div class="hc-card__id">
      <h3 class="hc-card__name"><a href={builder.href}>{builder.name}</a></h3>
      {meta && <p class="hc-card__meta">{meta}</p>}
    </div>
  </div>

  {builder.headline && <p class="hc-card__headline">{builder.headline}</p>}

  {
    builder.project && (
      <div class="hc-card__project">
        <p class="hc-card__project-name">
          <span>{builder.project.name}</span>
          {language && (
            <span class="hc-card__lang" data-tag={tagKey(language)}>
              {language}
            </span>
          )}
        </p>
        {builder.project.description && <p class="hc-card__project-copy">{builder.project.description}</p>}
      </div>
    )
  }

  {
    builder.skills.length > 0 && (
      <ul class="hc-chips" role="list">
        {builder.skills.map((skill, i) => (
          <li>
            <button type="button" class="hc-chip" data-tag={tagKey(skill)} aria-pressed="false" tabindex={i === 0 ? 0 : -1}>
              {skill}
            </button>
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .hc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
    padding: 1.35rem 1.35rem 1.25rem;
    border: 1px solid var(--hc-rule-t);
    border-radius: 1.25rem;
    background: linear-gradient(180deg, rgba(6, 63, 58, 0.72), rgba(1, 42, 40, 0.72));
    cursor: pointer;
    transition:
      border-color 350ms ease,
      background-color 350ms ease,
      transform 500ms var(--hc-ease),
      opacity 350ms ease;
  }

  .hc-card:hover,
  .hc-card:focus-within,
  .hc-card.is-source {
    border-color: rgba(242, 141, 104, 0.7);
  }

  .hc-card.is-linked {
    border-color: rgba(242, 141, 104, 0.45);
  }

  /* Unrelated cards step back through their frame and signature only; their
     text keeps full contrast. */
  :global(.hc-builders.has-focus) .hc-card:not(.is-source):not(.is-linked) {
    border-color: transparent;
    background: rgba(1, 42, 40, 0.5);
  }

  :global(.hc-builders.has-focus) .hc-card:not(.is-source):not(.is-linked) .hc-sig {
    opacity: 0.35;
    filter: saturate(0.3);
  }

  .hc-sig {
    transition: opacity 350ms ease, filter 350ms ease;
  }

  .hc-card__head {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .hc-sig {
    position: relative;
    flex: none;
    width: 5.5rem;
    height: 5.5rem;
    margin: -0.35rem 0 -0.35rem -0.35rem;
  }

  .hc-sig__svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .hc-sig__orbit {
    fill: none;
    stroke: rgba(127, 188, 178, 0.25);
    stroke-dasharray: 1.5 4;
  }

  .hc-sig__arc {
    fill: none;
    stroke: rgba(242, 141, 104, 0.6);
    stroke-width: 1.25;
  }

  .hc-sig__spoke {
    stroke: rgba(242, 141, 104, 0.35);
    stroke-width: 1;
  }

  .hc-sig__node {
    transition: transform 400ms var(--hc-ease);
  }

  .hc-sig__node circle {
    fill: var(--hc-dark);
    stroke: var(--hc-peach);
    stroke-width: 1.5;
    transition: fill 300ms ease;
  }

  .hc-sig__node path {
    fill: var(--hc-ink);
  }

  :global(.hc-sig__node.is-shared) circle {
    fill: var(--hc-peach);
  }

  .hc-sig__face {
    position: absolute;
    inset: 27%;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--hc-peach);
    color: var(--hc-dark);
    overflow: hidden;
  }

  .hc-sig__face span {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .hc-sig__face img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hc-card__id {
    min-width: 0;
  }

  .hc-card__name {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.3;
  }

  .hc-card__name a {
    color: var(--hc-ink);
    text-decoration: none;
  }

  .hc-card__name a:hover {
    color: var(--hc-peach);
  }

  .hc-card__meta {
    margin: 0.2rem 0 0;
    color: var(--hc-ink-3);
    font-size: 0.875rem;
  }

  .hc-card__headline {
    margin: 0;
    color: var(--hc-ink-2);
    font-size: 0.975rem;
    line-height: 1.5;
  }

  .hc-card__project {
    padding-top: 0.9rem;
    border-top: 1px solid var(--hc-rule);
  }

  .hc-card__project-name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 0.75rem;
    margin: 0;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--hc-ink);
  }

  .hc-card__lang {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 500;
    font-size: 0.8125rem;
    color: var(--hc-ink-2);
    transition: color 300ms ease;
  }

  .hc-card__lang::before {
    content: "";
    width: 0.45rem;
    height: 0.45rem;
    background: var(--hc-ink);
    transform: rotate(45deg);
  }

  :global(.hc-card__lang.is-shared) {
    color: var(--hc-peach);
  }

  .hc-card__project-copy {
    margin: 0.35rem 0 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--hc-ink-3);
  }

  .hc-chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: auto 0 0;
    padding: 0;
  }

  .hc-chip {
    position: relative;
    z-index: 1;
    min-height: 2rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid rgba(242, 141, 104, 0.35);
    border-radius: 999px;
    background: transparent;
    color: var(--hc-ink);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color 250ms ease,
      color 250ms ease,
      border-color 250ms ease;
  }

  /* 32 px to look at, 44 px to hit. */
  .hc-chip::after {
    content: "";
    position: absolute;
    inset: -6px -2px;
  }

  .hc-chip:hover {
    border-color: var(--hc-peach);
  }

  :global(.hc-chip.is-shared),
  .hc-chip[aria-pressed="true"] {
    background: var(--hc-peach);
    border-color: var(--hc-peach);
    color: var(--hc-dark);
  }
</style>
