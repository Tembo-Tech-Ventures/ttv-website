---
import type { HomepageBuilder } from "@/lib/homepage/builders";
import { HIRE } from "@/lib/homepage/content";

/**
 * Two overlapping cards on the one warm sheet in the stack. They part and the
 * one you point at (or focus) lifts; on scroll they arrive more tightly
 * overlapped and settle apart (`hire.ts`).
 */
interface Props {
  builders: HomepageBuilder[];
}

const { builders } = Astro.props;
const faces = builders.slice(0, 4);
---

<div class="hb-hire">
  <div class="hb-hire__copy">
    <h2 id="hb-hire-title" class="hb-h2 font-heading tracking-heading">{HIRE.title}</h2>
    <p class="hb-hire__summary">{HIRE.summary}</p>
  </div>

  <div class="hb-hire__pair" data-hb-hire>
    <div class="hb-hslot hb-hslot--primary" data-hb-hire-card>
    <a class="hb-hcard hb-hcard--primary" href={HIRE.primary.href}>
      <span class="hb-hcard__brief" aria-hidden="true">
        <span style="--w:70%" /><span style="--w:92%" /><span style="--w:84%" /><span style="--w:48%" />
      </span>
      <span class="hb-hcard__label">{HIRE.primary.label}</span>
      <span class="hb-hcard__path" aria-hidden="true">{HIRE.primary.href}</span>
      <span class="hb-hcard__arrow" aria-hidden="true">
        <svg viewBox="0 0 20 20" width="20" height="20"><path d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </span>
    </a>
    </div>
    <div class="hb-hslot hb-hslot--secondary" data-hb-hire-card>
    <a class="hb-hcard hb-hcard--secondary" href={HIRE.secondary.href}>
      <span class="hb-hcard__faces" aria-hidden="true">
        {faces.length > 0
          ? faces.map((builder) => <span class="font-heading">{builder.initials}</span>)
          : [0, 1, 2].map(() => <span />)}
      </span>
      <span class="hb-hcard__label">{HIRE.secondary.label}</span>
      <span class="hb-hcard__path" aria-hidden="true">{HIRE.secondary.href}</span>
      <span class="hb-hcard__arrow" aria-hidden="true">
        <svg viewBox="0 0 20 20" width="20" height="20"><path d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </span>
    </a>
    </div>
  </div>
</div>

<style>
  .hb-hire {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }

  @media (min-width: 64rem) {
    .hb-hire {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: clamp(3rem, 6vw, 6rem);
    }
  }

  .hb-hire :global(.hb-h2) {
    color: var(--color-dark);
  }

  .hb-hire__summary {
    margin: 1.25rem 0 0;
    max-width: 30rem;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.2rem);
    line-height: 1.6;
    color: #01302c;
  }

  /* ---------- The overlapping pair ---------- */
  .hb-hire__pair {
    --overlap: clamp(2.5rem, 7vw, 4.5rem);
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-block: 0.5rem 1rem;
  }

  .hb-hcard {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    align-content: start;
    min-height: 13.5rem;
    padding: clamp(1.4rem, 3vw, 2rem);
    border-radius: 1.5rem;
    text-decoration: none;
    box-shadow: 0 28px 50px -28px rgb(1 30 28 / 0.75);
    transition:
      translate 420ms cubic-bezier(0.2, 0.8, 0.2, 1),
      rotate 420ms cubic-bezier(0.2, 0.8, 0.2, 1),
      scale 420ms cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 420ms ease;
  }

  /* GSAP moves the slots on scroll; the cards inside keep their CSS pose and hover. */
  .hb-hslot {
    position: relative;
  }

  .hb-hslot--primary {
    z-index: 1;
  }

  .hb-hslot--secondary {
    z-index: 2;
    margin-top: calc(-1 * var(--overlap));
  }

  .hb-hslot:has(.hb-hcard:hover, .hb-hcard:focus-visible) {
    z-index: 3;
  }

  .hb-hcard--primary {
    width: 88%;
    padding-bottom: calc(clamp(1.4rem, 3vw, 2rem) + var(--overlap));
    background: var(--color-dark);
    color: var(--color-ink-primary);
    rotate: -2deg;
  }

  .hb-hcard--secondary {
    width: 82%;
    margin-left: auto;
    background: #fff8f2;
    color: var(--color-dark);
    rotate: 2deg;
  }

  .hb-hcard__label {
    align-self: end;
    font-size: clamp(1.4rem, 1.1rem + 1.1vw, 2rem);
    font-weight: 700;
    line-height: 1.15;
  }

  .hb-hcard__path {
    margin-top: 0.4rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.875rem;
    opacity: 0.75;
  }

  .hb-hcard__arrow {
    position: absolute;
    right: clamp(1.4rem, 3vw, 2rem);
    bottom: clamp(1.4rem, 3vw, 2rem);
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    transition: translate 320ms cubic-bezier(0.2, 0.8, 0.2, 1), rotate 320ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hb-hcard--primary .hb-hcard__arrow {
    top: clamp(1.4rem, 3vw, 2rem);
    bottom: auto;
    background: var(--color-primary);
    color: var(--color-dark);
  }

  .hb-hcard--secondary .hb-hcard__arrow {
    background: var(--color-dark);
    color: var(--color-ink-primary);
  }

  .hb-hcard__brief {
    display: grid;
    gap: 0.5rem;
    width: min(60%, 13rem);
    margin-bottom: 1.75rem;
    padding: 0.9rem;
    border-radius: 0.6rem;
    background: rgb(255 248 242 / 0.07);
    border: 1px dashed rgb(242 141 104 / 0.55);
  }

  .hb-hcard__brief span {
    display: block;
    width: var(--w);
    height: 0.4rem;
    border-radius: 999px;
    background: rgb(255 248 242 / 0.3);
  }

  .hb-hcard__brief span:first-child {
    background: var(--color-primary);
  }

  .hb-hcard__faces {
    display: flex;
    margin-bottom: 1.75rem;
  }

  .hb-hcard__faces span {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.8rem;
    border: 2px solid #fff8f2;
    background: var(--color-primary);
    color: var(--color-dark);
    font-size: 0.8rem;
    transition: translate 360ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hb-hcard__faces span:nth-child(even) {
    background: var(--color-teal);
    color: var(--color-ink-primary);
  }

  .hb-hcard__faces span + span {
    margin-left: -0.6rem;
  }

  /* Part on hover or focus; the one you are on comes forward. */
  .hb-hire__pair:hover .hb-hcard--primary,
  .hb-hire__pair:focus-within .hb-hcard--primary {
    translate: -0.75rem -0.6rem;
    rotate: -4deg;
  }

  .hb-hire__pair:hover .hb-hcard--secondary,
  .hb-hire__pair:focus-within .hb-hcard--secondary {
    translate: 0.75rem 0.9rem;
    rotate: 3.5deg;
  }

  .hb-hcard:hover,
  .hb-hcard:focus-visible {
    scale: 1.02;
    box-shadow: 0 40px 70px -30px rgb(1 30 28 / 0.85);
  }

  .hb-hcard:hover .hb-hcard__arrow,
  .hb-hcard:focus-visible .hb-hcard__arrow {
    translate: 4px 0;
    rotate: -45deg;
  }

  .hb-hcard:hover .hb-hcard__faces span + span,
  .hb-hcard:focus-visible .hb-hcard__faces span + span {
    translate: 0.35rem 0;
  }

  .hb-hcard:hover .hb-hcard__faces span + span + span,
  .hb-hcard:focus-visible .hb-hcard__faces span + span + span {
    translate: 0.7rem 0;
  }

  .hb-hcard:hover .hb-hcard__faces span + span + span + span,
  .hb-hcard:focus-visible .hb-hcard__faces span + span + span + span {
    translate: 1.05rem 0;
  }

  .hb-hcard:focus-visible {
    outline: 3px solid var(--color-dark);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .hb-hcard,
    .hb-hcard__arrow,
    .hb-hcard__faces span {
      transition: none;
    }
  }
</style>
