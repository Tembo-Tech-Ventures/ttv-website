---
import { COMMUNITY } from "@/lib/homepage/content";

/**
 * Three ways into the community as ARIA tabs with a sliding indicator. Each
 * panel pairs the role's promise with a small layered composition that
 * assembles itself when the tab opens (`community.ts`). Without JS a
 * <noscript> style shows all three panels and drops the tab row.
 */
interface Props {
  isAuthenticated: boolean;
}

const { isAuthenticated } = Astro.props;
const paths = COMMUNITY.paths;
---

<div class="hb-community" data-hb-tabs>
  <div class="hb-community__intro">
      <h2 id="hb-community-title" class="hb-h2 font-heading tracking-heading">{COMMUNITY.title}</h2>
      <p class="hb-lede">{COMMUNITY.summary}</p>
  </div>

  <div class="hb-community__bar">
  <div class="hb-seg" role="tablist" aria-label="Ways to join" data-hb-tablist>
    {paths.map((path, index) => (
      <button
        type="button"
        class="hb-seg__tab"
        role="tab"
        id={`hb-tab-${path.id}`}
        aria-controls={`hb-panel-${path.id}`}
        aria-selected={index === 0 ? "true" : "false"}
        tabindex={index === 0 ? 0 : -1}
        data-hb-tab
      >
        {index === 0 && <span class="hb-seg__pill" aria-hidden="true" data-hb-pill />}
        <span class="hb-seg__label">{path.role}</span>
      </button>
    ))}
  </div>
    <a class="hb-pill-ghost" href={COMMUNITY.join(isAuthenticated)}>
      Join the community
      <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18"><path d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </a>
  </div>

  <div class="hb-panels">
    {paths.map((path, index) => (
      <div
        class="hb-panel"
        role="tabpanel"
        id={`hb-panel-${path.id}`}
        aria-labelledby={`hb-tab-${path.id}`}
        hidden={index !== 0}
        data-hb-panel
      >
        <div class="hb-panel__copy" data-hb-panel-copy>
          <p class="hb-panel__promise">{path.promise}</p>
          <p class="hb-panel__detail">
            <span class="hb-panel__badge" aria-hidden="true">
              {path.id === "builder" ? (
                <svg viewBox="0 0 16 16" width="14" height="14"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              ) : (
                <svg viewBox="0 0 16 16" width="14" height="14"><path d="M8 1.5l5.5 2v4c0 3.4-2.3 5.9-5.5 7-3.2-1.1-5.5-3.6-5.5-7v-4z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
              )}
            </span>
            {path.detail}
          </p>
          <a class="hb-arrow-link" href={path.href}>
            {path.cta}
            <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18"><path d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
        </div>

        <div class={`hb-comp hb-comp--${path.id}`} aria-hidden="true" data-hb-comp>
          {path.id === "builder" && (
            <>
              <span class="hb-piece hb-sheet-card hb-comp__profile" data-hb-piece>
                <span class="hb-comp__avatar" />
                <span class="hb-bars"><span style="--w:62%" /><span style="--w:88%" /><span style="--w:44%" /></span>
                <span class="hb-chips"><span /><span /><span /></span>
              </span>
              <span class="hb-piece hb-sheet-card hb-comp__work" data-hb-piece>
                <span class="hb-comp__repo" />
                <span class="hb-bars"><span style="--w:90%" /><span style="--w:70%" /></span>
                <span class="hb-comp__part"><span /><span style="--w:58%" /></span>
              </span>
              <span class="hb-piece hb-comp__tag" data-hb-piece />
            </>
          )}
          {path.id === "mentor" && (
            <>
              <span class="hb-piece hb-sheet-card hb-comp__code" data-hb-piece>
                <span class="hb-code"><span style="--w:40%;--c:#f28d68" /><span style="--w:72%;--i:1" /><span style="--w:58%;--i:1" /><span style="--w:66%;--i:2;--c:#ffd166" /><span style="--w:48%;--i:2" /><span style="--w:30%;--i:1" /><span style="--w:20%" /></span>
              </span>
              <span class="hb-piece hb-comp__highlight" data-hb-piece />
              <span class="hb-piece hb-comp__note" data-hb-piece>
                <span class="hb-comp__pin" />
                <span class="hb-bars hb-bars--dark"><span style="--w:84%" /><span style="--w:92%" /><span style="--w:52%" /></span>
                <span class="hb-comp__sig" />
              </span>
            </>
          )}
          {path.id === "partner" && (
            <>
              <span class="hb-piece hb-sheet-card hb-comp__shortlist" data-hb-piece />
              <span class="hb-piece hb-sheet-card hb-comp__search" data-hb-piece>
                <span class="hb-comp__field">
                  <svg viewBox="0 0 16 16" width="14" height="14"><circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                  <span class="hb-comp__caret" />
                </span>
                {[0, 1, 2].map((row) => (
                  <span class:list={["hb-comp__result", { "is-hit": row === 1 }]}>
                    <span class="hb-comp__dot" />
                    <span class="hb-bars"><span style={`--w:${[70, 82, 60][row]}%`} /><span style={`--w:${[46, 54, 38][row]}%`} /></span>
                    <span class="hb-comp__chip" />
                  </span>
                ))}
              </span>
            </>
          )}
        </div>
      </div>
    ))}
  </div>
</div>

<noscript>
  <style is:inline>
    .hb-seg { display: none !important; }
    .hb-panel[hidden] { display: grid !important; }
  </style>
</noscript>

<style>
  .hb-community__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  .hb-pill-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3.25rem;
    padding: 0 1.5rem;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-dark);
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 10px 24px -12px rgb(242 141 104 / 0.6);
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hb-pill-ghost:hover,
  .hb-pill-ghost:focus-visible {
    transform: translateY(-2px);
  }

  /* When the bar wraps, the tabs stay right above the panel they control. */
  @media (max-width: 63.99rem) {
    .hb-pill-ghost {
      order: -1;
    }
  }

  .hb-pill-ghost:focus-visible {
    outline: 2px solid var(--color-ink-primary);
    outline-offset: 4px;
  }

  /* ---------- Segmented control ---------- */
  .hb-seg {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.25rem;
    width: min(100%, 36rem);
    padding: 0.35rem;
    border-radius: 999px;
    background: rgb(1 46 43 / 0.7);
    border: 1px solid rgb(255 248 242 / 0.1);
    box-shadow: 0 1px 0 rgb(255 248 242 / 0.06), inset 0 2px 6px rgb(0 0 0 / 0.3);
  }

  .hb-seg__tab {
    position: relative;
    min-height: 2.9rem;
    padding: 0.4rem 0.75rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-ink-secondary);
    font: inherit;
    font-size: clamp(0.85rem, 0.8rem + 0.25vw, 1rem);
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
    transition: color 380ms ease 80ms;
  }

  .hb-seg__tab:hover {
    color: var(--color-ink-primary);
  }

  .hb-seg__tab[aria-selected="true"] {
    color: var(--color-dark);
  }

  .hb-seg__tab:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .hb-seg__label {
    position: relative;
    z-index: 1;
  }

  .hb-seg__pill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--color-primary);
    box-shadow: 0 6px 16px -8px rgb(242 141 104 / 0.9);
  }

  /* ---------- Panels ---------- */
  .hb-panels {
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .hb-panel {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hb-panel + .hb-panel {
    margin-top: 3rem;
  }

  @media (min-width: 56rem) {
    .hb-panel {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }

  .hb-panel__promise {
    margin: 0;
    max-width: 28rem;
    font-size: clamp(1.35rem, 1.1rem + 1vw, 1.9rem);
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-ink-primary);
    text-wrap: pretty;
  }

  .hb-panel__detail {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 1.25rem 0 1.75rem;
    font-size: 1rem;
    color: var(--color-ink-secondary);
  }

  .hb-panel__badge {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: rgb(242 141 104 / 0.18);
    color: var(--color-primary);
  }

  /* ---------- Compositions ---------- */
  .hb-comp {
    position: relative;
    aspect-ratio: 6 / 4.4;
    width: 100%;
    max-width: 34rem;
    justify-self: center;
    border-radius: 1.75rem;
    background:
      radial-gradient(80% 80% at 70% 30%, rgb(242 141 104 / 0.14), transparent 70%),
      rgb(1 46 43 / 0.55);
    border: 1px solid rgb(255 248 242 / 0.08);
  }

  .hb-piece {
    position: absolute;
    display: block;
  }

  .hb-sheet-card {
    border-radius: 1rem;
    background: #175d55;
    border: 1px solid rgb(255 248 242 / 0.14);
    box-shadow: 0 22px 40px -22px rgb(0 0 0 / 0.8);
    padding: 1rem;
    box-sizing: border-box;
  }

  .hb-bars {
    display: grid;
    gap: 0.5rem;
  }

  .hb-bars span {
    display: block;
    width: var(--w, 80%);
    height: 0.5rem;
    border-radius: 999px;
    background: rgb(255 248 242 / 0.22);
  }

  .hb-bars span:first-child {
    height: 0.7rem;
    background: rgb(255 248 242 / 0.55);
  }

  .hb-bars--dark span,
  .hb-bars--dark span:first-child {
    background: rgb(1 61 57 / 0.35);
  }

  .hb-chips {
    display: flex;
    gap: 0.4rem;
    margin-top: 0.9rem;
  }

  .hb-chips span {
    width: 2.6rem;
    height: 1.1rem;
    border-radius: 999px;
    border: 1px solid rgb(255 248 242 / 0.3);
  }

  /* Builder: a profile with a piece of work and your part in it. */
  .hb-comp__profile {
    left: 7%;
    top: 12%;
    width: 50%;
  }

  .hb-comp__avatar {
    display: block;
    width: 2.6rem;
    height: 2.6rem;
    margin-bottom: 0.9rem;
    border-radius: 0.7rem;
    background: var(--color-primary);
  }

  .hb-comp__work {
    right: 7%;
    bottom: 11%;
    width: 52%;
    background: #1d6a61;
  }

  .hb-comp__repo {
    display: block;
    width: 1.4rem;
    height: 1.4rem;
    margin-bottom: 0.8rem;
    border-radius: 0.3rem;
    border: 1.5px solid #ffd166;
  }

  .hb-comp__part {
    display: grid;
    gap: 0.45rem;
    margin-top: 0.9rem;
    padding: 0.6rem;
    border-radius: 0.6rem;
    background: rgb(242 141 104 / 0.2);
    border-left: 3px solid var(--color-primary);
  }

  .hb-comp__part span {
    display: block;
    width: var(--w, 90%);
    height: 0.45rem;
    border-radius: 999px;
    background: rgb(242 141 104 / 0.75);
  }

  .hb-comp__tag {
    right: 12%;
    top: 14%;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    background: #ffd166;
    box-shadow: 0 14px 28px -14px rgb(0 0 0 / 0.8);
  }

  .hb-comp__tag::after {
    content: "";
    position: absolute;
    inset: 32% 28% 38% 30%;
    border: solid var(--color-dark);
    border-width: 0 0 3px 3px;
    rotate: -45deg;
  }

  /* Mentor: a note pinned to a specific part of someone's work. */
  .hb-comp__code {
    left: 7%;
    top: 10%;
    width: 64%;
    height: 78%;
    background: #0c3f3a;
  }

  .hb-code {
    display: grid;
    gap: 0.65rem;
    padding-top: 0.35rem;
  }

  .hb-code span {
    display: block;
    width: var(--w);
    height: 0.5rem;
    margin-left: calc(var(--i, 0) * 1.1rem);
    border-radius: 999px;
    background: var(--c, rgb(255 248 242 / 0.25));
  }

  .hb-comp__highlight {
    left: 9%;
    top: 47%;
    width: 52%;
    height: 2.1rem;
    border-radius: 0.5rem;
    border: 1.5px solid var(--color-primary);
    background: rgb(242 141 104 / 0.1);
  }

  .hb-comp__note {
    right: 7%;
    top: 26%;
    width: 40%;
    padding: 1.5rem 1rem 1rem;
    border-radius: 0.4rem 0.4rem 1.1rem 0.4rem;
    background: #f7b08f;
    box-shadow: 0 26px 40px -20px rgb(0 0 0 / 0.85);
    rotate: 4deg;
  }

  .hb-comp__pin {
    position: absolute;
    top: -0.55rem;
    left: 50%;
    width: 1.1rem;
    height: 1.1rem;
    margin-left: -0.55rem;
    border-radius: 50%;
    background: #ffd166;
    box-shadow: 0 3px 6px rgb(0 0 0 / 0.4);
  }

  .hb-comp__sig {
    display: block;
    width: 45%;
    height: 0.9rem;
    margin-top: 0.9rem;
    border-bottom: 2px solid var(--color-dark);
    border-radius: 0 0 40% 20%;
    opacity: 0.6;
  }

  /* Partner: searching the community and the work behind each profile. */
  .hb-comp__shortlist {
    left: 14%;
    top: 7%;
    width: 72%;
    height: 80%;
    background: #0e4a44;
    rotate: -3deg;
  }

  .hb-comp__search {
    left: 9%;
    top: 14%;
    width: 72%;
    display: grid;
    gap: 0.6rem;
    background: #196158;
  }

  .hb-comp__field {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    height: 2.4rem;
    padding: 0 0.8rem;
    border-radius: 999px;
    background: rgb(1 46 43 / 0.75);
    color: var(--color-primary);
  }

  .hb-comp__caret {
    width: 2px;
    height: 1.1rem;
    background: var(--color-ink-primary);
  }

  .hb-comp__result {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem;
    border-radius: 0.7rem;
  }

  .hb-comp__result.is-hit {
    background: rgb(242 141 104 / 0.18);
    outline: 1.5px solid rgb(242 141 104 / 0.7);
  }

  .hb-comp__dot {
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    background: rgb(255 248 242 / 0.3);
  }

  .is-hit .hb-comp__dot {
    background: var(--color-primary);
  }

  .hb-comp__chip {
    width: 2.4rem;
    height: 1rem;
    border-radius: 999px;
    border: 1px solid rgb(255 209 102 / 0.7);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hb-comp__caret {
      animation: hb-blink 1s steps(1) infinite;
    }
  }

  @keyframes hb-blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 30rem) {
    .hb-sheet-card {
      padding: 0.75rem;
    }

    .hb-comp__note {
      padding: 1.1rem 0.75rem 0.75rem;
    }

    .hb-comp__result {
      padding: 0.35rem 0.5rem;
    }
  }
</style>
