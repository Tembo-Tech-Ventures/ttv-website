---
import type { HomepageBuilder } from "@/lib/homepage/builders";
import { BUILDERS } from "@/lib/homepage/content";
import BuilderCard from "./BuilderCard.astro";
import { cohortNumberOf } from "./cohorts";

/**
 * Published builders as a card file across the full width. From four
 * profiles up (with motion), each card sticks a strip lower than the one
 * before, so covered cards keep their name showing: the stack becomes an index
 * of everyone you have passed. `stack.ts` sizes the strips to the screen. One
 * to three profiles sit as a plain list; none shows the shared empty line over
 * an empty file. Phones and tablets get the five most recent, then a link.
 */
interface Props {
  builders: HomepageBuilder[];
}

const { builders } = Astro.props;
const PHONE_LIMIT = 5;
const total = builders.length;
const stacked = total >= 4;
const lastOnPhone = Math.min(total, PHONE_LIMIT) - 1;
---

<div class="hb-builders__intro">
  <h2 id="hb-builders-title" class="hb-h2 font-heading tracking-heading">{BUILDERS.title}</h2>
  <div class="hb-builders__aside">
    <p class="hb-lede">{total > 0 ? BUILDERS.summary : BUILDERS.empty}</p>
    <a class:list={["hb-arrow-link hb-builders__all", { "hb-builders__all--wide-only": total > PHONE_LIMIT }]} href={BUILDERS.all.href}>
      {BUILDERS.all.label}
      <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18"><path d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </a>
  </div>
</div>

{total > 0 ? (
  <ol class:list={["hb-bstack", { "hb-bstack--file": stacked }]} data-hb-stack={stacked ? "" : undefined}>
    {builders.map((builder, index) => (
      <li
        class:list={[
          "hb-bstack__item",
          { "hb-bstack__item--extra": index >= PHONE_LIMIT, "hb-bstack__item--phone-last": index === lastOnPhone },
        ]}
        style={`--i:${index}`}
        data-hb-cohort={cohortNumberOf(builder) ?? undefined}
      >
        <BuilderCard builder={builder} />
      </li>
    ))}
  </ol>
) : (
  <div class="hb-bempty" aria-hidden="true">
    {[0, 1, 2].map((index) => (
      <span class="hb-bempty__sheet" style={`--i:${index}`}>
        <span class="hb-bempty__mono" />
        <span class="hb-bempty__lines"><span /><span /></span>
      </span>
    ))}
  </div>
)}

{total > PHONE_LIMIT && (
  <a class="hb-arrow-link hb-builders__all hb-builders__all--end" href={BUILDERS.all.href}>
    {BUILDERS.all.label}
    <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18"><path d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </a>
)}

<style>
  .hb-builders__intro {
    display: grid;
    gap: 1rem 4rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 64rem) {
    .hb-builders__intro {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: end;
    }
  }

  .hb-builders__aside {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem 2rem;
  }

  .hb-builders__aside :global(.hb-lede) {
    margin: 0;
  }

  /* With more than five, phones and tablets get the link after the stack instead. */
  .hb-builders__all--end {
    display: none;
    margin-top: 1.5rem;
  }

  @media (max-width: 63.99rem) {
    .hb-builders__all--wide-only {
      display: none;
    }

    .hb-builders__all--end {
      display: inline-flex;
    }
  }

  .hb-bstack {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 63.99rem) {
    .hb-bstack__item--extra {
      display: none;
    }
  }

  /* The card file. --hb-strip and --hb-gap come from stack.ts, sized to the screen. */
  @media (prefers-reduced-motion: no-preference) {
    .hb-bstack--file {
      gap: 0;
    }

    .hb-bstack--file .hb-bstack__item {
      position: sticky;
      top: calc(var(--hb-nav, 4.5rem) + 1rem + var(--i) * var(--hb-strip, 2.75rem));
      margin-bottom: var(--hb-gap, 1rem);
    }

    .hb-bstack--file .hb-bstack__item:last-child {
      margin-bottom: 0;
    }

    @media (max-width: 63.99rem) {
      .hb-bstack--file .hb-bstack__item {
        top: calc(var(--hb-nav, 4.5rem) + 0.75rem + var(--i) * var(--hb-strip, 2.5rem));
      }

      .hb-bstack--file .hb-bstack__item--phone-last {
        margin-bottom: 0;
      }
    }
  }

  /* No published profiles yet: an empty file beside the shared line. */
  .hb-bempty {
    position: relative;
    height: 12rem;
    max-width: 48rem;
  }

  .hb-bempty__sheet {
    position: absolute;
    inset-inline: calc(var(--i) * 1rem);
    top: calc(var(--i) * 2.75rem);
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 0.75rem 1.25rem;
    height: 6.5rem;
    border-radius: 1.25rem;
    background: color-mix(in srgb, #0f514a, #2c6964 calc(var(--i) * 25%));
    border: 1px solid rgb(255 248 242 / 0.12);
    box-shadow: 0 -10px 24px -16px rgb(0 0 0 / 0.65);
  }

  .hb-bempty__mono {
    flex: none;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 0.7rem;
    border: 1.5px dashed rgb(242 141 104 / 0.7);
  }

  .hb-bempty__lines {
    display: grid;
    gap: 0.6rem;
    flex: 1;
    padding-top: 0.5rem;
  }

  .hb-bempty__lines span {
    height: 0.55rem;
    border-radius: 999px;
    background: rgb(255 248 242 / 0.14);
  }

  .hb-bempty__lines span:nth-child(1) {
    width: 40%;
  }

  .hb-bempty__lines span:nth-child(2) {
    width: 65%;
  }
</style>
