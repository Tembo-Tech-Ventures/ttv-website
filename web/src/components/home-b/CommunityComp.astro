---
import type { HomepageBuilder } from "@/lib/homepage/builders";
import type { CommunityPath } from "@/lib/homepage/content";

/**
 * The small layered picture beside each community path, built from real
 * published profiles: a builder's profile and project, a mentor note pinned
 * to that project (shape only, never invented words), and a partner's search
 * filtered by real skills. With no published profiles it falls back to shapes.
 * The picture is decorative; its caption says what it shows.
 */
interface Props {
  path: CommunityPath["id"];
  builders: HomepageBuilder[];
}

const { path, builders } = Astro.props;
const featured = builders.find((builder) => builder.project) ?? builders[0] ?? null;
const reviewed = builders.filter((builder) => builder.project)[1] ?? featured;
const results = builders.slice(0, 3);
const filters = [...new Set(builders.flatMap((builder) => builder.skills))].slice(0, 3);
const captions = {
  builder: featured ? "From a published builder profile" : "A builder profile",
  mentor: "How a mentor note looks (illustration)",
  partner: "Searching published profiles (illustration)",
} as const;
---

<figure class={`hb-comp hb-comp--${path}`}>
  <div class="hb-comp__stage" aria-hidden="true" data-hb-comp>
    {path === "builder" && (
      <>
        <span class="hb-piece hb-card hb-comp__profile" data-hb-piece>
          <span class="hb-comp__who">
            <span class="hb-comp__mono font-heading">{featured?.initials ?? ""}</span>
            <span class="hb-comp__id">
              {featured ? <span class="hb-comp__name">{featured.name}</span> : <span class="hb-bar" style="--w:70%" />}
              {featured?.cohort ? <span class="hb-comp__small">{featured.cohort}</span> : <span class="hb-bar" style="--w:45%" />}
            </span>
          </span>
          <span class="hb-chips">
            {featured && featured.skills.length > 0
              ? featured.skills.map((skill) => <span class="hb-chip">{skill}</span>)
              : [0, 1, 2].map(() => <span class="hb-chip hb-chip--blank" />)}
          </span>
        </span>
        <span class="hb-piece hb-card hb-comp__work" data-hb-piece>
          <span class="hb-comp__repo">
            <svg viewBox="0 0 16 16" width="13" height="13"><path d="M3 2.5h7.5L13 5v8.5H3z M10.5 2.5V5H13" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" /></svg>
            {featured?.project?.name ?? ""}
          </span>
          {featured?.project?.description ? (
            <span class="hb-comp__desc">{featured.project.description}</span>
          ) : (
            <span class="hb-bars"><span class="hb-bar" style="--w:90%" /><span class="hb-bar" style="--w:70%" /></span>
          )}
          <span class="hb-comp__part">
            <span class="hb-comp__part-label">Your part</span>
            <span class="hb-bar hb-bar--peach" style="--w:85%" />
            <span class="hb-bar hb-bar--peach" style="--w:55%" />
          </span>
        </span>
        <span class="hb-piece hb-comp__tick" data-hb-piece />
      </>
    )}
    {path === "mentor" && (
      <>
        <span class="hb-piece hb-card hb-comp__code" data-hb-piece>
          <span class="hb-comp__repo">
            <svg viewBox="0 0 16 16" width="13" height="13"><path d="M3 2.5h7.5L13 5v8.5H3z M10.5 2.5V5H13" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" /></svg>
            {reviewed?.project?.name ?? ""}
            {reviewed?.project?.language && <span class="hb-comp__small">{reviewed.project.language}</span>}
          </span>
          <span class="hb-code">
            <span style="--w:40%;--c:#f28d68" /><span style="--w:72%;--i:1" /><span style="--w:58%;--i:1" /><span style="--w:66%;--i:2;--c:#ffd166" /><span style="--w:48%;--i:2" />
            <span class="hb-code__mark"><span style="--w:62%;--i:2" /><span style="--w:44%;--i:2" /></span>
            <span style="--w:30%;--i:1" /><span style="--w:54%;--i:1;--c:#f28d68" /><span style="--w:20%" />
          </span>
        </span>
        <span class="hb-piece hb-comp__note" data-hb-piece>
          <span class="hb-comp__pin" />
          <span class="hb-comp__note-label">Mentor note</span>
          <span class="hb-bars"><span class="hb-bar hb-bar--ink" style="--w:92%" /><span class="hb-bar hb-bar--ink" style="--w:80%" /><span class="hb-bar hb-bar--ink" style="--w:50%" /></span>
        </span>
      </>
    )}
    {path === "partner" && (
      <>
        <span class="hb-piece hb-card hb-comp__shortlist" data-hb-piece />
        <span class="hb-piece hb-card hb-comp__search" data-hb-piece>
          <span class="hb-comp__field">
            <svg viewBox="0 0 16 16" width="14" height="14"><circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
            {filters.length > 0 ? filters.map((skill) => <span class="hb-chip hb-chip--filter">{skill}</span>) : <span class="hb-comp__caret" />}
          </span>
          {(results.length > 0 ? results : [null, null, null]).map((builder, row) => (
            <span class:list={["hb-comp__result", { "is-hit": row === 1 }]}>
              <span class="hb-comp__mono hb-comp__mono--sm font-heading">{builder?.initials ?? ""}</span>
              <span class="hb-comp__id">
                {builder ? <span class="hb-comp__name">{builder.name}</span> : <span class="hb-bar" style="--w:60%" />}
                {builder?.headline ? <span class="hb-comp__small hb-comp__clip">{builder.headline}</span> : <span class="hb-bar" style="--w:80%" />}
              </span>
            </span>
          ))}
        </span>
      </>
    )}
  </div>
  <figcaption class="hb-comp__caption">{captions[path]}</figcaption>
</figure>

<style>
  .hb-comp {
    margin: 0;
    width: 100%;
    max-width: 36rem;
    justify-self: center;
  }

  .hb-comp__stage {
    position: relative;
    aspect-ratio: 6 / 4.3;
    border-radius: 1.75rem;
    background:
      radial-gradient(80% 80% at 70% 30%, rgb(242 141 104 / 0.14), transparent 70%),
      rgb(1 46 43 / 0.55);
    border: 1px solid rgb(255 248 242 / 0.08);
    container-type: inline-size;
    font-size: clamp(0.7rem, 2.6cqi, 0.9rem);
  }

  .hb-comp__caption {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--color-ink-secondary);
    text-align: center;
  }

  .hb-piece {
    position: absolute;
    display: block;
  }

  .hb-card {
    box-sizing: border-box;
    padding: 1em 1.1em;
    border-radius: 1em;
    background: #175d55;
    border: 1px solid rgb(255 248 242 / 0.14);
    box-shadow: 0 22px 40px -22px rgb(0 0 0 / 0.8);
    color: var(--color-ink-primary);
  }

  .hb-bars {
    display: grid;
    gap: 0.5em;
  }

  .hb-bar {
    display: block;
    width: var(--w, 80%);
    height: 0.5em;
    border-radius: 999px;
    background: rgb(255 248 242 / 0.22);
  }

  .hb-bar--peach {
    background: rgb(242 141 104 / 0.75);
  }

  .hb-bar--ink {
    background: rgb(1 61 57 / 0.35);
  }

  .hb-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
    margin-top: 0.9em;
  }

  .hb-chip {
    padding: 0.2em 0.65em;
    border-radius: 999px;
    border: 1px solid rgb(255 248 242 / 0.3);
    font-size: 0.85em;
    white-space: nowrap;
  }

  .hb-chip--blank {
    width: 3em;
    height: 1.2em;
  }

  .hb-chip--filter {
    border-color: rgb(255 209 102 / 0.7);
    color: #ffd166;
  }

  .hb-comp__who {
    display: flex;
    align-items: center;
    gap: 0.7em;
  }

  .hb-comp__mono {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.6em;
    height: 2.6em;
    border-radius: 0.7em;
    background: var(--color-primary);
    color: var(--color-dark);
    font-size: 0.9em;
  }

  .hb-comp__mono--sm {
    width: 2.2em;
    height: 2.2em;
    border-radius: 50%;
    font-size: 0.75em;
    background: rgb(255 248 242 / 0.25);
    color: var(--color-ink-primary);
  }

  .hb-comp__id {
    display: grid;
    gap: 0.25em;
    min-width: 0;
    flex: 1;
  }

  .hb-comp__name {
    font-weight: 700;
    font-size: 1.05em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hb-comp__small {
    font-size: 0.85em;
    color: rgb(255 248 242 / 0.75);
  }

  .hb-comp__clip {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hb-comp__repo {
    display: flex;
    align-items: center;
    gap: 0.45em;
    margin-bottom: 0.6em;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--color-primary);
  }

  .hb-comp__repo .hb-comp__small {
    margin-left: auto;
    font-family: var(--font-body);
  }

  .hb-comp__desc {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.45;
    color: rgb(255 248 242 / 0.8);
  }

  /* Builder */
  .hb-comp__profile {
    left: 6%;
    top: 9%;
    width: 54%;
  }

  .hb-comp__work {
    right: 5%;
    bottom: 9%;
    width: 58%;
    background: #1d6a61;
  }

  .hb-comp__part {
    display: grid;
    gap: 0.45em;
    margin-top: 0.8em;
    padding: 0.6em 0.7em;
    border-radius: 0.6em;
    background: rgb(242 141 104 / 0.18);
    border-left: 3px solid var(--color-primary);
  }

  .hb-comp__part-label {
    font-size: 0.8em;
    font-weight: 600;
    color: #ffc2a8;
  }

  .hb-comp__tick {
    right: 9%;
    top: 11%;
    width: 3em;
    height: 3em;
    border-radius: 50%;
    background: #ffd166;
    box-shadow: 0 14px 28px -14px rgb(0 0 0 / 0.8);
  }

  .hb-comp__tick::after {
    content: "";
    position: absolute;
    inset: 32% 28% 38% 30%;
    border: solid var(--color-dark);
    border-width: 0 0 3px 3px;
    rotate: -45deg;
  }

  /* Mentor */
  .hb-comp__code {
    left: 6%;
    top: 9%;
    width: 64%;
    background: #0c3f3a;
  }

  .hb-code {
    display: grid;
    gap: 0.65em;
    padding-top: 0.4em;
  }

  .hb-code > span:not(.hb-code__mark),
  .hb-code__mark > span {
    display: block;
    width: var(--w);
    height: 0.5em;
    margin-left: calc(var(--i, 0) * 1.1em);
    border-radius: 999px;
    background: var(--c, rgb(255 248 242 / 0.25));
  }

  /* The lines the note is pinned to. */
  .hb-code__mark {
    display: grid;
    gap: 0.65em;
    margin: -0.1em -0.5em;
    padding: 0.5em;
    border-radius: 0.5em;
    border: 1.5px solid var(--color-primary);
    background: rgb(242 141 104 / 0.1);
  }

  .hb-comp__note {
    right: 6%;
    top: 30%;
    width: 38%;
    box-sizing: border-box;
    padding: 1.4em 1em 1.1em;
    border-radius: 0.4em 0.4em 1.1em 0.4em;
    background: #f7b08f;
    color: var(--color-dark);
    box-shadow: 0 26px 40px -20px rgb(0 0 0 / 0.85);
    rotate: 4deg;
  }

  .hb-comp__note-label {
    display: block;
    margin-bottom: 0.6em;
    font-size: 0.85em;
    font-weight: 700;
  }

  .hb-comp__pin {
    position: absolute;
    top: -0.55em;
    left: 50%;
    width: 1.1em;
    height: 1.1em;
    margin-left: -0.55em;
    border-radius: 50%;
    background: #ffd166;
    box-shadow: 0 3px 6px rgb(0 0 0 / 0.4);
  }

  /* Partner */
  .hb-comp__shortlist {
    left: 15%;
    top: 6%;
    width: 74%;
    height: 84%;
    background: #0e4a44;
    rotate: -3deg;
  }

  .hb-comp__search {
    left: 7%;
    top: 12%;
    width: 76%;
    display: grid;
    gap: 0.4em;
    background: #196158;
  }

  .hb-comp__field {
    display: flex;
    align-items: center;
    gap: 0.45em;
    min-height: 2.4em;
    margin-bottom: 0.3em;
    padding: 0 0.8em;
    border-radius: 999px;
    background: rgb(1 46 43 / 0.75);
    color: var(--color-primary);
    overflow: hidden;
  }

  .hb-comp__caret {
    width: 2px;
    height: 1.1em;
    background: var(--color-ink-primary);
  }

  .hb-comp__result {
    display: flex;
    align-items: center;
    gap: 0.7em;
    padding: 0.5em 0.6em;
    border-radius: 0.7em;
  }

  .hb-comp__result.is-hit {
    background: rgb(242 141 104 / 0.2);
    outline: 1.5px solid rgb(242 141 104 / 0.75);
  }

  .is-hit .hb-comp__mono--sm {
    background: var(--color-primary);
    color: var(--color-dark);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hb-comp__caret {
      animation: hb-blink 1s steps(1) infinite;
    }
  }

  @keyframes hb-blink {
    50% {
      opacity: 0;
    }
  }

  /* Phones: taller stage, wider pieces, so the real names stay legible. */
  @media (max-width: 30rem) {
    .hb-comp__stage {
      aspect-ratio: 1 / 0.92;
      font-size: 0.75rem;
    }

    .hb-comp__profile {
      left: 5%;
      top: 6%;
      width: 76%;
    }

    .hb-comp__work {
      right: 4%;
      bottom: 6%;
      width: 80%;
    }

    .hb-comp__tick {
      top: 8%;
      right: 6%;
    }

    .hb-comp__code {
      width: 78%;
    }

    .hb-comp__note {
      width: 48%;
      top: 40%;
    }

    .hb-comp__search {
      left: 5%;
      width: 90%;
    }
  }
</style>
