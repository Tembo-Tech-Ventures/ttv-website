---
import { COHORT } from "@/lib/homepage/content";

/**
 * The opening sheet: what a cohort is, who can apply and how, beside a deck
 * of the cohorts so far with the running one on top. The deck is the page's
 * motif: builders below carry their cohort's card, and the hire pair is the
 * same kind of card. Each deck card is a button that brings it to the top;
 * pointing at or focusing the deck parts it (`deck.ts`). The rhythm cards
 * underneath arrive stacked and deal themselves out into a row.
 */
const cohorts = COHORT.timeline;
// Resting order, back to front: completed cohorts in order, the running one on top.
const order = [...cohorts.keys()].toSorted((a, b) => Number(cohorts[a].running) - Number(cohorts[b].running) || a - b);
---

<div class="hb-hero">
  <div class="hb-hero__copy">
    <h1 id="hb-cohorts-title" class="hb-hero__title font-heading tracking-heading">{COHORT.title}</h1>
    <p class="hb-hero__summary">{COHORT.summary}</p>
    <div class="hb-hero__actions">
      <a class="hb-pill" href={COHORT.apply.href}>
        <span>{COHORT.apply.label}</span>
        <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18"><path d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
      <a class="hb-quiet" href={COHORT.secondary.href}>{COHORT.secondary.label}</a>
    </div>
    <p class="hb-hero__eligibility">
      <span class="hb-check" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="14" height="14"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </span>
      {COHORT.eligibility}
    </p>
  </div>

  <div class="hb-deck-stage" data-hb-deck-stage>
    <ol class="hb-deck" style={`--n:${cohorts.length}`} data-hb-deck aria-label="Our cohorts so far">
      {cohorts.map((cohort, index) => (
        <li
          class:list={["hb-cc", { "hb-cc--running": cohort.running }]}
          style={`--k:${index};--slot:${order.indexOf(index)}`}
          data-hb-deck-card
        >
          <button type="button" class="hb-cc__pose" aria-pressed={cohort.running ? "true" : "false"} data-hb-deck-button>
            <span class="hb-cc__inner">
              <span class="hb-cc__head">
                <span class="hb-cc__name">{cohort.label}</span>
                <span class="hb-cc__status">
                  {cohort.running && <span class="hb-cc__pulse" aria-hidden="true" />}
                  {cohort.status}
                </span>
              </span>
              <span class="hb-cc__numeral font-heading tracking-display" aria-hidden="true">{cohort.number}</span>
              <span class="hb-cc__rule" aria-hidden="true" />
            </span>
          </button>
        </li>
      ))}
    </ol>
  </div>
</div>

<ul class="hb-facts">
  {COHORT.facts.map((fact) => (
    <li class="hb-fact">
      <span class="hb-fact__value font-heading tracking-subhead">{fact.value}</span>
      <span class="hb-fact__label">{fact.label}</span>
    </li>
  ))}
</ul>

<ol class="hb-rhythm" data-hb-rhythm>
  {COHORT.rhythm.map((step, index) => (
    <li class="hb-rhythm__card" style={`--k:${index}`} data-hb-rhythm-card>
      <span class="hb-rhythm__shape" aria-hidden="true">
        {Array.from({ length: index + 1 }, () => <span />)}
      </span>
      <h3 class="hb-rhythm__title">{step.title}</h3>
      <p class="hb-rhythm__copy">{step.copy}</p>
    </li>
  ))}
</ol>

<style>
  /* ---------- Split hero ---------- */
  .hb-hero {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }

  @media (min-width: 64rem) {
    .hb-hero {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(3rem, 5vw, 5rem);
    }
  }

  .hb-hero__title {
    margin: 0;
    max-width: 15ch;
    font-size: clamp(2rem, 1.1rem + 3.4vw, 3.9rem);
    line-height: 1.04;
    color: var(--color-ink-primary);
    text-wrap: balance;
  }

  .hb-hero__summary {
    margin: clamp(1.25rem, 2.5vw, 1.75rem) 0 0;
    max-width: 34rem;
    font-size: clamp(1.0625rem, 0.98rem + 0.35vw, 1.25rem);
    line-height: 1.6;
    color: var(--color-ink-secondary);
  }

  .hb-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin-top: clamp(1.75rem, 3vw, 2.25rem);
  }

  .hb-hero__eligibility {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 1.1rem 0 0;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-ink-primary);
  }

  .hb-check {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: rgb(242 141 104 / 0.2);
    color: var(--color-primary);
  }

  .hb-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3.25rem;
    padding: 0 1.6rem;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-dark);
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    box-shadow: 0 10px 24px -12px rgb(242 141 104 / 0.7);
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 220ms ease;
  }

  .hb-pill svg {
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hb-pill:hover,
  .hb-pill:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 16px 30px -14px rgb(242 141 104 / 0.85);
  }

  .hb-pill:hover svg,
  .hb-pill:focus-visible svg {
    transform: translateX(3px);
  }

  .hb-quiet {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-ink-primary);
    font-size: 1rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: rgb(242 141 104 / 0.55);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    transition: text-decoration-color 200ms ease, color 200ms ease;
  }

  .hb-quiet:hover,
  .hb-quiet:focus-visible {
    color: var(--color-primary);
    text-decoration-color: currentColor;
  }

  .hb-pill:focus-visible,
  .hb-quiet:focus-visible {
    outline: 2px solid var(--color-ink-primary);
    outline-offset: 4px;
  }

  /* ---------- The cohort deck ---------- */
  .hb-deck-stage {
    --peek: 2.6rem;
    --card-h: 11.5rem;
    --depth: 12px;
    --step-deg: 2.2deg;
    --x-step: 0.3rem;
    position: relative;
    display: flex;
    justify-content: center;
    perspective: 1100px;
  }

  @media (min-width: 40rem) {
    .hb-deck-stage {
      --depth: 22px;
      --step-deg: 3.4deg;
      --x-step: 0.7rem;
      --peek: 3.5rem;
      --card-h: 17rem;
    }
  }

  @media (min-width: 64rem) {
    .hb-deck-stage {
      --card-h: 19rem;
    }
  }

  .hb-deck {
    position: relative;
    width: min(100% - 2.5rem, 22rem);
    height: calc(var(--card-h) + (var(--n) - 1) * var(--peek));
    margin: 0;
    padding: 0;
    list-style: none;
    transform-style: preserve-3d;
  }

  /* GSAP owns each card's transform (scroll fan, hover parting); the resting
   * pose for its slot sits one level in, on the button. */
  /* Each card's box starts at its own slot, so a card never sits over the
   * visible strip of the cards behind it. */
  .hb-cc {
    position: absolute;
    inset-inline: 0;
    top: calc(var(--slot) * var(--peek));
    z-index: calc(var(--slot) + 1);
    height: var(--card-h);
    transform-origin: 50% 140%;
    transform-style: preserve-3d;
  }

  .hb-cc__pose {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    border-radius: 1.25rem;
    translate:
      calc((var(--slot) - (var(--n) - 1) / 2) * var(--x-step))
      0
      calc(var(--slot) * var(--depth));
    rotate: calc((var(--slot) - (var(--n) - 1) * 0.7) * var(--step-deg));
    transform-origin: 50% 140%;
  }

  .hb-cc__pose:focus-visible {
    outline: 2px solid var(--color-ink-primary);
    outline-offset: 4px;
  }

  .hb-cc__inner {
    position: relative;
    display: block;
    height: 100%;
    box-sizing: border-box;
    padding: 0.95rem 1.25rem;
    border-radius: 1.25rem;
    background: color-mix(in srgb, #0d4f48, #2c6964 calc(var(--k) * 22%));
    border: 1px solid rgb(255 248 242 / 0.12);
    box-shadow:
      0 1px 0 rgb(255 248 242 / 0.08) inset,
      0 18px 40px -18px rgb(0 0 0 / 0.65);
  }

  .hb-cc--running .hb-cc__inner {
    background:
      radial-gradient(120% 90% at 100% 100%, rgb(255 209 102 / 0.35), transparent 60%),
      var(--color-primary);
    border-color: rgb(255 248 242 / 0.45);
    color: var(--color-dark);
  }

  .hb-cc__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.875rem;
    line-height: 1.5rem;
    font-weight: 600;
  }

  .hb-cc__name {
    letter-spacing: 0.01em;
  }

  .hb-cc__status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0 0.6rem;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgb(255 248 242 / 0.85);
    background: rgb(0 0 0 / 0.18);
  }

  .hb-cc--running .hb-cc__status {
    color: var(--color-ink-primary);
    background: var(--color-dark);
    font-weight: 600;
  }

  .hb-cc__pulse {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #ffd166;
  }

  /* Every card carries its number; only the card on top shows it whole. */
  .hb-cc__numeral {
    position: absolute;
    left: 1.1rem;
    bottom: 0.4rem;
    font-size: clamp(5.5rem, 14vw, 8.5rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-primary);
  }

  .hb-cc__pose[aria-pressed="false"] .hb-cc__numeral {
    opacity: 0;
  }

  .hb-cc--running .hb-cc__numeral {
    color: var(--color-dark);
    -webkit-text-stroke: 0;
  }

  .hb-cc__rule {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    width: 34%;
    height: 0.6rem;
    border-radius: 999px;
    background: repeating-linear-gradient(90deg, currentColor 0 2px, transparent 2px 7px);
    opacity: 0.35;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hb-cc {
      transition: top 620ms cubic-bezier(0.3, 0.9, 0.25, 1);
    }

    .hb-cc__pose {
      transition:
        translate 620ms cubic-bezier(0.3, 0.9, 0.25, 1),
        rotate 620ms cubic-bezier(0.3, 0.9, 0.25, 1);
    }

    .hb-cc__numeral {
      transition: opacity 400ms ease 200ms;
    }

    .hb-cc__inner {
      animation: hb-deal 760ms cubic-bezier(0.18, 0.9, 0.24, 1.08) backwards;
      animation-delay: calc(120ms + var(--k) * 110ms);
      transition: translate 280ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    /* A card lifts out of the deck under the pointer. */
    @media (hover: hover) and (pointer: fine) {
      .hb-cc__pose:hover .hb-cc__inner {
        translate: 0 -0.6rem;
      }
    }

    .hb-cc__pulse::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: inherit;
      animation: hb-pulse 1.8s ease-out infinite;
    }

    .hb-hero__title,
    .hb-hero__summary,
    .hb-hero__actions,
    .hb-hero__eligibility {
      animation: hb-rise 760ms cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
    }

    .hb-hero__summary {
      animation-delay: 90ms;
    }

    .hb-hero__actions {
      animation-delay: 180ms;
    }

    .hb-hero__eligibility {
      animation-delay: 260ms;
    }
  }

  @keyframes hb-deal {
    from {
      opacity: 0;
      transform: translate(46%, 30%) rotate(14deg) scale(0.92);
    }
  }

  @keyframes hb-rise {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
  }

  @keyframes hb-pulse {
    from {
      transform: scale(1);
      opacity: 0.8;
    }
    to {
      transform: scale(3);
      opacity: 0;
    }
  }

  /* ---------- Facts ---------- */
  .hb-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: clamp(3rem, 7vw, 5rem) 0 0;
    padding: clamp(1.25rem, 2.5vw, 1.75rem) 0 0;
    list-style: none;
    border-top: 1px solid rgb(255 248 242 / 0.14);
  }

  .hb-fact {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }

  .hb-fact__value {
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 2.75rem);
    line-height: 1.1;
    color: var(--color-primary);
  }

  .hb-fact__label {
    max-width: 16rem;
    font-size: clamp(0.8125rem, 0.75rem + 0.3vw, 1rem);
    line-height: 1.45;
    color: var(--color-ink-secondary);
  }

  /* ---------- Rhythm ---------- */
  .hb-rhythm {
    display: grid;
    gap: 1rem;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .hb-rhythm {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  .hb-rhythm__card {
    position: relative;
    z-index: calc(1 + var(--k));
    padding: clamp(1.4rem, 2.5vw, 1.9rem);
    border-radius: 1.25rem;
    background: #0b4a44;
    border: 1px solid rgb(255 248 242 / 0.1);
    box-shadow: 0 22px 40px -26px rgb(0 0 0 / 0.75);
  }

  .hb-rhythm__shape {
    display: flex;
    height: 1.75rem;
    margin-bottom: 1.25rem;
  }

  .hb-rhythm__shape span {
    width: 1.35rem;
    height: 1.75rem;
    border-radius: 0.35rem;
    border: 1.5px solid var(--color-primary);
    background: #0b4a44;
  }

  .hb-rhythm__shape span + span {
    margin-left: -0.8rem;
    translate: 0 -0.2rem;
  }

  .hb-rhythm__shape span:last-child {
    background: var(--color-primary);
  }

  .hb-rhythm__title {
    margin: 0;
    font-size: clamp(1.125rem, 1rem + 0.4vw, 1.3rem);
    line-height: 1.3;
    color: var(--color-ink-primary);
  }

  .hb-rhythm__copy {
    margin: 0.6rem 0 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-secondary);
  }
</style>
