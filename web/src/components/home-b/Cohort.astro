---
import { COHORT, COMMUNITY } from "@/lib/homepage/content";
import { SITE_FACTS } from "@/lib/site";

/**
 * The opening sheet: what a cohort is and how to apply, beside a deck of the
 * cohorts so far with the running one on top. The rhythm cards underneath
 * arrive stacked and deal themselves out into a row (see `rhythm.ts`).
 */
const current = Number(SITE_FACTS.currentCohortNumber);
const cohorts = Array.from({ length: current }, (_, index) => {
  const number = String(index + 1).padStart(2, "0");
  return { number, running: index + 1 === current };
});
---

{/* The section is #cohort (SECTION_ORDER); #cohorts also resolves, as the brief names it. */}
<div class="hb-hero" id="cohorts">
  <div class="hb-hero__copy">
    <h1 id="hb-cohorts-title" class="hb-hero__title font-heading tracking-heading">{COHORT.title}</h1>
    <p class="hb-hero__summary">{COHORT.summary}</p>
    <div class="hb-hero__actions">
      <a class="hb-pill" href={COHORT.apply.href}>
        <span>{COHORT.apply.label}</span>
        <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18"><path d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
      <a class="hb-quiet" href="#community">{COMMUNITY.title}</a>
    </div>
  </div>

  <div class="hb-deck-stage" data-hb-deck-stage>
    <ol class="hb-deck" style={`--n:${cohorts.length}`} data-hb-deck aria-label="Our cohorts so far">
      {cohorts.map((cohort, index) => (
        <li
          class:list={["hb-cc", { "hb-cc--running": cohort.running }]}
          style={`--k:${index};--n:${cohorts.length}`}
          data-hb-deck-card
        >
          <div class="hb-cc__pose">
          <div class="hb-cc__inner">
            <p class="hb-cc__head">
              <span class="hb-cc__name">Cohort {cohort.number}</span>
              <span class="hb-cc__status">
                {cohort.running && <span class="hb-cc__pulse" aria-hidden="true" />}
                {cohort.running ? "Running now" : "Complete"}
              </span>
            </p>
            {cohort.running && (
              <span class="hb-cc__numeral font-heading tracking-display" aria-hidden="true">{cohort.number}</span>
            )}
            <span class="hb-cc__rule" aria-hidden="true" />
          </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</div>

<ul class="hb-facts">
  {COHORT.facts.map((fact) => (
    <li class="hb-fact">
      <span class="hb-fact__value font-heading tracking-subhead">{fact.value}</span>
      <span class="hb-fact__label">{fact.label}</span>
    </li>
  ))}
</ul>

<ol class="hb-rhythm" data-hb-rhythm>
  {COHORT.rhythm.map((step, index) => (
    <li class="hb-rhythm__card" style={`--k:${index}`} data-hb-rhythm-card>
      <span class="hb-rhythm__shape" aria-hidden="true">
        {Array.from({ length: index + 1 }, () => <span />)}
      </span>
      <h3 class="hb-rhythm__title">{step.title}</h3>
      <p class="hb-rhythm__copy">{step.copy}</p>
    </li>
  ))}
</ol>

<style>
  /* ---------- Split hero ---------- */
  .hb-hero {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }

  @media (min-width: 64rem) {
    .hb-hero {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(3rem, 5vw, 5rem);
    }
  }

  .hb-hero__title {
    margin: 0;
    max-width: 15ch;
    font-size: clamp(2rem, 1.1rem + 3.4vw, 3.9rem);
    line-height: 1.04;
    color: var(--color-ink-primary);
    text-wrap: balance;
  }

  .hb-hero__summary {
    margin: clamp(1.25rem, 2.5vw, 1.75rem) 0 0;
    max-width: 34rem;
    font-size: clamp(1.0625rem, 0.98rem + 0.35vw, 1.25rem);
    line-height: 1.6;
    color: var(--color-ink-secondary);
  }

  .hb-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: clamp(1.75rem, 3vw, 2.25rem);
  }

  .hb-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3.25rem;
    padding: 0 1.6rem;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-dark);
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    box-shadow: 0 10px 24px -12px rgb(242 141 104 / 0.7);
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 220ms ease;
  }

  .hb-pill svg {
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hb-pill:hover,
  .hb-pill:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 16px 30px -14px rgb(242 141 104 / 0.85);
  }

  .hb-pill:hover svg,
  .hb-pill:focus-visible svg {
    transform: translateX(3px);
  }

  .hb-quiet {
    color: var(--color-ink-primary);
    font-size: 0.975rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: rgb(242 141 104 / 0.55);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    transition: text-decoration-color 200ms ease, color 200ms ease;
  }

  .hb-quiet:hover,
  .hb-quiet:focus-visible {
    color: var(--color-primary);
    text-decoration-color: currentColor;
  }

  .hb-pill:focus-visible,
  .hb-quiet:focus-visible {
    outline: 2px solid var(--color-ink-primary);
    outline-offset: 4px;
  }

  /* ---------- The cohort deck ---------- */
  .hb-deck-stage {
    --peek: 2.6rem;
    --card-h: 11.5rem;
    position: relative;
    display: flex;
    justify-content: center;
    --depth: 12px;
    --step-deg: 2.2deg;
    perspective: 1100px;
  }

  .hb-deck {
    position: relative;
    width: min(100% - 2.5rem, 22rem);
    height: calc(var(--card-h) + (var(--n, 4) - 1) * var(--peek));
    margin: 0;
    padding: 0;
    list-style: none;
    transform-style: preserve-3d;
  }

  @media (min-width: 40rem) {
    .hb-deck-stage {
      --depth: 22px;
      --step-deg: 3.4deg;
      --peek: 3.5rem;
      --card-h: 17rem;
    }
  }

  @media (min-width: 64rem) {
    .hb-deck-stage {
      --card-h: 19rem;
    }
  }

  .hb-cc {
    --angle: calc((var(--k) - (var(--n) - 1) * 0.7) * var(--step-deg, 3.4deg));
    position: absolute;
    inset-inline: 0;
    top: calc(var(--k) * var(--peek));
    height: var(--card-h);
    transform-origin: 50% 140%;
    transform-style: preserve-3d;
  }

  /* Resting fan. GSAP owns the card's transform (scroll fan), so the pose sits
   * one level in, where GSAP's reset of the CSS rotate/translate can't reach. */
  .hb-cc__pose {
    height: 100%;
    translate: calc((var(--k) - (var(--n) - 1) / 2) * 0.7rem) 0 calc(var(--k) * var(--depth, 22px));
    rotate: var(--angle);
    transform-origin: 50% 140%;
  }

  .hb-cc__inner {
    position: relative;
    height: 100%;
    box-sizing: border-box;
    padding: 0.95rem 1.25rem;
    border-radius: 1.25rem;
    background: color-mix(in srgb, #0d4f48, #2c6964 calc(var(--k) * 22%));
    border: 1px solid rgb(255 248 242 / 0.12);
    box-shadow:
      0 1px 0 rgb(255 248 242 / 0.08) inset,
      0 18px 40px -18px rgb(0 0 0 / 0.65);
  }

  .hb-cc--running .hb-cc__inner {
    background:
      radial-gradient(120% 90% at 100% 100%, rgb(255 209 102 / 0.35), transparent 60%),
      var(--color-primary);
    border-color: rgb(255 248 242 / 0.45);
    color: var(--color-dark);
  }

  .hb-cc__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5rem;
    font-weight: 600;
  }

  .hb-cc__name {
    letter-spacing: 0.01em;
  }

  .hb-cc__status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0 0.6rem;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgb(255 248 242 / 0.82);
    background: rgb(0 0 0 / 0.16);
  }

  .hb-cc--running .hb-cc__status {
    color: var(--color-ink-primary);
    background: var(--color-dark);
    font-weight: 600;
  }

  .hb-cc__pulse {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #ffd166;
  }

  .hb-cc__numeral {
    position: absolute;
    left: 1.1rem;
    bottom: 0.4rem;
    font-size: clamp(5.5rem, 14vw, 8.5rem);
    line-height: 1;
    color: var(--color-dark);
  }

  .hb-cc__rule {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    width: 34%;
    height: 0.6rem;
    border-radius: 999px;
    background: repeating-linear-gradient(90deg, currentColor 0 2px, transparent 2px 7px);
    opacity: 0.35;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hb-cc__inner {
      animation: hb-deal 760ms cubic-bezier(0.18, 0.9, 0.24, 1.08) backwards;
      animation-delay: calc(120ms + var(--k) * 110ms);
    }

    .hb-cc__pulse::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: inherit;
      animation: hb-pulse 1.8s ease-out infinite;
    }

    .hb-hero__title,
    .hb-hero__summary,
    .hb-hero__actions {
      animation: hb-rise 760ms cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
    }

    .hb-hero__summary {
      animation-delay: 90ms;
    }

    .hb-hero__actions {
      animation-delay: 180ms;
    }
  }

  @keyframes hb-deal {
    from {
      opacity: 0;
      transform: translate(46%, 30%) rotate(14deg) scale(0.92);
    }
  }

  @keyframes hb-rise {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
  }

  @keyframes hb-pulse {
    from {
      transform: scale(1);
      opacity: 0.8;
    }
    to {
      transform: scale(3);
      opacity: 0;
    }
  }

  /* ---------- Facts ---------- */
  .hb-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: clamp(3rem, 7vw, 5rem) 0 0;
    padding: clamp(1.25rem, 2.5vw, 1.75rem) 0 0;
    list-style: none;
    border-top: 1px solid rgb(255 248 242 / 0.14);
  }

  .hb-fact {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }

  .hb-fact__value {
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 2.75rem);
    line-height: 1.1;
    color: var(--color-primary);
  }

  .hb-fact__label {
    max-width: 16rem;
    font-size: clamp(0.8125rem, 0.75rem + 0.3vw, 1rem);
    line-height: 1.45;
    color: var(--color-ink-secondary);
  }

  /* ---------- Rhythm ---------- */
  .hb-rhythm {
    display: grid;
    gap: 1rem;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .hb-rhythm {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  .hb-rhythm__card {
    position: relative;
    z-index: calc(1 + var(--k));
    padding: clamp(1.4rem, 2.5vw, 1.9rem);
    border-radius: 1.25rem;
    background: #0b4a44;
    border: 1px solid rgb(255 248 242 / 0.1);
    box-shadow: 0 22px 40px -26px rgb(0 0 0 / 0.75);
  }

  .hb-rhythm__shape {
    display: flex;
    height: 1.75rem;
    margin-bottom: 1.25rem;
  }

  .hb-rhythm__shape span {
    width: 1.35rem;
    height: 1.75rem;
    border-radius: 0.35rem;
    border: 1.5px solid var(--color-primary);
    background: #0b4a44;
  }

  .hb-rhythm__shape span + span {
    margin-left: -0.8rem;
    translate: 0 -0.2rem;
  }

  .hb-rhythm__shape span:last-child {
    background: var(--color-primary);
  }

  .hb-rhythm__title {
    margin: 0;
    font-size: clamp(1.125rem, 1rem + 0.4vw, 1.3rem);
    line-height: 1.3;
    color: var(--color-ink-primary);
  }

  .hb-rhythm__copy {
    margin: 0.6rem 0 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-secondary);
  }
</style>
