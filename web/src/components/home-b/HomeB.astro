---
import type { HomepageBuilder } from "@/lib/homepage/builders";
import Sheet from "./Sheet.astro";
import Cohort from "./Cohort.astro";
import Builders from "./Builders.astro";
import Community from "./Community.astro";
import Hire from "./Hire.astro";
import Principles from "./Principles.astro";
// oxlint-disable-next-line import/no-unassigned-import -- Candidate B's prefixed shared pieces.
import "./home-b.css";

/**
 * Homepage candidate B, "Layers": the page as a stack of sheets. The server
 * markup is the finished composition; `scripts/home-b.ts` adds the stacking,
 * deck, tabs and arrival motion when the visitor allows motion.
 */
interface Props {
  builders: HomepageBuilder[];
  isAuthenticated: boolean;
}

const { builders, isAuthenticated } = Astro.props;
---

<div class="hb" data-hb-root>
  <Sheet id="cohorts" tone="base" labelledby="hb-cohorts-title" layer={1}>
    <Cohort builders={builders} />
  </Sheet>
  <Sheet id="builders" tone="raised" labelledby="hb-builders-title" layer={2}>
    <Builders builders={builders} />
  </Sheet>
  <Sheet id="community" tone="lift" labelledby="hb-community-title" layer={3}>
    <Community isAuthenticated={isAuthenticated} builders={builders} />
  </Sheet>
  <Sheet id="hire" tone="peach" labelledby="hb-hire-title" layer={4} fill>
    <Hire builders={builders} />
  </Sheet>
  <Sheet id="principles" tone="deep" labelledby="hb-principles-title" layer={5}>
    <Principles />
  </Sheet>
</div>

<script>
  import { initHomeB } from "./scripts/home-b";

  initHomeB();
</script>
