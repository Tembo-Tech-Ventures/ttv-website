---
/**
 * A channel's page on a person's first visit to any channel: the header, then
 * "How we talk to each other" to agree to before the conversation shows
 * (ChannelPageBody renders ChannelView once they have). A page with its own
 * header (a private conversation) passes it in the `header` slot.
 */
import type { Channel } from "@/lib/platform/contracts";
import { CONDUCT_FIRST_VISIT, CONDUCT_TITLE } from "./conduct";
import ChannelHeader from "./ChannelHeader.astro";
import ConductAgree from "./ConductAgree.astro";
import ConductHabits from "./ConductHabits.astro";

interface Props {
  channel: Channel;
  /** This page with its query, where agreeing posts and returns. */
  action: string;
  /** False for an agent's delegated session: the habits show, the action does not. */
  canAgree?: boolean;
}

const { channel, action, canAgree = true } = Astro.props;
---

<div class="flex min-h-full flex-col" data-channel-frame={channel.slug} data-channel-kind={channel.kind}>
  {Astro.slots.has("header") ? <slot name="header" /> : <ChannelHeader channel={channel} />}
  <section aria-labelledby="conduct-title" data-conduct-gate class="mt-8">
    <h2 id="conduct-title" class="font-body text-2xl leading-tight font-bold text-ink-primary">{CONDUCT_TITLE}</h2>
    <p class="mt-2 mb-5 text-[0.9375rem] text-ink-muted">{CONDUCT_FIRST_VISIT}</p>
    <ConductHabits />
    <ConductAgree action={action} canAgree={canAgree} />
  </section>
</div>
