---
/**
 * The body of a channel page (community or cohort). Before a person has
 * agreed to how we talk to each other, ChannelFrame asks (U-2.3). After, the
 * conversation (U-2.1): ChannelView, with ChannelHeader as its children so the
 * thread rail can run the full height beside both. The page passes `fill`
 * to SpacePage exactly when the view shows, so the view sizes to the sheet.
 *
 * `?thread=` opens a thread (only one this reader can open: the server
 * answers no thread otherwise) and `?message=` marks a linked message.
 *
 * A page with its own header (a private conversation, U-4.1) passes it in the
 * `header` slot; otherwise the channel's own ChannelHeader shows.
 */
import type { ChannelPageView, ChannelsPage } from "./channel-page";
import ChannelFrame from "./ChannelFrame.astro";
import ChannelHeader from "./ChannelHeader.astro";
import ChannelView from "./ChannelView";

interface Props {
  page: ChannelsPage & ChannelPageView;
}

const { page } = Astro.props;
const query = Astro.url.searchParams;
// Read with the page's frame (channel-page.ts). The first page, the `?thread=` replies and the read
// marker (B-2.3), so the channel reads without JavaScript; it never moves the read marker. And the
// work the composer can attach (B-2.4): the person's own projects, and session clips only in their
// cohort's own channels, or null, and then the composer offers no attach tools.
const { first, shareables } = page;
const threadId = first?.page.thread ? query.get("thread") : null;
const ownHeader = Astro.slots.has("header");
---

{
  page.agreed ? (
    <ChannelView
      client:load
      me={page.context.me}
      channel={first?.channel ?? page.channel}
      initial={first?.page.initial ?? null}
      initialThread={first?.page.thread ?? null}
      initialRead={first?.page.read ?? null}
      now={Date.now()}
      shareables={shareables}
      threadId={threadId}
      messageId={query.get("message")}
    >
      <div class="channel-view__header">
        {ownHeader ? <slot name="header" /> : <ChannelHeader channel={page.channel} />}
      </div>
    </ChannelView>
  ) : ownHeader ? (
    <ChannelFrame channel={page.channel} canAgree={page.canAgree} action={page.self}>
      <slot name="header" slot="header" />
    </ChannelFrame>
  ) : (
    <ChannelFrame channel={page.channel} canAgree={page.canAgree} action={page.self} />
  )
}
