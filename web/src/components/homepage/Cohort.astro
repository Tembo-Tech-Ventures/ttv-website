---
import type { HomepageBuilder } from "@/lib/homepage/builders";
import { COHORT } from "@/lib/homepage/content";
import { cohortNumberOf } from "./cohorts";

/**
 * The opening sheet: what a cohort is, who can apply and how, beside a deck
 * of the cohorts so far with the running one on top. The deck is the page's
 * motif: builders below carry their cohort's card, and the hire pair is the
 * same kind of card. Each card carries that cohort's published builders. With
 * JS the cards become buttons that bring a cohort to the top (and point the
 * "Meet the builders" link at it); pointing at or focusing the deck parts it
 * (`deck.ts`). The skills map is the next layer of this section (`Homepage.astro`).
 */
interface Props {
  builders: HomepageBuilder[];
}

const { builders } = Astro.props;
const cohorts = COHORT.timeline.map((cohort) => ({
  ...cohort,
  people: builders.filter((builder) => cohortNumberOf(builder) === cohort.number),
}));
const SHOWN_FACES = 5;
// Resting order, back to front: completed cohorts in order, the running one on top.
const order = [...cohorts.keys()].toSorted((a, b) => Number(cohorts[a].running) - Number(cohorts[b].running) || a - b);
---

<div class="hp-hero">
  <div class="hp-hero__copy">
    <h1 id="hp-cohorts-title" class="hp-hero__title font-heading tracking-heading">{COHORT.title}</h1>
    <p class="hp-hero__summary">{COHORT.summary}</p>
    <div class="hp-hero__actions">
      <a class="hp-pill" href={COHORT.apply.href}>
        <span>{COHORT.apply.label}</span>
        <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18"><path d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
      <a class="hp-quiet" href={COHORT.secondary.href} data-hp-cohort-jump>{COHORT.secondary.label}</a>
    </div>
    <p class="hp-hero__eligibility">
      <span class="hp-check" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="14" height="14"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </span>
      {COHORT.eligibility}
    </p>
  </div>

  <div class="hp-deck-stage" data-hp-deck-stage>
    <svg class="hp-deck-net" viewBox="0 0 400 400" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
      {[
        { rx: 92, ry: 70 },
        { rx: 150, ry: 116 },
        { rx: 196, ry: 156 },
      ].map((ring, index) => (
        <ellipse class="hp-deck-net__ring" cx="200" cy="214" rx={ring.rx} ry={ring.ry} pathLength="1" style={`--k:${index}`} />
      ))}
      <ellipse class="hp-deck-net__cohort" cx="200" cy="214" rx="173" ry="136" pathLength="1" />
      {[
        [62, 120],
        [338, 104],
        [374, 250],
        [30, 292],
        [118, 356],
        [300, 352],
        [214, 58],
        [8, 196],
      ].map(([cx, cy], index) => (
        <circle class="hp-deck-net__dust" cx={cx} cy={cy} r={index % 3 === 0 ? 3 : 2.2} style={`--k:${index}`} />
      ))}
    </svg>
    <ol class="hp-deck" style={`--n:${cohorts.length}`} data-hp-deck aria-label="Our cohorts so far">
      {cohorts.map((cohort, index) => (
        <li
          class:list={["hp-cc", { "hp-cc--running": cohort.running, "is-top": order.indexOf(index) === cohorts.length - 1 }]}
          style={`--k:${index};--slot:${order.indexOf(index)}`}
          data-hp-deck-card
          data-cohort={cohort.number}
        >
          <div class="hp-cc__pose" data-hp-deck-button>
            <div class="hp-cc__inner">
              <p class="hp-cc__head">
                <span class="hp-cc__name">{cohort.label}</span>
                <span class="hp-cc__status">
                  {cohort.running && <span class="hp-cc__pulse" aria-hidden="true" />}
                  {cohort.status}
                </span>
              </p>
              {cohort.people.length > 0 && (
                <div class="hp-cc__people">
                  <span class="hp-cc__faces" aria-hidden="true">
                    {cohort.people.slice(0, SHOWN_FACES).map((person) => (
                      <span class="font-heading">{person.initials}</span>
                    ))}
                  </span>
                  <span class="hp-cc__count">
                    {cohort.people.length} published {cohort.people.length === 1 ? "profile" : "profiles"}
                  </span>
                </div>
              )}
              <span class="hp-cc__numeral font-heading tracking-display" aria-hidden="true">{cohort.number}</span>
              <span class="hp-cc__rule" aria-hidden="true" />
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>

  <ul class="hp-facts">
    {COHORT.facts.map((fact) => (
      <li class="hp-fact">
        <span class="hp-fact__value font-heading tracking-subhead">{fact.value}</span>
        <span class="hp-fact__label">{fact.label}</span>
      </li>
    ))}
  </ul>
</div>


<style>
  /* ---------- Split hero ---------- */
  /*
   * Phones: copy, deck, facts in one column. Tablets: copy across the top,
   * then the deck with the facts stacked in the column beside it. Desktop:
   * copy beside the deck, facts in a row underneath.
   */
  .hp-hero {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }

  @media (min-width: 40rem) and (max-width: 63.99rem) {
    .hp-hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
      column-gap: 2rem;
    }

    .hp-hero__copy {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64rem) {
    .hp-hero {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(3rem, 5vw, 5rem);
    }

    .hp-facts {
      grid-column: 1 / -1;
    }
  }

  .hp-hero__title {
    margin: 0;
    max-width: 15ch;
    font-size: clamp(2rem, 1.1rem + 3.4vw, 3.9rem);
    line-height: 1.04;
    color: var(--color-ink-primary);
    text-wrap: balance;
  }

  .hp-hero__summary {
    margin: clamp(1.25rem, 2.5vw, 1.75rem) 0 0;
    max-width: 34rem;
    font-size: clamp(1.0625rem, 0.98rem + 0.35vw, 1.25rem);
    line-height: 1.6;
    color: var(--color-ink-secondary);
  }

  .hp-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin-top: clamp(1.75rem, 3vw, 2.25rem);
  }

  .hp-hero__eligibility {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 1.1rem 0 0;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-ink-primary);
  }

  .hp-check {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: rgb(242 141 104 / 0.2);
    color: var(--color-primary);
  }

  .hp-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3.25rem;
    padding: 0 1.6rem;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-dark);
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    box-shadow: 0 10px 24px -12px rgb(242 141 104 / 0.7);
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 220ms ease;
  }

  .hp-pill svg {
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hp-pill:hover,
  .hp-pill:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 16px 30px -14px rgb(242 141 104 / 0.85);
  }

  .hp-pill:hover svg,
  .hp-pill:focus-visible svg {
    transform: translateX(3px);
  }

  .hp-quiet {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-ink-primary);
    font-size: 1rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: rgb(242 141 104 / 0.55);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    transition: text-decoration-color 200ms ease, color 200ms ease;
  }

  .hp-quiet:hover,
  .hp-quiet:focus-visible {
    color: var(--color-primary);
    text-decoration-color: currentColor;
  }

  .hp-pill:focus-visible,
  .hp-quiet:focus-visible {
    outline: 2px solid var(--color-ink-primary);
    outline-offset: 4px;
  }

  /* ---------- The cohort deck ---------- */
  /* Below 64rem the deck is inset and rotates gently, so no card's swing
   * (or the scroll fan) reaches past the gutter. */
  .hp-deck-stage {
    --peek: 2.6rem;
    --card-h: 13rem;
    --depth: 12px;
    --step-deg: 2deg;
    --x-step: 0.3rem;
    position: relative;
    display: flex;
    justify-content: center;
    margin-top: 1.5rem;
    perspective: 1100px;
  }

  /* The skills map's rings, faint behind the deck: the cohort at the centre. */
  .hp-deck-net {
    position: absolute;
    inset: -8% 0;
    width: 100%;
    height: 116%;
    overflow: visible;
    pointer-events: none;
  }

  @media (min-width: 64rem) {
    .hp-deck-net {
      inset: -24% -16%;
      width: 132%;
      height: 148%;
    }
  }

  .hp-deck-net__ring {
    fill: none;
    stroke: rgb(127 188 178 / 0.3);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .hp-deck-net__cohort {
    fill: none;
    stroke: rgb(242 141 104 / 0.6);
    stroke-width: 1.25;
    stroke-dasharray: 0.006 0.014;
    vector-effect: non-scaling-stroke;
  }

  .hp-deck-net__dust {
    fill: rgb(127 188 178 / 0.45);
  }

  .hp-deck {
    position: relative;
    z-index: 1;
    width: min(100% - 4rem, 24rem);
    height: calc(var(--card-h) + (var(--n) - 1) * var(--peek));
    margin: 0;
    padding: 0;
    list-style: none;
    transform-style: preserve-3d;
  }

  @media (min-width: 40rem) {
    .hp-deck-stage {
      --depth: 22px;
      --x-step: 0.5rem;
      --peek: 3.5rem;
      --card-h: 17rem;
      justify-content: flex-start;
    }

    .hp-deck-stage {
      --step-deg: 1.6deg;
    }

    .hp-deck {
      margin-left: 2.5rem;
    }
  }

  @media (min-width: 64rem) {
    .hp-deck-stage {
      --step-deg: 3.4deg;
      --x-step: 0.7rem;
      --card-h: 19rem;
      justify-content: center;
      margin-top: 0;
    }

    .hp-deck {
      width: min(100% - 3rem, 22rem);
      margin-left: 0;
    }
  }

  /* GSAP owns each card's transform (scroll fan, hover parting); the resting
   * pose for its slot sits one level in, on the button. */
  /* Each card's box starts at its own slot, so a card never sits over the
   * visible strip of the cards behind it. */
  .hp-cc {
    position: absolute;
    inset-inline: 0;
    top: calc(var(--slot) * var(--peek));
    z-index: calc(var(--slot) + 1);
    height: var(--card-h);
    transform-origin: 50% 140%;
    transform-style: preserve-3d;
  }

  .hp-cc__pose {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 1.25rem;
    translate:
      calc((var(--slot) - (var(--n) - 1) / 2) * var(--x-step))
      0
      calc(var(--slot) * var(--depth));
    rotate: calc((var(--slot) - (var(--n) - 1) * 0.7) * var(--step-deg));
    transform-origin: 50% 140%;
  }

  /* The cards only become buttons once deck.ts is running. */
  :global(.hp-deck--live) .hp-cc__pose {
    cursor: pointer;
  }

  .hp-cc__pose:focus-visible {
    outline: 2px solid var(--color-ink-primary);
    outline-offset: 4px;
  }

  /* Focusing a card brings it to the top (deck.ts), so it is frontmost; it
   * also lifts like a hovered one. */

  .hp-cc__pose:focus-visible .hp-cc__inner {
    translate: 0 -0.6rem;
  }

  .hp-cc__inner {
    position: relative;
    display: block;
    height: 100%;
    box-sizing: border-box;
    padding: 0.95rem 1.25rem;
    border-radius: 1.25rem;
    background: color-mix(in srgb, #0d4f48, #2c6964 calc(var(--k) * 22%));
    border: 1px solid rgb(255 248 242 / 0.12);
    box-shadow:
      0 1px 0 rgb(255 248 242 / 0.08) inset,
      0 18px 40px -18px rgb(0 0 0 / 0.65);
  }

  .hp-cc--running .hp-cc__inner {
    background:
      radial-gradient(120% 90% at 100% 100%, rgb(255 209 102 / 0.35), transparent 60%),
      var(--color-primary);
    border-color: rgb(255 248 242 / 0.45);
    color: var(--color-dark);
  }

  .hp-cc__head {
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.875rem;
    line-height: 1.5rem;
    font-weight: 600;
  }

  .hp-cc__name {
    letter-spacing: 0.01em;
  }

  .hp-cc__status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0 0.6rem;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgb(255 248 242 / 0.85);
    background: rgb(0 0 0 / 0.18);
  }

  .hp-cc--running .hp-cc__status {
    color: var(--color-ink-primary);
    background: var(--color-dark);
    font-weight: 600;
  }

  .hp-cc__pulse {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #ffd166;
  }

  /* The cohort's published builders, shown on whichever card is on top. */
  .hp-cc__people {
    display: grid;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .hp-cc:not(.is-top) .hp-cc__people {
    display: none;
  }

  .hp-cc__faces {
    display: flex;
  }

  .hp-cc__faces span {
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 0.6rem;
    border: 2px solid #0f514a;
    background: var(--color-primary);
    color: var(--color-dark);
    font-size: 0.7rem;
  }

  .hp-cc__faces span + span {
    margin-left: -0.35rem;
  }

  .hp-cc__count {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-ink-primary);
  }

  /* Every card carries its number; only the card on top shows it whole. */
  .hp-cc__numeral {
    position: absolute;
    left: 1.1rem;
    bottom: 0.4rem;
    font-size: clamp(4.5rem, 14vw, 8.5rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-primary);
  }

  .hp-cc:not(.is-top) .hp-cc__numeral {
    opacity: 0;
  }

  .hp-cc--running .hp-cc__numeral {
    color: var(--color-dark);
    -webkit-text-stroke: 0;
  }

  /* Tick rule under the status pill, clear of the big numeral. */
  .hp-cc__rule {
    position: absolute;
    top: 3.4rem;
    right: 1.25rem;
    width: 24%;
    height: 0.6rem;
    border-radius: 999px;
    background: repeating-linear-gradient(90deg, currentColor 0 2px, transparent 2px 7px);
    opacity: 0.35;
  }

  .hp-cc:not(.is-top) .hp-cc__rule {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hp-cc {
      transition: top 620ms cubic-bezier(0.3, 0.9, 0.25, 1);
    }

    .hp-cc__pose {
      transition:
        translate 620ms cubic-bezier(0.3, 0.9, 0.25, 1),
        rotate 620ms cubic-bezier(0.3, 0.9, 0.25, 1);
    }

    .hp-cc__numeral {
      transition: opacity 400ms ease 200ms;
    }

    .hp-cc.is-top .hp-cc__people {
      animation: hp-rise 520ms cubic-bezier(0.2, 0.8, 0.2, 1) 180ms backwards;
    }

    .hp-cc__inner {
      animation: hp-deal 760ms cubic-bezier(0.18, 0.9, 0.24, 1.08) backwards;
      animation-delay: calc(120ms + var(--k) * 110ms);
      transition: translate 280ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    /* A card lifts out of the deck under the pointer. */
    @media (hover: hover) and (pointer: fine) {
      .hp-cc__pose:hover .hp-cc__inner {
        translate: 0 -0.6rem;
      }
    }

    .hp-deck-net__ring {
      stroke-dasharray: 1 1;
      animation: hp-draw 1.8s cubic-bezier(0.65, 0, 0.35, 1) backwards;
      animation-delay: calc(200ms + var(--k) * 180ms);
    }

    .hp-deck-net__cohort,
    .hp-deck-net__dust {
      animation: hp-fade 900ms ease 1.1s backwards;
    }

    .hp-deck-net__dust {
      animation-delay: calc(900ms + var(--k) * 70ms);
    }

    .hp-cc__pulse::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: inherit;
      animation: hp-pulse 1.8s ease-out infinite;
    }

    .hp-hero__title,
    .hp-hero__summary,
    .hp-hero__actions,
    .hp-hero__eligibility {
      animation: hp-rise 760ms cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
    }

    .hp-hero__summary {
      animation-delay: 90ms;
    }

    .hp-hero__actions {
      animation-delay: 180ms;
    }

    .hp-hero__eligibility {
      animation-delay: 260ms;
    }
  }

  @keyframes hp-draw {
    from {
      stroke-dashoffset: 1;
    }
  }

  @keyframes hp-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes hp-deal {
    from {
      opacity: 0;
      transform: translate(46%, 30%) rotate(14deg) scale(0.92);
    }
  }

  @keyframes hp-rise {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
  }

  @keyframes hp-pulse {
    from {
      transform: scale(1);
      opacity: 0.8;
    }
    to {
      transform: scale(3);
      opacity: 0;
    }
  }

  /* ---------- Facts ---------- */
  .hp-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: clamp(1.25rem, 2.5vw, 1.75rem) 0 0;
    list-style: none;
    border-top: 1px solid rgb(255 248 242 / 0.14);
  }

  /* Tablets: the facts fill the column beside the deck, top-aligned with it. */
  @media (min-width: 40rem) and (max-width: 63.99rem) {
    .hp-facts {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
      margin-top: 1.5rem;
      padding: 0.25rem 0 0.25rem 1.5rem;
      border-top: 0;
      border-left: 1px solid rgb(255 248 242 / 0.14);
    }
  }

  .hp-fact {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }

  .hp-fact__value {
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 2.75rem);
    line-height: 1.1;
    color: var(--color-primary);
  }

  .hp-fact__label {
    max-width: 16rem;
    font-size: clamp(0.8125rem, 0.75rem + 0.3vw, 1rem);
    line-height: 1.45;
    color: var(--color-ink-secondary);
  }
</style>
