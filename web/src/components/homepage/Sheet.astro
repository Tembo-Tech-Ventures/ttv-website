---
// oxlint-disable-next-line import/no-unassigned-import -- Shared marketing sheet styles.
import "./sheet.css";
/**
 * One sheet in the homepage's stack. Every major section is a sheet (the
 * opening section is two: the hero, then the skills map sliding over it) with
 * rounded top corners that slides over the one before it. Without JS (or with
 * reduced motion) sheets simply sit in flow with their corners overlapping;
 * `stack.ts` adds `hp-stacked` to the root, measures each sheet and makes it
 * stick while the next sheet's edge and title are already on screen, so the
 * next one slides over it with no extra scroll.
 */
interface Props {
  /** Section id; omitted for a sheet that is one layer of a larger section. */
  id?: string;
  tone: "base" | "map" | "raised" | "lift" | "peach" | "deep";
  labelledby?: string;
  layer: number;
  /** Own the whole screen (below the nav) while held, so nothing shows underneath. */
  fill?: boolean;
  /** The last sheet: it never sticks, the page ends on it. */
  last?: boolean;
}

const { id, tone, labelledby, layer, fill = false, last = false } = Astro.props;
// A sheet that is a layer of a section is a plain container; the section is its parent.
const Tag = id ? "section" : "div";
---

<Tag
  id={id}
  class:list={["hp-sheet", `hp-sheet--${tone}`, { "hp-sheet--fill": fill, "hp-sheet--last": last }]}
  style={`--hp-layer:${layer}`}
  aria-labelledby={labelledby}
  data-hp-sheet
>
  <div class="hp-sheet__body">
    <slot />
  </div>
  <div class="hp-sheet__dim" aria-hidden="true" data-hp-dim></div>
</Tag>
