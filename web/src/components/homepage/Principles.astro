---
import { PRINCIPLES } from "@/lib/homepage/content";

/**
 * The five principles as a last stack. Words are outlined Mattone sized so
 * the longest fits its row (from measured advance widths, then refined by
 * `principles.ts` once the font loads); all five share one size so no word
 * shouts over another. With motion, each row sticks and the next slides over
 * it, and a word fills with peach as it lands. Reduced motion is a static list.
 */
const LONGEST_ADVANCE_EM = 9.29; // PHILOSOPHY in Mattone at -0.02em tracking
const fit = (0.97 / LONGEST_ADVANCE_EM).toFixed(4);
---

<h2 id="hp-principles-title" class="hp-h2 font-heading tracking-heading">{PRINCIPLES.title}</h2>

<ol class="hp-values" style={`--hp-fit:${fit}`} data-hp-values>
  {PRINCIPLES.values.map((value, index) => (
    <li class="hp-value" style={`--i:${index}`} data-hp-value>
      <div class="hp-value__inner">
        <p class="hp-value__word font-heading tracking-display" data-hp-word>{value.word}</p>
        <p class="hp-value__commitment">{value.commitment}</p>
      </div>
      <span class="hp-value__dim" aria-hidden="true" data-hp-dim></span>
    </li>
  ))}
</ol>

<style>
  .hp-values {
    margin: clamp(2rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .hp-value {
    position: relative;
    border-top: 1px solid rgb(242 141 104 / 0.28);
  }

  .hp-value__inner {
    container-type: inline-size;
    padding-block: clamp(1.25rem, 3vw, 2.25rem);
  }

  .hp-value__word {
    display: inline-block;
    margin: 0;
    font-size: calc(var(--hp-fit) * 100cqi);
    line-height: 1.12;
    white-space: nowrap;
    /* Room for descenders (EQUITY's Q tail) inside the box the fill paints. */
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-primary);
    background: linear-gradient(90deg, var(--color-primary) 50%, transparent 50%) 100% 0 / 200% 100% no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
  }

  .hp-value__commitment {
    max-width: 34rem;
    /* Equal rows, so a covered row never peeks out below the one on top. */
    min-height: calc(3 * 1.55em);
    margin: clamp(0.75rem, 2vw, 1.25rem) 0 0;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.55;
    color: var(--color-ink-primary);
  }

  /* One shared left edge for all five commitments. */
  @media (min-width: 48rem) {
    .hp-value__commitment {
      margin-left: calc(7 / 12 * 100%);
      max-width: none;
      min-height: calc(2 * 1.55em);
    }
  }

  .hp-value__dim {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: #00110f;
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hp-value {
      position: sticky;
      top: calc(var(--hp-nav, 4.6rem) + 0.75rem + var(--i) * 0.7rem);
      margin-bottom: 6vh;
      padding-inline: clamp(1rem, 2.5vw, 1.75rem);
      border: 1px solid rgb(242 141 104 / 0.28);
      border-radius: 1.25rem;
      background: #023834;
      box-shadow:
        0 -18px 30px -24px rgb(0 0 0 / 0.75),
        0 18px 30px -24px rgb(0 0 0 / 0.6);
    }

    .hp-value:last-child {
      margin-bottom: 0;
    }

    @media (max-width: 47.99rem) {
      .hp-value {
        margin-bottom: 5vh;
      }
    }

    .hp-value__word {
      transition: background-position 1s cubic-bezier(0.65, 0, 0.2, 1);
    }

    .hp-value.is-landed .hp-value__word {
      background-position: 0 0;
    }
  }
</style>
