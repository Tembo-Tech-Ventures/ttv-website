---
import { drizzle } from "drizzle-orm/d1";
import * as schema from "@/lib/db/schema";
import { env } from "cloudflare:workers";
import { eq, desc } from "drizzle-orm";
import { getCompletedCohorts } from "@/lib/talent/eligibility";
import { getInitials } from "@/components/talent/directory-helpers";

interface Slot {
  label: string;
}

const PLACEHOLDER_SLOTS: Slot[] = [
  { label: "Cohort 04 · Kenya" },
  { label: "Cohort 04 · Kenya" },
  { label: "Cohort 03 · Nigeria" },
  { label: "Cohort 02 · Alumni" },
];

const db = drizzle(env.DB, { schema });

const publishedProfiles = await db.query.studentProfile.findMany({
  where: eq(schema.studentProfile.status, "PUBLISHED"),
  orderBy: desc(schema.studentProfile.publishedAt),
  limit: 4,
  with: {
    user: { columns: { id: true, name: true, image: true } },
  },
});

const profileCards = await Promise.all(
  publishedProfiles.map(async (p) => {
    const cohorts = await getCompletedCohorts(db, p.user.id);
    const latestCohort = cohorts[0];
    const cohortLabel = latestCohort?.program
      ? `${latestCohort.program.name} · ${p.country ?? ""}`
      : p.country ?? "";
    return {
      handle: p.handle,
      name: p.user.name,
      image: p.user.image,
      initials: getInitials(p.user.name),
      label: cohortLabel,
    };
  }),
);

const hasProfiles = profileCards.length > 0;
---

<section id="humans" class="relative px-4 py-28 sm:px-8 md:py-36">
  <div class="mx-auto max-w-7xl">
    <div class="mb-14 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <p class="font-body text-xs font-semibold uppercase tracking-[0.4em] text-primary">
        &sect; 03 The cohort
      </p>
      {hasProfiles ? (
        <p class="max-w-md font-body text-base text-ink-secondary md:text-lg">
          Meet the builders from our cohorts across Africa.
          <a
            href="/talent"
            class="text-primary transition-colors hover:text-primary/80"
          >
            See all builders &rarr;
          </a>
        </p>
      ) : (
        <p class="max-w-md font-body text-base text-ink-secondary md:text-lg">
          Students asked for a place to show who they are and what they&apos;re
          building. We&apos;re putting it together with them &mdash; profiles land
          with Cohort 04.
        </p>
      )}
    </div>

    <ul class="grid grid-cols-2 gap-4 sm:gap-6 md:grid-cols-4">
      {Array.from({ length: 4 }, (_, i) => {
        const card = profileCards[i];
        if (card) {
          return (
            <li class="space-y-3">
              <a href={`/talent/${card.handle}`} class="block">
                <div
                  class="relative aspect-[4/5] overflow-hidden border border-[color:var(--color-rule)]"
                  style="background-color: var(--color-bg-raised);"
                >
                  {card.image ? (
                    <img
                      src={card.image}
                      alt=""
                      class="h-full w-full object-cover"
                      loading="lazy"
                    />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center">
                      <span
                        class="font-heading text-primary"
                        style="font-size: clamp(3rem, 7vw, 6rem); letter-spacing: -0.04em;"
                      >
                        {card.initials}
                      </span>
                    </div>
                  )}
                </div>
              </a>
              <p class="font-body text-sm font-semibold text-ink-primary">
                {card.name}
              </p>
              <p class="font-body text-xs font-semibold uppercase tracking-[0.24em] text-ink-muted">
                {card.label}
              </p>
            </li>
          );
        }
        const placeholder = PLACEHOLDER_SLOTS[i]!;
        return (
          <li class="space-y-3">
            <div
              class="relative aspect-[4/5] overflow-hidden border border-dashed border-[color:var(--color-rule)]"
              style="background-color: var(--color-bg-raised);"
            >
              <div class="flex h-full w-full items-center justify-center">
                <span
                  class="font-heading text-primary/40"
                  style="font-size: clamp(3rem, 7vw, 6rem); letter-spacing: -0.04em;"
                >
                  &mdash;
                </span>
              </div>
            </div>
            <p class="font-body text-xs font-semibold uppercase tracking-[0.24em] text-ink-muted">
              Profile coming
            </p>
            <p class="font-body text-sm text-ink-muted">{placeholder.label}</p>
          </li>
        );
      })}
    </ul>
  </div>
</section>
