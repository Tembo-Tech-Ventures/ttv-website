---
import type { HomepageBuilder } from "@/lib/homepage/builders";
import { COMMUNITY } from "@/lib/homepage/content";
import CommunityComp from "./CommunityComp.astro";

/**
 * Three ways into the community as ARIA tabs with a sliding indicator. Each
 * panel has one primary action (its role's page) beside a layered picture
 * built from real published profiles, which assembles itself when the tab
 * opens (`community.ts`). The general "join" link sits quietly under the
 * summary, before the tabs, so the visual and focus orders agree. Without JS a
 * <noscript> style shows all three panels and drops the tab row.
 */
interface Props {
  isAuthenticated: boolean;
  builders: HomepageBuilder[];
}

const { isAuthenticated, builders } = Astro.props;
const paths = COMMUNITY.paths;
---

<div class="hp-community" data-hp-tabs>
  <div class="hp-community__intro">
    <h2 id="hp-community-title" class="hp-h2 font-heading tracking-heading">{COMMUNITY.title}</h2>
    <div>
      <p class="hp-lede">{COMMUNITY.summary}</p>
      <a class="hp-community__join" href={COMMUNITY.join(isAuthenticated)}>{COMMUNITY.joinLabel}</a>
    </div>
  </div>

  <div class="hp-seg" role="tablist" aria-label="Ways to join" style="--sel:0" data-hp-tablist>
    <span class="hp-seg__pill" aria-hidden="true"></span>
    {paths.map((path, index) => (
      <button
        type="button"
        class="hp-seg__tab"
        role="tab"
        id={`hp-tab-${path.id}`}
        aria-controls={`hp-panel-${path.id}`}
        aria-selected={index === 0 ? "true" : "false"}
        tabindex={index === 0 ? 0 : -1}
        data-hp-tab
      >
        <span class={`hp-seg__glyph hp-seg__glyph--${path.id}`} aria-hidden="true"></span>
        <span class="hp-seg__label">{path.role}</span>
      </button>
    ))}
  </div>

  <div class="hp-panels">
    {paths.map((path, index) => (
      <div
        class="hp-panel"
        role="tabpanel"
        id={`hp-panel-${path.id}`}
        aria-labelledby={`hp-tab-${path.id}`}
        hidden={index !== 0}
        data-hp-panel
      >
        <div class="hp-panel__copy" data-hp-panel-copy>
          <p class="hp-panel__promise">{path.promise}</p>
          <p class="hp-panel__detail">
            <span class="hp-panel__badge" aria-hidden="true">
              {path.id === "builder" ? (
                <svg viewBox="0 0 16 16" width="14" height="14"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              ) : (
                <svg viewBox="0 0 16 16" width="14" height="14"><path d="M8 1.5l5.5 2v4c0 3.4-2.3 5.9-5.5 7-3.2-1.1-5.5-3.6-5.5-7v-4z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
              )}
            </span>
            {path.detail}
          </p>
          <a class="hp-panel__cta" href={path.href}>
            {path.cta}
            <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18"><path d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
        </div>
        <CommunityComp path={path.id} builders={builders} />
      </div>
    ))}
  </div>
</div>

<noscript>
  <style is:inline>
    .hp-seg { display: none !important; }
    .hp-panel[hidden] { display: grid !important; }
    .hp-panel { grid-area: auto !important; }
    .hp-panel + .hp-panel { margin-top: 3rem; }
  </style>
</noscript>

<style>
  .hp-community__intro {
    display: grid;
    gap: 1.25rem 4rem;
  }

  @media (min-width: 64rem) {
    .hp-community__intro {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: end;
    }

    .hp-community__intro :global(.hp-lede) {
      margin-top: 0;
    }
  }

  .hp-community__join {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-top: 0.5rem;
    color: var(--color-ink-primary);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgb(242 141 104 / 0.6);
    text-underline-offset: 0.3em;
    transition: color 200ms ease, text-decoration-color 200ms ease;
  }

  .hp-community__join:hover,
  .hp-community__join:focus-visible {
    color: var(--color-primary);
    text-decoration-color: currentColor;
  }

  .hp-community__join:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
    border-radius: 0.25rem;
  }

  /* ---------- Segmented control ---------- */
  .hp-seg {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.25rem;
    width: min(100%, 36rem);
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: 0.35rem;
    box-sizing: border-box;
    border-radius: 999px;
    background: rgb(1 46 43 / 0.7);
    border: 1px solid rgb(255 248 242 / 0.1);
    box-shadow: 0 1px 0 rgb(255 248 242 / 0.06), inset 0 2px 6px rgb(0 0 0 / 0.3);
  }

  .hp-seg__pill {
    position: absolute;
    top: 0.35rem;
    bottom: 0.35rem;
    left: 0.35rem;
    width: calc((100% - 0.7rem - 0.5rem) / 3);
    border-radius: 999px;
    background: var(--color-primary);
    box-shadow: 0 6px 16px -8px rgb(242 141 104 / 0.9);
    translate: calc(var(--sel) * (100% + 0.25rem)) 0;
  }

  .hp-seg__tab {
    position: relative;
    z-index: 1;
    min-height: 2.9rem;
    padding: 0.4rem 0.75rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-ink-secondary);
    font: inherit;
    font-size: clamp(0.85rem, 0.8rem + 0.25vw, 1rem);
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
  }

  /* Glyph and label side by side, centred, however the label wraps. */
  .hp-seg__tab {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hp-seg__label {
    text-align: left;
  }

  .hp-seg__tab:hover {
    color: var(--color-ink-primary);
  }

  .hp-seg__tab[aria-selected="true"] {
    color: var(--color-dark);
  }

  /* The skills map's shapes: builders are peach dots, mentors teal rings,
   * partners ink diamonds. On the selected (peach) tab they turn dark. */
  .hp-seg__glyph {
    display: inline-block;
    flex: none;
    width: 0.6rem;
    height: 0.6rem;
    margin-right: 0.45rem;
    vertical-align: 0.05em;
    border-radius: 50%;
    background: var(--color-primary);
    transition: background-color 160ms ease 190ms, border-color 160ms ease 190ms;
  }

  .hp-seg__glyph--mentor {
    box-sizing: border-box;
    background: transparent;
    border: 2px solid #7fbcb2;
  }

  .hp-seg__glyph--partner {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 1px;
    background: var(--color-ink-primary);
    rotate: 45deg;
  }

  .hp-seg__tab[aria-selected="true"] .hp-seg__glyph {
    background: var(--color-dark);
  }

  .hp-seg__tab[aria-selected="true"] .hp-seg__glyph--mentor {
    background: transparent;
    border-color: var(--color-dark);
  }

  /* Wide enough for every label on one line from 48rem. */
  @media (min-width: 48rem) {
    .hp-seg {
      width: min(100%, 42rem);
    }

    .hp-seg__tab {
      white-space: nowrap;
    }
  }

  .hp-seg__tab:focus-visible {
    outline: 2px solid var(--color-ink-primary);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hp-seg__pill {
      transition: translate 550ms cubic-bezier(0.65, 0, 0.35, 1);
    }

    .hp-seg__tab {
      /* Labels change colour as the pill passes their midpoint, never peach on peach. */
      transition: color 160ms ease 190ms;
    }
  }

  /* ---------- Panels ---------- */
  /* All panels share one grid cell; community.ts reserves the tallest one's
   * height, so switching tabs never moves the page below. */
  .hp-panels {
    display: grid;
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .hp-panel {
    grid-area: 1 / 1;
  }

  .hp-panel {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  @media (min-width: 56rem) {
    .hp-panel {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: start;
    }

    .hp-panel__copy {
      padding-top: clamp(1rem, 3vw, 2.5rem);
    }
  }

  .hp-panel__promise {
    margin: 0;
    max-width: 28rem;
    font-size: clamp(1.35rem, 1.1rem + 1vw, 1.9rem);
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-ink-primary);
    text-wrap: pretty;
  }

  .hp-panel__detail {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 1.25rem 0 1.75rem;
    font-size: 1rem;
    color: var(--color-ink-secondary);
  }

  .hp-panel__badge {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: rgb(242 141 104 / 0.18);
    color: var(--color-primary);
  }

  .hp-panel__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3.25rem;
    padding: 0 1.5rem;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-dark);
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 10px 24px -12px rgb(242 141 104 / 0.6);
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hp-panel__cta svg {
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hp-panel__cta:hover,
  .hp-panel__cta:focus-visible {
    transform: translateY(-2px);
  }

  .hp-panel__cta:hover svg,
  .hp-panel__cta:focus-visible svg {
    transform: translateX(3px);
  }

  .hp-panel__cta:focus-visible {
    outline: 2px solid var(--color-ink-primary);
    outline-offset: 4px;
  }
</style>
