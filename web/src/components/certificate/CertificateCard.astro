---
import type { CertificateView } from "@/lib/certificate/view-model";
import CertificateActions from "./CertificateActions.astro";

interface Props {
  view: CertificateView;
}

const { view } = Astro.props;

const rows = [
  { label: "Instructor", value: view.instructorName },
  { label: "Issued", value: view.issueDate },
  { label: "Credential ID", value: view.certificateId, mono: true },
  { label: "Verify at", value: view.verifyHost },
].filter((entry): entry is typeof entry & { value: string } =>
  Boolean(entry.value)
);
---

<main class="page">
  <article class="card">
    <div class="card-body">
      <div class="card-top">
        <p class="wordmark">Tembo Tech Ventures</p>
        <p class="status">Verified</p>
      </div>

      <div class="seal" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
          stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 12.5 9.5 18 20 6.5" />
        </svg>
      </div>

      <!--
        One heading, not an eyebrow paragraph plus a heading: the page's
        subject is "Certificate of Completion — <recipient>", and splitting it
        would leave the document type outside the heading outline entirely.
      -->
      <h1 class="title">
        <span class="eyebrow">Certificate of Completion</span>
        <span class="name">{view.studentName}</span>
      </h1>

      <p class="completed">completed</p>
      <p class="course">{view.curriculumTitle}</p>
      {view.programName && <p class="cohort">{view.programName}</p>}

      <dl class="meta">
        {rows.map((row) => (
          <div class="meta-row">
            <dt class="meta-label">{row.label}</dt>
            <dd class:list={["meta-value", row.mono && "meta-value-mono"]}>
              {row.value}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </article>

  <CertificateActions view={view} tone="light" />
</main>

<style>
  .page {
    --paper: #fffcf6;
    --ink: #10312e;
    --ink-soft: #5b736f;
    --hairline: rgba(1, 61, 57, 0.14);

    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    padding: clamp(1.25rem, 5vw, 4rem) 1rem clamp(2.5rem, 6vw, 4rem);
    /* The cream card floats on the brand teal so the credential reads as an
     * object rather than as the page itself. */
    background: var(--color-dark);
  }

  .card {
    width: 100%;
    max-width: 38rem;
    background: var(--paper);
    color: var(--ink);
    border-radius: 1.5rem;
    /* Clips the orange strip to the rounded top edge. */
    overflow: hidden;
    text-align: center;
    box-shadow: 0 24px 60px -30px rgb(0 0 0 / 0.75);
  }

  .card::before {
    content: "";
    display: block;
    height: 6px;
    background: var(--color-primary);
  }

  .card-body {
    padding: clamp(1.5rem, 5.5vw, 2.5rem);
  }

  .card-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: clamp(1.25rem, 4vw, 1.75rem);
    border-bottom: 1px solid var(--hairline);
  }

  .wordmark,
  .status {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .wordmark {
    letter-spacing: 0.26em;
    color: var(--color-teal);
    text-align: left;
  }

  /* Teal at both ends of the row balances the header against the seal. */
  .status {
    flex-shrink: 0;
    color: var(--color-teal);
  }

  .seal {
    width: 3rem;
    height: 3rem;
    margin: clamp(1.75rem, 5vw, 2.25rem) auto 0;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-dark);
  }

  .seal svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  /*
   * Global styles put Climate Crisis on every h1/h2. This credential is set
   * entirely in Maven Pro, so the heading opts out for itself and its spans.
   */
  .title {
    margin-top: 1.5rem;
    font-family: var(--font-body);
  }

  .eyebrow {
    display: block;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .name {
    display: block;
    margin-top: 0.7rem;
    font-family: var(--font-body);
    font-size: clamp(1.75rem, 7vw, 2.5rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .completed {
    margin-top: 1.4rem;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  /*
   * The brand orange fails contrast as body copy on cream, so the course line
   * takes the teal and orange stays on the strip and the seal.
   */
  .course {
    margin-top: 0.5rem;
    font-size: clamp(1.125rem, 4.4vw, 1.375rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-teal);
    text-wrap: balance;
  }

  .cohort {
    margin-top: 0.3rem;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .meta {
    margin-top: clamp(1.75rem, 5vw, 2.25rem);
    border: 1px solid var(--hairline);
    border-radius: 0.9rem;
    overflow: hidden;
    text-align: left;
  }

  /*
   * The label and a 25-character credential id fit on one line down to about
   * 23rem; below that the id would orphan its tail, so the pairs stack.
   */
  .meta-row {
    padding: 0.65rem 1rem;
  }

  @media (min-width: 23rem) {
    .meta-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.7rem 1rem;
    }
  }

  .meta-row + .meta-row {
    border-top: 1px solid var(--hairline);
  }

  .meta-label {
    flex-shrink: 0;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .meta-value {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    font-weight: 500;
  }

  @media (min-width: 23rem) {
    .meta-value {
      margin-top: 0;
      text-align: right;
    }
  }

  .meta-value-mono {
    font-family: ui-monospace, "SFMono-Regular", "Menlo", monospace;
    font-size: 0.6875rem;
    color: var(--ink-soft);
    overflow-wrap: anywhere;
  }

  @media (min-width: 30rem) {
    .meta-value-mono {
      font-size: 0.75rem;
    }
  }

  @media print {
    .page {
      min-height: 0;
      padding: 0;
      background: #fff;
    }

    .card {
      max-width: none;
      border-radius: 0;
      box-shadow: none;
    }
  }
</style>
