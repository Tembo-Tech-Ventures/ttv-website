---
import type { CertificateView } from "@/lib/certificate/view-model";
import CertificateActions from "./CertificateActions.astro";
import SignatureMark from "./SignatureMark.astro";

interface Props {
  view: CertificateView;
}

const { view } = Astro.props;

const credential = [
  { label: "Issued", value: view.issueDate },
  { label: "Credential ID", value: view.certificateId },
];
---

<main class="stage">
  <article class="sheet">
    <div class="band" aria-hidden="true"></div>

    <div class="inner">
      <header class="head">
        <p class="wordmark">Tembo Tech Ventures</p>
        <div class="seal" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 12.5 9.5 18 20 6.5" />
          </svg>
        </div>
      </header>

      <div class="body">
        <h1 class="title">
          <span class="eyebrow">Certificate of Completion</span>
          <span class="lede">This certifies that</span>
          <span class="name">{view.studentName}</span>
        </h1>
        <p class="lede lede-after">has completed</p>
        <p class="course">{view.curriculumTitle}</p>
        {view.programName && <p class="cohort">{view.programName}</p>}
      </div>

      <footer class="foot">
        {view.instructorName && (
          <div class="sign">
            <div class="sign-mark">
              <SignatureMark mark="instructor" />
            </div>
            <p class="sign-name">{view.instructorName}</p>
            <p class="sign-title">Instructor</p>
          </div>
        )}

        <dl class="credential">
          {credential.map((entry) => (
            <div class="credential-row">
              <dt>{entry.label}</dt>
              <dd>{entry.value}</dd>
            </div>
          ))}
          <div class="credential-row">
            <dt>Verify at</dt>
            <dd>
              <span class="screen-only">{view.verifyHost}</span>
              <span class="print-only">{view.verifyUrl}</span>
            </dd>
          </div>
        </dl>
      </footer>
    </div>
  </article>

  <CertificateActions view={view} tone="light" />
</main>

<style is:global>
  @media print {
    html,
    body {
      background: #fff !important;
    }
  }
</style>

<style>
  .stage {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.75rem;
    padding: clamp(1rem, 4vw, 3rem);
    background: var(--color-dark);
  }

  .sheet {
    --paper: #fffcf6;
    --ink: #10312e;
    --ink-soft: #5b736f;
    --hairline: rgba(1, 61, 57, 0.18);

    position: relative;
    width: 100%;
    max-width: 62rem;
    aspect-ratio: 11 / 8.5;
    overflow: hidden;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 30px 70px -35px rgb(0 0 0 / 0.8);
    container-type: size;
    container-name: sheet;
  }

  .band {
    position: absolute;
    inset: 0 auto 0 0;
    width: 2.2cqw;
    background: var(--color-primary);
  }

  .inner {
    position: absolute;
    inset: 0;
    padding: 6cqw 7cqw 5.5cqw calc(7cqw + 2.2cqw);
    display: flex;
    flex-direction: column;
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2cqw;
    padding-bottom: 3cqw;
    border-bottom: 1px solid var(--hairline);
  }

  .wordmark {
    font-size: 1.35cqw;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-teal);
  }

  .seal {
    flex-shrink: 0;
    width: 5cqw;
    height: 5cqw;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-dark);
  }

  .seal svg {
    width: 2.4cqw;
    height: 2.4cqw;
  }

  .body {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
  }

  .title {
    font-family: var(--font-body);
  }

  .eyebrow {
    display: block;
    font-size: 1.35cqw;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .lede {
    display: block;
    margin-top: 2.4cqw;
    font-size: 1.5cqw;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .lede-after {
    margin-top: 2cqw;
  }

  .name {
    display: block;
    margin-top: 1.4cqw;
    font-size: 5.6cqw;
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .course {
    margin-top: 1.2cqw;
    font-size: 2.9cqw;
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-teal);
    text-wrap: balance;
  }

  .cohort {
    margin-top: 0.9cqw;
    font-size: 1.6cqw;
    color: var(--ink-soft);
  }

  .foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 4cqw;
    padding-top: 3cqw;
  }

  .sign {
    width: 26cqw;
    flex-shrink: 0;
  }

  .sign-mark {
    height: 6.5cqw;
    display: flex;
    align-items: flex-end;
    margin-bottom: -1cqw;
    color: var(--ink);
  }

  .sign-mark :global(svg) {
    height: 100%;
    width: auto;
  }

  .sign-name {
    padding-top: 1cqw;
    border-top: 1px solid var(--ink);
    font-size: 1.7cqw;
    font-weight: 600;
  }

  .sign-title {
    margin-top: 0.3cqw;
    font-size: 1.2cqw;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .credential {
    text-align: right;
    font-size: 1.25cqw;
  }

  .credential-row + .credential-row {
    margin-top: 1cqw;
  }

  .credential dt {
    font-size: 1.05cqw;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .credential dd {
    margin-top: 0.25cqw;
    font-family: ui-monospace, "SFMono-Regular", "Menlo", monospace;
    overflow-wrap: anywhere;
  }

  .screen-only {
    display: inline;
  }

  .print-only {
    display: none;
  }

  @page {
    size: landscape;
    margin: 0;
  }

  @media print {
    .stage {
      min-height: 0;
      padding: 0;
      display: block;
      background: #fff;
    }

    .sheet {
      width: 100%;
      max-width: none;
      height: 100vh;
      aspect-ratio: auto;
      box-shadow: none;
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
      break-inside: avoid;
    }

    .screen-only {
      display: none;
    }

    .print-only {
      display: inline;
    }
  }
</style>
