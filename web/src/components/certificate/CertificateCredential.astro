---
import type { CertificateView } from "@/lib/certificate/view-model";
import CertificateActions from "./CertificateActions.astro";

interface Props {
  view: CertificateView;
}

const { view } = Astro.props;

const rows = [
  { label: "Instructor", value: view.instructorName },
  { label: "Issued", value: view.issueDate },
  { label: "Credential ID", value: view.certificateId, mono: true },
  { label: "Verify at", value: view.verifyHost },
].filter((entry): entry is typeof entry & { value: string } =>
  Boolean(entry.value)
);
---

<main class="page">
  <article class="card">
    <div class="card-top">
      <p class="wordmark">Tembo Tech Ventures</p>
      <p class="status">Verified</p>
    </div>

    <div class="seal" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
        stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 12.5 9.5 18 20 6.5" />
      </svg>
    </div>

    <p class="eyebrow">Certificate of Completion</p>
    <h1 class="name">{view.studentName}</h1>

    <p class="completed">completed</p>
    <p class="course">{view.curriculumTitle}</p>
    {view.programName && <p class="cohort">{view.programName}</p>}

    <dl class="meta">
      {rows.map((row) => (
        <div class="meta-row">
          <dt class="meta-label">{row.label}</dt>
          <dd class:list={["meta-value", row.mono && "meta-value-mono"]}>
            {row.value}
          </dd>
        </div>
      ))}
    </dl>
  </article>

  <CertificateActions view={view} tone="light" />
</main>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    padding: clamp(1.25rem, 5vw, 4rem) 1rem clamp(2.5rem, 6vw, 4rem);
    background:
      radial-gradient(
        56rem 32rem at 50% -14%,
        rgba(242, 141, 104, 0.14),
        transparent 70%
      ),
      #012A27;
  }

  .card {
    width: 100%;
    max-width: 38rem;
    background: linear-gradient(180deg, #0A4A44 0%, #063F3A 100%);
    border: 1px solid rgba(255, 248, 242, 0.13);
    border-radius: 1.5rem;
    padding: clamp(1.5rem, 5.5vw, 2.5rem);
    text-align: center;
    box-shadow: 0 30px 70px -40px rgb(0 0 0 / 0.9);
  }

  .card-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: clamp(1.25rem, 4vw, 1.75rem);
    border-bottom: 1px solid rgba(255, 248, 242, 0.12);
  }

  .wordmark,
  .status {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .wordmark {
    color: var(--color-ink-secondary);
    letter-spacing: 0.26em;
    text-align: left;
  }

  .status {
    flex-shrink: 0;
    color: var(--color-ink-muted);
  }

  .seal {
    width: 3rem;
    height: 3rem;
    margin: clamp(1.75rem, 5vw, 2.25rem) auto 0;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-dark);
  }

  .seal svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  .eyebrow {
    margin-top: 1.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .name {
    margin-top: 0.7rem;
    font-family: var(--font-body);
    font-size: clamp(1.75rem, 7vw, 2.5rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--color-ink-primary);
    text-wrap: balance;
  }

  .completed {
    margin-top: 1.4rem;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .course {
    margin-top: 0.5rem;
    font-size: clamp(1.125rem, 4.4vw, 1.375rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-primary);
    text-wrap: balance;
  }

  .cohort {
    margin-top: 0.3rem;
    font-size: 0.9375rem;
    color: var(--color-ink-secondary);
  }

  .meta {
    margin-top: clamp(1.75rem, 5vw, 2.25rem);
    border: 1px solid rgba(255, 248, 242, 0.12);
    border-radius: 0.9rem;
    overflow: hidden;
    text-align: left;
  }

  /*
   * Narrow phones cannot fit a label and a 25-character credential id on one
   * line without orphaning the tail of the id, so the pairs stack instead.
   */
  .meta-row {
    padding: 0.65rem 1rem;
  }

  @media (min-width: 26rem) {
    .meta-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.7rem 1rem;
    }
  }

  .meta-row + .meta-row {
    border-top: 1px solid rgba(255, 248, 242, 0.09);
  }

  .meta-label {
    flex-shrink: 0;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .meta-value {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-ink-secondary);
  }

  @media (min-width: 26rem) {
    .meta-value {
      margin-top: 0;
      text-align: right;
    }
  }

  .meta-value-mono {
    font-family: ui-monospace, "SFMono-Regular", "Menlo", monospace;
    font-size: 0.75rem;
    overflow-wrap: anywhere;
  }

  @media print {
    .page {
      min-height: 0;
      padding: 0;
      background: #fff;
    }

    .card {
      max-width: none;
      background: #fff;
      color: #10312e;
      border-color: rgba(1, 61, 57, 0.2);
      border-radius: 0;
      box-shadow: none;
    }

    .name {
      color: #10312e;
    }

    .cohort,
    .meta-value {
      color: #3d5a56;
    }

    .wordmark,
    .status,
    .eyebrow,
    .completed,
    .meta-label {
      color: #5b736f;
    }

    .card-top,
    .meta,
    .meta-row + .meta-row {
      border-color: rgba(1, 61, 57, 0.18);
    }

    .seal {
      box-shadow: none;
    }
  }
</style>
