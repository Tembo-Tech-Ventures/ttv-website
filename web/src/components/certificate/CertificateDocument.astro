---
import type { CertificateView } from "@/lib/certificate/view-model";
import CertificateActions from "./CertificateActions.astro";

interface Props {
  view: CertificateView;
}

const { view } = Astro.props;

const signatories = [
  { value: view.instructorName, role: "Instructor" },
  { value: view.issueDate, role: "Date of issue" },
].filter((entry): entry is { value: string; role: string } =>
  Boolean(entry.value)
);
---

<main class="page">
  <article class="paper">
    <header class="head">
      <p class="wordmark">Tembo Tech Ventures</p>
      <h1 class="title">Certificate of Completion</h1>
    </header>

    <section class="citation">
      <p class="label">This certifies that</p>
      <p class="name">{view.studentName}</p>
      <p class="label">has successfully completed</p>
      <p class="course">{view.curriculumTitle}</p>
      {view.programName && <p class="cohort">{view.programName}</p>}
    </section>

    <footer class="signatures">
      {signatories.map((entry) => (
        <div class="signature">
          <p class="signature-value">{entry.value}</p>
          <p class="signature-role">{entry.role}</p>
        </div>
      ))}
    </footer>

    <p class="verify">
      Certificate no. <span class="verify-id">{view.certificateId}</span>
      <span class="verify-sep" aria-hidden="true">·</span>
      <span class="verify-host">Verify at {view.verifyHost}</span>
    </p>
  </article>

  <CertificateActions view={view} tone="light" />
</main>

<style>
  .page {
    --paper: #fffcf6;
    --ink: #10312e;
    --ink-soft: #5b736f;
    --hairline: rgba(1, 61, 57, 0.14);

    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    padding: clamp(1rem, 4vw, 3.5rem) 1rem clamp(2.5rem, 6vw, 4rem);
    background: var(--color-dark);
  }

  .paper {
    width: 100%;
    max-width: 44rem;
    background: var(--paper);
    color: var(--ink);
    border-top: 6px solid var(--color-primary);
    box-shadow: 0 24px 60px -30px rgb(0 0 0 / 0.7);
    padding: clamp(2.25rem, 7vw, 4rem) clamp(1.5rem, 7vw, 4rem)
      clamp(1.75rem, 5vw, 2.75rem);
  }

  .head {
    text-align: center;
    padding-bottom: clamp(1.5rem, 4vw, 2rem);
    border-bottom: 1px solid var(--hairline);
  }

  .wordmark {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .title {
    margin-top: 0.9rem;
    font-family: var(--font-body);
    font-size: clamp(0.8125rem, 3vw, 1.125rem);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-teal);
  }

  .citation {
    text-align: center;
    padding: clamp(2rem, 6vw, 3rem) 0;
  }

  .label {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .name {
    margin: 0.85rem 0 1.75rem;
    font-size: clamp(1.875rem, 7.4vw, 2.875rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .course {
    margin-top: 0.85rem;
    font-size: clamp(1.125rem, 4.4vw, 1.5rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-teal);
    text-wrap: balance;
  }

  .cohort {
    margin-top: 0.4rem;
    font-size: clamp(0.875rem, 3vw, 1rem);
    color: var(--ink-soft);
  }

  .signatures {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    padding-top: clamp(1.75rem, 4vw, 2.25rem);
    border-top: 1px solid var(--hairline);
  }

  .signature {
    text-align: center;
  }

  .signature-value {
    font-size: clamp(0.9375rem, 3.2vw, 1.0625rem);
    font-weight: 600;
    text-wrap: balance;
  }

  .signature-role {
    margin-top: 0.35rem;
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .verify {
    margin-top: clamp(2rem, 5vw, 2.75rem);
    padding-top: clamp(1rem, 3vw, 1.25rem);
    border-top: 1px solid var(--hairline);
    text-align: center;
    font-size: 0.6875rem;
    line-height: 1.7;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
  }

  .verify-id {
    font-family: ui-monospace, "SFMono-Regular", "Menlo", monospace;
    overflow-wrap: anywhere;
  }

  .verify-sep {
    padding: 0 0.4rem;
    opacity: 0.5;
  }

  /* The separator only reads as one line on wide paper; stack it on phones. */
  @media (max-width: 32rem) {
    .verify-sep {
      display: none;
    }

    .verify-host {
      display: block;
    }
  }

  @media print {
    .page {
      min-height: 0;
      padding: 0;
      background: #fff;
    }

    .paper {
      max-width: none;
      box-shadow: none;
      padding: 2.5rem;
    }
  }
</style>
