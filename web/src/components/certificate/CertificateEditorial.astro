---
import type { CertificateView } from "@/lib/certificate/view-model";
import CertificateActions from "./CertificateActions.astro";

interface Props {
  view: CertificateView;
}

const { view } = Astro.props;

const specimen = [
  { label: "Instructor", value: view.instructorName },
  { label: "Issued", value: view.issueDate },
  { label: "Certificate no.", value: view.certificateId, mono: true },
  { label: "Verify at", value: view.verifyHost },
].filter((entry): entry is typeof entry & { value: string } =>
  Boolean(entry.value)
);
---

<main class="page">
  <article class="sheet">
    <p class="wordmark">Tembo Tech Ventures</p>

    <h1 class="display">Certificate</h1>
    <p class="display-sub">of Completion</p>

    <div class="citation">
      <div class="citation-text">
        <p class="label">Awarded to</p>
        <p class="name">{view.studentName}</p>

        <p class="label">for completing</p>
        <p class="course">{view.curriculumTitle}</p>
        {view.programName && <p class="cohort">{view.programName}</p>}
      </div>

      <div class="stamp" aria-hidden="true">
        <span class="stamp-word">Certified</span>
        <span class="stamp-rule"></span>
        <span class="stamp-year">{view.issueYear}</span>
      </div>
    </div>

    <dl class="specimen">
      {specimen.map((entry) => (
        <div class="specimen-item">
          <dt class="specimen-label">{entry.label}</dt>
          <dd class:list={["specimen-value", entry.mono && "specimen-value-mono"]}>
            {entry.value}
          </dd>
        </div>
      ))}
    </dl>

    <CertificateActions view={view} tone="dark" />
  </article>
</main>

<style>
  .page {
    --ink: #0d2f2b;
    --ink-soft: #5d7873;
    --hairline: rgba(13, 47, 43, 0.16);

    min-height: 100vh;
    background: #f9f1e7;
    color: var(--ink);
    padding: clamp(2.25rem, 7vw, 4.5rem) clamp(1.5rem, 6vw, 5rem)
      clamp(3rem, 8vw, 5rem);
  }

  .sheet {
    max-width: 54rem;
    margin: 0 auto;
  }

  .wordmark {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-teal);
  }

  .display {
    margin-top: clamp(1.25rem, 3.5vw, 2.25rem);
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 10.5vw, 5.5rem);
    line-height: 0.95;
    color: var(--color-primary);
    overflow-wrap: anywhere;
  }

  .display-sub {
    margin-top: clamp(0.6rem, 1.6vw, 0.9rem);
    font-size: clamp(0.8125rem, 3vw, 1.125rem);
    font-weight: 600;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .citation {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(1.25rem, 4vw, 3rem);
    align-items: start;
    margin-top: clamp(2.25rem, 6vw, 3.5rem);
    padding-top: clamp(2rem, 5vw, 3rem);
    border-top: 2px solid var(--ink);
  }

  .label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .name {
    margin: 0.75rem 0 clamp(1.75rem, 4.5vw, 2.5rem);
    font-size: clamp(1.875rem, 8vw, 3.25rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .course {
    margin-top: 0.75rem;
    font-size: clamp(1.25rem, 5vw, 1.875rem);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-teal);
  }

  .cohort {
    margin-top: 0.4rem;
    font-size: clamp(0.9375rem, 3vw, 1.0625rem);
    color: var(--ink-soft);
  }

  .stamp {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.4rem;
    width: clamp(4.5rem, 17vw, 7.5rem);
    aspect-ratio: 1;
    /* Sit level with the recipient's name rather than the label above it. */
    margin-top: clamp(1.25rem, 3vw, 2rem);
    border: 2px solid var(--color-teal);
    border-radius: 999px;
    color: var(--color-teal);
    transform: rotate(-7deg);
  }

  .stamp-word {
    font-size: clamp(0.5rem, 1.6vw, 0.625rem);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .stamp-rule {
    width: 1.75rem;
    height: 1px;
    background: currentColor;
    opacity: 0.5;
  }

  .stamp-year {
    font-size: clamp(0.875rem, 3vw, 1.25rem);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .specimen {
    display: grid;
    margin-top: clamp(2.25rem, 6vw, 3.5rem);
    border-top: 1px solid var(--hairline);
  }

  @media (min-width: 40rem) {
    .specimen {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.5rem;
      padding-top: 1rem;
    }
  }

  .specimen-item {
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--hairline);
  }

  @media (min-width: 40rem) {
    .specimen-item {
      padding: 0;
      border-bottom: none;
    }
  }

  .specimen-label {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .specimen-value {
    margin-top: 0.3rem;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .specimen-value-mono {
    font-family: ui-monospace, "SFMono-Regular", "Menlo", monospace;
    font-size: 0.75rem;
    color: var(--ink-soft);
    overflow-wrap: anywhere;
  }

  .sheet :global(.actions) {
    justify-content: flex-start;
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  @media print {
    .page {
      min-height: 0;
      padding: 2rem;
      background: #fff;
    }
  }
</style>
