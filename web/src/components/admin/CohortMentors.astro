---
import {
  Button,
  ButtonLink,
  ConfirmStep,
  DataCell,
  DataRow,
  DataTable,
  EmptyState,
  Notice,
  SelectField,
  confirmHref,
  linkClass,
  withoutConfirm,
} from "@/components/platform/ui";
import type { CohortMentorModel, CohortPerson } from "./cohort-mentors";

/**
 * The cohort's mentors on /admin/programs/[id] (U-2.4): who mentors this cohort, a way to add
 * someone, and a way to take it away, which asks first at ?confirm=. Plain form posts to the page,
 * like the staff list above it. Only shown while `channels` is on for the administrator: cohort
 * mentors exist for the channels.
 */
interface Props {
  model: CohortMentorModel;
  /** The cohort's page, which every form posts to. */
  page: string;
  url: URL;
  /** The confirm step the page is showing, if any (`remove-<roleId>`). */
  asking: string | null;
  /** Why the last mentor change was refused. */
  error?: string;
  /** The person chosen in a refused add, kept. */
  keptUserId?: string;
}

const { model, page, url, asking, error, keptUserId } = Astro.props;
const noCandidates = model.approvedCandidates.length === 0 && model.otherCandidates.length === 0 && model.rosterCandidates.length === 0;
const askingMentor = model.mentors.find((mentor) => asking === `remove-${mentor.roleId}`);
const option = (person: CohortPerson) => ({ value: person.id, label: `${person.name} (${person.email})` });
---

<section id="cohort-mentors" aria-labelledby="cohort-mentors-heading" class="flex max-w-3xl flex-col gap-5" data-cohort-mentors>
  <h2 id="cohort-mentors-heading" class="m-0 text-2xl">Mentors</h2>
  <p class="m-0 max-w-prose text-ink-secondary">
    Mentors you add join this cohort. They can watch its session recordings, read and post in its channels, and hide a message
    there for an admin to review. Removing someone ends this at once. Mentor access across the community still comes from an
    access request.
  </p>
  {error && <Notice tone="danger" focusOnLoad title="The mentors didn't change">{error}</Notice>}

  <DataTable caption="Cohort mentors" columns={[{ label: "Mentor" }, { label: "Access" }, { label: "Actions", hidden: true }]} isEmpty={model.mentors.length === 0}>
    {
      model.mentors.map((mentor) => (
        <DataRow data-cohort-mentor={mentor.userId} current={askingMentor?.roleId === mentor.roleId}>
          <DataCell label="Mentor" primary>
            <span class="flex min-w-0 flex-col">
              <a href={`/admin/users/${encodeURIComponent(mentor.userId)}`} class={linkClass()}>{mentor.name}</a>
              <span class="text-[0.8125rem] font-normal break-all text-ink-secondary">{mentor.email ?? "No email"}</span>
            </span>
          </DataCell>
          <DataCell label="Access">{mentor.approvedMentor ? "Community mentor" : "This cohort only"}</DataCell>
          <DataCell label="" align="end">
            <ButtonLink variant="danger" size="sm" href={confirmHref(url, `remove-${mentor.roleId}`)}>
              Remove<span class="sr-only"> {mentor.name} as a mentor</span>
            </ButtonLink>
          </DataCell>
        </DataRow>
      ))
    }
    <Fragment slot="empty">
      <EmptyState title="No mentors yet" headingLevel={3}>
        Add someone below. They join this cohort's channels and recordings at once.
      </EmptyState>
    </Fragment>
  </DataTable>

  {
    askingMentor && (
      <ConfirmStep
        title={`Remove ${askingMentor.name} as a mentor of this cohort?`}
        confirmLabel="Remove as a mentor"
        cancelHref={`${withoutConfirm(url)}#cohort-mentors`}
        action={page}
        fields={{ action: "remove-role", roleId: askingMentor.roleId, roleKind: "MENTOR" }}
      >
        They lose this cohort's channels and recordings at once. Their community mentor access, if they have it, stays.
      </ConfirmStep>
    )
  }

  {
    noCandidates ? (
      <p class="m-0 text-sm text-ink-secondary">Everyone who has signed in already mentors this cohort.</p>
    ) : (
      <form method="POST" action={page} class="grid gap-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end">
        <input type="hidden" name="action" value="add-role" />
        <input type="hidden" name="roleName" value="MENTOR" />
        <SelectField
          id="mentorUserId"
          name="userId"
          label="Person"
          placeholder="Choose a person"
          hint={model.rosterCandidates.length > 0 ? "People who applied to or study in this cohort are listed last. As a mentor they could hide their classmates' messages." : undefined}
          options={[
            { group: "Community mentors", options: model.approvedCandidates.map(option) },
            { group: "Everyone else", options: model.otherCandidates.map(option) },
            {
              group: "On this cohort's roster",
              options: model.rosterCandidates.map((person) => ({ ...option(person), label: `${person.name} (${person.email}) · on this cohort's roster` })),
            },
          ]}
          defaultValue={keptUserId}
          required
        />
        <div>
          <Button type="submit" size="lg">Add mentor</Button>
        </div>
      </form>
    )
  }
</section>
