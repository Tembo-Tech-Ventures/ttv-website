---
import Button from "@/components/common/Button.astro";
import Card from "@/components/common/Card.astro";
import type { CohortMentorModel } from "./cohort-mentors";

/**
 * The cohort's mentors on /admin/programs/[id] (U-2.4): who mentors this cohort, a way to add
 * someone, and a way to take it away. Plain form posts to the page, like the staff list above it.
 * Only shown while `channels` is on for the administrator: cohort mentors exist for the channels.
 */
interface Props {
  model: CohortMentorModel;
}

const { model } = Astro.props;
const noCandidates = model.approvedCandidates.length === 0 && model.otherCandidates.length === 0;
---

<Card>
  <section aria-labelledby="cohort-mentors-heading" data-cohort-mentors>
    <h3 id="cohort-mentors-heading" class="text-lg font-semibold text-white">Mentors</h3>
    <p class="mt-1 max-w-3xl text-sm text-ink-secondary">
      Mentors you add join this cohort. They can watch its session recordings, read and post in its channels, and hide a
      message there for an admin to review. Removing someone ends this at once. Mentor access across the community
      still comes from an access request.
    </p>

    {model.mentors.length > 0 ? (
      <ul class="mt-4 divide-y divide-teal/10 rounded-lg border border-teal/20" aria-label="Cohort mentors">
        {model.mentors.map((mentor) => (
          <li class="flex flex-wrap items-center justify-between gap-3 px-4 py-3" data-cohort-mentor={mentor.userId}>
            <div class="min-w-0">
              <a href={`/admin/users/${encodeURIComponent(mentor.userId)}`} class="font-medium text-white hover:text-primary hover:underline">
                {mentor.name}
              </a>
              <p class="truncate text-xs text-ink-muted">
                {mentor.email ?? "No email available"}
                {mentor.approvedMentor ? " · Community mentor" : " · Mentors this cohort only"}
              </p>
            </div>
            <form method="POST" onsubmit={`return confirm(${JSON.stringify(`Remove ${mentor.name} as a mentor of this cohort?`)})`}>
              <input type="hidden" name="action" value="remove-role" />
              <input type="hidden" name="roleId" value={mentor.roleId} />
              <input type="hidden" name="roleKind" value="MENTOR" />
              <Button type="submit" variant="danger" class="min-h-11" aria-label={`Remove ${mentor.name} as a mentor`}>
                Remove
              </Button>
            </form>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-4 text-ink-muted" data-cohort-mentors-empty>No mentors yet.</p>
    )}

    {noCandidates ? (
      <p class="mt-4 text-sm text-ink-muted">Everyone who has signed in already mentors this cohort.</p>
    ) : (
      <form method="POST" class="mt-4 flex flex-wrap items-end gap-3">
        <input type="hidden" name="action" value="add-role" />
        <input type="hidden" name="roleName" value="MENTOR" />
        <div class="flex w-full min-w-0 flex-col gap-1.5 sm:w-auto">
          <label for="mentorUserId" class="text-sm font-medium text-white/90">Person</label>
          <select id="mentorUserId" name="userId" required class="form-control min-h-11 w-full min-w-0">
            <option value="">Select a person…</option>
            {model.approvedCandidates.length > 0 && (
              <optgroup label="Community mentors">
                {model.approvedCandidates.map((person) => <option value={person.id}>{person.name} ({person.email})</option>)}
              </optgroup>
            )}
            {model.otherCandidates.length > 0 && (
              <optgroup label="Everyone else">
                {model.otherCandidates.map((person) => <option value={person.id}>{person.name} ({person.email})</option>)}
              </optgroup>
            )}
          </select>
        </div>
        <Button type="submit" class="min-h-11">Add mentor</Button>
      </form>
    )}
  </section>
</Card>
