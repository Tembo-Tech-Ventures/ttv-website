---
import { PiClockCounterClockwise, PiGithubLogo, PiGlobeSimple, PiLinkSimple } from "react-icons/pi";
import { Avatar, Button, FOCUS_RING, RoleBadge, TextAreaField } from "@/components/platform/ui";
import { formatMomentDate } from "@/lib/display-date";
import {
  ACCESS_ROLE_LABELS, addressName, displayLink, githubProfileUrl,
} from "@/lib/admin/access-requests";
import type { AdminAccessRequest } from "@/lib/platform/contracts";

/**
 * One access request in the admin queue (onboarding SPEC S6). Everything the person wrote is
 * untrusted and rendered as text: Astro escapes each expression, and nothing here uses set:html.
 * A pending request carries its decision form; a decided one says what was decided, and by whom.
 * A refused decision puts focus back on this card's message, beside the reason.
 */
interface Props {
  request: AdminAccessRequest;
  /** Why this request's last decision was refused, shown beside its form. */
  error?: string;
  /** The message as typed when the decision was refused, so it is not lost. */
  draftMessage?: string;
}

const { request, error, draftMessage = "" } = Astro.props;
const { requester } = request;
const first = addressName(requester.name);
const github = githubProfileUrl(request.githubLogin);
const pending = request.status === "PENDING";
const messageId = `access-request-${request.id}-message`;
const roleLabel = ACCESS_ROLE_LABELS[request.role];
// Every card has the same two buttons, so each name says whose request it decides (QAO-06).
// A deleted or unnamed account reads as Admin Home's attention list says it (lib/admin/attention.ts).
const decides = (verb: string) => `${verb} ${roleLabel.toLowerCase()} access for ${requester.name.trim() || "a member"}`;
const date = (at: number) => formatMomentDate(new Date(at));
const HISTORY_SHOWN = 3;
const earlier = request.earlierRequests.slice(0, HISTORY_SHOWN);
const earlierHidden = request.earlierRequests.length - earlier.length;
const earlierStatus = { APPROVED: "approved", DECLINED: "declined", WITHDRAWN: "withdrawn" } as const;
const meta = "inline-flex min-w-0 items-center gap-1.5";
// A flex item, so `truncate` holds; on a touch screen its padding makes the 44px target.
const metaLink = ["truncate rounded-sm hover:text-ink-primary hover:underline pointer-coarse:py-3", FOCUS_RING];
const icon = "size-4 shrink-0 text-ink-muted";
---

<li
  class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-4 border-b border-hairline py-6 lg:grid-cols-[auto_minmax(0,1fr)_minmax(16rem,22rem)] lg:gap-x-6"
  data-access-request={request.id}
  data-status={request.status}
>
  <Avatar id={requester.id} name={requester.name} src={requester.avatarUrl ?? undefined} size="lg" decorative />

  <div class="min-w-0 space-y-3">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
      <h2 class="font-body text-base font-bold text-ink-primary">
        <a href={`/admin/users/${encodeURIComponent(requester.id)}`} class:list={["rounded-sm hover:underline", FOCUS_RING]}>
          {requester.name}
        </a>
      </h2>
      <RoleBadge badge={{ kind: request.role, label: roleLabel }} />
      <span class="w-full text-sm text-ink-muted sm:w-auto">Requested {date(request.createdAt)}</span>
    </div>

    <div class="space-y-1 border-l-2 border-hairline pl-4 text-[0.9375rem] leading-relaxed">
      {request.organisation && (
        <p class="text-ink-primary">
          <strong class="font-bold">{request.organisation}</strong>
          {request.organisationRole && <span class="text-ink-secondary"> · {request.organisationRole}</span>}
        </p>
      )}
      <p class="whitespace-pre-line break-words text-ink-secondary" data-access-request-note>{request.note}</p>
    </div>

    <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-ink-secondary" aria-label={`About ${first}'s request`}>
      {request.githubLogin && (
        <li class={meta}>
          <PiGithubLogo className={icon} aria-hidden="true" />
          <span class="sr-only">GitHub:</span>
          {github ? (
            <a href={github} rel="noopener noreferrer nofollow" target="_blank" class:list={metaLink}>
              {request.githubLogin}<span class="sr-only"> (opens in a new tab)</span>
            </a>
          ) : (
            <span class="truncate">{request.githubLogin}</span>
          )}
        </li>
      )}
      {request.link ? (
        <li class={meta}>
          {request.role === "INSTITUTION"
            ? <PiGlobeSimple className={icon} aria-hidden="true" />
            : <PiLinkSimple className={icon} aria-hidden="true" />}
          <span class="sr-only">{request.role === "INSTITUTION" ? "Organisation website:" : "Their work:"}</span>
          <a href={request.link} rel="noopener noreferrer nofollow" target="_blank" class:list={metaLink}>
            {displayLink(request.link)}<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
      ) : (
        <li class={meta}>
          {request.role === "INSTITUTION"
            ? <PiGlobeSimple className={icon} aria-hidden="true" />
            : <PiLinkSimple className={icon} aria-hidden="true" />}
          {request.role === "INSTITUTION" ? "No website given" : "No link given"}
        </li>
      )}
      {earlier.map((item) => (
        <li class={meta}>
          <PiClockCounterClockwise className={icon} aria-hidden="true" />
          Earlier {item.role === request.role ? "" : `${ACCESS_ROLE_LABELS[item.role].toLowerCase()} `}request {earlierStatus[item.status]} {date(item.decidedAt ?? item.createdAt)}
        </li>
      ))}
      {earlierHidden > 0 && <li class={meta}>and {earlierHidden} more earlier</li>}
    </ul>
  </div>

  {pending ? (
    <form method="POST" class="col-span-2 space-y-3 lg:col-span-1" data-access-request-form>
      <input type="hidden" name="id" value={request.id} />
      <TextAreaField
        id={messageId}
        name="message"
        label={`Message to ${first}`}
        optional
        hint="Sent only if you decline."
        error={error}
        rows={2}
        maxLength={600}
        defaultValue={draftMessage}
        autoFocus={Boolean(error)}
      />
      <div class="grid grid-cols-2 gap-3">
        {/* Every card has its own decision, so each is quiet: no wall of peach down the queue. */}
        <Button type="submit" name="decision" value="approve" size="lg" aria-label={decides("Approve")} className="w-full">
          Approve
        </Button>
        <Button type="submit" name="decision" value="decline" size="lg" aria-label={decides("Decline")} className="w-full">
          Decline
        </Button>
      </div>
    </form>
  ) : (
    <div class="col-span-2 space-y-2 text-sm lg:col-span-1" data-access-request-decision>
      <p class="text-ink-primary">
        <span class="font-semibold">{request.status === "APPROVED" ? "Approved" : "Declined"}</span>
        <span class="text-ink-secondary">
          {request.decidedAt !== null && <> {date(request.decidedAt)}</>}
          {request.decidedBy && <> by {request.decidedBy.name}</>}
        </span>
      </p>
      {request.decisionMessage ? (
        <div>
          <p class="text-xs font-semibold text-ink-muted">Message to {first}</p>
          <p class="whitespace-pre-line break-words text-ink-secondary">{request.decisionMessage}</p>
        </div>
      ) : (
        request.status === "DECLINED" && <p class="text-ink-muted">No message.</p>
      )}
    </div>
  )}
</li>
