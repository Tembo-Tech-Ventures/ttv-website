---
import { PiInfo } from "react-icons/pi";
import PageTitle from "@/components/platform/spaces/PageTitle.astro";
import {
  Avatar, Button, Card, Chip, EmptyState, FOCUS_RING, Notice, PillNav, TextAreaField, type PillNavItem,
} from "@/components/platform/ui";
import { FORMAT_LABELS } from "@/components/platform/mentors/mentor-display";
import { firstName, formatModerationTime } from "./case-model";
import { REASON_MAX } from "./decision-form";
import { caseCause, decidedStatus, requestNoteChoices, type RequestNotesViewProps } from "./request-notes";

/**
 * "Request notes" on /admin/moderation (U-4.1 on B-4.1's checks): one card per mentor request whose
 * note Tembo's check held or its mentor reported, with the note as written, what raised it, and keep
 * or remove with a reason for the record. Plain form posts. Everything members wrote is rendered as
 * text: Astro escapes each expression, and nothing here uses set:html.
 */
type Props = RequestNotesViewProps & {
  /** The message queue's tabs, so the whole page reads as one set of lists. */
  queueTabs: PillNavItem[];
  /** The admin reading: one who is party to a request can't decide it (B-4.1), so they get no form for it. */
  viewerId: string;
};

const { state, items, formAction, tabHrefs, nextHref, paged, notice, failure, rowError, queueTabs, viewerId } = Astro.props;
const PAGER_LINK = `inline-flex min-h-11 items-center rounded-sm font-semibold text-peach-ink hover:underline ${FOCUS_RING}`;
const LISTS = [["OPEN", "Waiting for a decision"], ["DECIDED", "Decided requests"]] as const;
---

<div class="mx-auto max-w-6xl space-y-8 pt-4 lg:px-6 lg:pt-6" data-request-notes data-state={state}>
  <header class="space-y-4">
    <PageTitle spaces>Moderation</PageTitle>
    <p class="max-w-3xl text-base leading-relaxed text-ink-secondary sm:text-lg">
      Requests for a mentor's time whose note Tembo's check held, or that a mentor reported. Keeping one sends it
      to its mentor as it was written, and takes one of their spots this month; removing it closes it, and the
      person who asked can ask again.
    </p>
  </header>

  {notice && <Notice tone="success" focusOnLoad id="request-notes-notice">{notice}</Notice>}
  {failure && <Notice tone="danger" focusOnLoad id="request-notes-failure">{failure}</Notice>}

  <div class="space-y-3">
    <PillNav label="Moderation lists" countLabel="waiting" items={queueTabs} />
    <PillNav
      label="Request notes"
      items={LISTS.map(([value, label]) => ({ label, href: tabHrefs[value], current: value === state }))}
    />
  </div>

  {items.length === 0 ? (
    state === "OPEN" ? (
      <EmptyState title="Nothing needs a decision" headingLevel={2}>
        Requests whose note Tembo's check holds, or that a mentor reports, appear here.
      </EmptyState>
    ) : (
      <EmptyState title="Nothing decided yet" headingLevel={2}>Decisions appear here.</EmptyState>
    )
  ) : (
    <ul class="space-y-4" aria-label={state === "OPEN" ? "Request notes waiting for a decision" : "Decided request notes"} data-request-notes-list={state}>
      {items.map((item) => {
        const { request, decision } = item;
        const asker = request.requester;
        const mentor = request.mentor;
        const headingId = `request-note-${item.id}`;
        const error = rowError?.id === item.id ? rowError.message : undefined;
        const ids = { reason: `request-note-${item.id}-reason`, choices: `request-note-${item.id}-choices` };
        const choices = requestNoteChoices(item);
        // Every card has the same buttons, so each name says whose request it decides.
        const whose = `${asker.name}'s request to ${mentor.name}`;
        // Decided: where the request stands now, not what raised it (QA4-21). Open: what raised it.
        const status = item.state === "DECIDED" ? decidedStatus(item) : null;
        return (
          <Card as="li" aria-labelledby={headingId} data-request-note={item.id} data-state={item.state}>
            <div class="flex flex-wrap items-start gap-x-4 gap-y-2">
              <Avatar id={asker.id} name={asker.name} src={asker.avatarUrl ?? undefined} size="md" decorative />
              <div class="min-w-0 flex-1">
                <h2 id={headingId} class="font-body text-lg leading-snug font-bold break-words text-ink-primary">
                  {asker.name} asked {mentor.name}
                </h2>
                <p class="text-sm text-ink-secondary">
                  {FORMAT_LABELS[request.format]} · opened {formatModerationTime(item.openedAt)}
                </p>
              </div>
              <div class="order-last basis-full sm:order-none sm:basis-auto">
                {status ? (
                  <Chip tone={decision?.action === "remove" ? "danger" : "success"}><span data-request-note-status>{status}</span></Chip>
                ) : (
                  <Chip tone={item.report ? "peach" : "neutral"}>{item.report ? "Reported by the mentor" : "Held by Tembo's check"}</Chip>
                )}
              </div>
            </div>

            <p class="mt-4 text-sm text-ink-secondary" data-request-note-cause>{caseCause(item)}</p>
            {item.report && (
              <blockquote class="mt-2 border-l-2 border-hairline pl-3 text-sm leading-relaxed break-words text-ink-secondary">
                <span class="sr-only">{firstName(mentor.name)} wrote: </span>{item.report.reason}
              </blockquote>
            )}

            <div class="mt-4 rounded-xl border border-hairline px-4 py-3">
              <p class="text-xs font-semibold text-ink-muted">The note, as written</p>
              <p class="mt-1 text-[0.9375rem] leading-relaxed break-words whitespace-pre-line text-ink-primary">{request.note}</p>
              {request.project && (
                <p class="mt-2 text-sm text-ink-secondary">
                  {request.project.type === "project" ? `Attached: ${request.project.title}` : "Attached work that is no longer shared."}
                </p>
              )}
            </div>

            {decision ? (
              <p class="mt-4 text-sm text-ink-secondary" data-request-note-decision={decision.action}>
                <span class="font-semibold text-ink-primary">{decision.action === "keep" ? "Kept" : "Removed"}</span>
                {` by ${decision.by?.name ?? "a former admin"}, ${formatModerationTime(decision.decidedAt)}: `}
                <span class="break-words">{decision.reason}</span>
              </p>
            ) : viewerId === asker.id || viewerId === mentor.id ? (
              <p class="mt-5 text-sm text-ink-secondary" data-request-note-own>Another admin needs to check a request you're part of.</p>
            ) : (
              <form method="POST" action={formAction} class="mt-5 space-y-3" data-request-note-form>
                <input type="hidden" name="requestId" value={item.id} />
                <TextAreaField
                  id={ids.reason}
                  name="reason"
                  label="Reason"
                  hint="Kept with your decision. Only admins see it."
                  error={error}
                  rows={2}
                  required
                  maxLength={REASON_MAX}
                  defaultValue={error ? rowError?.draft : ""}
                  autoFocus={Boolean(error)}
                />
                <div id={ids.choices} class="space-y-1 text-sm text-ink-secondary" data-request-note-choices>
                  <p data-request-note-keep>{choices.keep}</p>
                  {choices.remove && <p data-request-note-remove>{choices.remove}</p>}
                </div>
                <div class="grid gap-3 sm:grid-cols-2">
                  <Button
                    type="submit" name="action" value="keep" size="lg" className="w-full"
                    aria-label={`${choices.keepLabel}, ${whose}`} aria-describedby={ids.choices}
                  >
                    {choices.keepLabel}
                  </Button>
                  <Button
                    type="submit" name="action" value="remove" variant="danger" size="lg" className="w-full"
                    aria-label={`${choices.removeLabel}, ${whose}`} aria-describedby={ids.choices}
                  >
                    {choices.removeLabel}
                  </Button>
                </div>
              </form>
            )}
          </Card>
        );
      })}
    </ul>
  )}

  {(nextHref || paged) && (
    <nav aria-label="More request notes" class="flex flex-wrap gap-4 text-sm">
      {paged && <a href={tabHrefs[state]} class={PAGER_LINK}>Back to the start</a>}
      {nextHref && <a href={nextHref} class={PAGER_LINK}>{state === "OPEN" ? "More request notes" : "Older request notes"}</a>}
    </nav>
  )}

  <p class="flex gap-2 text-sm text-ink-secondary">
    <PiInfo className="mt-0.5 size-4 shrink-0 text-ink-muted" aria-hidden="true" />
    The person who asked sees only that their request is being checked, then whether it was sent. They never see who raised it, or why.
  </p>
</div>
