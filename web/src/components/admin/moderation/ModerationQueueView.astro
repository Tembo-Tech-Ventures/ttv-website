---
import { PiInfo } from "react-icons/pi";
import PageTitle from "@/components/platform/spaces/PageTitle.astro";
import { ButtonLink, EmptyState, FOCUS_RING, Notice, PillNav } from "@/components/platform/ui";
import ModerationCase from "./ModerationCase.astro";
import { REQUEST_NOTES_LABEL } from "./request-notes";
import { QUEUE_TABS } from "./case-model";
import type { QueueViewProps } from "./page-flow";

/**
 * The admin moderation queue (U-2.4, screens/08), as /admin/moderation and its DEV harness render
 * it. Plain links and form posts, so it works without JavaScript. enhance.ts posts the same forms
 * and swaps this whole region for the one the server renders back, so a decision reads the same
 * either way, and a refused one never looks recorded.
 */
type Props = QueueViewProps & {
  /** The "Request notes" tab, while mentor requests are on for this admin. */
  requestNotesHref?: string;
  /** Open checks on request notes this admin may decide, shown on that tab. */
  requestNotesCount?: number;
};

const { state, items, pendingCount, formAction, tabHrefs, nextHref, paged, notice, noticeSubject, failure, rowError, requestNotesHref, requestNotesCount } = Astro.props;
const PAGER_LINK = `inline-flex min-h-11 items-center rounded-sm font-semibold text-peach-ink hover:underline ${FOCUS_RING}`;
---

<div class="mx-auto max-w-6xl space-y-8 pt-4 lg:px-6 lg:pt-6" data-moderation-root data-state={state} data-pending-count={pendingCount}>
  <header class="space-y-4">
    <PageTitle spaces>Moderation</PageTitle>
    <p class="max-w-3xl text-base leading-relaxed text-ink-secondary sm:text-lg">
      Tembo hides only what is clearly abusive. Contact details are hidden from other members until you decide;
      everything else stays visible.
    </p>
  </header>

  {notice && (
    <Notice tone="success" focusOnLoad id="moderation-notice" title={noticeSubject}>
      {notice}
      <Fragment slot="actions">
        <ButtonLink href={tabHrefs.DECIDED} variant="ghost" size="sm">See decided cases</ButtonLink>
      </Fragment>
    </Notice>
  )}
  {failure && <Notice tone="danger" focusOnLoad id="moderation-failure">{failure}</Notice>}

  <PillNav
    label="Moderation lists"
    countLabel="waiting"
    items={[
      ...QUEUE_TABS.map((tab) => ({
        label: tab.label, href: tabHrefs[tab.state], current: tab.state === state,
        ...(tab.state === "PENDING" ? { count: pendingCount } : {}),
      })),
      ...(requestNotesHref ? [{ label: REQUEST_NOTES_LABEL, href: requestNotesHref, count: requestNotesCount }] : []),
    ]}
  />

  {items.length === 0 ? (
    state === "PENDING" ? (
      <EmptyState title="Nothing needs a decision" headingLevel={2}>
        Messages Tembo flags, members report or a mentor hides appear here.
      </EmptyState>
    ) : (
      <EmptyState title="Nothing decided yet" headingLevel={2}>Decisions appear here, newest first.</EmptyState>
    )
  ) : (
    <ul class="-mt-2 space-y-4" aria-label={state === "PENDING" ? "Cases that need a decision" : "Decided cases"} data-moderation-list={state}>
      {items.map((item) => (
        <ModerationCase
          item={item}
          action={formAction}
          error={rowError?.id === item.id ? rowError.message : undefined}
          draftReason={rowError?.id === item.id ? rowError.draft : undefined}
        />
      ))}
    </ul>
  )}

  {(nextHref || paged) && (
    <nav aria-label="More cases" class="flex flex-wrap gap-4 text-sm">
      {paged && <a href={tabHrefs[state]} class={PAGER_LINK}>Back to the start</a>}
      {nextHref && <a href={nextHref} class={PAGER_LINK}>Older cases</a>}
    </nav>
  )}

  <p class="flex gap-2 text-sm text-ink-secondary">
    <PiInfo className="mt-0.5 size-4 shrink-0 text-ink-muted" aria-hidden="true" />
    Reports are counted, never named: no one here or in the channel sees who reported a message.
  </p>
</div>

<script>
  import { enhanceModerationQueue } from "./enhance";

  enhanceModerationQueue(document);
</script>
