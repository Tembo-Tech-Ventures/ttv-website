---
import { Button, FOCUS_RING, cx } from "@/components/platform/ui";
import { CONTROL, FIELD_ERROR, HINT, LABEL } from "@/components/platform/ui/recipes";
import { REASON_MAX } from "./decision-form";
import type { DecisionOption } from "./case-model";

/**
 * The decision form for one case: a required reason, then one button per decision. A plain form
 * post; enhance.ts posts the same form without a page load. The error paragraph is always there
 * (empty and hidden until needed), so the enhancement can say why nothing changed in place. That
 * live paragraph is why the field is built from the kit's field recipes rather than TextAreaField,
 * which draws its error only when it has one.
 */
interface Props {
  caseId: string;
  action: string;
  options: DecisionOption[];
  /** Each button's accessible name, which says whose message it decides. */
  names: string[];
  error?: string;
  draftReason?: string;
  class?: string;
}

const { caseId, action, options, names, error, draftReason = "", class: className } = Astro.props;
// Only a hide shows its reason to the author (with the message's other reasons); every reason stays here.
const hint = options.some((option) => option.action === "hide")
  ? "Kept with your decision. If you hide the message, its author sees this reason."
  : "Kept with your decision. Only admins see it.";
const ids = { reason: `moderation-${caseId}-reason`, hint: `moderation-${caseId}-hint`, error: `moderation-${caseId}-error` };
// Hiding takes a message away from its channel, so it is the danger action; keeping or restoring is quiet.
const variant = (option: DecisionOption) => (option.action === "hide" ? "danger" : "quiet");
---

<form method="POST" action={action} class:list={["space-y-3", className]} data-moderation-form>
  <input type="hidden" name="messageId" value={caseId} />
  <div class="flex min-w-0 flex-col gap-1.5">
    <label for={ids.reason} class={LABEL}>Reason</label>
    <p id={ids.hint} class={cx(HINT, "m-0")}>{hint}</p>
    <textarea
      id={ids.reason}
      name="reason"
      rows="2"
      required
      maxlength={REASON_MAX}
      aria-describedby={error ? `${ids.hint} ${ids.error}` : ids.hint}
      aria-invalid={error ? "true" : undefined}
      class={cx(CONTROL, "min-h-24 resize-y py-2.5 leading-relaxed")}
    >{draftReason}</textarea>
    <p
      id={ids.error}
      role="alert"
      tabindex="-1"
      autofocus={Boolean(error)}
      class:list={["m-0 rounded-sm", FIELD_ERROR, FOCUS_RING, !error && "hidden"]}
      data-moderation-error
    >{error}</p>
  </div>
  <div class:list={["grid gap-3", options.length > 1 && "grid-cols-2"]}>
    {options.map((option, index) => (
      <Button type="submit" name="action" value={option.action} variant={variant(option)} size="lg" aria-label={names[index]} className="w-full">
        {option.label}
      </Button>
    ))}
  </div>
</form>
