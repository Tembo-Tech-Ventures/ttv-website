---
import { PRINCIPLES } from "@/lib/homepage/content";
import Words from "./Words.astro";

/**
 * #principles: five words in outlined Mattone, each sized to the full content
 * width from its measured advance (em at -0.02em tracking), so the server
 * render already fits and nothing crops before script runs. With motion
 * allowed, each word fills with peach as it crosses the middle of the screen.
 */
const ADVANCE_EM: Record<string, number> = {
  COMMUNITY: 8.77,
  PHILOSOPHY: 9.29,
  EQUITY: 5.32,
  CONTINUITY: 8.81,
  HONESTY: 6.92,
};

const values = PRINCIPLES.values.map((value) => ({
  ...value,
  // Unknown words fall back to a generous per-letter estimate, so they shrink rather than crop.
  advance: ADVANCE_EM[value.word] ?? value.word.length * 1.05,
}));
---

<section id="principles" class="ha-section principles">
  <div class="ha-wrap">
    <h2 class="ha-h2 title" data-ha-reveal="words"><Words text={PRINCIPLES.title} /></h2>

    <dl class="values">
      {
        values.map((value) => (
          <div class="value" data-ha-value>
            <dt class="word-box">
              <span class="word" style={`--advance: ${value.advance}`} data-ha-word>
                {value.word}
              </span>
            </dt>
            <dd class="commitment" data-ha-commitment>
              {value.commitment}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .title {
    max-width: 14ch;
  }

  .values {
    margin: clamp(3rem, 6vw, 5rem) 0 0;
  }

  .value {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--ha-gap);
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
    border-top: 1px solid var(--ha-rule);
  }

  .value:last-child {
    border-bottom: 1px solid var(--ha-rule);
  }

  .word-box {
    grid-column: 1 / -1;
    min-width: 0;
    container-type: inline-size;
  }

  /* Size from the measured advance, with 2% to spare for the stroke. */
  .word {
    --ha-fill: 0%;
    display: block;
    width: max-content;
    font-family: var(--font-heading);
    font-size: calc(98cqw / var(--advance));
    line-height: 1.08;
    letter-spacing: var(--tracking-display);
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: max(1px, 0.011em) var(--ha-peach);
    background: linear-gradient(var(--ha-peach), var(--ha-peach)) no-repeat 0 0 / var(--ha-fill) 100%;
    -webkit-background-clip: text;
    background-clip: text;
  }

  .commitment {
    grid-column: 1 / -1;
    margin: clamp(0.75rem, 1.5vw, 1.25rem) 0 0;
    font-family: var(--font-body);
    font-size: clamp(1.0625rem, 0.98rem + 0.4vw, 1.375rem);
    line-height: 1.5;
    color: var(--ha-ink);
    text-wrap: pretty;
  }

  @media (min-width: 768px) {
    .commitment {
      grid-column: 7 / -1;
    }
  }
</style>
