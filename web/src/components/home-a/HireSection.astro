---
import type { HomepageBuilder } from "@/lib/homepage/builders";
import { HIRE } from "@/lib/homepage/content";
import Pill from "./Pill.astro";
import TextLink from "./TextLink.astro";
import Words from "./Words.astro";

/**
 * #hire: the one inverted band on the page, set as a sheet that slides up
 * over the end of the community section. A slow outlined marquee of the
 * builders' own skills runs beneath the copy; it is decorative and hidden from
 * assistive technology, and omitted when no builder has listed a skill.
 */
interface Props {
  builders: HomepageBuilder[];
}

const { builders } = Astro.props;
const skills = [
  ...new Set(
    builders.flatMap((builder) => [...builder.skills, builder.project?.language ?? ""]).filter(Boolean),
  ),
].slice(0, 16);
---

<section id="hire" class="hire" data-ha-hire>
  <div class="band" data-ha-band>
    <div class="ha-wrap">
      <div class="content ha-grid">
        <h2 class="ha-h2 title"><Words text={HIRE.title} /></h2>
        <div class="aside" data-ha-reveal="rise">
          <p class="ha-lead lead">{HIRE.summary}</p>
          <div class="actions">
            <Pill href={HIRE.primary.href} label={HIRE.primary.label} tone="dark" />
            <TextLink href={HIRE.secondary.href} label={HIRE.secondary.label} class="secondary" />
          </div>
        </div>
      </div>
    </div>

    {
      skills.length > 0 && (
        <div class="marquee" aria-hidden="true">
          <div class="marquee-track" data-ha-loop>
            {[0, 1].map(() => (
              <span class="marquee-run">
                {skills.map((skill) => (
                  <span class="marquee-item">{skill}</span>
                ))}
              </span>
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  /* Overlaps the community section's bottom padding (never its content). */
  .hire {
    position: relative;
    z-index: 2;
    margin-top: calc(var(--ha-section) * -0.5);
    padding-block: 0 clamp(1rem, 3vw, 2.5rem);
  }

  /* A soft shadow cast up onto the section the sheet slides over. */
  .hire::before {
    content: "";
    position: absolute;
    top: -3.5rem;
    left: 0;
    right: 0;
    height: 3.5rem;
    background: linear-gradient(to top, rgba(0, 20, 18, 0.45), transparent);
    pointer-events: none;
  }

  .band {
    position: relative;
    overflow-x: clip;
    padding-block: clamp(4.5rem, 9vw, 8rem) clamp(2.5rem, 5vw, 4.5rem);
    background: var(--ha-peach);
    color: var(--ha-dark);
  }

  .content {
    row-gap: 1.75rem;
    align-items: end;
  }

  .title,
  .aside {
    grid-column: 1 / -1;
  }

  .title {
    color: var(--ha-dark);
  }

  .lead {
    color: var(--ha-dark);
    max-width: 34rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2rem;
  }

  .actions :global(.secondary) {
    color: var(--ha-dark);
  }

  .band :global(a:focus-visible) {
    outline-color: var(--ha-dark);
  }

  @media (min-width: 768px) {
    .title {
      grid-column: 1 / span 6;
      align-self: start;
    }

    .aside {
      grid-column: 7 / -1;
    }
  }

  .marquee {
    margin-top: clamp(3.5rem, 7vw, 6rem);
    padding-top: 1.5rem;
    border-top: 1px solid rgba(1, 61, 57, 0.25);
    pointer-events: none;
    user-select: none;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: ha-marquee 70s linear infinite;
  }

  .marquee-run {
    display: flex;
    flex: none;
  }

  .marquee-item {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 1.5rem + 4.5vw, 6rem);
    line-height: 1.1;
    letter-spacing: var(--tracking-display);
    color: transparent;
    -webkit-text-stroke: max(1px, 0.012em) rgba(1, 61, 57, 0.55);
  }

  .marquee-item::after {
    content: "";
    width: 0.18em;
    height: 0.18em;
    margin-inline: 0.45em;
    border-radius: 50%;
    background: rgba(1, 61, 57, 0.55);
  }

  @keyframes ha-marquee {
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
