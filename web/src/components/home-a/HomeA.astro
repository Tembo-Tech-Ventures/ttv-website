---
import type { HomepageBuilder } from "@/lib/homepage/builders";
import BuildersSection from "./BuildersSection.astro";
import CohortSection from "./CohortSection.astro";
import CommunitySection from "./CommunitySection.astro";
import HireSection from "./HireSection.astro";
import PrinciplesSection from "./PrinciplesSection.astro";
// oxlint-disable-next-line import/no-unassigned-import -- Candidate A's prefixed primitives.
import "./home-a.css";

/**
 * Candidate A — "Kinetic editorial: type is the image".
 *
 * The server render is the finished page. The hero intro is pure CSS, so it
 * never waits on the network; motion/index.ts adds scroll-driven motion on top,
 * and only when the visitor has not asked for reduced motion.
 */
interface Props {
  builders: HomepageBuilder[];
  isAuthenticated: boolean;
}

const { builders, isAuthenticated } = Astro.props;
---

<div class="ha-root" data-ha-root>
  <CohortSection />
  <BuildersSection builders={builders} />
  <CommunitySection isAuthenticated={isAuthenticated} />
  <HireSection builders={builders} />
  <PrinciplesSection />
</div>

<script>
  import { initHomeA } from "./motion/index";

  initHomeA();
</script>
