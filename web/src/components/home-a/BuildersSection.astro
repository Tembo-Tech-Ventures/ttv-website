---
import type { HomepageBuilder } from "@/lib/homepage/builders";
import { BUILDERS } from "@/lib/homepage/content";
import Arrow from "./Arrow.astro";
import BuilderCard from "./BuilderCard.astro";
import TextLink from "./TextLink.astro";
import Words from "./Words.astro";

/**
 * #builders: a horizontal gallery. Without script it is a native swipe track
 * with scroll snap at every width. On large screens with motion allowed,
 * motion/builders.ts pins the stage (track and meter, not the heading) and
 * lets vertical scroll drive the track, while the heading slides away.
 */
interface Props {
  builders: HomepageBuilder[];
}

const { builders } = Astro.props;
const total = String(builders.length).padStart(2, "0");
// With one to three builders the row sits on the 12-column grid, and the
// closing tile takes whatever columns the cards leave.
const few = builders.length > 0 && builders.length <= 3;
const span = { 1: 6, 2: 4, 3: 3 }[builders.length] ?? 4;
const endSpan = 12 - span * builders.length;
---

<section
  id="builders"
  class:list={["builders", few && "is-few"]}
  data-ha-builders
  style={few ? `--span: ${span}; --end-span: ${endSpan}` : undefined}
>
  <div class="frame" data-ha-frame>
    <div class="ha-wrap">
      <div class="head ha-grid" data-ha-head>
        <h2 class="ha-h2 title" data-ha-reveal="words"><Words text={BUILDERS.title} /></h2>
        <div class="aside" data-ha-reveal="rise">
          <p class="ha-lead">{BUILDERS.summary}</p>
          <TextLink href={BUILDERS.all.href} label={BUILDERS.all.label} class="all" />
        </div>
      </div>
    </div>

    <div class="stage" data-ha-pin>
      {
        builders.length > 0 ? (
          <>
            <div class="viewport" data-ha-viewport>
              <ul class="track" data-ha-track>
                {builders.map((builder) => (
                  <li class="slide">
                    <BuilderCard builder={builder} />
                  </li>
                ))}
                <li class="end-slide">
                  <a class="end" href={BUILDERS.all.href}>
                    <span class="end-label">{BUILDERS.all.label}</span>
                    <span class="end-icon">
                      <Arrow />
                    </span>
                  </a>
                </li>
              </ul>
            </div>

            <div class="ha-wrap controls" data-ha-controls>
              <div class="meter" aria-hidden="true">
                <span class="bar">
                  <span class="bar-fill" data-ha-bar />
                </span>
                <span class="count">
                  <span data-ha-index>01</span> / {total}
                </span>
              </div>
              <div class="steps">
                <button type="button" class="step" data-ha-step="-1" aria-label="Previous builders">
                  <Arrow class="flip" />
                </button>
                <button type="button" class="step" data-ha-step="1" aria-label="Next builders">
                  <Arrow />
                </button>
              </div>
            </div>
          </>
        ) : (
          <div class="ha-wrap">
            <p class="empty">{BUILDERS.empty}</p>
          </div>
        )
      }
    </div>
  </div>

  <div class="cursor" aria-hidden="true" data-ha-cursor>View</div>
</section>

<style>
  .builders {
    position: relative;
    padding-block: var(--ha-section);
  }

  .head {
    row-gap: 1.5rem;
    align-items: end;
  }

  .title,
  .aside {
    grid-column: 1 / -1;
  }

  .aside :global(.all) {
    margin-top: 1rem;
  }

  @media (min-width: 768px) {
    .title {
      grid-column: 1 / span 6;
    }

    .aside {
      grid-column: 7 / -1;
    }
  }

  .stage {
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }

  /* Native swipe track. The side padding lines the first card up with the grid. */
  .track {
    position: relative;
    --edge: max(var(--ha-gutter), calc((100% - 80rem) / 2 + var(--ha-gutter)));
    display: flex;
    gap: var(--ha-gap);
    margin: 0;
    padding: 0.5rem var(--edge) 1.25rem;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--edge);
    scrollbar-width: thin;
    scrollbar-color: var(--ha-peach) transparent;
  }

  .slide,
  .end-slide {
    flex: 0 0 clamp(17rem, 80vw, 22.5rem);
    scroll-snap-align: start;
  }

  /* The closing tile: a quiet way out to the full directory. */
  .end {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    height: 100%;
    min-height: 16rem;
    box-sizing: border-box;
    padding: 1.5rem;
    border: 1px dashed rgba(242, 141, 104, 0.45);
    border-radius: 1.25rem;
    color: var(--ha-ink);
    text-decoration: none;
    transition: background-color 450ms var(--ha-ease), border-color 450ms var(--ha-ease);
  }

  .end-label {
    max-width: 10ch;
    font-family: var(--font-body);
    font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.25rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .end-icon {
    display: grid;
    place-items: center;
    align-self: flex-end;
    width: 4.5rem;
    height: 4.5rem;
    border: 1px solid var(--ha-peach);
    border-radius: 50%;
    color: var(--ha-peach);
    transition: background-color 450ms var(--ha-ease), color 450ms var(--ha-ease), transform 600ms var(--ha-ease);
  }

  .end-icon :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
  }

  .end:hover,
  .end:focus-visible {
    border-color: var(--ha-peach);
    background: rgba(242, 141, 104, 0.08);
  }

  .end:hover .end-icon,
  .end:focus-visible .end-icon {
    background: var(--ha-peach);
    color: var(--ha-dark);
    transform: rotate(-45deg);
  }

  @media (min-width: 1024px) {
    .builders.is-few .track {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      max-width: 80rem;
      box-sizing: border-box;
      margin-inline: auto;
      padding-inline: var(--ha-gutter);
      overflow: visible;
    }

    .builders.is-few .slide {
      grid-column: span var(--span);
    }

    .builders.is-few .end-slide {
      grid-column: span var(--end-span);
    }
  }

  .controls {
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 1.25rem;
  }

  .builders.has-overflow .controls {
    display: flex;
  }

  .builders.has-overflow .track {
    scrollbar-width: none;
  }

  .builders.has-overflow .track::-webkit-scrollbar {
    display: none;
  }

  .meter {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 1.25rem;
    max-width: 28rem;
  }

  .bar {
    position: relative;
    flex: 1;
    height: 2px;
    background: var(--ha-rule);
    overflow: hidden;
  }

  .bar-fill {
    position: absolute;
    inset: 0;
    background: var(--ha-peach);
    transform: scaleX(0.15);
    transform-origin: left center;
    transition: transform 450ms var(--ha-ease);
  }

  .count {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ha-ink-2);
    font-variant-numeric: tabular-nums;
  }

  .steps {
    display: none;
    gap: 0.6rem;
  }

  .step {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--ha-rule);
    border-radius: 50%;
    background: transparent;
    color: var(--ha-ink);
    cursor: pointer;
    transition: border-color 300ms var(--ha-ease), background-color 300ms var(--ha-ease), color 300ms var(--ha-ease);
  }

  .step :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .step :global(.flip) {
    transform: scaleX(-1);
  }

  .step:hover {
    border-color: var(--ha-peach);
    background: var(--ha-peach);
    color: var(--ha-dark);
  }

  .step:disabled {
    opacity: 0.35;
    cursor: default;
    pointer-events: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .steps {
      display: flex;
    }
  }

  /* Pinned mode: the track becomes one long row moved by transforms. */
  .builders.is-pinned .viewport {
    overflow: clip;
  }

  .builders.is-pinned .track {
    width: max-content;
    overflow: visible;
    scroll-snap-type: none;
  }

  .builders.is-pinned .slide,
  .builders.is-pinned .end-slide {
    flex-basis: clamp(21rem, 24vw, 24rem);
  }

  .builders.is-pinned .steps {
    display: none;
  }

  .empty {
    margin: 0;
    padding: clamp(2rem, 4vw, 3rem) 0;
    border-block: 1px solid var(--ha-rule);
    max-width: none;
    font-family: var(--font-body);
    font-size: clamp(1.25rem, 1rem + 0.9vw, 1.875rem);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--ha-ink);
    text-wrap: balance;
  }

  /* The "View" disc that trails a fine pointer across the cards. */
  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 40;
    display: grid;
    place-items: center;
    /* Trails below-right of the pointer and inverts what it passes over, so it never hides text. */
    width: 4.5rem;
    height: 4.5rem;
    margin: 0.75rem 0 0 0.75rem;
    border-radius: 50%;
    background: var(--ha-ink);
    color: var(--ha-dark);
    mix-blend-mode: difference;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 700;
    pointer-events: none;
    opacity: 0;
    transform: scale(0);
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .end,
    .end-icon {
      transition: none;
    }

    .end:hover .end-icon,
    .end:focus-visible .end-icon {
      transform: none;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .builders.has-cursor :global(.card) {
      cursor: none;
    }
  }
</style>
