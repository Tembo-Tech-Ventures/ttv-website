---
/**
 * Renders a line of display copy as one span per word, so a reveal can slide
 * each word up from behind its own mask without replacing any text node. The
 * server output is the finished composition; motion only adds a starting pose.
 * Each word carries its index as `--i`, so a pure-CSS intro can stagger it.
 */
interface Props {
  text: string;
  /** How many trailing words to set in peach. */
  accent?: number;
  /** Start each sentence on a new line ("Not in a cohort? / Join the community."). */
  sentences?: boolean;
}

const { text, accent = 0, sentences = false } = Astro.props;
const words = text.split(/\s+/).filter(Boolean);
const accentFrom = words.length - accent;
---

{
  words.map((word, index) => (
    <>
      <span class:list={["ha-w", index >= accentFrom && "ha-accent"]} style={`--i: ${index}`}>
        <span class="ha-wi">{word}</span>
      </span>
      {index < words.length - 1 && (sentences && /[.?!]$/.test(word) ? <br /> : " ")}
    </>
  ))
}
