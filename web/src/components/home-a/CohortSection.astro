---
import { BUILDERS, COHORT } from "@/lib/homepage/content";
import Pill from "./Pill.astro";
import TextLink from "./TextLink.astro";
import Words from "./Words.astro";

/**
 * #cohorts: the hero and the programme. The title, summary and apply action
 * come first so a phone visitor knows what a cohort is before scrolling; the
 * cohort strip and the weekly rhythm follow as the evidence.
 */
const meetLabel = BUILDERS.title.replace(/\.$/, "");
---

<section id="cohorts" class="cohorts" data-ha-hero>
  <div class="ha-wrap">
    <div class="hero ha-grid">
      <h1 class="ha-h1 title"><Words text={COHORT.title} accent={2} /></h1>

      <div class="intro" data-ha-rise>
        <p class="ha-lead lead">{COHORT.summary}</p>
        <div class="actions">
          <Pill href={COHORT.apply.href} label={COHORT.apply.label} />
          <TextLink href="#builders" label={meetLabel} />
        </div>
      </div>

      <ul class="facts" data-ha-rise>
        {
          COHORT.facts.map((fact) => (
            <li class="fact">
              <span class="fact-value" data-ha-count>{fact.value}</span>
              <span class="fact-label">{fact.label}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <ol class="strip" aria-label="Cohorts so far" data-ha-strip>
      {
        COHORT.timeline.map((cohort) => (
          <li class:list={["cohort", cohort.running ? "is-live" : "is-done"]}>
            <span class="cohort-line" aria-hidden="true" />
            <span class="cohort-num">{cohort.number}</span>
            <span class="cohort-state">
              {cohort.running && <span class="pulse" aria-hidden="true" />}
              {cohort.status}
            </span>
          </li>
        ))
      }
    </ol>

    <div class="rhythm" data-ha-rhythm>
      <span class="rhythm-draw" aria-hidden="true" data-ha-draw />
      <ul class="rhythm-list ha-grid">
        {
          COHORT.rhythm.map((item) => (
            <li class="beat" data-ha-beat>
              <h3 class="beat-title">{item.title}</h3>
              <p class="beat-copy">{item.copy}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .cohorts {
    position: relative;
    padding-top: clamp(2.75rem, 7vw, 6.5rem);
    padding-bottom: var(--ha-section);
  }

  .hero {
    row-gap: clamp(2.25rem, 5vw, 4.5rem);
    align-items: end;
  }

  .title {
    grid-column: 1 / -1;
    max-width: 17ch;
  }

  .intro,
  .facts {
    grid-column: 1 / -1;
  }

  .lead {
    max-width: 34rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2rem;
  }

  .facts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fact {
    display: grid;
    grid-template-columns: 6.25rem 1fr;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.85rem;
    border-top: 1px solid var(--ha-rule);
  }

  .fact:last-child {
    border-bottom: 1px solid var(--ha-rule);
  }

  .fact-value {
    font-family: var(--font-heading);
    font-size: clamp(1.85rem, 1.4rem + 1.4vw, 2.6rem);
    line-height: 1;
    letter-spacing: var(--tracking-heading);
    color: var(--ha-peach);
    font-variant-numeric: tabular-nums;
  }

  .fact-label {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.4;
    color: var(--ha-ink-2);
  }

  @media (min-width: 900px) {
    .intro {
      grid-column: 1 / span 6;
    }

    .facts {
      grid-column: 8 / -1;
    }

    .fact {
      grid-template-columns: 7.5rem 1fr;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      min-height: calc(100svh - 4.5rem - clamp(2.75rem, 7vw, 6.5rem) - 3.5rem);
      align-content: space-between;
    }
  }

  /* The cohort strip: four numerals on a shared rule. Complete ones are filled. */
  .strip {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem var(--ha-gap);
    margin: clamp(4.5rem, 9vw, 8rem) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .strip {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .cohort {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--ha-rule);
  }

  .cohort-line {
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--ha-peach);
    transform-origin: left center;
  }

  .is-live .cohort-line {
    background: linear-gradient(90deg, transparent, var(--ha-peach) 40%, transparent 80%) no-repeat;
    background-size: 60% 100%;
    animation: ha-scan 2.6s var(--ha-ease) infinite;
  }

  .cohort-num {
    --ha-fill: 0%;
    display: block;
    font-family: var(--font-heading);
    font-size: clamp(3.75rem, 1rem + 7.2vw, 8.25rem);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    color: transparent;
    -webkit-text-stroke: max(1px, 0.014em) var(--ha-peach);
    background: linear-gradient(var(--ha-peach), var(--ha-peach)) no-repeat 0 0 / var(--ha-fill) 100%;
    -webkit-background-clip: text;
    background-clip: text;
    transition: --ha-fill 700ms var(--ha-ease);
  }

  /* Completed numerals are filled by script on arrival, so no CSS transition fights it. */
  .is-done .cohort-num {
    --ha-fill: 100%;
    transition: none;
  }

  .cohort-state {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-body);
    font-size: clamp(0.875rem, 0.82rem + 0.25vw, 1rem);
    font-weight: 600;
    color: var(--ha-ink-2);
  }

  .is-live .cohort-state {
    color: var(--ha-peach);
  }

  .pulse {
    position: relative;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--ha-peach);
    flex: none;
  }

  .pulse::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid var(--ha-peach);
    animation: ha-pulse 1.8s ease-out infinite;
  }

  @media (hover: hover) and (pointer: fine) {
    .is-live:hover .cohort-num {
      --ha-fill: 100%;
    }
  }

  @keyframes ha-pulse {
    from { transform: scale(1); opacity: 0.9; }
    to { transform: scale(3.2); opacity: 0; }
  }

  @keyframes ha-scan {
    from { background-position: -80% 0; }
    to { background-position: 220% 0; }
  }

  /* The rhythm: three columns on one rule, with a peach line drawn by scroll. */
  .rhythm {
    position: relative;
    margin-top: clamp(4rem, 8vw, 7rem);
    border-top: 1px solid var(--ha-rule);
  }

  .rhythm-draw {
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--ha-peach);
    transform-origin: left center;
  }

  .rhythm-list {
    margin: 0;
    padding: 0;
    list-style: none;
    row-gap: 2.25rem;
  }

  .beat {
    grid-column: 1 / -1;
    padding-top: 1.75rem;
  }

  .beat-title {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(1.3rem, 1.1rem + 0.7vw, 1.75rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--ha-ink);
  }

  .beat-copy {
    margin: 0.85rem 0 0;
    max-width: 24rem;
    font-family: var(--font-body);
    font-size: clamp(1rem, 0.96rem + 0.18vw, 1.125rem);
    line-height: 1.6;
    color: var(--ha-ink-2);
  }

  @media (min-width: 768px) {
    .beat {
      grid-column: span 4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse::after,
    .is-live .cohort-line {
      animation: none;
    }

    .is-live .cohort-line {
      background: var(--ha-peach);
      background-size: 100% 100%;
      opacity: 0.5;
    }

    .cohort-num {
      transition: none;
    }
  }
</style>
