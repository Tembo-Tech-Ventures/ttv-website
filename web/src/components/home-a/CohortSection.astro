---
import { COHORT } from "@/lib/homepage/content";
import Pill from "./Pill.astro";
import TextLink from "./TextLink.astro";
import Words from "./Words.astro";

/**
 * #cohorts: the hero and the programme. The title, summary, apply action and
 * eligibility come first so a phone visitor knows what a cohort is, and that
 * they can join without a degree, before scrolling.
 *
 * On large screens the running cohort's numeral sits behind the headline as
 * the hero's image. It is decorative (the facts and the strip say the same in
 * text); motion/cohort.ts carries it down into its slot in the cohort strip.
 */
const running = COHORT.timeline.find((cohort) => cohort.running) ?? COHORT.timeline.at(-1);
---

<section id="cohorts" class="cohorts" data-ha-hero>
  <div class="ha-wrap">
    <div class="hero ha-grid" data-ha-hero-grid>
      {
        running && (
          <div class="live" aria-hidden="true" data-ha-live>
            <span class="live-num" data-ha-live-num>{running.number}</span>
            <span class="live-caption" data-ha-live-tag>
              <span class="live-scan" data-ha-loop>
                <span class="glint" />
              </span>
              <span class="live-label">
                <span class="pulse" data-ha-loop />
                {running.status}
              </span>
            </span>
          </div>
        )
      }

      <h1 class="ha-h1 title ha-hero-title"><Words text={COHORT.title} accent={2} /></h1>

      <div class="intro ha-hero-rise" style="--r: 0">
        <p class="ha-lead lead">{COHORT.summary}</p>
        <div class="actions">
          <Pill href={COHORT.apply.href} label={COHORT.apply.label} />
          <p class="eligibility">{COHORT.eligibility}</p>
          <TextLink href={COHORT.secondary.href} label={COHORT.secondary.label} />
        </div>
      </div>

      <ul class="facts ha-hero-rise" style="--r: 1">
        {
          COHORT.facts.map((fact, index) => (
            <li class="fact">
              <span class="fact-value" data-ha-count={index === 0 ? "" : undefined}>
                {fact.value}
              </span>
              <span class="fact-label">{fact.label}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <ol class="strip" aria-label="Cohorts so far" data-ha-strip>
      {
        COHORT.timeline.map((cohort) => (
          <li class:list={["cohort", cohort.running ? "is-live" : "is-done"]}>
            <span class="cohort-line" aria-hidden="true" data-ha-loop={cohort.running ? "" : undefined}>
              {cohort.running && <span class="glint" />}
            </span>
            <span class="cohort-num" data-ha-slot={cohort.running ? "" : undefined}>
              {cohort.number}
            </span>
            <span class="cohort-state">
              {cohort.running && <span class="pulse" aria-hidden="true" data-ha-loop />}
              {cohort.status}
            </span>
          </li>
        ))
      }
    </ol>

    <div class="rhythm" data-ha-rhythm>
      <span class="rhythm-draw" aria-hidden="true" data-ha-draw />
      <ul class="rhythm-list ha-grid">
        {
          COHORT.rhythm.map((item) => (
            <li class="beat" data-ha-beat>
              <h3 class="beat-title">{item.title}</h3>
              <p class="beat-copy">{item.copy}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .cohorts {
    position: relative;
    padding-top: clamp(2.75rem, 7vw, 6.5rem);
    padding-bottom: var(--ha-section);
  }

  /* The hero ends where its content ends: one fixed gap, no stretched band. */
  .hero {
    position: relative;
    row-gap: clamp(2.25rem, 5vh, 4rem);
    align-items: start;
  }

  .title {
    position: relative;
    z-index: 1;
    grid-row: 1;
    grid-column: 1 / -1;
    max-width: 17ch;
  }

  /* Above the travelling numeral, which only ever passes behind them. */
  .intro,
  .facts {
    position: relative;
    z-index: 1;
    grid-column: 1 / -1;
  }

  .lead {
    max-width: 34rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2rem;
  }

  .eligibility {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    color: var(--ha-ink);
  }

  .eligibility::before {
    content: "";
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--ha-peach);
    flex: none;
  }

  .facts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fact {
    display: grid;
    grid-template-columns: 6.25rem 1fr;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.85rem;
    border-top: 1px solid var(--ha-rule);
  }

  .fact:last-child {
    border-bottom: 1px solid var(--ha-rule);
  }

  .fact-value {
    font-family: var(--font-heading);
    font-size: clamp(1.85rem, 1.4rem + 1.4vw, 2.6rem);
    line-height: 1;
    letter-spacing: var(--tracking-heading);
    color: var(--ha-peach);
    font-variant-numeric: tabular-nums;
  }

  .fact-label {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.4;
    color: var(--ha-ink-2);
  }

  /* One right-hand column start for the whole page: column 7. */
  @media (min-width: 768px) {
    .intro {
      grid-column: 1 / span 6;
    }

    .facts {
      grid-column: 7 / -1;
    }

    .fact {
      grid-template-columns: 7.5rem 1fr;
    }
  }

  /* The running cohort's numeral, layered behind the headline. */
  .live {
    display: none;
  }

  /*
   * Large screens: the headline keeps to eight columns, the numeral to the last
   * four. Size and spacing also answer to the window's height, so Apply and the
   * eligibility line are on the first screen of a real laptop browser window.
   * The 82px cap keeps the headline on four lines at every width.
   */
  @media (min-width: 1024px) {
    .cohorts {
      padding-top: clamp(1.5rem, 5svh, 6.5rem);
    }

    .hero {
      row-gap: clamp(1.5rem, 4svh, 4rem);
    }

    .title {
      grid-column: 1 / span 8;
      max-width: none;
      font-size: min(5.125rem, 0.9rem + 4.7vw, 10.5svh);
    }

    .actions {
      margin-top: clamp(1.25rem, 3svh, 2rem);
    }

    .live {
      position: relative;
      z-index: 0;
      grid-row: 1;
      grid-column: 9 / -1;
      align-self: start;
      justify-self: end;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.85rem;
      margin-top: 0.4rem;
      pointer-events: none;
      user-select: none;
    }
  }

  /* A caption under the numeral, in the strip's own numeral-then-state order. */
  .live-caption {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    width: 100%;
  }

  .live-scan {
    position: relative;
    width: 100%;
    height: 2px;
    overflow: hidden;
    background: var(--ha-rule);
  }

  /* The moving highlight is a transformed child, so it never repaints. */
  .glint {
    position: absolute;
    inset: 0 auto 0 0;
    width: 45%;
    background: linear-gradient(90deg, transparent, var(--ha-peach) 45%, transparent);
    animation: ha-glint 2.6s var(--ha-ease) infinite;
  }

  .live-label {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ha-peach);
  }

  .live-num {
    display: block;
    font-family: var(--font-heading);
    font-size: clamp(8rem, 12.5vw, 12rem);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    color: transparent;
    -webkit-text-stroke: max(1px, 0.012em) var(--ha-peach);
    transform-origin: 0 0;
  }

  /* The cohort strip: four numerals on a shared rule. Complete ones are filled. */
  .strip {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem var(--ha-gap);
    margin: clamp(4rem, 8vw, 7rem) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .strip {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .cohort {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--ha-rule);
  }

  .cohort-line {
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--ha-peach);
    transform-origin: left center;
  }

  .is-live .cohort-line {
    overflow: hidden;
    background: transparent;
  }

  .cohort-num {
    --ha-fill: 0%;
    display: block;
    width: max-content;
    font-family: var(--font-heading);
    font-size: clamp(3.75rem, 1rem + 7.2vw, 8.25rem);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    color: transparent;
    -webkit-text-stroke: max(1px, 0.012em) var(--ha-peach);
    background: linear-gradient(var(--ha-peach), var(--ha-peach)) no-repeat 0 0 / var(--ha-fill) 100%;
    -webkit-background-clip: text;
    background-clip: text;
    transition: --ha-fill 700ms var(--ha-ease);
  }

  /* Completed numerals are filled by script on arrival, so no CSS transition fights it. */
  .is-done .cohort-num {
    --ha-fill: 100%;
    transition: none;
  }

  /* While motion assembles the strip, completed numerals start empty; the fill tween takes over. */
  .strip.is-assembling .is-done .cohort-num {
    --ha-fill: 0%;
  }

  .cohort-state {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-body);
    font-size: clamp(0.875rem, 0.82rem + 0.25vw, 1rem);
    font-weight: 600;
    color: var(--ha-ink-2);
  }

  .is-live .cohort-state {
    color: var(--ha-peach);
  }

  .pulse {
    position: relative;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--ha-peach);
    flex: none;
  }

  .pulse::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid var(--ha-peach);
    animation: ha-pulse 1.8s ease-out infinite;
  }

  /* The beat when the travelling 04 lands: a fill that drains away again. */
  .cohort-num.is-landed {
    --ha-fill: 100%;
    transition-duration: 380ms;
  }

  @media (hover: hover) and (pointer: fine) {
    .is-live:hover .cohort-num {
      --ha-fill: 100%;
    }
  }

  @keyframes ha-pulse {
    from { transform: scale(1); opacity: 0.9; }
    to { transform: scale(3.2); opacity: 0; }
  }

  @keyframes ha-glint {
    from { transform: translateX(-100%); }
    to { transform: translateX(320%); }
  }

  /* The rhythm: three columns on one rule, with a peach line drawn by scroll. */
  .rhythm {
    position: relative;
    margin-top: clamp(4rem, 8vw, 7rem);
    border-top: 1px solid var(--ha-rule);
  }

  .rhythm-draw {
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--ha-peach);
    transform-origin: left center;
  }

  .rhythm-list {
    margin: 0;
    padding: 0;
    list-style: none;
    row-gap: 2.25rem;
  }

  .beat {
    grid-column: 1 / -1;
    padding-top: 1.75rem;
  }

  .beat-title {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(1.3rem, 1.1rem + 0.7vw, 1.75rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--ha-ink);
  }

  .beat-copy {
    margin: 0.85rem 0 0;
    max-width: 24rem;
    font-family: var(--font-body);
    font-size: clamp(1rem, 0.96rem + 0.18vw, 1.125rem);
    line-height: 1.6;
    color: var(--ha-ink-2);
  }

  @media (min-width: 768px) {
    .beat {
      grid-column: span 4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse::after,
    .glint {
      animation: none;
    }

    .glint {
      display: none;
    }

    .is-live .cohort-line {
      background: var(--ha-peach);
      opacity: 0.5;
    }

    .cohort-num {
      transition: none;
    }
  }
</style>
