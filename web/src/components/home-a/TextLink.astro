---
import Arrow from "./Arrow.astro";

/** Secondary action: text with a redrawing underline and a nudging arrow. */
interface Props {
  href: string;
  label: string;
  class?: string;
}

const { href, label, class: className } = Astro.props;
---

<a href={href} class:list={["ha-link", className]}>
  <span class="ha-link-text">{label}</span>
  <Arrow />
</a>
