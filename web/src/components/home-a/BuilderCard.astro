---
import type { HomepageBuilder } from "@/lib/homepage/builders";

/**
 * One builder. The whole card is a single link to the profile. The monogram is
 * outlined and wipes to solid peach on hover or focus; an avatar, when there is
 * one, takes its place.
 */
interface Props {
  builder: HomepageBuilder;
}

const { builder } = Astro.props;
// Cohort and country on two short lines, so the label never crowds the monogram.
const where = [builder.cohort, builder.country].filter(Boolean);
---

<a class="card" href={builder.href} data-ha-card>
  <div class="art">
    {
      builder.image ? (
        <img class="avatar" src={builder.image} alt="" width="72" height="72" loading="lazy" decoding="async" />
      ) : (
        <span class="mono" aria-hidden="true">
          {builder.initials}
        </span>
      )
    }
    {
      where.length > 0 && (
        <span class="where">
          {where.map((part) => (
            <span>{part}</span>
          ))}
        </span>
      )
    }
  </div>

  <div class="body">
    <h3 class="name">{builder.name}</h3>
    {builder.headline && <p class="headline">{builder.headline}</p>}

    {
      builder.project && (
        <div class="project">
          <p class="project-title">
            <span class="project-name">{builder.project.name}</span>
            {builder.project.language && <span class="project-lang">{builder.project.language}</span>}
          </p>
          {builder.project.description && <p class="project-description">{builder.project.description}</p>}
        </div>
      )
    }

    {
      builder.skills.length > 0 && (
        <ul class="skills" aria-label="Skills">
          {builder.skills.map((skill) => (
            <li>{skill}</li>
          ))}
        </ul>
      )
    }
  </div>
</a>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
    border: 1px solid var(--ha-rule);
    border-radius: 1.25rem;
    background: rgba(1, 42, 40, 0.55);
    color: var(--ha-ink);
    text-decoration: none;
    transition: border-color 400ms var(--ha-ease), background-color 400ms var(--ha-ease);
  }

  .card:hover,
  .card:focus-visible {
    border-color: var(--ha-peach);
    background: rgba(1, 42, 40, 0.9);
  }

  /* A compact art band: monogram bottom-left, cohort on the same line at right. */
  .art {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    min-height: clamp(6.5rem, 16vw, 8.5rem);
    box-sizing: border-box;
    padding: 1rem 1.5rem 1rem;
    border-bottom: 1px solid var(--ha-rule);
  }

  .mono {
    --ha-fill: 0%;
    font-family: var(--font-heading);
    font-size: clamp(3rem, 2.3rem + 2vw, 4rem);
    white-space: nowrap;
    line-height: 0.9;
    letter-spacing: var(--tracking-display);
    color: transparent;
    -webkit-text-stroke: max(1px, 0.016em) var(--ha-peach);
    background: linear-gradient(var(--ha-peach), var(--ha-peach)) no-repeat 0 0 / var(--ha-fill) 100%;
    -webkit-background-clip: text;
    background-clip: text;
    transition: --ha-fill 650ms var(--ha-ease), transform 650ms var(--ha-ease);
  }

  .card:hover .mono,
  .card:focus-visible .mono {
    --ha-fill: 100%;
    transform: translateX(0.35rem);
  }

  .avatar {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    object-fit: cover;
    outline: 1px solid var(--ha-peach);
    outline-offset: 4px;
    filter: grayscale(1) contrast(1.05);
    transition: filter 500ms var(--ha-ease);
  }

  .card:hover .avatar,
  .card:focus-visible .avatar {
    filter: none;
  }

  .where {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    flex: none;
    padding-bottom: 0.3rem;
    line-height: 1.35;
    text-align: right;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ha-ink-2);
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.4rem 1.5rem 1.5rem;
  }

  .name {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--ha-ink);
  }

  /* Two lines reserved, so the project rule lines up across a row of cards. */
  .headline {
    min-height: 3em;
    margin: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--ha-ink-2);
  }

  .project {
    margin: 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--ha-rule);
    font-family: var(--font-body);
  }

  .project-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 0.75rem;
    margin: 0;
  }

  .project-name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--ha-peach);
  }

  .project-lang {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ha-ink-2);
  }

  .project-description {
    margin: 0.4rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ha-ink-2);
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: auto 0 0;
    padding-top: 0.25rem;
    padding: 0;
    list-style: none;
  }

  .skills li {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--ha-rule);
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ha-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .mono,
    .avatar {
      transition: none;
    }

    .card:hover .mono,
    .card:focus-visible .mono {
      transform: none;
    }
  }
</style>
