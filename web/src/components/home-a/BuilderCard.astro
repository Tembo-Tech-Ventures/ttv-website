---
import type { HomepageBuilder } from "@/lib/homepage/builders";
import { formatCohortLocation } from "@/lib/site";

/**
 * One builder. The whole card is a single link to the profile. The monogram is
 * outlined and wipes to solid peach on hover or focus; an avatar, when there is
 * one, takes its place.
 */
interface Props {
  builder: HomepageBuilder;
}

const { builder } = Astro.props;
const where = formatCohortLocation(builder.cohort, builder.country);
---

<a class="card" href={builder.href} data-ha-card>
  <div class="art">
    {
      builder.image ? (
        <img class="avatar" src={builder.image} alt="" width="96" height="96" loading="lazy" decoding="async" />
      ) : (
        <span class="mono" aria-hidden="true">
          {builder.initials}
        </span>
      )
    }
    {where && <span class="where">{where}</span>}
  </div>

  <div class="body">
    <h3 class="name">{builder.name}</h3>
    {builder.headline && <p class="headline">{builder.headline}</p>}

    {
      builder.project && (
        <p class="project">
          <span class="project-label">Project</span>
          <span class="project-name">{builder.project.name}</span>
          {builder.project.language && <span class="project-lang">{builder.project.language}</span>}
        </p>
      )
    }

    {
      builder.skills.length > 0 && (
        <ul class="skills" aria-label="Skills">
          {builder.skills.map((skill) => (
            <li>{skill}</li>
          ))}
        </ul>
      )
    }
  </div>
</a>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
    border: 1px solid var(--ha-rule);
    border-radius: 1.25rem;
    background: rgba(1, 42, 40, 0.55);
    color: var(--ha-ink);
    text-decoration: none;
    transition: border-color 400ms var(--ha-ease), background-color 400ms var(--ha-ease);
  }

  .card:hover,
  .card:focus-visible {
    border-color: var(--ha-peach);
    background: rgba(1, 42, 40, 0.9);
  }

  .art {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(10.5rem, 30vw, 13.5rem);
    padding: 1.25rem 1.5rem 1.1rem;
    border-bottom: 1px solid var(--ha-rule);
  }

  .mono {
    --ha-fill: 0%;
    font-family: var(--font-heading);
    font-size: clamp(4.25rem, 3rem + 4vw, 6.25rem);
    line-height: 0.9;
    letter-spacing: var(--tracking-display);
    color: transparent;
    -webkit-text-stroke: max(1px, 0.016em) var(--ha-peach);
    background: linear-gradient(var(--ha-peach), var(--ha-peach)) no-repeat 0 0 / var(--ha-fill) 100%;
    -webkit-background-clip: text;
    background-clip: text;
    transition: --ha-fill 650ms var(--ha-ease), transform 650ms var(--ha-ease);
  }

  .card:hover .mono,
  .card:focus-visible .mono {
    --ha-fill: 100%;
    transform: translateX(0.35rem);
  }

  .avatar {
    width: 6rem;
    height: 6rem;
    border-radius: 50%;
    object-fit: cover;
    outline: 1px solid var(--ha-peach);
    outline-offset: 4px;
    filter: grayscale(1) contrast(1.05);
    transition: filter 500ms var(--ha-ease);
  }

  .card:hover .avatar,
  .card:focus-visible .avatar {
    filter: none;
  }

  .where {
    position: absolute;
    top: 1.25rem;
    right: 1.5rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ha-ink-2);
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.4rem 1.5rem 1.5rem;
  }

  .name {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--ha-ink);
  }

  .headline {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--ha-ink-2);
  }

  .project {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.6rem;
    margin: auto 0 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--ha-rule);
    font-family: var(--font-body);
    font-size: 0.9375rem;
  }

  .project-label {
    color: var(--ha-ink-3);
  }

  .project-name {
    font-weight: 700;
    color: var(--ha-peach);
  }

  .project-lang {
    color: var(--ha-ink-2);
  }

  .project-lang::before {
    content: "·";
    margin-right: 0.6rem;
    color: var(--ha-ink-3);
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skills li {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--ha-rule);
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ha-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .mono,
    .avatar {
      transition: none;
    }

    .card:hover .mono,
    .card:focus-visible .mono {
      transform: none;
    }
  }
</style>
