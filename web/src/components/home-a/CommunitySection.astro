---
import { COMMUNITY } from "@/lib/homepage/content";
import Arrow from "./Arrow.astro";
import Pill from "./Pill.astro";
import Words from "./Words.astro";

/**
 * #community: three ways in, set as large editorial rows. Everything is
 * readable at rest; hover and keyboard focus add a peach wipe, slide the role
 * and turn the arrow.
 */
interface Props {
  isAuthenticated: boolean;
}

const { isAuthenticated } = Astro.props;
---

<section id="community" class="ha-section community">
  <div class="ha-wrap">
    <div class="head ha-grid">
      <h2 class="ha-h2 title" data-ha-reveal="words"><Words text={COMMUNITY.title} accent={1} sentences /></h2>
      <div class="aside" data-ha-reveal="rise">
        <p class="ha-lead">{COMMUNITY.summary}</p>
        <div class="join">
          <Pill href={COMMUNITY.join(isAuthenticated)} label={COMMUNITY.joinLabel} />
        </div>
      </div>
    </div>

    <ul class="paths" data-ha-paths>
      {
        COMMUNITY.paths.map((path) => (
          <li class="item">
            <span class="item-rule" aria-hidden="true" data-ha-rule />
            <a class="path ha-grid" href={path.href} data-ha-press>
              <span class="wipe" aria-hidden="true" />
              <h3 class="role">{path.role}</h3>
              <span class="copy">
                <span class="promise">{path.promise}</span>
                <span class="detail">{path.detail}</span>
                <span class="cta">
                  <span class="cta-label">{path.cta}</span>
                  <span class="cta-icon">
                    <Arrow />
                  </span>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .head {
    row-gap: 1.75rem;
    align-items: end;
  }

  .title,
  .aside {
    grid-column: 1 / -1;
  }

  .join {
    margin-top: 1.75rem;
  }

  /* A full-width two-line title, with the deck on the shared right column beneath it. */
  @media (min-width: 768px) {
    .aside {
      grid-column: 7 / -1;
    }
  }

  .paths {
    margin: clamp(3rem, 6vw, 5rem) 0 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--ha-rule);
  }

  .item {
    position: relative;
  }

  .item-rule {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    width: 100%;
    height: 1px;
    background: var(--ha-rule);
    transform-origin: left center;
  }

  .path {
    position: relative;
    row-gap: 1rem;
    align-items: center;
    margin-inline: calc(var(--ha-gutter) * -0.75);
    padding: clamp(1.75rem, 3.2vw, 2.75rem) calc(var(--ha-gutter) * 0.75);
    color: var(--ha-ink);
    text-decoration: none;
    isolation: isolate;
    scroll-margin-block: 1.5rem;
  }

  .wipe {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ha-peach);
    transform: scaleY(0);
    transform-origin: center bottom;
    transition: transform 600ms var(--ha-ease);
  }

  .role,
  .copy {
    grid-column: 1 / -1;
  }

  .role {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(1.9rem, 1.2rem + 2.4vw, 3.25rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.025em;
    transition: transform 600ms var(--ha-ease), color 400ms var(--ha-ease);
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-family: var(--font-body);
  }

  .promise {
    text-wrap: pretty;
    font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.25rem);
    line-height: 1.5;
    color: var(--ha-ink);
    transition: color 400ms var(--ha-ease);
  }

  .detail {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.9375rem;
    color: var(--ha-ink-2);
    transition: color 400ms var(--ha-ease);
  }

  .detail::before {
    content: "";
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--ha-peach);
    flex: none;
    transition: background-color 400ms var(--ha-ease);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.85rem;
    margin-top: 0.75rem;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    color: var(--ha-peach);
    transition: color 400ms var(--ha-ease);
  }

  .cta-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    flex: none;
  }

  .cta-icon :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
    transform: rotate(-45deg);
    transition: transform 600ms var(--ha-ease);
  }

  @media (min-width: 768px) {
    .role {
      grid-column: 1 / span 6;
      align-self: start;
    }

    .copy {
      grid-column: 7 / -1;
    }
  }

  .path:hover .wipe,
  .path:focus-visible .wipe,
  .path:active .wipe,
  .path.is-pressed .wipe {
    transform: scaleY(1);
  }

  /* Touch has no hover: answer the press itself, quickly (see motion/ambient.ts). */
  .path:active .wipe,
  .path.is-pressed .wipe {
    transition-duration: 200ms;
  }

  .path:hover .role,
  .path:focus-visible .role {
    transform: translateX(clamp(0.5rem, 1.5vw, 1.25rem));
  }

  .path:hover .role,
  .path:hover .promise,
  .path:hover .cta,
  .path:hover .detail,
  .path:focus-visible .role,
  .path:focus-visible .promise,
  .path:focus-visible .cta,
  .path:focus-visible .detail,
  .path:active .role,
  .path:active .promise,
  .path:active .cta,
  .path:active .detail,
  .path.is-pressed .role,
  .path.is-pressed .promise,
  .path.is-pressed .cta,
  .path.is-pressed .detail {
    color: var(--ha-dark);
  }

  .path:hover .detail::before,
  .path:focus-visible .detail::before,
  .path.is-pressed .detail::before {
    background: var(--ha-dark);
  }

  .path:hover .cta-icon :global(svg),
  .path:focus-visible .cta-icon :global(svg),
  .path.is-pressed .cta-icon :global(svg) {
    transform: rotate(0deg);
  }

  .path:focus-visible {
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .wipe,
    .role,
    .promise,
    .detail,
    .cta,
    .cta-icon :global(svg) {
      transition: none;
    }

    .path:hover .role,
    .path:focus-visible .role {
      transform: none;
    }
  }
</style>
