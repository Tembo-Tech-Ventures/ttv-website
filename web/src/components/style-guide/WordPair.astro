---
import { PiCheckBold, PiXBold } from "react-icons/pi";

/**
 * Two ways to say one thing: the one we write, and the one we don't, with
 * why. The pair is a list so it reads in order without its colours.
 */
interface Props {
  write: string;
  not: string;
  why?: string;
}

const { write, not, why } = Astro.props;
---

<li class="min-w-0 rounded-[1.125rem] border border-hairline bg-ink-primary/4 p-5" data-word-pair>
  <p class="m-0 flex items-start gap-2.5 text-[0.9375rem] leading-relaxed text-ink-primary">
    <PiCheckBold aria-hidden className="mt-1 size-4 shrink-0 text-success-ink" />
    <span><span class="sr-only">Write: </span>{write}</span>
  </p>
  <p class="mt-2 mb-0 flex items-start gap-2.5 text-[0.9375rem] leading-relaxed text-ink-secondary">
    <PiXBold aria-hidden className="mt-1 size-4 shrink-0 text-danger-ink" />
    <span><span class="sr-only">Not: </span><s class="decoration-danger-ink/60">{not}</s></span>
  </p>
  {why && <p class="mt-3 mb-0 border-t border-hairline pt-3 text-sm leading-relaxed text-ink-muted">{why}</p>}
</li>
