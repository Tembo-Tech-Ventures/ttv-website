---
/**
 * A short piece of code to copy. It wraps rather than scrolling sideways: a
 * page that already scrolls should not hide a second scroller inside it.
 */
interface Props {
  code: string;
}

const { code } = Astro.props;
---

<pre
  class="mt-3 mb-0 rounded-xl border border-hairline bg-ground/60 px-4 py-3.5 font-mono text-[0.8125rem] leading-relaxed break-words whitespace-pre-wrap text-ink-secondary"
  data-code><code>{code}</code></pre>
